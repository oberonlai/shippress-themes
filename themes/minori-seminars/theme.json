{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": false,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "Ground (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "half",
     "name": "Alt ground",
     "color": "#F8F6F7"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#2A2628"
    },
    {
     "slug": "plum",
     "name": "Accent (plum-grey)",
     "color": "#655A62"
    },
    {
     "slug": "brick",
     "name": "Secondary tick (brick)",
     "color": "#B5524F"
    },
    {
     "slug": "tint-light",
     "name": "Tint band, light",
     "color": "#EFEAEE"
    },
    {
     "slug": "tint-deep",
     "name": "Tint band, deep",
     "color": "#D8CDD6"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#D8CDD6"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6E6569"
    },
    {
     "slug": "neutral-tag",
     "name": "Neutral tag",
     "color": "#8C8388"
    }
   ],
   "gradients": [
    {
     "slug": "tint",
     "name": "Tint band (124deg)",
     "gradient": "linear-gradient(124deg,#EFEAEE 0%,#D8CDD6 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Libre Baskerville)",
     "fontFamily": "\"Libre Baskerville\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Libre Baskerville",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LibreBaskerville-wght-latin.ttf"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "\"Karla\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Karla",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/karla-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "zh",
     "name": "Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Libre Baskerville\", \"Noto Serif CJK TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "ja",
     "name": "Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Libre Baskerville\", \"Noto Serif CJK JP\", \"Hiragino Mincho ProN\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-600-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Card title",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Statement",
     "size": "1.75rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Label",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Banner / H2",
     "size": "3.75rem",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Giant word",
     "size": "5rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.875rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.125rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "7.5rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.9"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "400",
     "lineHeight": "1.2"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--plum)"
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--white)",
     "text": "var(--wp--preset--color--ink)"
    }
   }
  },
  "blocks": {}
 }
}