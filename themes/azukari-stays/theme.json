{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Paper (ground)",
     "color": "#F1F3F2"
    },
    {
     "slug": "bar",
     "name": "Info bar grey",
     "color": "#E3E6E5"
    },
    {
     "slug": "dark",
     "name": "Ink-blue (panels)",
     "color": "#1C262E"
    },
    {
     "slug": "footer",
     "name": "Footer ink",
     "color": "#14181B"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#14181B"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5A6166"
    },
    {
     "slug": "hairline",
     "name": "Stepper hairline",
     "color": "#CCCCCC"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#D5DAD9"
    },
    {
     "slug": "accent",
     "name": "Clay (accent)",
     "color": "#9F563A"
    },
    {
     "slug": "accent-dark",
     "name": "Clay dark (hover)",
     "color": "#874630"
    },
    {
     "slug": "accent-on-dark",
     "name": "Clay tint on dark",
     "color": "#C98C72"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Outfit)",
     "fontFamily": "\"Outfit\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-small",
     "size": "0.6875rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "nav",
     "name": "Nav",
     "size": "0.875rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "2.5rem"
    },
    {
     "slug": "huge",
     "name": "Huge",
     "size": "3.5rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.75rem, 3.6vw + 1.5rem, 4.5rem)"
    },
    {
     "slug": "giant",
     "name": "Giant",
     "size": "clamp(3.5rem, 5vw + 1rem, 5.625rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "10",
     "name": "1",
     "size": "0.5rem"
    },
    {
     "slug": "20",
     "name": "2",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "3",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "4",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "5",
     "size": "3rem"
    },
    {
     "slug": "60",
     "name": "6",
     "size": "5rem"
    },
    {
     "slug": "70",
     "name": "7",
     "size": "7.5rem"
    },
    {
     "slug": "80",
     "name": "8",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "lineHeight": "1.8",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.25",
     "letterSpacing": "-0.015em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--accent)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent-dark)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--nav)",
     "fontWeight": "600",
     "letterSpacing": "0.06em"
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--accent-dark)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontWeight": "300"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}