{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1184px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "mist", "name": "Stage mist", "color": "#E4E1DD" },
				{ "slug": "ink", "name": "Ink", "color": "#1A1714" },
				{ "slug": "main", "name": "Rikyu-cha (main)", "color": "#6B5C4C" },
				{ "slug": "paper", "name": "Off-white on brown", "color": "#F4F1EC" },
				{ "slug": "clay", "name": "Clay (accent)", "color": "#A8745A" },
				{ "slug": "sage", "name": "Sage paper", "color": "#8F9A86" },
				{ "slug": "slate", "name": "Slate paper", "color": "#5E6B78" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Instrument Sans)",
					"fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Albert Sans)",
					"fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Label", "size": "0.775rem" },
				{ "slug": "pill", "name": "Pill", "size": "0.845rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.65rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "Display", "size": "4.5rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "3rem" },
				{ "slug": "60", "name": "XL", "size": "8.07rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"line": "1px",
			"ease": "cubic-bezier(.77, 0, .18, 1)",
			"rise": "cubic-bezier(.22, 1, .36, 1)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.8",
			"letterSpacing": "0.0375em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--clay)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "0.04em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "600", "lineHeight": "1.02", "letterSpacing": "-0.01em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--pill)", "fontWeight": "700", "letterSpacing": "0.2em", "textTransform": "uppercase" }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "letterSpacing": "0.04em" } },
			"core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700" } }
		}
	}
}
