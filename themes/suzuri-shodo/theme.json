{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "washi",
          "name": "Washi (ground)",
          "color": "#F4F0E8"
        },
        {
          "slug": "felt",
          "name": "Felt grey (footer, bands)",
          "color": "#E2DCD0"
        },
        {
          "slug": "sumi",
          "name": "Sumi ink (text)",
          "color": "#1E1C1A"
        },
        {
          "slug": "stone",
          "name": "Stone grey (secondary text)",
          "color": "#5E5852"
        },
        {
          "slug": "seal",
          "name": "Seal red (small marks only)",
          "color": "#9A4A3A"
        },
        {
          "slug": "heavy",
          "name": "Heavy ink tone (marks)",
          "color": "#3D3935"
        },
        {
          "slug": "mid",
          "name": "Mid ink tone (marks)",
          "color": "#6E6862"
        },
        {
          "slug": "pale",
          "name": "Pale ink tone (marks)",
          "color": "#A39C94"
        },
        {
          "slug": "dry",
          "name": "Dry ink tone (marks, hairlines)",
          "color": "#CDC6BB"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Sawarabi Mincho)",
          "fontFamily": "\"Sawarabi Mincho\", \"Hiragino Mincho ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Sawarabi Mincho",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/sawarabimincho-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Zen Kaku Gothic Antique)",
          "fontFamily": "\"Zen Kaku Gothic Antique\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Kaku Gothic Antique",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zenkaku-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Zen Kaku Gothic Antique",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zenkaku-500-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.35rem + 1.1vw, 2.375rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.25rem, 1.5rem + 3vw, 4.25rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--washi)",
      "text": "var(--wp--preset--color--sumi)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.8",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.3",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--sumi)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--sumi)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--sumi)",
          "text": "var(--wp--preset--color--washi)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.06em",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (wordmark top-left, numbered menu in the hero corner on the home page, top-right elsewhere)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (weekly class timetable on a folded practice sheet beside the school details)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
