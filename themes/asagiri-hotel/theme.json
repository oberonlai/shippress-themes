{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (page)",
     "color": "#E7E4E1"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#F1EEEC"
    },
    {
     "slug": "ink",
     "name": "Ink (text, close band)",
     "color": "#2A2A28"
    },
    {
     "slug": "deep",
     "name": "Deep (photo tint, footer)",
     "color": "#1B1B1A"
    },
    {
     "slug": "accent",
     "name": "Oxblood (button, arrows, rules)",
     "color": "#730D0D"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5E5A56"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Libre Baskerville)",
     "fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Libre Baskerville",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LibreBaskerville-wght-latin.ttf"
       ]
      },
      {
       "fontFamily": "Libre Baskerville",
       "fontStyle": "italic",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Lora)",
     "fontFamily": "\"Lora\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Lora",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/lora-variable.woff2"
       ]
      },
      {
       "fontFamily": "Lora",
       "fontStyle": "italic",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/lora-italic-variable.woff"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "3.5rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(3.25rem, 6.6vw, 6rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "6rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(6rem, 13.9vw, 12.5rem)"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.9"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.3",
     "letterSpacing": "0"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--panel)"
    },
    "border": {
     "radius": "4px"
    },
    "typography": {
     "fontSize": "0.875rem"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "letterSpacing": "-0.01em"
    }
   },
   "core/post-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400"
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "400",
     "letterSpacing": "0.04em"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
