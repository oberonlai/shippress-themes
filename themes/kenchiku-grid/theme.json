{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "paper", "name": "Off-white", "color": "#F2F2F0" },
        { "slug": "white", "name": "Plaster white", "color": "#FAFAF8" },
        { "slug": "concrete-light", "name": "Light concrete", "color": "#D9DAD7" },
        { "slug": "concrete", "name": "Concrete grey", "color": "#8A8C8E" },
        { "slug": "graphite", "name": "Graphite", "color": "#3A3C3F" },
        { "slug": "charcoal", "name": "Charcoal", "color": "#1C1D1F" },
        { "slug": "blueprint", "name": "Blueprint blue (accent)", "color": "#9DB4C8" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Grotesk (Inter Tight)",
          "fontFamily": "\"Inter Tight\", \"Inter\", \"Helvetica Neue\", \"Arial Nova\", Helvetica, Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "400 600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-tight-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (JetBrains Mono)",
          "fontFamily": "\"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace",
          "fontFace": [
            { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.6875rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Body", "size": "1.0625rem" },
        { "slug": "large", "name": "Lead", "size": "clamp(1.25rem, 1.05rem + 0.55vw, 1.5rem)" },
        { "slug": "x-large", "name": "Heading", "size": "clamp(1.625rem, 1.2rem + 1.3vw, 2.375rem)" },
        { "slug": "xx-large", "name": "Section title", "size": "clamp(2.25rem, 1.2rem + 3.1vw, 4.25rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(3rem, 1rem + 6vw, 7.5rem)" },
        { "slug": "giant", "name": "Wordmark", "size": "clamp(3.5rem, 0.25rem + 15.4vw, 14rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Hairline gap", "size": "0.5rem" },
        { "slug": "20", "name": "Gutter", "size": "1.25rem" },
        { "slug": "30", "name": "Small", "size": "clamp(1.25rem, 1rem + 0.8vw, 1.75rem)" },
        { "slug": "40", "name": "Medium", "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem)" },
        { "slug": "50", "name": "Large", "size": "clamp(2.5rem, 1.5rem + 3vw, 4.5rem)" },
        { "slug": "60", "name": "Module", "size": "clamp(3.5rem, 2rem + 4.5vw, 6.5rem)" },
        { "slug": "70", "name": "Section", "size": "clamp(4.5rem, 2.5rem + 6.5vw, 9rem)" },
        { "slug": "80", "name": "Bay", "size": "clamp(6rem, 3rem + 9vw, 12rem)" }
      ]
    },
    "custom": {
      "gutter": "1.25rem",
      "columns": "12",
      "gridline": "rgba(28, 29, 31, 0.075)",
      "gridline-dark": "rgba(242, 242, 240, 0.07)",
      "hairline": "1px solid var(--wp--preset--color--concrete-light)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|charcoal"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 3.2vw, 2.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 3.2vw, 2.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "-0.005em"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|charcoal" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|graphite" } },
        ":focus": { "color": { "text": "var:preset|color|graphite" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|charcoal" },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "500",
          "lineHeight": "1.08",
          "letterSpacing": "-0.025em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "0.98", "letterSpacing": "-0.045em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.02", "letterSpacing": "-0.035em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "letterSpacing": "-0.025em" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "letterSpacing": "-0.015em" } },
      "h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "fontWeight": "400", "letterSpacing": "0.06em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|charcoal", "text": "var:preset|color|paper" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|charcoal", "radius": "0px" },
        "spacing": { "padding": { "top": "0.95rem", "right": "1.5rem", "bottom": "0.95rem", "left": "1.5rem" } },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "fontWeight": "400", "letterSpacing": "0.08em", "textTransform": "uppercase", "lineHeight": "1.4" },
        ":hover": { "color": { "background": "var:preset|color|paper", "text": "var:preset|color|charcoal" } },
        ":focus": { "color": { "background": "var:preset|color|paper", "text": "var:preset|color|charcoal" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|concrete" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.02em", "lineHeight": "1.6" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontSize": "1.0625rem", "fontWeight": "600", "letterSpacing": "-0.01em", "lineHeight": "1.2" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|concrete" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.04em" }
      },
      "core/navigation": {
        "typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500", "letterSpacing": "-0.005em", "lineHeight": "1.4" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontWeight": "500", "letterSpacing": "-0.025em", "lineHeight": "1.12" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|concrete" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.04em" }
      },
      "core/post-terms": {
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.06em", "textTransform": "uppercase" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|graphite" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.6" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|concrete-light" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "-0.025em" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.22em;text-decoration-thickness:1px;transition:color .2s ease,text-decoration-color .2s ease}a:hover{text-decoration-color:var(--wp--preset--color--blueprint)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "Studio / About", "postTypes": ["page"] },
    { "name": "page-projects", "title": "Projects archive", "postTypes": ["page"] },
    { "name": "page-project", "title": "Project detail", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Newsletter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
