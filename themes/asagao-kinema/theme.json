{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "700px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "night",
          "name": "Night plum (ground)",
          "color": "#1E1A22"
        },
        {
          "slug": "plum",
          "name": "Dusk plum (panels, bands)",
          "color": "#2C2731"
        },
        {
          "slug": "pale",
          "name": "Pale house light (text)",
          "color": "#E8E3E6"
        },
        {
          "slug": "lilac",
          "name": "Muted lilac (lines, numerals, large type)",
          "color": "#8C7896"
        },
        {
          "slug": "lilac-soft",
          "name": "Soft lilac (small links on dark)",
          "color": "#B9A8C2"
        },
        {
          "slug": "ash",
          "name": "Ash (quiet meta text)",
          "color": "#A69FA8"
        },
        {
          "slug": "seat",
          "name": "Seat velvet (cards)",
          "color": "#252029"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Piazzolla)",
          "fontFamily": "Piazzolla, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Piazzolla",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Piazzolla[opsz,wght].ttf"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Libre Franklin)",
          "fontFamily": "\"Libre Franklin\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Libre Franklin",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/LibreFranklin[wght].ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.75rem, 1.4rem + 1.4vw, 2.6rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.4rem, 1.6rem + 3.4vw, 4.6rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--night)",
      "text": "var(--wp--preset--color--pale)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--lilac-soft)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--pale)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--pale)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--pale)",
          "text": "var(--wp--preset--color--night)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.06em"
        },
        "border": {
          "radius": "0"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--lilac-soft)",
            "text": "var(--wp--preset--color--night)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (masthead with programme dateline)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (tickets / visit, two tones)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}