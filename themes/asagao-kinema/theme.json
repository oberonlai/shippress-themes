{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "night",
          "name": "Sumi ink (header bar, film strip, text)",
          "color": "#1C1C1C"
        },
        {
          "slug": "plum",
          "name": "Shu vermilion (hero, page heads, bands; sumi text on it)",
          "color": "#EB6101"
        },
        {
          "slug": "pale",
          "name": "Washi (reading ground)",
          "color": "#F7F3EA"
        },
        {
          "slug": "lilac",
          "name": "Tokiwa green (membership band, intertitles; text on washi)",
          "color": "#007B43"
        },
        {
          "slug": "lilac-soft",
          "name": "Deep shu (links and small text on washi)",
          "color": "#A84200"
        },
        {
          "slug": "ash",
          "name": "Kinari (quiet text on sumi, panels)",
          "color": "#E6DFCF"
        },
        {
          "slug": "seat",
          "name": "Gofun (text on sumi and tokiwa)",
          "color": "#FFFDF7"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Antonio)",
          "fontFamily": "Antonio, \"Arial Narrow\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Antonio",
              "fontStyle": "normal",
              "fontWeight": "100 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Antonio[wght].ttf"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Chivo)",
          "fontFamily": "Chivo, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Chivo",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Chivo[wght].ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.125rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(2.25rem, 1.6rem + 2.8vw, 4.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(3.25rem, 1.8rem + 6.4vw, 8.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--pale)",
      "text": "var(--wp--preset--color--night)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3.5rem)",
        "right": "clamp(1.25rem, 4vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--lilac-soft)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--night)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500",
          "lineHeight": "1.02",
          "letterSpacing": "0",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--night)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.15"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--night)",
          "text": "var(--wp--preset--color--seat)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "1.0625rem",
          "fontWeight": "500",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "0"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--lilac)",
            "text": "var(--wp--preset--color--seat)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (fixed top bar: name, dateline cells, menu, tickets)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (end credits: visit details, prices, sitemap)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
