{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1000px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "grey",
     "name": "Grey panel",
     "color": "#F5F5F5"
    },
    {
     "slug": "navy",
     "name": "Navy (ink)",
     "color": "#192F60"
    },
    {
     "slug": "navy-deep",
     "name": "Deep navy",
     "color": "#13203B"
    },
    {
     "slug": "navy-mid",
     "name": "Mid navy bar",
     "color": "#2C3E6F"
    },
    {
     "slug": "red",
     "name": "Red (the one CTA)",
     "color": "#E22632"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#E3E3E3"
    },
    {
     "slug": "field",
     "name": "Field underline",
     "color": "#CACDD4"
    },
    {
     "slug": "tint",
     "name": "Tint",
     "color": "#8BA5D7"
    },
    {
     "slug": "muted",
     "name": "Muted blue",
     "color": "#6D82AB"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#B3202B"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#E7EEF8"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "svh"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Plus Jakarta Sans)",
     "fontFamily": "\"Plus Jakarta Sans\", \"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Plus Jakarta Sans",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/plus-jakarta-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "tiny",
     "name": "Tiny",
     "size": ".75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".875rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "lede",
     "name": "Lede",
     "size": "1.3125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.75rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.75rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "clamp(3rem, 1.6rem + 3.6vw, 4.25rem)"
    },
    {
     "slug": "page",
     "name": "Page title",
     "size": "clamp(3.25rem, 1rem + 6.8vw, 7rem)"
    },
    {
     "slug": "hero",
     "name": "Hero",
     "size": "clamp(4.25rem, 1.4rem + 8.2vw, 8.75rem)"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--navy)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--navy)"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.02",
     "letterSpacing": "-.04em"
    },
    "color": {
     "text": "var(--wp--preset--color--navy)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--hero)",
     "fontWeight": "800",
     "lineHeight": ".87",
     "letterSpacing": "-.05em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.1",
     "letterSpacing": "-.02em"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--red)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1rem",
     "fontWeight": "600",
     "textDecoration": "none"
    },
    "border": {
     "radius": "0"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}