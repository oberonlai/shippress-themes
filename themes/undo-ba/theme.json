{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "stone",
          "name": "Stone (ground)",
          "color": "#EFECE6"
        },
        {
          "slug": "paper",
          "name": "Paper (bands and cards)",
          "color": "#F8F6F2"
        },
        {
          "slug": "warm-grey",
          "name": "Warm grey (hairlines, large numerals)",
          "color": "#77716A"
        },
        {
          "slug": "grey-deep",
          "name": "Deep warm grey (quiet text)",
          "color": "#6A645D"
        },
        {
          "slug": "oxblood",
          "name": "Oxblood (the one accent: links, buttons)",
          "color": "#6E2B27"
        },
        {
          "slug": "charcoal",
          "name": "Charcoal (text, dark bands)",
          "color": "#1E1F1E"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Bellefair)",
          "fontFamily": "Bellefair, \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Bellefair",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bellefair-regular-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Inter)",
          "fontFamily": "Inter, \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 5vw, 8.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6rem, 4rem + 7vw, 11rem)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--warm-grey) 45%, transparent)",
      "ease": "cubic-bezier(.33, .1, .25, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|stone",
      "text": "var:preset|color|charcoal"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|oxblood"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|charcoal"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.12",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var:preset|color|charcoal"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.5rem, 1.7rem + 3.2vw, 4.5rem)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.875rem, 1.4rem + 1.9vw, 3rem)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem)"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|oxblood",
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.875rem",
          "fontWeight": "500",
          "letterSpacing": "0.06em"
        },
        "border": {
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|charcoal",
            "text": "var:preset|color|stone"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|charcoal",
            "text": "var:preset|color|stone"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "color": {
          "text": "var:preset|color|grey-deep"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|charcoal"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|charcoal"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var:preset|color|grey-deep"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|warm-grey"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.35"
        },
        "border": {
          "left": {
            "width": "0px"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}