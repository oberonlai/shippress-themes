{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1280px", "wideSize": "1440px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "ink", "name": "Ink", "color": "#333333" },
        { "slug": "graphite", "name": "Graphite", "color": "#4E5350" },
        { "slug": "night", "name": "Night", "color": "#0E100F" },
        { "slug": "ochre", "name": "Ochre", "color": "#957123" },
        { "slug": "ochre-dark", "name": "Ochre dark", "color": "#7F601E" },
        { "slug": "ochre-soft", "name": "Ochre soft", "color": "#C9B27A" },
        { "slug": "sand", "name": "Sand", "color": "#F0EEEA" },
        { "slug": "sand-2", "name": "Sand line", "color": "#E1DED5" },
        { "slug": "lattice", "name": "Lattice", "color": "#EDE9E1" },
        { "slug": "mist", "name": "Mist", "color": "#ECEDEE" },
        { "slug": "notice", "name": "Notice red", "color": "#BD2D2D" },
        { "slug": "notice-bg", "name": "Notice pale", "color": "#FAE3E3" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Hanken Grotesk)",
          "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Instrument Sans)",
          "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Japanese subset (Noto Sans JP)",
          "fontFamily": "\"Noto Sans JP\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "label", "name": "Label", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "1rem" },
        { "slug": "h3", "name": "Heading 3", "size": "1.25rem" },
        { "slug": "band", "name": "Band title", "size": "2.25rem" },
        { "slug": "value", "name": "Value heading", "size": "2rem" },
        { "slug": "stat", "name": "Stat numeral", "size": "2.75rem" },
        { "slug": "h2", "name": "Section title", "size": "2.75rem" },
        { "slug": "numeral", "name": "Numeral", "size": "4.25rem" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.75rem, 5.2vw, 5rem)" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "10px" },
        { "slug": "20", "name": "S", "size": "20px" },
        { "slug": "30", "name": "M", "size": "40px" },
        { "slug": "40", "name": "L", "size": "80px" },
        { "slug": "50", "name": "XL", "size": "120px" }
      ]
    },
    "custom": { "radius": "0", "container": "1280px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "1.75" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--graphite)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--ochre-dark)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.08" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--band)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)" } }
    },
    "spacing": { "blockGap": "20px" },
    "blocks": {
      "core/button": { "border": { "radius": "0" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
