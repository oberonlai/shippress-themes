{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Blush paper (ground)",
          "color": "#FDF2EF"
        },
        {
          "slug": "card",
          "name": "Mount white (paper cards)",
          "color": "#FFFAF8"
        },
        {
          "slug": "petal",
          "name": "Petal (soft panels)",
          "color": "#F8E1DA"
        },
        {
          "slug": "coral",
          "name": "Coral (accent, large text and shapes only)",
          "color": "#E26D5A"
        },
        {
          "slug": "coral-deep",
          "name": "Deep coral (links, small accent text)",
          "color": "#A63F2C"
        },
        {
          "slug": "leaf",
          "name": "Leaf green (headings, footer)",
          "color": "#3E5C3A"
        },
        {
          "slug": "moss",
          "name": "Moss (dark panels)",
          "color": "#2A3F27"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#24301F"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (DM Serif Display)",
          "fontFamily": "\"DM Serif Display\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "DM Serif Display",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-serif-display-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "DM Serif Display",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-serif-display-italic-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (DM Sans)",
          "fontFamily": "\"DM Sans\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "100 1000",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.625rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.75rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6rem",
          "fluid": {
            "min": "3.1rem",
            "max": "7.25rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 9.5rem)"
        }
      ]
    },
    "custom": {
      "muted": "#6E5752",
      "line": "color-mix(in srgb, var(--wp--preset--color--leaf) 16%, transparent)",
      "line-strong": "color-mix(in srgb, var(--wp--preset--color--leaf) 34%, transparent)",
      "blush-on-dark": "#F4B6A8",
      "ease": "cubic-bezier(.22, .8, .24, 1)",
      "header-height": "5.25rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.25rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.25rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|coral-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|leaf"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "letterSpacing": "-0.012em"
        },
        "color": {
          "text": "var:preset|color|leaf"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "0.98"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.02"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|leaf",
          "text": "var:preset|color|paper"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.02em"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|coral-deep",
            "text": "var:preset|color|card"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:custom|muted"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.75rem",
          "fontWeight": "400",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|leaf"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|leaf"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500"
        },
        "color": {
          "text": "var:custom|muted"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontStyle": "italic",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var:preset|color|coral-deep"
        },
        "border": {
          "width": "0px",
          "style": "none"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line-strong"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full-width page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
