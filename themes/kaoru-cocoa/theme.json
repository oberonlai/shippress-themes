{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1192px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "White (ground)",
					"color": "#FFFFFF"
				},
				{
					"slug": "panel",
					"name": "Panel",
					"color": "#F5F5F4"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#333333"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#737373"
				},
				{
					"slug": "brand",
					"name": "Smoked bamboo",
					"color": "#6B5A4E"
				},
				{
					"slug": "brand-soft",
					"name": "Smoked bamboo, soft",
					"color": "#7D6E63"
				},
				{
					"slug": "brand-dark",
					"name": "Smoked bamboo, dark",
					"color": "#5C4D43"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#D9D6D2"
				},
				{
					"slug": "accent",
					"name": "Rust (one line)",
					"color": "#B5472A"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Source Serif 4\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-variable-latin.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-italic-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-variable-latin.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS (12)",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "note",
					"name": "Note (13)",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "s",
					"name": "S (14)",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "m",
					"name": "M (16)",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "l",
					"name": "L (20)",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "xl",
					"name": "XL (24)",
					"size": "1.5rem",
					"fluid": false
				},
				{
					"slug": "2xl",
					"name": "2XL (32)",
					"size": "2rem",
					"fluid": false
				},
				{
					"slug": "3xl",
					"name": "3XL (36)",
					"size": "2.25rem",
					"fluid": false
				},
				{
					"slug": "4xl",
					"name": "4XL (56)",
					"size": "3.5rem",
					"fluid": false
				},
				{
					"slug": "display",
					"name": "Display (72)",
					"size": "4.5rem",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3xl)",
					"lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--l)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--s)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"bottom": "10px",
						"left": "18px",
						"right": "18px"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.6"
				}
			}
		},
		"spacing": {
			"blockGap": "0px"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}