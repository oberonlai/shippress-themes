{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1280px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "pale", "name": "Pale ground", "color": "#F4F4F4" },
    { "slug": "card", "name": "Card ground", "color": "#F7F9FA" },
    { "slug": "ink", "name": "Ink (text)", "color": "#222222" },
    { "slug": "charcoal", "name": "Charcoal (statements, footer)", "color": "#3C4046" },
    { "slug": "navy", "name": "Navy (active, labels, links)", "color": "#0C416F" },
    { "slug": "navy-deep", "name": "Navy deep (link hover)", "color": "#0A4E83" },
    { "slug": "blue", "name": "Blue (figures band, focus)", "color": "#278CF5" },
    { "slug": "mist", "name": "Mist", "color": "#DCE3E8" },
    { "slug": "rule", "name": "Rule", "color": "#E6E9EC" }
   ],
   "gradients": [
    { "slug": "figures", "name": "Figures band", "gradient": "linear-gradient(105deg, #4A97DB 0%, #278CF5 45%, #0080FF 100%)" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "heading",
     "name": "Headings and numerals (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Hanken Grotesk\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/inter-tight-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-sans-jp-700-ja.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif"
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Body", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
    { "slug": "large", "name": "Large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
    { "slug": "x-large", "name": "Section heading", "size": "3.0625rem", "fluid": { "min": "2rem", "max": "3.0625rem" } },
    { "slug": "xx-large", "name": "Page statement", "size": "4.25rem", "fluid": { "min": "2.4rem", "max": "4.25rem" } },
    { "slug": "huge", "name": "Hero slogan", "size": "6rem", "fluid": { "min": "2.6rem", "max": "6rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "%", "vw", "vh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "3.5rem" },
    { "slug": "60", "name": "XL", "size": "clamp(3.5rem, 7vw, 6.25rem)" }
   ]
  },
  "border": { "radius": true },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    { "slug": "dock", "name": "Docked card", "shadow": "0 8px 32px rgba(34, 34, 34, 0.10)" }
   ]
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75"
  },
  "spacing": { "padding": { "left": "clamp(1.25rem, 4vw, 5rem)", "right": "clamp(1.25rem, 4vw, 5rem)" }, "blockGap": "1.25rem" },
  "elements": {
   "link": {
    "color": { "text": "var(--wp--preset--color--navy)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--navy-deep)" } },
    "typography": { "textDecoration": "underline" }
   },
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.2" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.4" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--navy)", "text": "var(--wp--preset--color--paper)" },
    "border": { "radius": "999px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--base)" }
   }
  },
  "blocks": {
   "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "1.25rem" } },
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--small)" } }
  }
 },
 "customTemplates": [
  { "name": "page-bare", "title": "Page with its own photo head", "postTypes": [ "page" ] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
