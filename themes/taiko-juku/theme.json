{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1040px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Washi paper (ground)",
					"color": "#F5F1F8"
				},
				{
					"slug": "tsutsuji",
					"name": "Edo purple (main colour, large fields)",
					"color": "#745399"
				},
				{
					"slug": "blush",
					"name": "Pale wisteria (soft panels)",
					"color": "#E6DCEF"
				},
				{
					"slug": "night",
					"name": "Sumi night (text, rail, dark bands)",
					"color": "#17121F"
				},
				{
					"slug": "deep",
					"name": "Deep purple (links on paper)",
					"color": "#5B3F7E"
				},
				{
					"slug": "quiet",
					"name": "Ash violet (secondary text)",
					"color": "#544B5E"
				},
				{
					"slug": "glow",
					"name": "Lilac (labels on night)",
					"color": "#C9B3E6"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Yusei Magic)",
					"fontFamily": "\"Yusei Magic\", \"Hiragino Maru Gothic ProN\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Yusei Magic",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/yusei-magic-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese/Chinese kanji subset (Yusei Magic CJK)",
					"fontFamily": "\"Yusei Magic CJK\", \"Hiragino Maru Gothic ProN\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Yusei Magic CJK",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/yusei-magic-cjk.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Huninn)",
					"fontFamily": "\"Huninn\", \"PingFang TC\", \"Noto Sans TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Huninn",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/huninn-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Karla)",
					"fontFamily": "\"Karla\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Karla",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/karla-variable-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--night)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
			"lineHeight": "1.8",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4.5vw, 3.5rem)",
				"right": "clamp(1.25rem, 4.5vw, 3.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.3",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--night)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--night)",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "0.9375rem",
					"letterSpacing": "0.06em",
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (sumi bar: school name, Try a class button; the menu runs down a side rail on wide screens)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (sumi field: school name, synced dojo details and the menu)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
