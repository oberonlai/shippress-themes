{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#222222"
    },
    {
     "slug": "text",
     "name": "Text (warm off-white)",
     "color": "#ECE9E2"
    },
    {
     "slug": "mute",
     "name": "Mute (meta)",
     "color": "#A29F98"
    },
    {
     "slug": "dim",
     "name": "Dim (inactive numerals)",
     "color": "#5A5751"
    },
    {
     "slug": "line",
     "name": "Line (1px rules)",
     "color": "#4A4946"
    },
    {
     "slug": "indigo",
     "name": "Indigo (panel, glow)",
     "color": "#3A3A5E"
    },
    {
     "slug": "white",
     "name": "White box",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Box text",
     "color": "#151515"
    },
    {
     "slug": "paper",
     "name": "Paper (form panel)",
     "color": "#ECE9E2"
    },
    {
     "slug": "amber",
     "name": "Amber (focus ring)",
     "color": "#C9A24B"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#E59A8A"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#9CCFB4"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Space Grotesk)",
     "fontFamily": "\"Space Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Space Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/space-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-small",
     "size": ".6875rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": ".9375rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.5rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "clamp(2.5rem, 1rem + 3.65vw, 4.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "8px"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "16px"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "24px"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "72px"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "110px"
    },
    {
     "slug": "80",
     "name": "7",
     "size": "160px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.6",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1"
    },
    "color": {
     "text": "var(--wp--preset--color--text)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "500",
     "lineHeight": "1.05",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.1"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.2"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--text)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--white)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--white)",
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "600",
     "letterSpacing": ".02em",
     "lineHeight": "1.4",
     "textTransform": "uppercase"
    },
    "spacing": {
     "padding": {
      "top": "4px",
      "bottom": "4px",
      "left": "8px",
      "right": "8px"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-head",
   "title": "Page with photo head",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
