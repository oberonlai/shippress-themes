{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "680px", "wideSize": "1290px" },
  "color": {
   "defaultPalette": false, "defaultGradients": false, "defaultDuotone": false, "custom": true,
   "palette": [
    { "slug": "base", "name": "Base (cool off-white)", "color": "#F4F6F3" },
    { "slug": "ink", "name": "Ink (text, hairlines)", "color": "#1B221E" },
    { "slug": "deep", "name": "Deep green (buttons)", "color": "#3F4D44" },
    { "slug": "celadon", "name": "Celadon (small accents)", "color": "#6E7F74" },
    { "slug": "grey", "name": "Grey (labels, tags)", "color": "#5F6A64" },
    { "slug": "rule", "name": "Light rule", "color": "#E3E7E3" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false, "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display", "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body", "name": "Body (Onest)",
     "fontFamily": "\"Onest\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Onest", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh", "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja", "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "paragraph", "name": "Long paragraph", "size": "0.9375rem", "fluid": false },
    { "slug": "medium", "name": "Lead", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Section title", "size": "1.75rem", "fluid": false },
    { "slug": "x-large", "name": "Page title", "size": "2.5rem", "fluid": false },
    { "slug": "xx-large", "name": "Hero (max 4.25rem)", "size": "clamp(2.75rem, 6vw, 4.25rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.6", "fontWeight": "400" },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "1.25rem" },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.6", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "400", "lineHeight": "1.25" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "1.25rem" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--deep)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "0.9375rem", "letterSpacing": "0.04em", "fontWeight": "500" },
    "spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "2rem", "right": "2rem" } }
   }
  },
  "blocks": {
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "border": { "color": "var(--wp--preset--color--ink)" } }
  }
 }
}
