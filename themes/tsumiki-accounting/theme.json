{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "700px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink navy (text, headings)",
          "color": "#22303F"
        },
        {
          "slug": "paper",
          "name": "Paper (ground)",
          "color": "#F3F4F6"
        },
        {
          "slug": "mist",
          "name": "Mist (bands, footer)",
          "color": "#DCE1E8"
        },
        {
          "slug": "slate",
          "name": "Slate (accent, block marks, links)",
          "color": "#4B6584"
        },
        {
          "slug": "card",
          "name": "Card white",
          "color": "#FAFBFC"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Spectral)",
          "fontFamily": "Spectral, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Spectral",
              "fontStyle": "normal",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/spectral-light-latin.woff2"
              ]
            },
            {
              "fontFamily": "Spectral",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/spectral-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Spectral",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/spectral-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Commissioner)",
          "fontFamily": "Commissioner, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Commissioner",
              "fontStyle": "normal",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/commissioner-300-latin.woff2"
              ]
            },
            {
              "fontFamily": "Commissioner",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/commissioner-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Commissioner",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/commissioner-500-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.75rem, 1.45rem + 1.2vw, 2.5rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "300"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "300",
          "lineHeight": "1.15",
          "letterSpacing": "-0.015em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--slate)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.04em",
          "fontWeight": "400",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (wordmark top-left, numbered menu in the corner)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (map and office card)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
