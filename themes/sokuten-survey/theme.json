{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Pale sky band",
     "color": "#ECF6FF"
    },
    {
     "slug": "ink",
     "name": "Ink (headings)",
     "color": "#1F1A16"
    },
    {
     "slug": "body",
     "name": "Body text",
     "color": "#333333"
    },
    {
     "slug": "main",
     "name": "Umber (labels, footer)",
     "color": "#594E45"
    },
    {
     "slug": "sky",
     "name": "Sky (the one pill)",
     "color": "#64B5EB"
    },
    {
     "slug": "stake",
     "name": "Survey-tape orange (dots, chips)",
     "color": "#D9622B"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B625A"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DCDCDC"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Outfit)",
     "fontFamily": "\"Outfit\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "600 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem",
     "fluid": {
      "min": "1.125rem",
      "max": "1.375rem"
     }
    },
    {
     "slug": "large",
     "name": "Large (H2)",
     "size": "2.25rem",
     "fluid": {
      "min": "1.625rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "x-large",
     "name": "X-large (tagline)",
     "size": "3.125rem",
     "fluid": {
      "min": "2rem",
      "max": "3.125rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XX-large (figures)",
     "size": "4.5rem",
     "fluid": {
      "min": "3rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "%"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--body)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--main)"
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.3"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.25rem",
     "lineHeight": "1.4"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
