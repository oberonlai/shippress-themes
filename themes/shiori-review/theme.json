{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "oat",
          "name": "Oat paper (ground)",
          "color": "#F3EFE7"
        },
        {
          "slug": "paper",
          "name": "Paper (cards and fields)",
          "color": "#FAF8F3"
        },
        {
          "slug": "stone",
          "name": "Warm stone (panels)",
          "color": "#E0D8C9"
        },
        {
          "slug": "sumi",
          "name": "Sumi ink (text)",
          "color": "#1F1D1A"
        },
        {
          "slug": "oxblood",
          "name": "Deep red-brown (links, buttons, small accents)",
          "color": "#5A2E26"
        },
        {
          "slug": "muted",
          "name": "Muted ink (secondary text)",
          "color": "#5E574D"
        },
        {
          "slug": "ribbon",
          "name": "Faded red pencil (ribbons, rules, display)",
          "color": "#6A3E35"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Source Serif 4)",
          "fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Source Serif 4",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-serif-4-variable-latin.woff2"
              ]
            },
            {
              "fontFamily": "Source Serif 4",
              "fontStyle": "italic",
              "fontWeight": "400 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (Azeret Mono)",
          "fontFamily": "\"Azeret Mono\", ui-monospace, Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "Azeret Mono",
              "fontStyle": "normal",
              "fontWeight": "400 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/azeret-mono-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 1vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--oat)",
      "text": "var(--wp--preset--color--sumi)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--serif)",
      "fontSize": "clamp(1.0625rem, 1.03rem + 0.15vw, 1.15rem)",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--sumi)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--oxblood)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--sumi)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "0.8125rem",
          "letterSpacing": "0.04em",
          "fontWeight": "400"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Masthead (huge wordmark, issue dateline, ruled menu row)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (strip of issue covers over the colophon)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}