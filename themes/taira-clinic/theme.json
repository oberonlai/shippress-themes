{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#FFFFFF"
				},
				{
					"slug": "band",
					"name": "Pale band",
					"color": "#F4F6F6"
				},
				{
					"slug": "slate",
					"name": "Slate (aonibi)",
					"color": "#5A6568"
				},
				{
					"slug": "steel",
					"name": "Steel blue",
					"color": "#2C5A86"
				},
				{
					"slug": "steel-deep",
					"name": "Steel blue hover",
					"color": "#234B72"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1F2A2D"
				},
				{
					"slug": "line",
					"name": "Hairline",
					"color": "#C9D1D2"
				},
				{
					"slug": "rule",
					"name": "Pale rule",
					"color": "#E3E8E8"
				},
				{
					"slug": "field",
					"name": "Form border",
					"color": "#8A9496"
				}
			],
			"gradients": []
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Figtree)",
					"fontFamily": "\"Figtree\", \"Manrope\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Manrope)",
					"fontFamily": "\"Manrope\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-tc",
					"name": "Traditional Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-jp",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Chip",
					"size": "0.6875rem"
				},
				{
					"slug": "s",
					"name": "Label",
					"size": "0.8125rem"
				},
				{
					"slug": "nav",
					"name": "Navigation",
					"size": "0.9375rem"
				},
				{
					"slug": "m",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "l",
					"name": "Lead",
					"size": "1.1875rem"
				},
				{
					"slug": "xl",
					"name": "H3",
					"size": "1.25rem"
				},
				{
					"slug": "bar",
					"name": "Title bar",
					"size": "1.5rem"
				},
				{
					"slug": "head",
					"name": "H2",
					"size": "2.25rem"
				},
				{
					"slug": "figure",
					"name": "Figure",
					"size": "2.5rem"
				},
				{
					"slug": "inner",
					"name": "Inner title",
					"size": "3rem"
				},
				{
					"slug": "display",
					"name": "Hero headline",
					"size": "4.5rem"
				}
			]
		},
		"custom": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontWeight": "400",
			"lineHeight": "1.8"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--steel)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--steel-deep)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.4",
					"letterSpacing": "0.06em"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--steel)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				"border": {
					"radius": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--steel-deep)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			}
		}
	}
}