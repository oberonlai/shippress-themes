{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1312px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#F1F0EE"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1D1D1F"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#6D6D72"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#D6D4CF"
				},
				{
					"slug": "cell",
					"name": "Table cell border",
					"color": "#BDBBB5"
				},
				{
					"slug": "band",
					"name": "Dark band",
					"color": "#3A4F44"
				},
				{
					"slug": "sand",
					"name": "Sand",
					"color": "#E0CEAA"
				},
				{
					"slug": "accent",
					"name": "Accent (chips)",
					"color": "#715C1F"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Archivo)",
					"fontFamily": "\"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Inter Tight)",
					"fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter Tight",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-tight-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW subset)",
					"fontFamily": "\"Noto Sans TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja subset)",
					"fontFamily": "\"Noto Sans JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-400-ja.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-700-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Notes",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Rows and captions",
					"size": "0.9375rem"
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Card titles",
					"size": "1.125rem"
				},
				{
					"slug": "large",
					"name": "Section titles",
					"size": "1.625rem"
				},
				{
					"slug": "x-large",
					"name": "Vertical headline",
					"size": "3rem"
				},
				{
					"slug": "xx-large",
					"name": "Display numerals",
					"size": "4.25rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "500",
			"lineHeight": "1.8"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.3",
					"letterSpacing": "0.06em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.5",
					"letterSpacing": "0.1em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.5"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sand)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"fontSize": "0.8125rem"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "4px"
				}
			}
		},
		"spacing": {
			"blockGap": "0"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
