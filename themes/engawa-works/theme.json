{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "concrete",
          "name": "Concrete (ground)",
          "color": "#F2F2EF"
        },
        {
          "slug": "paper",
          "name": "Paper (cards and fields)",
          "color": "#FAFAF8"
        },
        {
          "slug": "grey",
          "name": "Soft grey (panels)",
          "color": "#D9D9D3"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#262624"
        },
        {
          "slug": "umber",
          "name": "Deep ochre (links, buttons, small accents)",
          "color": "#655835"
        },
        {
          "slug": "stone",
          "name": "Stone (secondary text)",
          "color": "#5A5954"
        },
        {
          "slug": "ochre",
          "name": "Muted ochre (large display, rules and marks only)",
          "color": "#8A7A4E"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display and text (Geologica)",
          "fontFamily": "\"Geologica\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Geologica",
              "fontStyle": "normal",
              "fontWeight": "300 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/geologica-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (Fragment Mono)",
          "fontFamily": "\"Fragment Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "Fragment Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/fragment-mono-regular-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.35rem + 1.1vw, 2.375rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.25rem, 1.5rem + 3vw, 4.25rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--concrete)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--display)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.7",
      "fontWeight": "300"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "300",
          "lineHeight": "1.15",
          "letterSpacing": "-0.015em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--umber)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.02em",
          "fontWeight": "400"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Two-tier header (utility strip with today's hours and Book a tour, then the wordmark and menu)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (slow \"today at the space\" ticker, space details and links)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
