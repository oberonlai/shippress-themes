{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1192px",
   "wideSize": "1192px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "stone",
     "name": "Stone",
     "color": "#E5E4D5"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#EDECE2"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#212227"
    },
    {
     "slug": "night",
     "name": "Night",
     "color": "#1C1D1F"
    },
    {
     "slug": "glow",
     "name": "Forest glow",
     "color": "#1C3537"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ochre",
     "name": "Ochre (hairlines and markers only)",
     "color": "#B98C46"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#5B5C57"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Newsreader)",
     "fontFamily": "\"Newsreader\", Georgia, \"Times New Roman\", serif"
    },
    {
     "slug": "ui",
     "name": "UI (Figtree)",
     "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "caption",
     "name": "Caption",
     "size": "0.79rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "ui",
     "name": "UI",
     "size": "0.9rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Card title",
     "size": "1.3125rem"
    },
    {
     "slug": "section-label",
     "name": "Section label",
     "size": "1.375rem"
    },
    {
     "slug": "x-large",
     "name": "Section heading",
     "size": "2.64rem"
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "3.5rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.75rem, 5vw, 4.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "12px"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "24px"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "48px"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "96px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--stone)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.85",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--ink)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.1"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.3"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--ui)",
     "fontSize": "0.9rem",
     "fontWeight": "500",
     "letterSpacing": "0.033em"
    },
    "spacing": {
     "padding": {
      "top": "8.4px",
      "bottom": "8.4px",
      "left": "21px",
      "right": "21px"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/table": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   }
  }
 }
}