{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1080px", "wideSize": "1080px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#333333" },
				{ "slug": "sage", "name": "Wash sage", "color": "#CAE2D3" },
				{ "slug": "peach", "name": "Wash peach", "color": "#EFAE90" },
				{ "slug": "rosebrown", "name": "Wash mauve-brown", "color": "#B5998E" },
				{ "slug": "mist", "name": "Wash mist", "color": "#98C2D2" },
				{ "slug": "accent", "name": "Accent (kyubai-nezu)", "color": "#6E6578" },
				{ "slug": "muted", "name": "Muted text", "color": "#5C5862" },
				{ "slug": "night", "name": "Overlay night", "color": "#2B2730" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-variable-latin.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Figtree)",
					"fontFamily": "\"Figtree\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/figtree-variable-latin.woff2"] }
					]
				},
				{
					"slug": "cjk-zh",
					"name": "Noto Serif TC (zh-TW)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
					]
				},
				{
					"slug": "cjk-ja",
					"name": "Noto Serif JP (ja)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Meta", "size": "0.6875rem" },
				{ "slug": "small", "name": "Small body", "size": "0.8125rem" },
				{ "slug": "medium", "name": "Body", "size": "1rem" },
				{ "slug": "large", "name": "Heading 2", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Section title", "size": "2.25rem" },
				{ "slug": "xx-large", "name": "Hero heading", "size": "3.125rem" },
				{ "slug": "huge", "name": "Statement", "size": "4.25rem" }
			]
		},
		"spacing": { "units": ["px", "rem", "em", "%", "vw", "svh"] },
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"spacing": { "blockGap": "0" },
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.5",
					"letterSpacing": "0.05em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.1", "letterSpacing": "0" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } }
		}
	}
}
