{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "700px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "High-key white (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "mist",
     "name": "Morning mist (soft panels)",
     "color": "#F6F1F1"
    },
    {
     "slug": "beni",
     "name": "Crimson red (main colour, large fields)",
     "color": "#C9171E"
    },
    {
     "slug": "ink",
     "name": "Ink (text and the footer)",
     "color": "#1C1416"
    },
    {
     "slug": "deep",
     "name": "Deep crimson (links on white)",
     "color": "#9E1117"
    },
    {
     "slug": "quiet",
     "name": "Wet stone (secondary text)",
     "color": "#5F5658"
    },
    {
     "slug": "blush",
     "name": "Pale red (labels on ink)",
     "color": "#F4B9BB"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Kiwi Maru)",
     "fontFamily": "\"Kiwi Maru\", \"Hiragino Maru Gothic ProN\", \"Helvetica Neue\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Kiwi Maru",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/kiwi-maru-500-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese kanji and kana subset (Kiwi Maru JA)",
     "fontFamily": "\"Kiwi Maru JA\", \"Hiragino Maru Gothic ProN\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Kiwi Maru JA",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/kiwi-maru-500-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Onest)",
     "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "300 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
    "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.2",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--beni)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em",
     "fontWeight": "700"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header (white bar: shop name, Shop the tackle button, cart and a Menu button that opens a full-screen crimson menu)",
   "area": "header"
  },
  {
   "name": "checkout-header",
   "title": "Checkout header (shop name and a secure-checkout note)",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer (crimson strip with the shop line, then the ink field with the synced shop details and the menu)",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (sections, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
