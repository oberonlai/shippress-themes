{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper white (ground, the raised key)",
          "color": "#FBFBFA"
        },
        {
          "slug": "ivory",
          "name": "Ivory (key row, quiet bands)",
          "color": "#EDEBE7"
        },
        {
          "slug": "ebony",
          "name": "Ebony (text, footer)",
          "color": "#161616"
        },
        {
          "slug": "brass",
          "name": "Muted brass (large type and marks only)",
          "color": "#9A8152"
        },
        {
          "slug": "deep-brass",
          "name": "Deep brass (links and small labels)",
          "color": "#6E5A30"
        },
        {
          "slug": "felt",
          "name": "Felt grey (secondary text)",
          "color": "#5C5954"
        },
        {
          "slug": "pale-brass",
          "name": "Pale brass (labels on ebony)",
          "color": "#B8A47A"
        },
        {
          "slug": "hairline",
          "name": "Hairline (rules only)",
          "color": "#D8D4CC"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Linden Hill)",
          "fontFamily": "\"Linden Hill\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Linden Hill",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lindenhill-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Linden Hill",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lindenhill-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Atkinson Hyperlegible)",
          "fontFamily": "\"Atkinson Hyperlegible\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/atkinson-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Atkinson Hyperlegible",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/atkinson-700-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.1875rem, 1.1rem + 0.4vw, 1.4375rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.5vw, 2.875rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.75rem, 1.8rem + 4vw, 5.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ebony)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ebony)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.375rem, 1.25rem + 0.5vw, 1.75rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.1875rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep-brass)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ebony)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.08em",
          "fontWeight": "700",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (the menu as a row of ruled key cells, the current page a raised white key)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (the weekly lesson timetable on ebony beside the school details)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
