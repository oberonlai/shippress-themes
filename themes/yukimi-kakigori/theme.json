{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Cream white (ground)",
					"color": "#FAF6EC"
				},
				{
					"slug": "rikyu",
					"name": "Rikyu-nezumi sage grey (main colour, large fields)",
					"color": "#8F9B84"
				},
				{
					"slug": "mist",
					"name": "Matcha mist (soft panels)",
					"color": "#E6EBDD"
				},
				{
					"slug": "ink",
					"name": "Deep green ink (text, footer)",
					"color": "#1E2A22"
				},
				{
					"slug": "deep",
					"name": "Deep matcha (links and labels on light grounds)",
					"color": "#3F5A3F"
				},
				{
					"slug": "quiet",
					"name": "Grey green (secondary text)",
					"color": "#5A6858"
				},
				{
					"slug": "pale",
					"name": "Pale sage (labels on the green-ink footer)",
					"color": "#C9D4B8"
				},
				{
					"slug": "field-ink",
					"name": "Deep green ink (type on the sage field)",
					"color": "#1E2A22"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Darumadrop One)",
					"fontFamily": "\"Darumadrop One\", \"Hiragino Maru Gothic ProN\", \"Arial Rounded MT Bold\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Darumadrop One",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/darumadrop-one-400-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese kana and kanji subset (Darumadrop One JA)",
					"fontFamily": "\"Darumadrop One JA\", \"Hiragino Maru Gothic ProN\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Darumadrop One JA",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/darumadrop-one-400-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja-kanji",
					"name": "Display, Japanese kanji subset (Zen Maru Gothic JA)",
					"fontFamily": "\"Zen Maru Gothic JA\", \"Hiragino Maru Gothic ProN\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Zen Maru Gothic JA",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/zen-maru-gothic-700-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"PingFang TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Rubik)",
					"fontFamily": "\"Rubik\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rubik-variable-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
			"lineHeight": "1.8",
			"fontWeight": "300"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4.5vw, 3.5rem)",
				"right": "clamp(1.25rem, 4.5vw, 3.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.25",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--rikyu)",
					"text": "#1E2A22"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontSize": "0.9375rem",
					"letterSpacing": "0.04em",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (top bar: workshop name, Request a survey button; the menu as a fixed side rail on wide screens)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (ink field: house name, synced house details and the menu)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
