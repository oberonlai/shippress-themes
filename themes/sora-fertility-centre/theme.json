{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "ground", "name": "Ground", "color": "#D5D0CB" },
				{ "slug": "arch", "name": "Arch", "color": "#E6E2DE" },
				{ "slug": "paper", "name": "Paper", "color": "#F2EFEC" },
				{ "slug": "field", "name": "Field", "color": "#EFECE9" },
				{ "slug": "ink", "name": "Ink", "color": "#2E2A29" },
				{ "slug": "body", "name": "Body ink", "color": "#3F3938" },
				{ "slug": "accent", "name": "Cherry blossom grey", "color": "#B39A9A" },
				{ "slug": "deep", "name": "Deep accent", "color": "#6B5151" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display", "name": "Spectral", "fontFamily": "Spectral, 'Noto Serif', Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Spectral", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/spectral-light-latin.woff2"] },
						{ "fontFamily": "Spectral", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/spectral-regular-latin.woff2"] },
						{ "fontFamily": "Spectral", "fontWeight": "300 400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/spectral-italic-latin.woff2"] }
					]
				},
				{
					"slug": "body", "name": "Open Sans", "fontFamily": "'Open Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Open Sans", "fontWeight": "300 800", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/opensans-variable-latin.woff2"] }
					]
				},
				{
					"slug": "display-zh", "name": "Noto Serif TC (zh-TW)", "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
					]
				},
				{
					"slug": "display-ja", "name": "Noto Serif JP (ja)", "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.375rem" },
				{ "slug": "x-large", "name": "X-Large", "size": "2.25rem" },
				{ "slug": "xx-large", "name": "XX-Large", "size": "4.5rem" }
			]
		},
		"spacing": { "units": ["px", "em", "rem", "%", "vw"] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--body)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.9" },
		"spacing": { "blockGap": "1.5rem" },
		"elements": {
			"heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.15" } },
			"link": { "color": { "text": "var(--wp--preset--color--deep)" } }
		}
	}
}
