{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "customTemplates": [
    { "name": "page-inner", "title": "Inner page (page head in content)", "postTypes": [ "page" ] }
  ],
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1193px", "wideSize": "1320px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "white", "name": "White (ground)", "color": "#FFFFFF" },
        { "slug": "stone", "name": "Stone (hero lower half, footer)", "color": "#F2F1EC" },
        { "slug": "band", "name": "Pale lime band (timeline)", "color": "#F5F1D8" },
        { "slug": "ink", "name": "Ink (text)", "color": "#1E1E1C" },
        { "slug": "muted", "name": "Muted text", "color": "#55554F" },
        { "slug": "moss", "name": "Moss (small accents)", "color": "#5E6B52" },
        { "slug": "mint", "name": "Mint (ring 2)", "color": "#46A882" },
        { "slug": "sun", "name": "Sun (label dot)", "color": "#E2662A" },
        { "slug": "track", "name": "Ring track", "color": "#E6E3D8" }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Lora",
          "fontFamily": "Lora, Georgia, 'Times New Roman', serif",
          "fontFace": [
            { "fontFamily": "Lora", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-variable.woff2" ] },
            { "fontFamily": "Lora", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-italic-variable.woff" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Karla",
          "fontFamily": "Karla, system-ui, -apple-system, 'Segoe UI', sans-serif",
          "fontFace": [
            { "fontFamily": "Karla", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/karla-variable-latin.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Body", "size": "1.125rem" },
        { "slug": "medium", "name": "Lead", "size": "1.4rem" },
        { "slug": "large", "name": "Large", "size": "2.1rem" },
        { "slug": "x-large", "name": "Section heading", "size": "2.75rem" },
        { "slug": "xx-large", "name": "Tile heading", "size": "4.25rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ]
    },
    "border": { "radius": true }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "spacing": { "blockGap": "1.25rem" },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.15" },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--moss)" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--moss)", "text": "#FFFFFF" },
        "border": { "radius": "0" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700", "fontSize": "1rem" },
        "spacing": { "padding": { "top": "22px", "right": "44px", "bottom": "22px", "left": "44px" } }
      }
    },
    "blocks": {
      "core/image": { "border": { "radius": "10px" } }
    }
  }
}
