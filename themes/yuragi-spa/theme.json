{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": false,
  "layout": {
   "contentSize": "640px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "pale",
     "name": "Pale grey (panels)",
     "color": "#F2F2F2"
    },
    {
     "slug": "pale-2",
     "name": "Pale grey 2 (alternate band)",
     "color": "#F5F5F5"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#DDDDDD"
    },
    {
     "slug": "ink",
     "name": "Ink (headings)",
     "color": "#1A1A1A"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#333333"
    },
    {
     "slug": "mid",
     "name": "Mid grey (captions)",
     "color": "#616161"
    },
    {
     "slug": "stone",
     "name": "Stone (brackets, dashes)",
     "color": "#6A6E70"
    },
    {
     "slug": "clay",
     "name": "Clay (booking accent)",
     "color": "#9C5B46"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "serif",
     "name": "Serif (EB Garamond)",
     "fontFamily": "\"EB Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", \"Songti TC\", \"Hiragino Mincho ProN\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/eb-garamond-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      },
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "italic",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/eb-garamond-italic-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "sans",
     "name": "Sans (Outfit)",
     "fontFamily": "\"Outfit\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "brackets",
     "name": "Brackets",
     "fontFamily": "\"Yuragi Brackets\", \"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Yuragi Brackets",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/yuragi-brackets.woff2"
       ],
       "unicodeRange": "U+3010-3011"
      }
     ]
    },
    {
     "slug": "noto-serif-tc",
     "name": "Noto Serif TC",
     "fontFamily": "\"Noto Serif TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-serif-jp",
     "name": "Noto Serif JP",
     "fontFamily": "\"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.1875rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "Section heading",
     "size": "clamp(2rem, 3.4vw, 2.5rem)"
    },
    {
     "slug": "xx-large",
     "name": "Hero pairs",
     "size": "clamp(2.5rem, 5.4vw, 4.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(3rem, 7vw, 6rem)"
    },
    {
     "slug": "70",
     "name": "XXL",
     "size": "clamp(6rem, 12vw, 10.5rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--sans)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.9",
   "fontWeight": "300"
  },
  "spacing": {
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--serif)",
     "fontWeight": "400",
     "lineHeight": "1.35",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.18"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "typography": {
      "textDecoration": "underline"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--clay)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--sans)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "500",
     "letterSpacing": "0.12em"
    },
    "spacing": {
     "padding": {
      "top": "16px",
      "bottom": "16px",
      "left": "32px",
      "right": "32px"
     }
    },
    ":hover": {
     "color": {
      "background": "#8A4F3C",
      "text": "#FFFFFF"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page",
   "postTypes": ["page"]
  }
 ]
}