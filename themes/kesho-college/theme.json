{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1100px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#120E12"
    },
    {
     "slug": "paper",
     "name": "White (text)",
     "color": "#FFFFFF"
    },
    {
     "slug": "soft",
     "name": "Soft text",
     "color": "#CFC6CD"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#B9B0B7"
    },
    {
     "slug": "accent",
     "name": "Lilac (accent)",
     "color": "#D9B6CF"
    },
    {
     "slug": "mauve",
     "name": "Deep mauve",
     "color": "#6B5A68"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "italic",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Karla)",
     "fontFamily": "Karla, \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Karla",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/karla-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.5rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.5rem"
     }
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem",
     "fluid": {
      "min": "1.875rem",
      "max": "2.5rem"
     }
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "3.75rem",
     "fluid": {
      "min": "2.5rem",
      "max": "3.75rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "5.625rem",
     "fluid": {
      "min": "3rem",
      "max": "5.625rem"
     }
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(4.25rem, 14.4vw, 13rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "20px"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "30px"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "40px"
    },
    {
     "slug": "80",
     "name": "XL",
     "size": "80px"
    },
    {
     "slug": "150",
     "name": "Section",
     "size": "clamp(96px, 10.4vw, 150px)"
    },
    {
     "slug": "160",
     "name": "Gap",
     "size": "clamp(96px, 11vw, 160px)"
    }
   ]
  },
  "border": {
   "radius": false
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--paper)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2"
  },
  "spacing": {
   "padding": {
    "left": "20px",
    "right": "20px"
   },
   "blockGap": "30px"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--accent)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--paper)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.4"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--ground)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "800",
     "fontSize": "0.875rem",
     "letterSpacing": "0.08em",
     "textTransform": "uppercase"
    },
    "spacing": {
     "padding": {
      "top": "16px",
      "bottom": "16px",
      "left": "32px",
      "right": "32px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--mauve)",
      "text": "var(--wp--preset--color--paper)"
     }
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "rgba(255,255,255,.16)"
    }
   }
  }
 }
}
