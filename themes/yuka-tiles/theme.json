{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1120px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "surface",
     "name": "Surface",
     "color": "#F5F5F5"
    },
    {
     "slug": "grey",
     "name": "Grey (wordmark, footer headings)",
     "color": "#88888A"
    },
    {
     "slug": "muted",
     "name": "Soft ink (nav, labels)",
     "color": "#6F6F72"
    },
    {
     "slug": "contrast",
     "name": "Ink (headings, body)",
     "color": "#4A4A4D"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#D9D9DB"
    },
    {
     "slug": "accent",
     "name": "Copper (outline boxes, figures)",
     "color": "#7A6758"
    },
    {
     "slug": "accent-dark",
     "name": "Copper dark (hover)",
     "color": "#685748"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Albert Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Legal line",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "Hours, meta",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body, nav",
     "size": "1rem"
    },
    {
     "slug": "prose",
     "name": "Narrative",
     "size": "1.0625rem"
    },
    {
     "slug": "l",
     "name": "Row titles, ledes",
     "size": "1.25rem"
    },
    {
     "slug": "lead",
     "name": "Hero lead, footer headings",
     "size": "1.5625rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.5625rem"
     }
    },
    {
     "slug": "xl",
     "name": "Caption plate",
     "size": "2rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2rem"
     }
    },
    {
     "slug": "section",
     "name": "Section headline",
     "size": "2.75rem",
     "fluid": {
      "min": "2rem",
      "max": "2.75rem"
     }
    },
    {
     "slug": "title",
     "name": "Inner page title",
     "size": "3.25rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.25rem"
     }
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.5rem",
     "fluid": {
      "min": "3rem",
      "max": "4.5rem"
     }
    },
    {
     "slug": "wordmark",
     "name": "Wordmark",
     "size": "4rem",
     "fluid": {
      "min": "1.75rem",
      "max": "4rem"
     }
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "300",
   "lineHeight": "1.5"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.02"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--section)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--l)",
     "fontWeight": "500",
     "lineHeight": "1.2"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "0",
     "width": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1rem",
     "fontWeight": "400"
    },
    "spacing": {
     "padding": {
      "top": "0.6rem",
      "bottom": "0.6rem",
      "left": "0.875rem",
      "right": "0.875rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--accent-dark)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--m)",
     "fontWeight": "300",
     "letterSpacing": "0.04em"
    }
   }
  }
 }
}