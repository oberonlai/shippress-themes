{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "kinari",
          "name": "Kinari paper (ground)",
          "color": "#FBF5E4"
        },
        {
          "slug": "washi",
          "name": "Washi (tiles, cards)",
          "color": "#FFFCF3"
        },
        {
          "slug": "yuzu-pale",
          "name": "Pale yuzu",
          "color": "#FCEBA6"
        },
        {
          "slug": "yuzu",
          "name": "Yuzu yellow",
          "color": "#F5C518"
        },
        {
          "slug": "kihada",
          "name": "Kihada deep yellow",
          "color": "#E3A008"
        },
        {
          "slug": "matcha-pale",
          "name": "Pale matcha",
          "color": "#E3EDC4"
        },
        {
          "slug": "matcha",
          "name": "Fresh matcha",
          "color": "#9CC04A"
        },
        {
          "slug": "matcha-deep",
          "name": "Deep matcha (links)",
          "color": "#46661A"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#EADFC0"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#5A6150"
        },
        {
          "slug": "ink",
          "name": "Charcoal-green ink",
          "color": "#1F2B24"
        }
      ],
      "gradients": [
        {
          "slug": "yuzu-morning",
          "name": "Yuzu morning",
          "gradient": "linear-gradient(160deg, #FCEBA6 0%, #FBF5E4 70%)"
        },
        {
          "slug": "matcha-foam",
          "name": "Matcha foam",
          "gradient": "linear-gradient(160deg, #E3EDC4 0%, #FBF5E4 75%)"
        },
        {
          "slug": "sunny-tile",
          "name": "Sunny tile",
          "gradient": "linear-gradient(135deg, #F5C518 0%, #FCEBA6 100%)"
        }
      ],
      "duotone": [
        {
          "slug": "ink-yuzu",
          "name": "Ink and yuzu",
          "colors": [
            "#1F2B24",
            "#F5C518"
          ]
        },
        {
          "slug": "ink-kinari",
          "name": "Ink and kinari",
          "colors": [
            "#1F2B24",
            "#FBF5E4"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Bricolage Grotesque)",
          "fontFamily": "\"Bricolage Grotesque\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bricolage-grotesque-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Nunito)",
          "fontFamily": "Nunito, \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Nunito",
              "fontStyle": "normal",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/nunito-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Nunito",
              "fontStyle": "italic",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/nunito-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "hand",
          "name": "Handwritten notes (Patrick Hand)",
          "fontFamily": "\"Patrick Hand\", \"Comic Neue\", \"Segoe Print\", cursive",
          "fontFace": [
            {
              "fontFamily": "Patrick Hand",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/patrick-hand-400-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.125rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.1875rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.5rem",
          "fluid": {
            "min": "2.25rem",
            "max": "4rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6rem",
          "fluid": {
            "min": "3rem",
            "max": "7rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Tile gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Tile padding",
          "size": "clamp(1.5rem, 1rem + 1.6vw, 2.75rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(2.5rem, 1.6rem + 3.4vw, 5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(3.5rem, 2rem + 5.5vw, 7.5rem)"
        }
      ]
    },
    "custom": {
      "radius": {
        "tile": "28px",
        "small": "16px",
        "pill": "999px"
      },
      "ease": "cubic-bezier(.34, 1.4, .64, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|kinari",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1rem, 3.5vw, 3rem)",
        "bottom": "0px",
        "left": "clamp(1rem, 3.5vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "450",
      "lineHeight": "1.62"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|matcha-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1.02",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "750",
          "lineHeight": "0.94",
          "letterSpacing": "-0.035em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "720",
          "lineHeight": "0.98",
          "letterSpacing": "-0.03em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "680",
          "lineHeight": "1.05"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "680",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700",
          "lineHeight": "1.3",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "800",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|kinari"
        },
        "border": {
          "radius": "999px",
          "width": "2px",
          "style": "solid",
          "color": "var:preset|color|ink"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.5rem",
            "bottom": "0.85rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.9375rem",
          "fontWeight": "800",
          "letterSpacing": "0.01em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|yuzu",
            "text": "var:preset|color|ink"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|yuzu",
            "text": "var:preset|color|ink"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|hand",
          "fontSize": "1.0625rem",
          "lineHeight": "1.35"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.5rem",
          "fontWeight": "750",
          "letterSpacing": "-0.03em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|hand",
          "fontSize": "1rem",
          "lineHeight": "1.1"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "750",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.02"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "750",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "800",
          "letterSpacing": "0.04em"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.55"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "750"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|hairline"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "650",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.02"
        }
      },
      "core/image": {
        "border": {
          "radius": "28px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "28px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.22em;text-decoration-thickness:2px;text-decoration-color:var(--wp--preset--color--yuzu);transition:color .25s ease,text-decoration-color .25s ease}a:hover{text-decoration-color:var(--wp--preset--color--matcha)}::selection{background:var(--wp--preset--color--yuzu);color:var(--wp--preset--color--ink)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the shop",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-brewing-guide",
      "title": "Brewing guide",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-tea-subscription",
      "title": "Tea subscription",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (The Steep)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and visit",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
