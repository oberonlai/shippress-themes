{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "washi",
          "name": "Washi (ground)",
          "color": "#F5F0E6"
        },
        {
          "slug": "kinari",
          "name": "Kinari (surface)",
          "color": "#EAE3D4"
        },
        {
          "slug": "sumi",
          "name": "Sumi (text)",
          "color": "#2B2A26"
        },
        {
          "slug": "sencha",
          "name": "Sencha (primary)",
          "color": "#55673F"
        },
        {
          "slug": "sencha-pale",
          "name": "Pale sencha (tint)",
          "color": "#DDE2D0"
        },
        {
          "slug": "hojicha",
          "name": "Hojicha (accent)",
          "color": "#7B5A43"
        },
        {
          "slug": "yuzu",
          "name": "Yuzu (a dot, never a fill)",
          "color": "#D9A93A"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "sumi-washi",
          "name": "Sumi and washi",
          "colors": [
            "#2B2A26",
            "#F5F0E6"
          ]
        },
        {
          "slug": "sencha-washi",
          "name": "Sencha and washi",
          "colors": [
            "#2E3826",
            "#F5F0E6"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Shippori Mincho)",
          "fontFamily": "\"Shippori Mincho\", \"Hiragino Mincho ProN\", \"Yu Mincho\", \"Noto Serif JP\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Shippori Mincho",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-mincho-400-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Shippori Mincho",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-mincho-500-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Shippori Mincho",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-mincho-600-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Hanken Grotesk)",
          "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "1.875rem",
          "fluid": {
            "min": "1.4375rem",
            "max": "2.125rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3rem",
          "fluid": {
            "min": "2rem",
            "max": "3.375rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.625rem",
            "max": "5.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 10rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 16%, transparent)",
      "mute": "color-mix(in srgb, var(--wp--preset--color--sumi) 76%, var(--wp--preset--color--washi))",
      "footer": {
        "background": "#2B2A26",
        "text": "#F5F0E6",
        "mute": "#BDB5A6"
      },
      "band": {
        "background": "#55673F",
        "text": "#F5F0E6"
      },
      "ease": "cubic-bezier(.22, .61, .36, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|washi",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.72"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|sencha"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|hojicha"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|hojicha"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "500",
          "lineHeight": "1.18",
          "letterSpacing": "0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "500",
          "lineHeight": "1.08",
          "letterSpacing": "-0.005em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.14"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.35"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|sencha",
          "text": "var:preset|color|washi"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|sencha"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.75rem",
            "bottom": "0.95rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "0.8125rem",
          "fontWeight": "600",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.04em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.375rem",
          "fontWeight": "500",
          "letterSpacing": "0.04em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.06em",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.8125rem",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "500",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sencha"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:custom|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.45"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.25"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.25em;text-decoration-thickness:1px;transition:color .3s ease}::selection{background:var(--wp--preset--color--sencha-pale);color:var(--wp--preset--color--sumi)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the shop",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-brewing-guide",
      "title": "Brewing guide",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-tea-subscription",
      "title": "Tea subscription",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (The Steep)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and visit",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
