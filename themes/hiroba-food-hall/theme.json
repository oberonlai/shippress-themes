{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1056px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "paper",
     "name": "Paper band",
     "color": "#F6F1E7"
    },
    {
     "slug": "window",
     "name": "Window ground",
     "color": "#F1F5F5"
    },
    {
     "slug": "stone",
     "name": "Stone band",
     "color": "#E5E2D8"
    },
    {
     "slug": "grey",
     "name": "Light grey band",
     "color": "#F4F4F4"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#3F342C"
    },
    {
     "slug": "gold",
     "name": "Gold (accent)",
     "color": "#B8860A"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6F665F"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "Fraunces, Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/fraunces-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Literata)",
     "fontFamily": "Literata, Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Literata",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/literata-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large (statement)",
     "size": "1.875rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "X-large (caps title)",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "XX-large (figures)",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Huge (H1)",
     "size": "4.25rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--gold)"
     }
    }
   }
  },
  "spacing": {
   "padding": {
    "left": "var(--hb-gut)",
    "right": "var(--hb-gut)"
   },
   "blockGap": "0"
  }
 }
}