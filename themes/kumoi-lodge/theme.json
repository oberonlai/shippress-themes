{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1030px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ink",
     "name": "Ink (type, rules)",
     "color": "#3C342C"
    },
    {
     "slug": "meta",
     "name": "Meta text",
     "color": "#5E564E"
    },
    {
     "slug": "lichen",
     "name": "Lichen (page ground)",
     "color": "#E0E5C5"
    },
    {
     "slug": "mint",
     "name": "Mint",
     "color": "#D3E8DD"
    },
    {
     "slug": "butter",
     "name": "Butter",
     "color": "#F2EFCF"
    },
    {
     "slug": "cream",
     "name": "Cream",
     "color": "#F4ECE0"
    },
    {
     "slug": "blush",
     "name": "Blush",
     "color": "#EADFD9"
    },
    {
     "slug": "ember",
     "name": "Ember (rings, underline)",
     "color": "#B4572F"
    },
    {
     "slug": "white",
     "name": "White (on photos)",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/fraunces-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "meta",
     "name": "Meta",
     "size": "0.846rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.08rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.52rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "xx-large-alt",
     "name": "XX-large (inner h1)",
     "size": "4.25rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "XX-large (wordmark)",
     "size": "4.5rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "svh"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--lichen)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.5"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large-alt)",
     "fontWeight": "300",
     "lineHeight": "1.2"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "letterSpacing": "0.1em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "letterSpacing": "0.08em",
     "lineHeight": "1.75"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--ember)"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "50px"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page (blurred head, full width)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
