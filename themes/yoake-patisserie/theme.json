{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1152px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "dawn",
     "name": "Dawn (blush, 15:00 tile)",
     "color": "#F6BFBC"
    },
    {
     "slug": "dawn-mid",
     "name": "Dawn mid (11:00 tile)",
     "color": "#F9D5D2"
    },
    {
     "slug": "dawn-pale",
     "name": "Dawn pale (07:00 tile, panels)",
     "color": "#FDEEEC"
    },
    {
     "slug": "paper",
     "name": "Paper (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "cocoa",
     "name": "Cocoa (text, footer)",
     "color": "#41342B"
    },
    {
     "slug": "umber",
     "name": "Umber (kickers)",
     "color": "#664A29"
    },
    {
     "slug": "brick",
     "name": "Brick (rules, numerals)",
     "color": "#6D311D"
    },
    {
     "slug": "on-dark",
     "name": "On dark",
     "color": "#FDEEEC"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A3301F"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F5A3A"
    }
   ],
   "gradients": [
    {
     "slug": "dawn-110",
     "name": "Dawn wash 110",
     "gradient": "linear-gradient(110deg, #F6BFBC 22%, #F9D5D2 55%, #FDEEEC 90%)"
    },
    {
     "slug": "dawn-290",
     "name": "Dawn wash 290",
     "gradient": "linear-gradient(290deg, #F6BFBC 22%, #F9D5D2 55%, #FDEEEC 90%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Instrument Serif)",
     "fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Serif",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-serif-latin.woff2"
       ]
      },
      {
       "fontFamily": "Instrument Serif",
       "fontStyle": "italic",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-serif-italic-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "Karla, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Karla",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/karla-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-small",
     "size": ".75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "1.75rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "2.75rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "4.25rem"
    },
    {
     "slug": "numeral",
     "name": "Numeral",
     "size": "6rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "8px"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "16px"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "24px"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "72px"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "110px"
    },
    {
     "slug": "80",
     "name": "7",
     "size": "160px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--cocoa)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "2",
   "fontWeight": "300"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2"
    },
    "color": {
     "text": "var(--wp--preset--color--cocoa)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.05",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.6",
     "letterSpacing": ".02em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--cocoa)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--brick)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--cocoa)",
     "text": "var(--wp--preset--color--paper)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": ".9375rem",
     "fontWeight": "500",
     "letterSpacing": ".1em",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "18px",
      "bottom": "18px",
      "left": "32px",
      "right": "32px"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}