{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Morning Yatai",
  "settings": {
    "color": {
      "palette": [
        { "slug": "yoru", "name": "Paper-lantern daylight (ground)", "color": "#FBF1DE" },
        { "slug": "kon", "name": "Rice paper (raised panel)", "color": "#FFF9EC" },
        { "slug": "ai", "name": "Straw (bands, cards)", "color": "#F2E0C2" },
        { "slug": "hairline", "name": "Hairline", "color": "#E0C8A2" },
        { "slug": "hanabi", "name": "Hanabi burnt orange (accent, buttons)", "color": "#B03600" },
        { "slug": "kogane", "name": "Old marigold (labels)", "color": "#835500" },
        { "slug": "spark", "name": "Spark magenta (one accent)", "color": "#B0125A" },
        { "slug": "kasumi", "name": "Indigo haze (quiet text)", "color": "#4C4B70" },
        { "slug": "chochin", "name": "Indigo ink (text)", "color": "#14163F" }
      ],
      "gradients": [
        { "slug": "night-sky", "name": "Morning sky", "gradient": "linear-gradient(180deg, #FBF1DE 0%, #FFF9EC 62%, #F6E2C8 100%)" },
        { "slug": "afterglow", "name": "Afterglow", "gradient": "radial-gradient(60% 55% at 72% 18%, rgba(176,54,0,.12) 0%, rgba(251,241,222,0) 70%), radial-gradient(40% 45% at 12% 80%, rgba(176,18,90,.08) 0%, rgba(251,241,222,0) 72%)" },
        { "slug": "fuse", "name": "Fuse (orange to marigold)", "gradient": "linear-gradient(100deg, #B03600 0%, #A44400 55%, #8F4F00 100%)" }
      ]
    }
  }
}
