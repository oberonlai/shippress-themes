{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "yoru", "name": "Yoru summer-night indigo (ground)", "color": "#0D0F2E" },
        { "slug": "kon", "name": "Kon indigo (raised panel)", "color": "#161A45" },
        { "slug": "ai", "name": "Ai deep blue (bands, cards)", "color": "#232870" },
        { "slug": "hairline", "name": "Hairline", "color": "#2F3580" },
        { "slug": "hanabi", "name": "Hanabi vermilion-orange (fireworks, buttons)", "color": "#FF5B24" },
        { "slug": "kogane", "name": "Kogane marigold (labels, highlights)", "color": "#FFB830" },
        { "slug": "spark", "name": "Spark magenta (one accent)", "color": "#FF3D8B" },
        { "slug": "kasumi", "name": "Kasumi haze (quiet text)", "color": "#B8B7DA" },
        { "slug": "chochin", "name": "Chochin lantern cream (text)", "color": "#FFF2D9" }
      ],
      "gradients": [
        { "slug": "night-sky", "name": "Night sky", "gradient": "linear-gradient(180deg, #0D0F2E 0%, #161A45 62%, #2A1F55 100%)" },
        { "slug": "afterglow", "name": "Afterglow", "gradient": "radial-gradient(60% 55% at 72% 18%, rgba(255,91,36,.30) 0%, rgba(13,15,46,0) 70%), radial-gradient(40% 45% at 12% 80%, rgba(255,61,139,.16) 0%, rgba(13,15,46,0) 72%)" },
        { "slug": "fuse", "name": "Fuse (orange to marigold)", "gradient": "linear-gradient(100deg, #FF5B24 0%, #FF8A2A 55%, #FFB830 100%)" }
      ],
      "duotone": [
        { "slug": "yoru-chochin", "name": "Night and lantern", "colors": ["#0D0F2E", "#FFF2D9"] },
        { "slug": "ai-hanabi", "name": "Indigo and fireworks", "colors": ["#161A45", "#FF8A4F"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
      "fontFamilies": [
        {
          "slug": "poster",
          "name": "Poster (Big Shoulders Display)",
          "fontFamily": "\"Big Shoulders Display\", \"Bebas Neue\", \"Arial Narrow\", Impact, sans-serif",
          "fontFace": [
            { "fontFamily": "Big Shoulders Display", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/big-shoulders-display-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "wide",
          "name": "Wide (Unbounded)",
          "fontFamily": "\"Unbounded\", \"Arial Black\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Unbounded", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/unbounded-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Text (Onest)",
          "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Onest", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
        { "slug": "xx-large", "name": "Section title", "size": "4.5rem", "fluid": { "min": "3.25rem", "max": "6rem" } },
        { "slug": "display", "name": "Poster", "size": "8rem", "fluid": { "min": "4.25rem", "max": "10.5rem" } },
        { "slug": "numeral", "name": "Date numeral", "size": "16rem", "fluid": { "min": "8.5rem", "max": "21rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Spark", "size": "0.5rem" },
        { "slug": "20", "name": "Ember", "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)" },
        { "slug": "30", "name": "Star", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)" },
        { "slug": "40", "name": "Shell", "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)" },
        { "slug": "50", "name": "Burst", "size": "clamp(3rem, 1.8rem + 4.2vw, 6.5rem)" },
        { "slug": "60", "name": "Volley", "size": "clamp(4.5rem, 2.4rem + 7vw, 10rem)" },
        { "slug": "70", "name": "Finale", "size": "clamp(6rem, 3rem + 10.5vw, 15rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.16, 1, .3, 1)",
      "spin": "90s"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|yoru",
      "text": "var:preset|color|chochin"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|kogane" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|chochin" } },
        ":focus": { "color": { "text": "var:preset|color|chochin" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|chochin" },
        "typography": {
          "fontFamily": "var:preset|font-family|poster",
          "fontWeight": "800",
          "lineHeight": "0.92",
          "letterSpacing": "-0.01em",
          "textTransform": "uppercase"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "900", "lineHeight": "0.84", "letterSpacing": "-0.015em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "900", "lineHeight": "0.88" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "800", "lineHeight": "0.95" } },
      "h4": { "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "var:preset|font-size|large", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.01em", "textTransform": "none" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "700", "lineHeight": "1.3", "letterSpacing": "0", "textTransform": "none" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "lineHeight": "1.4", "letterSpacing": "0.16em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|hanabi", "text": "var:preset|color|yoru" },
        "border": { "width": "2px", "style": "solid", "color": "var:preset|color|hanabi", "radius": "999px" },
        "spacing": { "padding": { "top": "0.95rem", "right": "1.7rem", "bottom": "0.95rem", "left": "1.7rem" } },
        "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "0.8125rem", "fontWeight": "700", "letterSpacing": "0.04em", "textTransform": "uppercase", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|kogane", "text": "var:preset|color|yoru" }, "border": { "color": "var:preset|color|kogane" } },
        ":focus": { "color": { "background": "var:preset|color|kogane", "text": "var:preset|color|yoru" }, "border": { "color": "var:preset|color|kogane" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|kasumi" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "lineHeight": "1.55", "letterSpacing": "0.01em" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "1rem", "fontWeight": "800", "letterSpacing": "0.02em", "lineHeight": "1", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|chochin" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|kasumi" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.75rem", "fontWeight": "500", "letterSpacing": "0.02em" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "0.75rem", "fontWeight": "600", "letterSpacing": "0.06em", "textTransform": "uppercase", "lineHeight": "1.3" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|poster", "fontWeight": "800", "letterSpacing": "-0.005em", "lineHeight": "0.95", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|chochin" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|kogane" },
        "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "letterSpacing": "0.08em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|kasumi" },
        "typography": { "fontFamily": "var:preset|font-family|wide", "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "letterSpacing": "0.08em", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|hanabi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|kasumi" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.65" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "900" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|kasumi" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|poster", "fontWeight": "800", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1", "textTransform": "uppercase" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|poster", "fontWeight": "900", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "0.9", "textTransform": "uppercase" }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/details": {
        "typography": { "fontSize": "var:preset|font-size|medium" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.28em;text-decoration-thickness:1px;transition:color .3s ease,text-decoration-color .3s ease}::selection{background:var(--wp--preset--color--hanabi);color:var(--wp--preset--color--yoru)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About the festival", "postTypes": ["page"] },
    { "name": "page-program", "title": "Program: lineup and timetable", "postTypes": ["page"] },
    { "name": "page-tickets", "title": "Tickets and passes", "postTypes": ["page"] },
    { "name": "page-access", "title": "Access, map and FAQ", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Newsletter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
