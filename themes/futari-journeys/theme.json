{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1100px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Band (moss-tinted pale)",
     "color": "#F2F4EF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#222222"
    },
    {
     "slug": "muted",
     "name": "Muted moss grey",
     "color": "#5E6B57"
    },
    {
     "slug": "moss",
     "name": "Bamboo moss",
     "color": "#769164"
    },
    {
     "slug": "moss-deep",
     "name": "Deep moss (the one CTA)",
     "color": "#3F5236"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#E2E2E2"
    },
    {
     "slug": "rule",
     "name": "Eyebrow rule",
     "color": "#C9CFC3"
    },
    {
     "slug": "mist",
     "name": "Mist (footer text)",
     "color": "#E9ECE6"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A23B3B"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F6B45"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "svh"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Manrope)",
     "fontFamily": "Manrope, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "1.75rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "clamp(1.625rem, 1rem + 1.6vw, 2.25rem)"
    },
    {
     "slug": "huge",
     "name": "Huge",
     "size": "clamp(2.625rem, 1.2rem + 4vw, 4.5rem)"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.8",
   "letterSpacing": ".04em"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "400",
     "lineHeight": "1.45",
     "letterSpacing": ".08em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "fontWeight": "500",
     "lineHeight": "1.04",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.25rem",
     "fontWeight": "600",
     "lineHeight": "1.3",
     "letterSpacing": ".04em"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--moss-deep)",
     "text": "var(--wp--preset--color--paper)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": ".875rem",
     "fontWeight": "600",
     "letterSpacing": ".06em",
     "textDecoration": "none"
    },
    "border": {
     "radius": "0"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}