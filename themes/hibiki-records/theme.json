{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "charcoal",
					"name": "Charcoal (page)",
					"color": "#17191A"
				},
				{
					"slug": "cell",
					"name": "Deep graphite (cells)",
					"color": "#1E2122"
				},
				{
					"slug": "graphite",
					"name": "Graphite (panels, cards, the ticker band)",
					"color": "#262A2B"
				},
				{
					"slug": "hair",
					"name": "Hairline (decorative)",
					"color": "#3A3F40"
				},
				{
					"slug": "quiet",
					"name": "Warm grey (secondary text)",
					"color": "#A9A69F"
				},
				{
					"slug": "bone",
					"name": "Bone (text, buttons)",
					"color": "#E6E3DD"
				},
				{
					"slug": "teal",
					"name": "Muted grey-teal (rings, rules, large marks)",
					"color": "#5C8A86"
				},
				{
					"slug": "teal-light",
					"name": "Pale teal (links and small labels)",
					"color": "#8DB5AF"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Display + text (Familjen Grotesk)",
					"fontFamily": "\"Familjen Grotesk\", \"Helvetica Neue\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Familjen Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/familjengrotesk-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Catalogue numbers + labels (Martian Mono)",
					"fontFamily": "\"Martian Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "Martian Mono",
							"fontStyle": "normal",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/martianmono-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "clamp(1.125rem, 1.04rem + 0.36vw, 1.375rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.55rem, 1.25rem + 1.1vw, 2.2rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section title",
					"size": "clamp(1.9rem, 1.4rem + 2vw, 3rem)"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(2.3rem, 1.5rem + 3.4vw, 4.4rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(3.5rem, 2.2rem + 4.6vw, 6.5rem)"
				},
				{
					"slug": "60",
					"name": "Large section",
					"size": "clamp(4.5rem, 2.6rem + 7vw, 9rem)"
				}
			]
		},
		"custom": {
			"line": "color-mix(in srgb, var(--wp--preset--color--bone) 12%, transparent)",
			"line-strong": "color-mix(in srgb, var(--wp--preset--color--bone) 24%, transparent)",
			"muted": "var(--wp--preset--color--quiet)",
			"on-dark": "#E6E3DD",
			"on-dark-muted": "#A9A69F",
			"ease": "cubic-bezier(.2, .7, .2, 1)",
			"panel": "#262A2B"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|charcoal",
			"text": "var:preset|color|bone"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.72",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|teal-light"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|bone"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var:preset|color|bone"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.18",
					"letterSpacing": "-0.02em",
					"fontWeight": "500"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.22",
					"letterSpacing": "-0.015em",
					"fontWeight": "500"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.005em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|bone",
					"text": "var:preset|color|charcoal"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.06em"
				},
				"border": {
					"radius": "0px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|teal-light",
						"text": "var:preset|color|charcoal"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "1.0625rem",
					"fontWeight": "500",
					"letterSpacing": "0.02em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|bone"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|bone"
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"textTransform": "uppercase",
					"letterSpacing": "0.14em"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"lineHeight": "1.45"
				},
				"border": {
					"left": {
						"color": "var:preset|color|teal",
						"width": "2px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:custom|line-strong"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "checkout-header",
			"title": "Checkout header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (sections)",
			"postTypes": [
				"page"
			]
		}
	]
}
