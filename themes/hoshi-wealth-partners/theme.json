{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page (page head in content)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1244px"
  },
  "color": {
   "defaultPalette": false,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F2F2E9"
    },
    {
     "slug": "ground-2",
     "name": "Ground 2",
     "color": "#EEEEE2"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#212836"
    },
    {
     "slug": "band",
     "name": "Dark band",
     "color": "#40403D"
    },
    {
     "slug": "stone",
     "name": "Stone",
     "color": "#B7B7B1"
    },
    {
     "slug": "light",
     "name": "Light on band",
     "color": "#D6D6CF"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5C5F66"
    },
    {
     "slug": "accent",
     "name": "Sea pine",
     "color": "#6B6A3E"
    },
    {
     "slug": "tint",
     "name": "Sea pine tint",
     "color": "#A8A672"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ]
  },
  "typography": {
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "EB Garamond",
     "fontFamily": "'EB Garamond', Garamond, Georgia, 'Times New Roman', serif",
     "fontFace": [
      {
       "fontFamily": "EB Garamond",
       "fontWeight": "400 800",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ebgaramond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "EB Garamond",
       "fontWeight": "400 800",
       "fontStyle": "italic",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ebgaramond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Heebo",
     "fontFamily": "Heebo, system-ui, -apple-system, 'Segoe UI', sans-serif",
     "fontFace": [
      {
       "fontFamily": "Heebo",
       "fontWeight": "100 900",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/heebo-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-Small",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.2425rem"
    },
    {
     "slug": "x-large",
     "name": "X-Large",
     "size": "2.205rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-Large",
     "size": "clamp(2.25rem, 6vw, 5.5rem)"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.25rem, 8.6vw, 8.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.6",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.15"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   }
  }
 }
}