{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1400px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "base-2",
     "name": "Header and footer ground",
     "color": "#F8F7F3"
    },
    {
     "slug": "panel",
     "name": "Warm grey panel",
     "color": "#F0EFE7"
    },
    {
     "slug": "panel-2",
     "name": "Tile ground",
     "color": "#FCFBF9"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#D3D0C8"
    },
    {
     "slug": "line-2",
     "name": "Tile border",
     "color": "#EBE9E2"
    },
    {
     "slug": "contrast",
     "name": "Text",
     "color": "#333333"
    },
    {
     "slug": "meta",
     "name": "Meta text",
     "color": "#736D6D"
    },
    {
     "slug": "primary",
     "name": "Coffee brown",
     "color": "#6A5648"
    },
    {
     "slug": "primary-deep",
     "name": "Deep label brown",
     "color": "#5D2F0C"
    },
    {
     "slug": "link",
     "name": "Link brown",
     "color": "#795134"
    },
    {
     "slug": "accent",
     "name": "Accent blue",
     "color": "#005BAC"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Plus Jakarta Sans)",
     "fontFamily": "\"Plus Jakarta Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Plus Jakarta Sans",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/plus-jakarta-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (DM Sans)",
     "fontFamily": "\"DM Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "DM Sans",
       "fontStyle": "normal",
       "fontWeight": "100 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dm-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Chip",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "H3",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "H2",
     "size": "1.875rem",
     "fluid": {
      "min": "1.5rem",
      "max": "1.875rem"
     }
    },
    {
     "slug": "x-large",
     "name": "H2 on band",
     "size": "2.75rem",
     "fluid": {
      "min": "2rem",
      "max": "2.75rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "H1 hero",
     "size": "4.25rem",
     "fluid": {
      "min": "2.5rem",
      "max": "4.25rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "6.25rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": {
    "left": "20px",
    "right": "20px"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "800",
     "lineHeight": "1.05",
     "letterSpacing": "-0.02em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "letterSpacing": "-0.01em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--link)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--primary-deep)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "100px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.65rem",
      "bottom": "0.65rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--line)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
