{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#FFFFFF"
				},
				{
					"slug": "band",
					"name": "Pale sage band",
					"color": "#EDF0E6"
				},
				{
					"slug": "grey",
					"name": "Pale grey",
					"color": "#EEF1F2"
				},
				{
					"slug": "pine",
					"name": "Pine",
					"color": "#5C6B48"
				},
				{
					"slug": "pine-deep",
					"name": "Pine deep",
					"color": "#3F4A31"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#232820"
				},
				{
					"slug": "body",
					"name": "Body",
					"color": "#4A5145"
				},
				{
					"slug": "meta",
					"name": "Meta",
					"color": "#6B7266"
				},
				{
					"slug": "line",
					"name": "Hairline",
					"color": "#DADDD5"
				},
				{
					"slug": "frame",
					"name": "Frame",
					"color": "#E0E0E0"
				},
				{
					"slug": "dot",
					"name": "Dotted rule",
					"color": "#9AA190"
				},
				{
					"slug": "brick",
					"name": "Brick accent",
					"color": "#B5472F"
				},
				{
					"slug": "bark",
					"name": "Bark",
					"color": "#7B5A44"
				},
				{
					"slug": "ochre",
					"name": "Ochre",
					"color": "#8E6E2A"
				},
				{
					"slug": "rose",
					"name": "Clay rose",
					"color": "#A5586B"
				},
				{
					"slug": "teal",
					"name": "Slate teal",
					"color": "#3F7C85"
				},
				{
					"slug": "moss",
					"name": "Moss",
					"color": "#657A3E"
				},
				{
					"slug": "pale-text",
					"name": "Panel text",
					"color": "#EEF1E8"
				},
				{
					"slug": "pale-text-2",
					"name": "Panel eyebrow",
					"color": "#DDE3D3"
				}
			],
			"gradients": []
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Manrope)",
					"fontFamily": "\"Manrope\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-variable-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "s",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "m",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "l",
					"name": "Narrative",
					"size": "1.0625rem"
				},
				{
					"slug": "xl",
					"name": "H3",
					"size": "1.125rem"
				},
				{
					"slug": "2xl",
					"name": "Section head",
					"size": "1.75rem"
				},
				{
					"slug": "3xl",
					"name": "Statement",
					"size": "2.25rem"
				},
				{
					"slug": "4xl",
					"name": "Inner page title",
					"size": "3.375rem"
				},
				{
					"slug": "display",
					"name": "Hero headline",
					"size": "4.5rem"
				}
			]
		},
		"custom": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontWeight": "400",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--pine)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--pine-deep)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--pine)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.9375rem",
					"fontWeight": "700"
				},
				"border": {
					"radius": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--pine-deep)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			}
		}
	}
}