{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1142px", "wideSize": "1142px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ground", "name": "Willow ground", "color": "#DDE3D3" },
        { "slug": "paper", "name": "Paper", "color": "#FAF5EA" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "primary", "name": "Willow", "color": "#5F6849" },
        { "slug": "ink", "name": "Ink", "color": "#2D3324" },
        { "slug": "muted", "name": "Muted", "color": "#5A614D" },
        { "slug": "rind", "name": "Rind", "color": "#EBCB94" },
        { "slug": "mist", "name": "Mist", "color": "#E3E8DA" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Albert Sans)",
          "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Instrument Sans)",
          "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ] }
          ]
        }
        ,
        {
          "slug": "display-zh",
          "name": "Chinese subset, headings (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "Eyebrow", "size": "0.8125rem" },
        { "slug": "s", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Body", "size": "1rem" },
        { "slug": "m", "name": "Lead", "size": "1.125rem" },
        { "slug": "l", "name": "Label", "size": "1.25rem" },
        { "slug": "xl", "name": "Quote", "size": "1.75rem" },
        { "slug": "xxl", "name": "Heading 2", "size": "2.5rem" },
        { "slug": "hero", "name": "Hero", "size": "clamp(3rem, 5vw, 4.5rem)" },
        { "slug": "display", "name": "Display", "size": "4.5rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "12px" },
        { "slug": "20", "name": "S", "size": "24px" },
        { "slug": "30", "name": "M", "size": "49.6px" },
        { "slug": "40", "name": "L", "size": "120px" },
        { "slug": "50", "name": "XL", "size": "200px" }
      ]
    },
    "custom": { "radius": "24.8px", "pebble": "58% 42% 47% 53% / 52% 46% 54% 48%", "grid": "49.6px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.75" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "fontWeight": "600", "lineHeight": "1.0" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--l)" } }
    },
    "spacing": { "blockGap": "24px" },
    "blocks": {
      "core/button": { "border": { "radius": "24.8px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
