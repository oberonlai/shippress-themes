{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1260px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (cool white)", "color": "#F3F6F6" },
    { "slug": "white", "name": "White (cards)", "color": "#FFFFFF" },
    { "slug": "mist", "name": "Mist panel", "color": "#E6EDEE" },
    { "slug": "veil", "name": "Veil", "color": "#BFD0D6" },
    { "slug": "main", "name": "Main (aonibi)", "color": "#51686B" },
    { "slug": "main-deep", "name": "Main, deep", "color": "#3E5255" },
    { "slug": "ink", "name": "Ink (headings)", "color": "#1F2D30" },
    { "slug": "body", "name": "Body text", "color": "#4A5A5D" },
    { "slug": "meta", "name": "Meta (dates, captions)", "color": "#5F6F72" },
    { "slug": "line", "name": "Hairline", "color": "#C8D5D6" },
    { "slug": "accent", "name": "Accent (arrows)", "color": "#8A4940" },
    { "slug": "sheet-1", "name": "Sheet, back", "color": "#D5E0E2" },
    { "slug": "sheet-2", "name": "Sheet, middle", "color": "#E2EAEB" },
    { "slug": "sheet-3", "name": "Sheet, front", "color": "#EEF3F3" },
    { "slug": "on-main", "name": "Text on main", "color": "#DCE5E6" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Outfit)",
     "fontFamily": "\"Outfit\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Outfit", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/outfit-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "\"Figtree\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-500.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Meta (12px)", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small (14px)", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base (16px)", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Message text", "size": "1.0625rem", "fluid": false },
    { "slug": "large", "name": "Card title / fee", "size": "1.25rem", "fluid": false },
    { "slug": "x-large", "name": "Section head (28px)", "size": "1.75rem", "fluid": false },
    { "slug": "xx-large", "name": "Docked headline (54px)", "size": "clamp(2.25rem, 1.2rem + 2.9vw, 3.375rem)", "fluid": false },
    { "slug": "display", "name": "Hero headline (72px)", "size": "clamp(2.75rem, 1.2rem + 4.3vw, 4.5rem)", "fluid": false },
    { "slug": "giant", "name": "Giant section word (136px)", "size": "clamp(2.6rem, 1.9rem + 6.2vw, 8.5rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--body)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.8", "fontWeight": "400" },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.3", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.02", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "400" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "400", "lineHeight": "1.35" } },
   "h4": { "typography": { "fontSize": "1.0625rem", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
   "link": { "color": { "text": "var(--wp--preset--color--main)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--main)", "text": "var(--wp--preset--color--white)" },
    "border": { "radius": "999px" },
    "typography": { "fontSize": "0.9375rem", "fontWeight": "600", "letterSpacing": "0" },
    "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.75rem", "right": "1.75rem" } }
   }
  }
 }
}
