{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1024px",
   "wideSize": "1260px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F0F0F0"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1D1D1D"
    },
    {
     "slug": "navy",
     "name": "Navy (brand)",
     "color": "#3F5260"
    },
    {
     "slug": "brass",
     "name": "Brass",
     "color": "#8A7456"
    },
    {
     "slug": "brass-text",
     "name": "Brass, text",
     "color": "#77623F"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DDDDDD"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#8FA3AE"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#E4E8EB"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#5E6E79"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A3352B"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F5E46"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Mark",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "s",
     "name": "S",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "m",
     "name": "M",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "l",
     "name": "L",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "section",
     "name": "Section word",
     "size": "2.75rem",
     "fluid": false
    },
    {
     "slug": "count",
     "name": "Count",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Hero",
     "size": "4.5rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.08",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--section)",
     "lineHeight": "1.1"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--m)",
     "fontWeight": "500",
     "lineHeight": "1.3"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--s)",
     "fontWeight": "500"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "14px",
      "bottom": "14px",
      "left": "28px",
      "right": "28px"
     }
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}
