{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1296px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Base (page ground)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text, headings, back-to-top)", "color": "#14181D" },
    { "slug": "primary", "name": "Iron (buttons, placement bar)", "color": "#3A4654" },
    { "slug": "primary-dark", "name": "Iron dark (hover)", "color": "#2F3945" },
    { "slug": "slate", "name": "Slate (cohort strip, module band, ruler bars)", "color": "#4A5F69" },
    { "slug": "slate-2", "name": "Slate light (labels, meta, hangar-practice bar)", "color": "#476672" },
    { "slug": "wash", "name": "Pale wash", "color": "#E6ECEE" },
    { "slug": "grey", "name": "Quiet grey (footer, hairlines)", "color": "#E5E5E5" },
    { "slug": "accent", "name": "Signal red (chevrons, active menu, thread line)", "color": "#E31F26" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset, headings (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "label", "name": "Meta, pills", "size": "0.8125rem", "fluid": false },
    { "slug": "small", "name": "Small (nav, labels)", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.08rem", "fluid": false },
    { "slug": "medium", "name": "Medium (H3)", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "Large (H2)", "size": "2.025rem", "fluid": { "min": "1.625rem", "max": "2.025rem" } },
    { "slug": "x-large", "name": "Page title (H1)", "size": "2.375rem", "fluid": { "min": "1.875rem", "max": "2.375rem" } },
    { "slug": "stat", "name": "Facts numbers", "size": "2.75rem", "fluid": { "min": "2.125rem", "max": "2.75rem" } },
    { "slug": "display", "name": "Hero headline", "size": "clamp(2.75rem, 6.4vw, 5.5rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M (card gap)", "size": "2.25rem" },
    { "slug": "50", "name": "L", "size": "3.5rem" },
    { "slug": "60", "name": "Section", "size": "6.25rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.5"
  },
  "spacing": { "blockGap": "1.25rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.1" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500", "lineHeight": "1.25" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "600" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--slate)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "textDecoration": "none", "textTransform": "uppercase", "letterSpacing": "0.04em" },
    "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--grey)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
