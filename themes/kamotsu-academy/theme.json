{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (pale grey)",
     "color": "#F5F5F5"
    },
    {
     "slug": "paper",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#222222"
    },
    {
     "slug": "ink-deep",
     "name": "Ink deep (navy black)",
     "color": "#1A2130"
    },
    {
     "slug": "navy",
     "name": "Navy (pills, road)",
     "color": "#243044"
    },
    {
     "slug": "navy-hover",
     "name": "Navy hover",
     "color": "#33415A"
    },
    {
     "slug": "slate",
     "name": "Slate (meta text)",
     "color": "#5E6B80"
    },
    {
     "slug": "hivis",
     "name": "Hi-vis yellow (badge, highlighter)",
     "color": "#E8F52C"
    },
    {
     "slug": "silver",
     "name": "Silver (text on dark)",
     "color": "#B8BCBE"
    },
    {
     "slug": "footer",
     "name": "Footer black",
     "color": "#111111"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "italic",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Work Sans)",
     "fontFamily": "\"Work Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Work Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/work-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": ".75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": ".9375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Card title",
     "size": "1.5rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Section heading",
     "size": "2rem",
     "fluid": {
      "min": "1.625rem",
      "max": "2rem"
     }
    },
    {
     "slug": "huge",
     "name": "Huge",
     "size": "4.25rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.25rem"
     }
    },
    {
     "slug": "page-word",
     "name": "Page word",
     "size": "clamp(3rem, 11vw, 10rem)",
     "fluid": false
    },
    {
     "slug": "kv-1",
     "name": "KV line 1",
     "size": "clamp(3rem, 13.4vw, 12rem)",
     "fluid": false
    },
    {
     "slug": "kv-2",
     "name": "KV line 2",
     "size": "clamp(3.5rem, 15.3vw, 13.75rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(3.75rem, 7vw, 6.25rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "card",
     "name": "Docked card",
     "shadow": "0 4px 20px rgba(0, 0, 0, 0.12)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.75"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--navy-hover)"
     }
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.05"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.35"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "fontSize": "0.875rem"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "800",
     "fontSize": "1.25rem"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "fontSize": "0.9rem"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-bare",
   "title": "Page with its own head band",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}