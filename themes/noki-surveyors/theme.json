{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1100px",
   "wideSize": "1305px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#F5F6F7"
    },
    {
     "slug": "contrast",
     "name": "Ink",
     "color": "#2E2B31"
    },
    {
     "slug": "muted",
     "name": "Soft ink",
     "color": "#5A5660"
    },
    {
     "slug": "strip",
     "name": "Strip tint",
     "color": "#E7E9EC"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#9EA3A6"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "accent",
     "name": "Edo purple",
     "color": "#5E5166"
    },
    {
     "slug": "accent-dark",
     "name": "Edo purple dark",
     "color": "#4D4255"
    },
    {
     "slug": "on-dark",
     "name": "Text on ink",
     "color": "#D9D6DD"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Barlow)",
     "fontFamily": "\"Barlow\", \"IBM Plex Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Barlow",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/barlow-400-latin.woff2"
       ]
      },
      {
       "fontFamily": "Barlow",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/barlow-500-latin.woff2"
       ]
      },
      {
       "fontFamily": "Barlow",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/barlow-600-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (IBM Plex Sans)",
     "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "IBM Plex Sans",
       "fontStyle": "normal",
       "fontWeight": "400 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ibm-plex-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Legal, labels",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "Meta, card lines",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "Lede, narrative",
     "size": "1.0625rem"
    },
    {
     "slug": "xl",
     "name": "Card titles",
     "size": "1.375rem"
    },
    {
     "slug": "2xl",
     "name": "Band titles",
     "size": "2rem"
    },
    {
     "slug": "3xl",
     "name": "Section headline",
     "size": "2.625rem"
    },
    {
     "slug": "4xl",
     "name": "Inner page title",
     "size": "3.5rem"
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.5rem"
    }
   ]
  },
  "custom": {}
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.4",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "600"
    },
    "border": {
     "radius": "2px"
    },
    "spacing": {
     "padding": {
      "top": "0.9rem",
      "bottom": "0.9rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--accent-dark)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)"
    }
   }
  }
 }
}