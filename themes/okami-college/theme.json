{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1160px",
   "wideSize": "1340px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#282828"
    },
    {
     "slug": "navy",
     "name": "Navy (deep band)",
     "color": "#2A3850"
    },
    {
     "slug": "panel",
     "name": "Pale panel",
     "color": "#EEF2F6"
    },
    {
     "slug": "lilac",
     "name": "Lilac panel",
     "color": "#F4EFF7"
    },
    {
     "slug": "teal",
     "name": "Teal (strip)",
     "color": "#4FC3C8"
    },
    {
     "slug": "slate",
     "name": "Slate (strip)",
     "color": "#5C7988"
    },
    {
     "slug": "blue",
     "name": "Blue (rule)",
     "color": "#4A95CA"
    },
    {
     "slug": "violet",
     "name": "Violet (rule)",
     "color": "#6C6FA8"
    },
    {
     "slug": "tag",
     "name": "Tag yellow",
     "color": "#F2D21B"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5F6670"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DDDDDD"
    },
    {
     "slug": "grey",
     "name": "Tag grey",
     "color": "#F0F0F0"
    }
   ],
   "gradients": [
    {
     "slug": "strip",
     "name": "Caption strip",
     "gradient": "linear-gradient(90deg, #4FC3C8, #5C7988)"
    },
    {
     "slug": "rule",
     "name": "Pick-up rule",
     "gradient": "linear-gradient(90deg, #4A95CA, #6C6FA8)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Source Serif 4\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/fraunces-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Caption",
     "size": "2.75rem",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Figure (maximum 4.5rem)",
     "size": "4.5rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.5"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontSize": "1rem",
     "letterSpacing": "0.05em",
     "fontWeight": "400"
    },
    "spacing": {
     "padding": {
      "top": "0.875rem",
      "bottom": "0.875rem",
      "left": "2.5rem",
      "right": "2.5rem"
     }
    }
   }
  }
 }
}