{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper (cool white ground)",
          "color": "#F4F5F7"
        },
        {
          "slug": "white",
          "name": "White (cards, sheets, tables)",
          "color": "#FFFFFF"
        },
        {
          "slug": "mist",
          "name": "Mist (tinted panels)",
          "color": "#E4E8ED"
        },
        {
          "slug": "line",
          "name": "Line (hairlines and plan grid; decoration only)",
          "color": "#C3CAD3"
        },
        {
          "slug": "slate",
          "name": "Slate (headings, buttons, walls in the plans)",
          "color": "#3A4A5C"
        },
        {
          "slug": "deep",
          "name": "Deep slate (utility strip, footer)",
          "color": "#26313E"
        },
        {
          "slug": "ink",
          "name": "Ink (body text)",
          "color": "#1E2733"
        },
        {
          "slug": "muted",
          "name": "Muted (quiet text on paper and white)",
          "color": "#5A6675"
        },
        {
          "slug": "fog",
          "name": "Fog (quiet text on deep slate)",
          "color": "#A9B4C2"
        },
        {
          "slug": "brass",
          "name": "Brass (lines, markers; text only on deep slate)",
          "color": "#C6A15B"
        },
        {
          "slug": "brass-deep",
          "name": "Deep brass (small brass text on paper and white)",
          "color": "#7F5F22"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "slate-paper",
          "name": "Slate and paper",
          "colors": [
            "#26313E",
            "#F4F5F7"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Space Grotesk)",
          "fontFamily": "\"Space Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/space-grotesk-variable.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (IBM Plex Sans)",
          "fontFamily": "\"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "100 700",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/ibm-plex-sans-variable.woff2"
              ]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "italic",
              "fontWeight": "100 700",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/ibm-plex-sans-italic-variable.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3rem",
          "fluid": {
            "min": "2.125rem",
            "max": "3.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "4.5rem",
          "fluid": {
            "min": "2.625rem",
            "max": "5.25rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.5rem + 2vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.5rem + 4vw, 6.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(5rem, 3.5rem + 6vw, 9rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "ease": "cubic-bezier(.25, .8, .25, 1)",
      "hairline": "1px solid #C3CAD3",
      "wall": "1px solid #3A4A5C"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1rem, 4vw, 3rem)",
        "bottom": "0px",
        "left": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|slate"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|brass-deep"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|brass-deep"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|slate"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "500",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.04"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.12"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.2"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.3"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|slate",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|slate"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "right": "1.35rem",
            "bottom": "0.8rem",
            "left": "1.35rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "letterSpacing": "0.01em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|deep",
            "text": "var:preset|color|white"
          },
          "border": {
            "color": "var:preset|color|deep"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|deep",
            "text": "var:preset|color|white"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.25rem",
          "fontWeight": "600",
          "letterSpacing": "-0.01em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|slate"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "500",
          "lineHeight": "1.1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|slate"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|brass-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.6"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|muted"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0 0 0 1px",
          "color": "var:preset|color|brass",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400",
          "lineHeight": "1.4"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "1px 0",
          "color": "var:preset|color|slate",
          "style": "solid"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.25"
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "bottom": "0"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Page without title (the page holds its own heading)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
