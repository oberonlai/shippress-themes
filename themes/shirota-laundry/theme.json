{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "38rem",
   "wideSize": "1392px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#111111"
    },
    {
     "slug": "card",
     "name": "Card ground",
     "color": "#F6F4F4"
    },
    {
     "slug": "band",
     "name": "Soft band",
     "color": "#F0F0F0"
    },
    {
     "slug": "ghost",
     "name": "Ghost wordmark",
     "color": "#F3EFEF"
    },
    {
     "slug": "line",
     "name": "Weave line",
     "color": "#E5E1E1"
    },
    {
     "slug": "accent",
     "name": "Red mouse (accent)",
     "color": "#8A6A68"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B6463"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "ui",
     "name": "UI (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "serif-zh",
     "name": "Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "serif-ja",
     "name": "Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Eyebrow",
     "size": "0.6875rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Lead",
     "size": "1.375rem",
     "fluid": {
      "min": "1.125rem",
      "max": "1.375rem"
     }
    },
    {
     "slug": "x-large",
     "name": "H3 large",
     "size": "2rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "H1",
     "size": "4.5rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.5rem"
     }
    },
    {
     "slug": "lead",
     "name": "Statement",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "h2",
     "name": "H2",
     "size": "2.75rem",
     "fluid": {
      "min": "2rem",
      "max": "2.75rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "20",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "30",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "40",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "50",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "60",
     "size": "6.5rem"
    },
    {
     "slug": "70",
     "name": "70",
     "size": "10.9rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--display)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.6"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.2"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "400",
     "lineHeight": "1.05",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h2)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.5rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--ui)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "500"
    }
   }
  }
 }
}