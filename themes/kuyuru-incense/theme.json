{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "640px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "smoke",
          "name": "Wisteria smoke (ground)",
          "color": "#EDEAEE"
        },
        {
          "slug": "paper",
          "name": "Pale smoke (panels)",
          "color": "#F5F3F6"
        },
        {
          "slug": "mist",
          "name": "Mist (panels and rules)",
          "color": "#CFC8D2"
        },
        {
          "slug": "dusk",
          "name": "Dusk plum (quiet text)",
          "color": "#5F5664"
        },
        {
          "slug": "ink",
          "name": "Ink plum (text)",
          "color": "#3B3340"
        },
        {
          "slug": "night",
          "name": "Ink plum (dark bands)",
          "color": "#3B3340"
        },
        {
          "slug": "plum",
          "name": "Muted plum (small accents, active states)",
          "color": "#7A6483"
        },
        {
          "slug": "plum-deep",
          "name": "Deep plum (accent text and links)",
          "color": "#614D69"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Display (Hina Mincho)",
          "fontFamily": "\"Hina Mincho\", \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Hina Mincho",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hina-mincho-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Text (Red Hat Text)",
          "fontFamily": "\"Red Hat Text\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Red Hat Text",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/red-hat-text-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)"
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "clamp(1.125rem, 1.04rem + 0.36vw, 1.375rem)"
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.5rem, 1.22rem + 1.1vw, 2.125rem)"
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "clamp(2rem, 1.45rem + 2.3vw, 3.375rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.5rem, 1.5rem + 4.3vw, 5.25rem)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 6.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 9rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--ink) 14%, transparent)",
      "line-strong": "color-mix(in srgb, var(--wp--preset--color--ink) 36%, transparent)",
      "muted": "var(--wp--preset--color--dusk)",
      "on-dark": "#EDEAEE",
      "on-dark-muted": "#CFC8D2",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "panel": "#3B3340"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|smoke",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.8",
      "letterSpacing": "0.02em"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|plum-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1.18",
          "letterSpacing": "0.01em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.22",
          "letterSpacing": "0.01em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400",
          "letterSpacing": "0.01em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "400",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "400",
          "letterSpacing": "0"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|night",
          "text": "var:preset|color|paper"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "400",
          "letterSpacing": "0.12em"
        },
        "border": {
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          }
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:preset|color|dusk"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.25rem",
          "fontWeight": "400",
          "letterSpacing": "0.12em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|ink"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|ink"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:preset|color|dusk"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "textTransform": "uppercase",
          "letterSpacing": "0.14em"
        }
      },
      "core/quote": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400",
          "lineHeight": "1.45"
        },
        "border": {
          "left": {
            "color": "var:preset|color|plum",
            "width": "2px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line-strong"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full-width page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}