{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1040px", "wideSize": "1400px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "White (page, sheets, header)", "color": "#FFFFFF" },
    { "slug": "pale", "name": "Silver mist (bands, page heads)", "color": "#EBEDEF" },
    { "slug": "primary", "name": "Graphite slate (tile, discs, booking band)", "color": "#3F5A66" },
    { "slug": "deep", "name": "Deep slate (text, menu tab)", "color": "#3B4A5C" },
    { "slug": "muted", "name": "Muted (eyebrows, meta)", "color": "#5F6B75" },
    { "slug": "silver", "name": "Silver (numerals, copyright)", "color": "#9A9C9F" },
    { "slug": "line", "name": "Hairline", "color": "#DDE2E5" },
    { "slug": "ink", "name": "Ink (photo overlays)", "color": "#12171B" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Onest)",
     "fontFamily": "\"Onest\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Onest", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "xs", "name": "XS (captions)", "size": "0.6875rem" },
    { "slug": "s", "name": "S (labels)", "size": "0.8125rem" },
    { "slug": "m", "name": "M (body)", "size": "1rem" },
    { "slug": "medium", "name": "Medium (titles)", "size": "1.375rem" },
    { "slug": "large", "name": "Large (section titles)", "size": "2.25rem" },
    { "slug": "x-large", "name": "X-large", "size": "3rem" },
    { "slug": "xx-large", "name": "XX-large (hero)", "size": "4.5rem" }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "S", "size": "1rem" },
    { "slug": "30", "name": "M", "size": "2.5rem" },
    { "slug": "40", "name": "L", "size": "5rem" },
    { "slug": "50", "name": "Section", "size": "7rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--deep)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--deep)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.2" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--primary)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--deep)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
    "border": { "radius": "999px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "0.9375rem", "letterSpacing": "0.04em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "500", "lineHeight": "1.15", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "300", "lineHeight": "1.2" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500", "lineHeight": "1.4" } }
  }
 },
 "customTemplates": [
  { "name": "page-ghost", "title": "Page with ghost word", "postTypes": ["page"] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
