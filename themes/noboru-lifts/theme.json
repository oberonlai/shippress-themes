{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper",
     "color": "#F9F9F9"
    },
    {
     "slug": "band",
     "name": "Band",
     "color": "#E4E4E4"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#3E3A39"
    },
    {
     "slug": "slate",
     "name": "Slate",
     "color": "#626E78"
    },
    {
     "slug": "accent-a",
     "name": "Accent teal",
     "color": "#1B7A74"
    },
    {
     "slug": "accent-b",
     "name": "Accent blue",
     "color": "#1A5F86"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": [
    {
     "slug": "cta",
     "name": "Call to action",
     "gradient": "linear-gradient(45deg, #1B7A74, #1A5F86)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"Instrument Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Instrument Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.9375rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.125rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "X-Large",
     "size": "3.5rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "5.25rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "fontWeight": "500"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "clamp(2.75rem, 5vw, 4.25rem)",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.5"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "border": {
     "radius": "0"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}