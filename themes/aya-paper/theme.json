{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1360px"
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "gradients": [],
   "palette": [
    {
     "slug": "paper",
     "name": "Ground",
     "color": "#F4F4F1"
    },
    {
     "slug": "white",
     "name": "Band (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0D0E0B"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#CFCFCB"
    },
    {
     "slug": "chip",
     "name": "Chip",
     "color": "#DFE0DA"
    },
    {
     "slug": "muted",
     "name": "Muted sage (meta text)",
     "color": "#5E6254"
    },
    {
     "slug": "sage",
     "name": "Sage (rikyu-nezumi)",
     "color": "#888C7B"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-500.woff2"
       ]
      }
     ]
    },
    {
     "slug": "mono",
     "name": "Mono (system)",
     "fontFamily": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
    }
   ],
   "fontSizes": [
    {
     "slug": "tiny",
     "name": "Tiny (mono, chips)",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small (meta)",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.75rem"
    },
    {
     "slug": "large",
     "name": "Heading",
     "size": "2.25rem"
    },
    {
     "slug": "x-large",
     "name": "Wordmark",
     "size": "4.5rem"
    },
    {
     "slug": "xx-large",
     "name": "Figure / page title",
     "size": "5rem"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.125rem",
   "lineHeight": "1.7",
   "fontWeight": "400",
   "letterSpacing": "0.01em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.3",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "textTransform": "uppercase"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.25rem"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.8125rem",
     "fontWeight": "600",
     "fontFamily": "var(--wp--preset--font-family--display)"
    },
    "spacing": {
     "padding": {
      "top": "12px",
      "bottom": "12px",
      "left": "20px",
      "right": "20px"
     }
    }
   }
  },
  "blocks": {}
 }
}