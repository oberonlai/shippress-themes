{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Pale bamboo paper (ground)",
					"color": "#F3F8F4"
				},
				{
					"slug": "wakatake",
					"name": "Wakatake young bamboo (main colour, large fields)",
					"color": "#68BE8D"
				},
				{
					"slug": "mint",
					"name": "Pale bamboo (soft panels)",
					"color": "#D3EEDD"
				},
				{
					"slug": "ink",
					"name": "Sumi ink (text, panel borders, dark bands)",
					"color": "#10231A"
				},
				{
					"slug": "deep",
					"name": "Deep bamboo (links on paper)",
					"color": "#24653F"
				},
				{
					"slug": "quiet",
					"name": "Moss grey (secondary text)",
					"color": "#4A5D52"
				},
				{
					"slug": "sprout",
					"name": "Sprout (labels on ink)",
					"color": "#A8DDBC"
				},
				{
					"slug": "beni",
					"name": "Seal red (stamps and small marks)",
					"color": "#C8372D"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Zen Old Mincho)",
					"fontFamily": "\"Zen Old Mincho\", \"Hiragino Mincho ProN\", \"Yu Mincho\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Zen Old Mincho",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/zen-old-mincho-regular-latin.woff2"
							]
						},
						{
							"fontFamily": "Zen Old Mincho",
							"fontStyle": "normal",
							"fontWeight": "900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/zen-old-mincho-black-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese kanji and kana subset (Zen Old Mincho CJK)",
					"fontFamily": "\"Zen Old Mincho CJK\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Zen Old Mincho CJK",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/zen-old-mincho-regular-cjk.woff2"
							]
						},
						{
							"fontFamily": "Zen Old Mincho CJK",
							"fontStyle": "normal",
							"fontWeight": "900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/zen-old-mincho-black-cjk.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (LXGW WenKai TC)",
					"fontFamily": "\"LXGW WenKai TC\", \"PingFang TC\", \"Noto Serif TC\", serif",
					"fontFace": [
						{
							"fontFamily": "LXGW WenKai TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lxgw-wenkai-tc-zh-tw-400.woff2"
							]
						},
						{
							"fontFamily": "LXGW WenKai TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lxgw-wenkai-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Golos Text)",
					"fontFamily": "\"Golos Text\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Golos Text",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/golos-text-variable-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
			"lineHeight": "1.75",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4.5vw, 3.5rem)",
				"right": "clamp(1.25rem, 4.5vw, 3.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontSize": "0.9375rem",
					"letterSpacing": "0.04em",
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (paper bar: studio name, Request a commission button; the menu runs down a sumi side rail on wide screens)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (sumi field: studio name in poster type, synced studio details and the menu)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
