{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "mist",
          "name": "Mist mint (ground)",
          "color": "#E6F2EF"
        },
        {
          "slug": "paper",
          "name": "Paper (cards and bands)",
          "color": "#FAFCFB"
        },
        {
          "slug": "line",
          "name": "Sea line (hairlines, contours)",
          "color": "#B7D3CD"
        },
        {
          "slug": "quiet",
          "name": "Quiet teal-grey (small text)",
          "color": "#476462"
        },
        {
          "slug": "teal",
          "name": "Teal (headings, route line)",
          "color": "#1C7C7D"
        },
        {
          "slug": "teal-deep",
          "name": "Deep teal (links, buttons, dark bands)",
          "color": "#155E5F"
        },
        {
          "slug": "amber",
          "name": "Amber (stamps and route dots only)",
          "color": "#F2A541"
        },
        {
          "slug": "ink",
          "name": "Ink (body text)",
          "color": "#16302F"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Klee One)",
          "fontFamily": "\"Klee One\", \"Hiragino Mincho ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Klee One",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/klee-one-regular-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD, U+00A5"
            },
            {
              "fontFamily": "Klee One",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/klee-one-semibold-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD, U+00A5"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Noto Sans)",
          "fontFamily": "\"Noto Sans\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Noto Sans",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD, U+00A5"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 5vw, 8.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6rem, 4rem + 7vw, 11rem)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "line": "var(--wp--preset--color--line)",
      "ease": "cubic-bezier(.33, .1, .25, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|mist",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|teal-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.3",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var:preset|color|teal-deep"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.625rem, 1.3rem + 1.3vw, 2.375rem)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem)"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|teal-deep",
          "text": "var:preset|color|paper"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "letterSpacing": "0.04em"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "color": {
          "text": "var:preset|color|quiet"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "clamp(1.375rem, 1.25rem + 0.5vw, 1.75rem)",
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|teal-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|teal-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var:preset|color|quiet"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|line"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem)",
          "lineHeight": "1.35"
        },
        "border": {
          "left": {
            "width": "0px"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-sections",
      "title": "Page with its own heading (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
