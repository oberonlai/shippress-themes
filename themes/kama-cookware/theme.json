{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": { "contentSize": "720px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "palette": [
    { "slug": "ground", "color": "#E8ECEB", "name": "Ground" },
    { "slug": "surface", "color": "#F4F6F5", "name": "Surface" },
    { "slug": "ink", "color": "#1B2323", "name": "Ink" },
    { "slug": "dark", "color": "#141B1B", "name": "Dark band" },
    { "slug": "slate", "color": "#5F6E6E", "name": "Slate" },
    { "slug": "rust", "color": "#8A4B2E", "name": "Seasoned iron" }
   ]
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "caption", "size": "0.6875rem", "name": "Caption" },
    { "slug": "small", "size": "0.8125rem", "name": "Small" },
    { "slug": "base", "size": "1rem", "name": "Base" },
    { "slug": "medium", "size": "1.25rem", "name": "Medium" },
    { "slug": "h3", "size": "1.7rem", "name": "Heading 3" },
    { "slug": "hero", "size": "4.25rem", "name": "Hero" },
    { "slug": "question", "size": "4.5rem", "name": "Question" },
    { "slug": "section", "size": "5.75rem", "name": "Section" },
    { "slug": "wordmark", "size": "9rem", "name": "Wordmark" }
   ]
  },
  "spacing": {
   "units": ["px", "rem", "%", "vw", "vh"],
   "spacingSizes": [
    { "slug": "30", "size": "1rem", "name": "S" },
    { "slug": "40", "size": "2rem", "name": "M" },
    { "slug": "50", "size": "5rem", "name": "L" },
    { "slug": "60", "size": "10rem", "name": "XL" }
   ]
  },
  "border": { "radius": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.8" },
  "spacing": { "blockGap": "1.25rem" },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "lineHeight": "1.45" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } }
  },
  "blocks": {
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.8125rem", "letterSpacing": "0.15em" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
