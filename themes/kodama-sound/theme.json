{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "deep",
					"name": "Deep",
					"color": "#231A2C"
				},
				{
					"slug": "pale",
					"name": "Pale",
					"color": "#F1E8F3"
				},
				{
					"slug": "mauve",
					"name": "Mauve",
					"color": "#95859C"
				},
				{
					"slug": "tint",
					"name": "Tint",
					"color": "#E8DCEB"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#17141A"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F4F1F5"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#D9D2DC"
				},
				{
					"slug": "mauve-ink",
					"name": "Mauve ink",
					"color": "#5E5266"
				},
				{
					"slug": "point",
					"name": "Point",
					"color": "#C9A9C0"
				},
				{
					"slug": "tab",
					"name": "Tab",
					"color": "#2F2338"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Instrument Sans",
					"fontFamily": "\"Instrument Sans\", \"Figtree\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "\"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Tiny",
					"size": "0.6875rem"
				},
				{
					"slug": "label",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "nav",
					"name": "Nav",
					"size": "0.8125rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "1.25rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.75rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2.5rem"
				},
				{
					"slug": "x-large",
					"name": "X-large",
					"size": "3.75rem"
				},
				{
					"slug": "xx-large",
					"name": "XX-large",
					"size": "4.25rem"
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "4.5rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw"
			]
		},
		"border": {
			"radius": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--deep)",
			"text": "var(--wp--preset--color--paper)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.9"
		},
		"spacing": {
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"lineHeight": "1.08",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--paper)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "0"
				}
			}
		}
	}
}
