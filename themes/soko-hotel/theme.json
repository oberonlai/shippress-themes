{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1260px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "stage", "name": "Stage (warm black)", "color": "#0E0B08" },
				{ "slug": "paper", "name": "Paper", "color": "#FAFAF8" },
				{ "slug": "ink", "name": "Ink", "color": "#333333" },
				{ "slug": "ink-soft", "name": "Ink soft", "color": "#666666" },
				{ "slug": "mist", "name": "Mist", "color": "#B2B2B2" },
				{ "slug": "ivory", "name": "Ivory", "color": "#F2EEE6" },
				{ "slug": "umber", "name": "Umber", "color": "#8C7042" },
				{ "slug": "line", "name": "Line", "color": "#D9D6CF" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "gloock",
					"name": "Headings (Gloock)",
					"fontFamily": "\"Gloock\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Gloock",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/gloock-regular-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "source-sans-3",
					"name": "Body (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-serif-tc",
					"name": "Noto Serif TC (zh-TW)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "noto-serif-jp",
					"name": "Noto Serif JP (ja)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Label", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "body", "name": "Body", "size": "1rem" },
				{ "slug": "medium", "name": "Room name", "size": "1.5rem" },
				{ "slug": "large", "name": "Essay title", "size": "2.5rem" },
				{ "slug": "x-large", "name": "Heading", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Page title", "size": "3.5rem" },
				{ "slug": "display", "name": "Display (H1)", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "2.5rem" },
				{ "slug": "50", "name": "XL", "size": "6rem" },
				{ "slug": "60", "name": "XXL", "size": "10rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "300",
			"lineHeight": "2",
			"letterSpacing": "0.035em"
		},
		"spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--gloock)", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--umber)" } }
			},
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--source-sans-3)", "fontWeight": "400", "fontSize": "0.8125rem", "letterSpacing": "0.1em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.08" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.3" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
