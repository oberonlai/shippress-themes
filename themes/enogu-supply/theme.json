{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "670px",
   "wideSize": "950px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "base",
     "name": "Base",
     "color": "#FFFFFF"
    },
    {
     "slug": "contrast",
     "name": "Ink",
     "color": "#333333"
    },
    {
     "slug": "tile",
     "name": "Tile grey",
     "color": "#F6F6F6"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DDDDDD"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#767676"
    },
    {
     "slug": "accent-line",
     "name": "Hairline orange",
     "color": "#FF5800"
    },
    {
     "slug": "slate",
     "name": "Slate",
     "color": "#5E7380"
    },
    {
     "slug": "slate-dark",
     "name": "Slate dark",
     "color": "#4C5E69"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "manrope",
     "name": "Headings (Manrope)",
     "fontFamily": "\"Manrope\", \"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "public-sans",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "S",
     "size": "0.8125rem"
    },
    {
     "slug": "m",
     "name": "M",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "L",
     "size": "1.25rem"
    },
    {
     "slug": "xl",
     "name": "XL",
     "size": "1.75rem"
    },
    {
     "slug": "2xl",
     "name": "2XL",
     "size": "2.25rem"
    },
    {
     "slug": "3xl",
     "name": "3XL",
     "size": "3.25rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "3rem"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "6rem"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "8rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--public-sans)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--slate)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--slate-dark)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--manrope)",
     "fontWeight": "400",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--3xl)",
     "fontWeight": "300",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)",
     "letterSpacing": "0.05em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--l)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--slate)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--public-sans)",
     "fontSize": "var(--wp--preset--font-size--s)",
     "fontWeight": "500",
     "letterSpacing": "0.04em"
    },
    "spacing": {
     "padding": {
      "top": "0.5rem",
      "bottom": "0.5rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--slate-dark)",
      "text": "var(--wp--preset--color--base)"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "variations": {}
   }
  }
 }
}