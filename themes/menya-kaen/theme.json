{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "yellow",
          "name": "Yellow (ground)",
          "color": "#FFD400"
        },
        {
          "slug": "ink",
          "name": "Ink (text, bars, the machine)",
          "color": "#1A1A1A"
        },
        {
          "slug": "red",
          "name": "Red (buttons, big type, bands)",
          "color": "#D7261E"
        },
        {
          "slug": "red-deep",
          "name": "Deep red (small red text and links on yellow)",
          "color": "#A3140E"
        },
        {
          "slug": "white",
          "name": "White (ticket faces, cards, text on red)",
          "color": "#FFFFFF"
        },
        {
          "slug": "smoke",
          "name": "Smoke (quiet text on yellow and white)",
          "color": "#4A4436"
        },
        {
          "slug": "ash",
          "name": "Ash (quiet text on ink)",
          "color": "#B8B2A0"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "ink-yellow",
          "name": "Ink and yellow",
          "colors": [
            "#1A1A1A",
            "#FFD400"
          ]
        },
        {
          "slug": "ink-red",
          "name": "Ink and red",
          "colors": [
            "#1A1A1A",
            "#D7261E"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Anton)",
          "fontFamily": "Anton, Impact, \"Arial Narrow Bold\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Anton",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/anton-regular.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Lato)",
          "fontFamily": "Lato, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Lato",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lato-regular.woff2"
              ]
            },
            {
              "fontFamily": "Lato",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lato-italic.woff2"
              ]
            },
            {
              "fontFamily": "Lato",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lato-bold.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.125rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.1875rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "4.5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "9rem",
          "fluid": {
            "min": "4rem",
            "max": "11rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 5vw, 8rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6rem, 4rem + 7vw, 11rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "line": "#1A1A1A",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "press": "6px",
      "radius": {
        "key": "10px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|yellow",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|red-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "0.95",
          "letterSpacing": "0.005em",
          "textTransform": "uppercase"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "0.86"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "0.9"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.1"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.2"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "700",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|red",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "8px",
          "width": "3px",
          "style": "solid",
          "color": "var:preset|color|ink"
        },
        "shadow": "0 var(--wp--custom--press) 0 0 var(--wp--preset--color--ink)",
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.4rem",
            "bottom": "0.8rem",
            "left": "1.4rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.125rem",
          "fontWeight": "400",
          "letterSpacing": "0.04em",
          "lineHeight": "1.1",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|yellow"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|yellow"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|smoke"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.5rem",
          "fontWeight": "400",
          "letterSpacing": "0.02em",
          "lineHeight": "1",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|yellow"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "700",
          "letterSpacing": "0.08em",
          "lineHeight": "1.2",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "0.95"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|smoke"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "700",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "700",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|red-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|smoke"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.55"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|smoke"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0 0 0 6px",
          "color": "var:preset|color|red",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.05",
          "textTransform": "uppercase"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "400",
          "lineHeight": "0.95",
          "textTransform": "uppercase"
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "bottom": "0"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Page without title (the page holds its own heading)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
