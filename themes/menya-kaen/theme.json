{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "sumi",
          "name": "Sumi (text, the footer)",
          "color": "#1E1B18"
        },
        {
          "slug": "washi",
          "name": "Washi (ground)",
          "color": "#F3EEE5"
        },
        {
          "slug": "paper",
          "name": "Paper (the menu card)",
          "color": "#FAF7F1"
        },
        {
          "slug": "linen",
          "name": "Linen (the noren)",
          "color": "#E6DCCB"
        },
        {
          "slug": "wood",
          "name": "Dark wood (the noren rod, quiet panels)",
          "color": "#4A3426"
        },
        {
          "slug": "vermilion",
          "name": "Vermilion (the seal, small marks, small accent text)",
          "color": "#A63A24"
        },
        {
          "slug": "stone",
          "name": "Stone (quiet text on washi and paper)",
          "color": "#6B635B"
        },
        {
          "slug": "ash",
          "name": "Ash (hairlines and rules only; not for text)",
          "color": "#8A8178"
        },
        {
          "slug": "mist",
          "name": "Mist (quiet text on sumi)",
          "color": "#B5ACA2"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "sumi-washi",
          "name": "Sumi and washi",
          "colors": [
            "#1E1B18",
            "#F3EEE5"
          ]
        },
        {
          "slug": "wood-linen",
          "name": "Dark wood and linen",
          "colors": [
            "#4A3426",
            "#E6DCCB"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Shippori Mincho B1)",
          "fontFamily": "\"Shippori Mincho B1\", \"Hiragino Mincho ProN\", \"Yu Mincho\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Shippori Mincho B1",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-mincho-b1-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Shippori Mincho B1",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-mincho-b1-medium-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Zen Kaku Gothic New)",
          "fontFamily": "\"Zen Kaku Gothic New\", \"Hiragino Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Kaku Gothic New",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-kaku-gothic-new-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Zen Kaku Gothic New",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-kaku-gothic-new-medium-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "clamp(1.125rem, 1.04rem + 0.4vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)",
          "fluid": false
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.25rem, 1.6rem + 2.8vw, 4rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(3rem, 2.2rem + 3vw, 5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 4.5vw, 7.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6.5rem, 4.5rem + 8vw, 12rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "ease": "cubic-bezier(.25, .6, .2, 1)",
      "rail": "4.75rem",
      "hair": "1px solid rgba(30, 27, 24, 0.16)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|washi",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.9",
      "letterSpacing": "0.02em"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|vermilion"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|vermilion"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "500",
          "lineHeight": "1.35",
          "letterSpacing": "0.03em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1.25"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.3"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.4"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.5"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.6"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.24em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "transparent",
          "text": "var:preset|color|sumi"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|sumi"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.75rem",
            "bottom": "0.95rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.8125rem",
          "fontWeight": "500",
          "letterSpacing": "0.2em",
          "lineHeight": "1.2",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.7",
          "letterSpacing": "0.08em"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem)",
          "fontWeight": "500",
          "letterSpacing": "0.32em",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "letterSpacing": "0.24em",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "500",
          "lineHeight": "1.35"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|vermilion"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.85"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|stone"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|ash"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0 0 0 1px",
          "color": "var:preset|color|vermilion",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400",
          "lineHeight": "1.8"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.6"
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "bottom": "0"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Page without title (the page holds its own heading)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
