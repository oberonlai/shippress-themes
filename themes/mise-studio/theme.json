{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "948px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (page)", "color": "#F5F3F5" },
    { "slug": "base", "name": "Base (sheets, header)", "color": "#FFFFFF" },
    { "slug": "panel", "name": "Panel (hero panel, strips)", "color": "#F0EEF0" },
    { "slug": "ink", "name": "Ink (text, headings)", "color": "#4B474A" },
    { "slug": "muted", "name": "Muted (eyebrow, units, dates)", "color": "#6E6A6F" },
    { "slug": "bar", "name": "Bar (accordion bars)", "color": "#8A868B" },
    { "slug": "border", "name": "Border (sheets, rows)", "color": "#E6E4E6" },
    { "slug": "rule", "name": "Rule (title rules, page-top)", "color": "#CCCACC" },
    { "slug": "plum", "name": "Plum (pill, rings, dots, links)", "color": "#6A5A66" },
    { "slug": "plum-deep", "name": "Plum deep (hover)", "color": "#574A54" },
    { "slug": "error", "name": "Error (forms)", "color": "#A23B3B" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Libre Franklin)",
     "fontFamily": "\"Libre Franklin\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Libre Franklin", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/libre-franklin-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset, headings (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-500.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Labels, captions", "size": "0.8125rem", "fluid": false },
    { "slug": "small", "name": "Small (dates, notes)", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "lead", "name": "Lead (narrative)", "size": "1.0625rem", "fluid": false },
    { "slug": "bar", "name": "Accordion bar", "size": "1.1875rem", "fluid": false },
    { "slug": "h3", "name": "H3, prices", "size": "1.25rem", "fluid": false },
    { "slug": "medium", "name": "Sheet titles, cell names", "size": "1.375rem", "fluid": false },
    { "slug": "medium-large", "name": "Section title (ring H2)", "size": "1.75rem", "fluid": false },
    { "slug": "large", "name": "Band caption", "size": "2rem", "fluid": false },
    { "slug": "x-large", "name": "Page title (H1)", "size": "2.5rem", "fluid": false },
    { "slug": "xx-large", "name": "Hero headline", "size": "4.5rem", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S (between sheets)", "size": "1.875rem" },
    { "slug": "40", "name": "M", "size": "2.5rem" },
    { "slug": "50", "name": "L (section, sheet padding)", "size": "3.3125rem" },
    { "slug": "60", "name": "XL", "size": "5rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.7"
  },
  "spacing": { "blockGap": "1.25rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.4" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.3" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--medium-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "600" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "600" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--plum)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--plum-deep)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--plum)", "text": "#FFFFFF" },
    "border": { "radius": "999px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.9375rem", "fontWeight": "600", "textDecoration": "none" },
    "spacing": { "padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1.375rem", "right": "1.375rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "999px" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--rule)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
