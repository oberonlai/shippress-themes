{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (nav pill, form surface)",
     "color": "#FFFFFF"
    },
    {
     "slug": "strip",
     "name": "Strip (title strip, start band)",
     "color": "#E9E6EB"
    },
    {
     "slug": "stage",
     "name": "Stage (main ground)",
     "color": "#F6F6F7"
    },
    {
     "slug": "paper",
     "name": "Paper (alternate ground)",
     "color": "#FBFBFC"
    },
    {
     "slug": "ink",
     "name": "Ink (text, buttons)",
     "color": "#2A3141"
    },
    {
     "slug": "body",
     "name": "Body grey",
     "color": "#5F6068"
    },
    {
     "slug": "accent",
     "name": "Accent (hairlines, focus; never text on light)",
     "color": "#A89DAC"
    },
    {
     "slug": "accent-on-dark",
     "name": "Accent on dark",
     "color": "#C9C0CD"
    },
    {
     "slug": "dark",
     "name": "Dark (statement band, footer)",
     "color": "#202835"
    },
    {
     "slug": "on-dark-muted",
     "name": "Muted on dark",
     "color": "#B7B9C3"
    },
    {
     "slug": "rule",
     "name": "Form border",
     "color": "#CFCBD3"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "300 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (IBM Plex Sans)",
     "fontFamily": "\"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "IBM Plex Sans",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ibm-plex-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "micro",
     "name": "Micro",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "label",
     "name": "Label",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "3rem"
    },
    {
     "slug": "xx-large",
     "name": "Home title",
     "size": "clamp(2.5rem, 5.2vw, 4.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "6rem"
    },
    {
     "slug": "60",
     "name": "XXL",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--stage)",
   "text": "var(--wp--preset--color--body)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "fontWeight": "400",
   "lineHeight": "2.0",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.15",
     "letterSpacing": "0.02em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--body)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "500",
     "fontSize": "var(--wp--preset--font-size--micro)",
     "letterSpacing": "0.1em",
     "textTransform": "uppercase"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.08"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--label)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.5"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Page, title strip in content",
   "postTypes": ["page"]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}