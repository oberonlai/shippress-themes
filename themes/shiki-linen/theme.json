{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Flax band",
     "color": "#F7F4EC"
    },
    {
     "slug": "ink",
     "name": "Ink (text, button)",
     "color": "#0D0E0B"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5C5F57"
    },
    {
     "slug": "moss",
     "name": "Moss (stitch, tags)",
     "color": "#5F6B4E"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#E4E2DA"
    },
    {
     "slug": "flax",
     "name": "Flax (swatch tone)",
     "color": "#C9BFA9"
    },
    {
     "slug": "slate",
     "name": "Slate (swatch tone)",
     "color": "#6F7B80"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Manrope)",
     "fontFamily": "\"Manrope\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "tiny",
     "name": "Tiny (tags, captions)",
     "size": "0.6875rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small (button)",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base (body)",
     "size": "0.9375rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium (statement)",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large (section head)",
     "size": "1.75rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "2.5rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "XX large (page head)",
     "size": "4.25rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "10",
     "name": "S",
     "size": "14px"
    },
    {
     "slug": "20",
     "name": "M",
     "size": "29px"
    },
    {
     "slug": "30",
     "name": "L",
     "size": "72px"
    },
    {
     "slug": "40",
     "name": "XL",
     "size": "140px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "200",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "fontWeight": "400"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--moss)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "400",
     "letterSpacing": "0.05em",
     "textDecoration": "none"
    },
    "spacing": {
     "padding": {
      "top": "8px",
      "bottom": "8px",
      "left": "20px",
      "right": "20px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--moss)",
      "text": "var(--wp--preset--color--paper)"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "0.97rem",
     "fontWeight": "400"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
