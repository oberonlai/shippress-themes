{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "645px", "wideSize": "1290px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text)", "color": "#383736" },
    { "slug": "panel", "name": "Pale panel", "color": "#F4F4F4" },
    { "slug": "line", "name": "Hairline", "color": "#DDDDDD" },
    { "slug": "accent", "name": "Dusty rose-grey (small accents)", "color": "#8A7070" },
    { "slug": "accent-dark", "name": "Accent hover", "color": "#7D6565" },
    { "slug": "muted", "name": "Muted text", "color": "#6B6A68" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Literata)",
     "fontFamily": "\"Literata\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "400 600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-variable-latin.woff2" ] },
      { "fontFamily": "Literata", "fontStyle": "italic", "fontWeight": "400 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-italic-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": false },
    { "slug": "x-large", "name": "Heading", "size": "clamp(1.75rem, 2.4vw, 2.25rem)", "fluid": false },
    { "slug": "xx-large", "name": "Page title", "size": "clamp(2.25rem, 3.6vw, 3rem)", "fluid": false },
    { "slug": "huge", "name": "Hero (maximum 4.25rem)", "size": "clamp(2.5rem, 4.4vw, 4.25rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.9", "fontWeight": "400", "letterSpacing": "0.01em" },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.65", "letterSpacing": "0.04em" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.6", "letterSpacing": "0.06em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "1.1875rem", "fontWeight": "500", "lineHeight": "1.4", "letterSpacing": "0.02em" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "#FFFFFF" },
    "border": { "radius": "7.5px" },
    "typography": { "fontSize": "0.9375rem", "letterSpacing": "0.04em", "fontWeight": "500" },
    "spacing": { "padding": { "top": "18.75px", "bottom": "18.75px", "left": "37.5px", "right": "37.5px" } }
   }
  }
 }
}
