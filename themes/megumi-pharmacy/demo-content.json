   "title": "Vaccinations & travel",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p04-flu.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacist gives a flu shot into a young man’s upper arm in a bright consultation room.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p04-flu.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Vaccinations &amp; travel</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">Vaccinations,<br>talked through first.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">Flu vaccination $25.00. Travel health consultation $45.00, vaccines at cost.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Ana Kovač</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Given in the consultation room.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>From 1 October, Ana Kovač gives flu vaccinations in the consultation room. Book at the counter or by phone on (416) 555-0148. Please tell us about any allergies and the medicines you take when you book. A pharmacist talks you through the vaccination before it is given.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A travel health consultation takes 30 minutes and costs $45.00. Travel vaccines are charged at cost in addition to the consultation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"mp-fees\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fees\"><!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Flu vaccination</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">In the consultation room</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$25.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Travel health consultation</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">30 minutes; vaccines at cost</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$45.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "people",
   "title": "People",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p01-counter.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacist in a stone coat speaks with a customer across a pale oak counter.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p01-counter.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">People</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">Six people,<br>one counter.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">The same faces are at the counter each week.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-people__grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-people__grid\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full mp-people__photo\"><img src=\"/wp-content/themes/megumi-pharmacy/assets/images/p05-megumi.webp\" alt=\"Portrait of pharmacist Megumi Ward in front of oak dispensary drawers.\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"className\":\"mp-people__text\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-people__text\"><!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Megumi Ward</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Founder & pharmacist</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Megumi Ward opened the pharmacy in 2006 and still works at the counter. She explains a new medicine by name before it is handed over.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Daniel Osei</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Pharmacist manager</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Daniel Osei looks after inhalers and new medicines. He shows inhaler technique at the counter, including how to use a spacer.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Leila Haddad</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Pharmacist, medicine reviews</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Leila Haddad leads medicine reviews in the consultation room. She sits with the medicines a person actually takes and turns them into one list.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Ana Kovač</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Pharmacist, vaccinations & travel</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Ana Kovač gives flu vaccinations and travel health consultations in the consultation room. Travel vaccines are charged at cost in addition to the consultation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Samuel Brandt</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Pharmacy technician</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Samuel Brandt prepares prescriptions in the dispensary and checks the printed label against the box. He also makes up the weekly blister packs.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-bio\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-bio\"><!-- wp:paragraph {\"className\":\"mp-pname\"} -->\n<p class=\"mp-pname\">Grace Liu</p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"mp-prole\"} -->\n<p class=\"mp-prole\">Pharmacy assistant</p>\n<!-- /wp:paragraph --><!-- wp:paragraph -->\n<p>Grace Liu works the front counter and hands finished prescriptions across. She also looks after home deliveries within 3 km.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "about",
   "title": "About",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p09-shopfront.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacy shopfront on a high street in early morning with a bench and a bicycle.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p09-shopfront.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">About</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">An independent pharmacy<br>since 2006.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">1184 Queen Street East, Toronto, near the streetcar stop.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Story</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">One practical thing at a time.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Megumi Ward opened Megumi Pharmacy in 2006 at 1184 Queen Street East, Toronto, ON M4M 1L4. It is an independent community pharmacy with a small counter shop, and the address has not changed. Medicines are explained in person at the counter.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The shop added one practical thing at a time. In 2011 a consultation room was opened so a medicine review or a vaccination could take place off the main counter. In 2015 the weekly blister-pack service began. In 2019 home delivery started for addresses within 3 km. By 2024 there were six people on the team, and there are still six.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Every new medicine is explained before it is handed over, and every new long-term medicine is followed by a call two weeks later. New prescriptions are usually ready in 20 minutes; repeat prescriptions within 24 hours. The pharmacy does not use pressure sales, and it does not promise results.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/people/\">Meet the people</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "visit",
   "title": "Visit",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p09-shopfront.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacy shopfront on a high street in early morning with a bench and a bicycle.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p09-shopfront.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Visit</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">Find the counter.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">1184 Queen Street East, Toronto, ON M4M 1L4, near the streetcar stop.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Hours</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Open every day but statutory holidays.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-fees\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fees\"><!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Monday–Friday</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\"></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">8:30–19:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Saturday</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\"></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">9:00–17:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Sunday</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\"></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">10:00–14:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Statutory holidays are closed. Phone (416) 555-0148, email counter@megumipharmacy.example. Home delivery within 3 km costs $4.00. A blood pressure check is free and needs no appointment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "shop",
   "title": "Shop",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p13-organiser.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"A translucent grey seven-day pill organiser on a pale stone surface.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p13-organiser.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Shop</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">Small things<br>by the till.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">Chosen by the pharmacists. No medicines are sold online; pickup at the counter is free.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:pattern {\"slug\":\"megumi-pharmacy/front-shelf\"} /-->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
