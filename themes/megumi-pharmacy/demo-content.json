  {
   "slug": "medicine-reviews",
   "title": "Medicine reviews",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p03-review.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacist and an older woman at a round table with a pill organiser and a handwritten list.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p03-review.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Medicine reviews</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">One list for<br>every medicine you take.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">Thirty minutes in the consultation room with Leila Haddad. $35.00, by appointment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-panel\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-panel\"><!-- wp:group {\"className\":\"mp-wrap mp-panel__grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-panel__grid\"><!-- wp:group {\"className\":\"mp-panel__text\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-panel__text\"><!-- wp:group {\"className\":\"sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">A review</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">What happens in thirty minutes</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Bring everything you take, including creams, vitamins and anything bought without a prescription.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-rows\"><!-- wp:details {\"showContent\":true,\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\" open><summary>Bring it all</summary><!-- wp:paragraph -->\n<p>Put every box, bottle and inhaler in a bag. We would rather see too much than too little.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>We sit down together</summary><!-- wp:paragraph -->\n<p>Leila Haddad goes through each medicine with you: what it is for, when you take it, and what you notice.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>You leave with one list</summary><!-- wp:paragraph -->\n<p>One printed list in plain words, a copy for your doctor if you wish, and a note of any questions to take to them.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-panel__photos mp-panel__photos--one\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-panel__photos mp-panel__photos--one\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full mp-shot\"><img src=\"/wp-content/themes/megumi-pharmacy/assets/images/p07-inhaler.webp\" alt=\"Pharmacist shows a teenage boy how to hold an inhaler with a spacer.\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
