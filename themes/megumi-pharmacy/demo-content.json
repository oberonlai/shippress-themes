   "title": "Services & fees",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p06-sorting.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Overhead view of a pharmacist and an older woman sorting medicine boxes on a table.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p06-sorting.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Services &amp; fees</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">Every service,<br>with its price.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">Prices are in Canadian dollars and are the same on every visit.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Fees</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Services and what they cost.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-fees\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fees\"><!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Prescription dispensing</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Per item</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$9.95</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Weekly blister packs</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Prepared each week, per week</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$6.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Medicine review</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">30 minutes, by appointment</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$35.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Blood pressure check</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">10 minutes, no appointment</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">Free</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Flu vaccination</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">In the consultation room</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$25.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Travel health consultation</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">30 minutes; vaccines at cost</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$45.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Home delivery</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Within 3 km</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$4.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-cap\"} -->\n<p class=\"mp-cap\">Medicine reviews and vaccinations are described on their own pages.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/medicine-reviews/\">Medicine reviews</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/vaccinations/\">Vaccinations &amp; travel</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
