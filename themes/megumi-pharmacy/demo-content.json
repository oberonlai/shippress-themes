  {
   "slug": "prescriptions",
   "title": "Prescriptions",
   "template": "page-wide",
   "content": "<!-- wp:cover {\"url\":\"/wp-content/themes/megumi-pharmacy/assets/images/p08-label.webp\",\"dimRatio\":0,\"isDark\":false,\"align\":\"full\",\"className\":\"mp-phead sp-parallax\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-light mp-phead sp-parallax\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Pharmacy technician checks a printed label against a plain box.\" src=\"/wp-content/themes/megumi-pharmacy/assets/images/p08-label.webp\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"mp-phead__in mp-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-phead__in mp-wrap\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Prescriptions</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1,\"className\":\"mp-phero\"} -->\n<h1 class=\"wp-block-heading mp-phero\">How a prescription<br>is talked through.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"mp-plede\"} -->\n<p class=\"mp-plede\">New prescriptions are usually ready in 20 minutes. Repeat prescriptions are ready within 24 hours.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-panel\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-panel\"><!-- wp:group {\"className\":\"mp-wrap mp-panel__grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-panel__grid\"><!-- wp:group {\"className\":\"mp-panel__text\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-panel__text\"><!-- wp:group {\"className\":\"sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Five steps</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">From hand-in to a call two weeks later</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A prescription can arrive on paper, as an e-prescription from your doctor, or as a repeat request by email or phone.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-rows\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-rows\"><!-- wp:details {\"showContent\":true,\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\" open><summary>Hand it in</summary><!-- wp:paragraph -->\n<p>Hand the prescription in at the counter, or send a repeat request to counter@megumipharmacy.example or on (416) 555-0148.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>We check it against your record</summary><!-- wp:paragraph -->\n<p>Allergies and other medicines are checked before anything is prepared. The check takes about 10 minutes.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>Prepared and double-checked</summary><!-- wp:paragraph -->\n<p>A technician prepares the item; a pharmacist checks the label against the box.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>Talked through at the counter</summary><!-- wp:paragraph -->\n<p>A pharmacist explains what it is for and how to take it, at the counter or in the consultation room.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"className\":\"mp-row\"} -->\n<details class=\"wp-block-details mp-row\"><summary>A call two weeks later</summary><!-- wp:paragraph -->\n<p>For every new long-term medicine we call two weeks later to ask how the first days have gone.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-panel__photos mp-panel__photos--one\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-panel__photos mp-panel__photos--one\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full mp-shot\"><img src=\"/wp-content/themes/megumi-pharmacy/assets/images/p02-bag.webp\" alt=\"Pharmacy assistant hands a plain white paper bag to an older man.\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Fees</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">What it costs.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"mp-fees\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fees\"><!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Prescription dispensing</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Per item</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$9.95</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Weekly blister packs</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Prepared each week, per week</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$6.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"mp-fee\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-fee\"><!-- wp:paragraph {\"className\":\"mp-fee__name\"} -->\n<p class=\"mp-fee__name\">Home delivery</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__note\"} -->\n<p class=\"mp-fee__note\">Within 3 km</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"mp-fee__price\"} -->\n<p class=\"mp-fee__price\">$4.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/services/\">All services &amp; fees</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"mp-sec\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull mp-sec\"><!-- wp:group {\"className\":\"mp-wrap mp-col sp-reveal sp-reveal--up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group mp-wrap mp-col sp-reveal sp-reveal--up\"><!-- wp:paragraph {\"className\":\"mp-kicker\"} -->\n<p class=\"mp-kicker\">Questions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"mp-h2\"} -->\n<h2 class=\"wp-block-heading mp-h2\">Ask at the counter.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Phone (416) 555-0148 or email counter@megumipharmacy.example. A pharmacist is at the counter Mon–Fri 8:30–19:00, Sat 9:00–17:00 and Sun 10:00–14:00. All prices in Canadian dollars.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-more\"} -->\n<p class=\"mp-more\"><a href=\"/visit/\">Plan your visit</a><span class=\"mp-pill\" aria-hidden=\"true\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
