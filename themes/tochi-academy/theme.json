{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1180px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "mist", "name": "Mist (ground)", "color": "#F5F6F2" },
				{ "slug": "base", "name": "White (disc, panels)", "color": "#FFFFFF" },
				{ "slug": "card", "name": "Card tint", "color": "#EEF0EB" },
				{ "slug": "ink", "name": "Ink", "color": "#141A16" },
				{ "slug": "main", "name": "Chitose green (main)", "color": "#3E5646" },
				{ "slug": "deep", "name": "Deep green", "color": "#26362C" },
				{ "slug": "tan", "name": "Ticker tan", "color": "#C9BBA2" },
				{ "slug": "sand", "name": "Sand", "color": "#E0D3BF" },
				{ "slug": "muted", "name": "Muted text", "color": "#66645F" },
				{ "slug": "accent", "name": "Copper (accent)", "color": "#B0763A" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Newsreader)",
					"fontFamily": "\"Newsreader\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-italic-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif-4-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "tag", "name": "Tag", "size": "0.725rem" },
				{ "slug": "label", "name": "Label", "size": "0.8125rem" },
				{ "slug": "pill", "name": "Button", "size": "0.9rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "card", "name": "Card title", "size": "1.1875rem" },
				{ "slug": "ticker", "name": "Ticker", "size": "1.4375rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Heading 2", "size": "3rem" },
				{ "slug": "xx-large", "name": "Display", "size": "4.5rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "4rem" },
				{ "slug": "60", "name": "XL (section)", "size": "6.0625rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"line": "1px",
			"ease": "cubic-bezier(.455, .03, .515, .955)",
			"rise": "cubic-bezier(.22, 1, .36, 1)",
			"radius": { "photo": "16px", "card": "10px", "pill": "100px" }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.85",
			"letterSpacing": "0.02em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--main)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.2", "letterSpacing": "0" }
			},
			"h1": { "typography": { "fontSize": "clamp(2.75rem, 5vw, 4.5rem)", "lineHeight": "1.08" } },
			"h2": { "typography": { "fontSize": "clamp(2rem, 3.2vw, 3rem)" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--card)", "fontWeight": "600", "lineHeight": "1.6" } },
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "100px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--pill)", "fontWeight": "600", "letterSpacing": "0.2em", "textTransform": "uppercase" }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "letterSpacing": "0.01em" } },
			"core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--label)", "fontWeight": "600", "letterSpacing": "0.12em", "textTransform": "uppercase" } }
		}
	}
}
