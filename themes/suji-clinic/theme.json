{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ground",
     "name": "Paper ground",
     "color": "#F3F5F5"
    },
    {
     "slug": "wedge",
     "name": "Pale wedge",
     "color": "#EDEFEF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#332F26"
    },
    {
     "slug": "main",
     "name": "Slate (main)",
     "color": "#565565"
    },
    {
     "slug": "steel",
     "name": "Steel",
     "color": "#7A97AE"
    },
    {
     "slug": "taupe",
     "name": "Taupe",
     "color": "#998E73"
    },
    {
     "slug": "tint-taupe",
     "name": "Tint, taupe",
     "color": "#CCC6B9"
    },
    {
     "slug": "tint-blue",
     "name": "Tint, blue",
     "color": "#CDD9E2"
    },
    {
     "slug": "tint-lav",
     "name": "Tint, lavender",
     "color": "#DED9E5"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B6B67"
    },
    {
     "slug": "rule",
     "name": "Rule grey",
     "color": "#CFCFCF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "Figtree, \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-300.woff2" ] },
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-300.woff2" ] },
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.5rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "4.5rem"
    },
    {
     "slug": "huge",
     "name": "Huge",
     "size": "7.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.375rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "6rem"
    }
   ]
  },
  "border": {
   "radius": false
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "300",
   "lineHeight": "2",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.25",
     "letterSpacing": "0.02em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "typography": {
      "textDecoration": "none"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--main)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "letterSpacing": "0.1em"
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  },
  {
   "name": "nav-strip",
   "title": "Navigation strip",
   "area": "uncategorized"
  }
 ],
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page (twin head)",
   "postTypes": [
    "page"
   ]
  }
 ]
}