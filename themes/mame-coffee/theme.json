{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1340px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (page)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text, rules)",
     "color": "#1D1D1D"
    },
    {
     "slug": "panel",
     "name": "Panel grey",
     "color": "#E8E8E8"
    },
    {
     "slug": "hairline",
     "name": "Hairline grey",
     "color": "#C8C8C8"
    },
    {
     "slug": "rating",
     "name": "Rating empty",
     "color": "#D3D3D3"
    },
    {
     "slug": "main",
     "name": "Black oak (UI)",
     "color": "#3F3834"
    },
    {
     "slug": "roast",
     "name": "Deep roast (overlay, footer)",
     "color": "#26211E"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6E6862"
    },
    {
     "slug": "accent",
     "name": "Copper (chip dot, underline)",
     "color": "#B8793E"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-zh",
     "name": "Traditional Chinese (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Newsreader\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-ja",
     "name": "Japanese (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Newsreader\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small (13px)",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base (15px)",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium (17px)",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Large (26px)",
     "size": "1.625rem"
    },
    {
     "slug": "x-large",
     "name": "X-large (36px)",
     "size": "2.25rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large (68px)",
     "size": "clamp(2.4rem, 9vw, 4.25rem)"
    },
    {
     "slug": "huge",
     "name": "Huge (86px wordmark)",
     "size": "clamp(2.6rem, 6vw, 5.375rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vh",
    "vw"
   ],
   "defaultSpacingSizes": false,
   "spacingSizes": [
    {
     "slug": "20",
     "name": "Small",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "Gap (44px)",
     "size": "clamp(1.25rem, 3vw, 2.75rem)"
    },
    {
     "slug": "40",
     "name": "Block",
     "size": "clamp(2rem, 4vw, 3.5rem)"
    },
    {
     "slug": "50",
     "name": "Section (140px)",
     "size": "clamp(4rem, 9.7vw, 8.75rem)"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var:preset|color|paper",
   "text": "var:preset|color|ink"
  },
  "spacing": {
   "blockGap": "1.25rem",
   "padding": {
    "top": "0px",
    "bottom": "0px",
    "left": "clamp(1.25rem, 3.5vw, 3.125rem)",
    "right": "clamp(1.25rem, 3.5vw, 3.125rem)"
   }
  },
  "typography": {
   "fontFamily": "var:preset|font-family|body",
   "fontSize": "var:preset|font-size|base",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var:preset|color|ink"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var:preset|color|main"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var:preset|font-family|heading",
     "fontWeight": "500",
     "lineHeight": "1.15"
    },
    "color": {
     "text": "var:preset|color|ink"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var:preset|font-size|xx-large",
     "lineHeight": "1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var:preset|font-size|x-large",
     "lineHeight": "1.25",
     "fontWeight": "400"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var:preset|font-size|large",
     "textTransform": "uppercase",
     "letterSpacing": "0.01em"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var:preset|font-size|medium"
    }
   },
   "button": {
    "color": {
     "background": "var:preset|color|main",
     "text": "var:preset|color|paper"
    },
    "typography": {
     "fontSize": "var:preset|font-size|base",
     "fontWeight": "600"
    },
    "border": {
     "radius": "0"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.6rem",
      "right": "1.6rem"
     }
    }
   },
   "caption": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    },
    "color": {
     "text": "var:preset|color|muted"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var:preset|font-family|heading",
     "fontSize": "1.375rem",
     "fontWeight": "500",
     "textTransform": "uppercase"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      },
      "color": {
       "text": "var:preset|color|paper"
      }
     }
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "var:preset|font-size|medium",
     "fontWeight": "600",
     "textTransform": "uppercase"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/post-title": {
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      }
     }
    }
   },
   "core/post-date": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    },
    "color": {
     "text": "var:preset|color|muted"
    }
   },
   "core/separator": {
    "color": {
     "text": "var:preset|color|hairline"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Full-width page (sections only)",
   "postTypes": [
    "page"
   ]
  }
 ]
}