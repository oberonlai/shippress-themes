{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1120px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "Paper (ground)", "color": "#F5F0EE" },
    { "slug": "white", "name": "White (bar, cards)", "color": "#FFFFFF" },
    { "slug": "rose", "name": "Dusk rose (field, buttons)", "color": "#8A746E" },
    { "slug": "blush", "name": "Blush (key-card band, borders)", "color": "#D9C9C4" },
    { "slug": "pale", "name": "Pale tint band", "color": "#EDE4E1" },
    { "slug": "ink", "name": "Deep ink (text, footer)", "color": "#3E3230" },
    { "slug": "amber", "name": "Dawn amber (marker, underline)", "color": "#D69A5C" },
    { "slug": "amber-ink", "name": "Amber ink (small text)", "color": "#9A6226" },
    { "slug": "muted", "name": "Muted text", "color": "#75645F" },
    { "slug": "hairline", "name": "Hairline", "color": "#E6DCD8" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "\"Karla\", -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Karla", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/karla-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "label", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Medium (h3)", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "1.5rem", "fluid": false },
    { "slug": "x-large", "name": "Heading (h2)", "size": "clamp(1.75rem, 1.2rem + 1.4vw, 2.25rem)", "fluid": false },
    { "slug": "xx-large", "name": "Large heading", "size": "3rem", "fluid": false },
    { "slug": "display", "name": "Display (h1, maximum 4.5rem)", "size": "clamp(2.75rem, 1.4rem + 4vw, 4.5rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.7", "fontWeight": "400" },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.05", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.3" } },
   "link": { "color": { "text": "var(--wp--preset--color--rose)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--rose)", "text": "#FFFFFF" },
    "border": { "radius": "6px" },
    "typography": { "fontSize": "0.9375rem", "fontWeight": "700", "letterSpacing": "0.01em" },
    "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.5rem", "right": "1.5rem" } }
   }
  }
 }
}
