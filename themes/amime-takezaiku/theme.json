{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "700px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "color": "#FFFCEB",
     "name": "Kariyasu washi (page ground)"
    },
    {
     "slug": "mist",
     "color": "#FAF3C4",
     "name": "Pale kariyasu (cards, notes)"
    },
    {
     "slug": "kariyasu",
     "color": "#F5E56B",
     "name": "Kariyasu yellow (main colour: hero field, shelf band, page heads, band card, footer strip)"
    },
    {
     "slug": "ink",
     "color": "#22200F",
     "name": "Sumi olive-black (text, side rail, footer)"
    },
    {
     "slug": "deep",
     "color": "#5F5410",
     "name": "Deep olive (links, prices, labels)"
    },
    {
     "slug": "quiet",
     "color": "#5A5644",
     "name": "Quiet olive grey (secondary text)"
    },
    {
     "slug": "pale",
     "color": "#F9EFA0",
     "name": "Pale kariyasu (labels on ink)"
    },
    {
     "slug": "ai",
     "color": "#4F6B2E",
     "name": "Bamboo green (small marks)"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Sawarabi Mincho)",
     "fontFamily": "\"Sawarabi Mincho\", \"Hiragino Mincho ProN\", \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Sawarabi Mincho",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/sawarabi-mincho-400-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese kanji and kana subset (Sawarabi Mincho JA)",
     "fontFamily": "\"Sawarabi Mincho JA\", \"Hiragino Mincho ProN\", serif",
     "fontFace": [
      {
       "fontFamily": "Sawarabi Mincho JA",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/sawarabi-mincho-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"PMingLiU\", \"Songti TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-500.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Urbanist)",
     "fontFamily": "\"Urbanist\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Urbanist",
       "fontStyle": "normal",
       "fontWeight": "300 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/urbanist-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4vw, 3rem)",
    "right": "clamp(1.25rem, 4vw, 3rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em",
     "fontWeight": "700"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header (white top header: the shop name on the left; the Shop the baskets button, account and cart on the right; from 1100 px the main menu stands as a fixed ink side rail on the left, below that it opens as a full-screen kariyasu overlay)",
   "area": "header"
  },
  {
   "name": "checkout-header",
   "title": "Checkout header (shop name and a secure-checkout note)",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer (kariyasu yellow strip with the workshop line, then the ink field with the synced shop details and the menu)",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (sections, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
