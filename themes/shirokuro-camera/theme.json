{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "700px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "color": "#FFF7EC",
     "name": "Warm paper (page ground)"
    },
    {
     "slug": "mist",
     "color": "#FDE8CF",
     "name": "Pale mikan (cards, notes)"
    },
    {
     "slug": "mikan",
     "color": "#F08300",
     "name": "Mikan orange (main colour: hero field, board lead, shelf band, page heads, footer strip)"
    },
    {
     "slug": "ink",
     "color": "#1E1A16",
     "name": "Camera black (text, frames, footer)"
    },
    {
     "slug": "deep",
     "color": "#8F3D00",
     "name": "Deep mikan (links, prices, labels)"
    },
    {
     "slug": "quiet",
     "color": "#5F5247",
     "name": "Warm grey (secondary text)"
    },
    {
     "slug": "pale",
     "color": "#FFD9A8",
     "name": "Pale mikan (labels on black)"
    },
    {
     "slug": "teal",
     "color": "#1D6B66",
     "name": "Lens teal (small marks)"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (DotGothic16)",
     "fontFamily": "\"DotGothic16\", \"Hiragino Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "DotGothic16",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dotgothic16-400-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese kanji and kana subset (DotGothic16 JA)",
     "fontFamily": "\"DotGothic16 JA\", \"Hiragino Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "DotGothic16 JA",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dotgothic16-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Lexend Deca)",
     "fontFamily": "\"Lexend Deca\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Lexend Deca",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LexendDeca-wght.ttf"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4vw, 3rem)",
    "right": "clamp(1.25rem, 4vw, 3rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.25",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header (formal top header, centred: the Shop cameras button on the left, the shop name in the middle, account and cart on the right, the main menu centred on its own row below; below 1100 px a Menu button opens it as a full-screen mikan overlay)",
   "area": "header"
  },
  {
   "name": "checkout-header",
   "title": "Checkout header (shop name and a secure-checkout note)",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer (mikan orange strip with sprocket holes and the shop line, then the black field with the synced shop details and the menu)",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (sections, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
