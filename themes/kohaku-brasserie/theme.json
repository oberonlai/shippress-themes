{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "stone",
     "name": "Stone (page ground)",
     "color": "#D4D3C7"
    },
    {
     "slug": "stone-light",
     "name": "Stone light (plate-rim ellipse)",
     "color": "#E4E3D9"
    },
    {
     "slug": "paper",
     "name": "Paper (light bands, text on photo)",
     "color": "#F6F3EC"
    },
    {
     "slug": "espresso",
     "name": "Espresso (night bands, footer)",
     "color": "#1D1915"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#26221D"
    },
    {
     "slug": "clove",
     "name": "Clove (rules, small fills)",
     "color": "#7A6A56"
    },
    {
     "slug": "clove-text",
     "name": "Clove text (labels)",
     "color": "#5E5141"
    },
    {
     "slug": "amber",
     "name": "Lamp amber (marker, one underline)",
     "color": "#B98A45"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/fraunces-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Literata)",
     "fontFamily": "\"Literata\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Literata",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/literata-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "label",
     "name": "Label",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "subtitle",
     "name": "Heading 3",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "title",
     "name": "Heading 2",
     "size": "clamp(2.25rem, 3.6vw, 3.5rem)",
     "fluid": false
    },
    {
     "slug": "display",
     "name": "Display (hero)",
     "size": "clamp(2.75rem, 5.2vw, 5.5rem)",
     "fluid": false
    },
    {
     "slug": "display-xl",
     "name": "Display XL (big word)",
     "size": "clamp(4.25rem, 8.3vw, 7.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "6rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--stone)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.85"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.02"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--title)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--subtitle)",
     "fontWeight": "400",
     "lineHeight": "1.6",
     "letterSpacing": "0.04em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--clove-text)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "400",
     "textDecoration": "none"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "2rem",
      "right": "2rem"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/separator": {
    "color": {
     "background": "var(--wp--preset--color--clove)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
