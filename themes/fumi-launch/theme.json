{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "44rem",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "field",
     "name": "Field (rikyu green)",
     "color": "#3E453A"
    },
    {
     "slug": "mid",
     "name": "Mid tone",
     "color": "#6F7765"
    },
    {
     "slug": "ivory",
     "name": "Ivory",
     "color": "#FAF8EA"
    },
    {
     "slug": "persimmon",
     "name": "Persimmon",
     "color": "#F26B3A"
    },
    {
     "slug": "stage",
     "name": "Stage black",
     "color": "#0E0D0B"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1E211B"
    }
   ],
   "gradients": []
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "defaultFontSizes": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display",
     "fontFamily": "\"Gloock\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Gloock",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/gloock-regular-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body",
     "fontFamily": "\"Public Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-serif-tc",
     "name": "Noto Serif TC",
     "fontFamily": "\"Noto Serif TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-serif-jp",
     "name": "Noto Serif JP",
     "fontFamily": "\"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(4.25rem, 12.8vw, 11.5rem)"
    },
    {
     "slug": "xx-large",
     "name": "XX large",
     "size": "clamp(2.25rem, 5.2vw, 4.375rem)"
    },
    {
     "slug": "x-large",
     "name": "X large",
     "size": "clamp(2.25rem, 4vw, 3.5rem)"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.75rem"
    },
    {
     "slug": "x-small",
     "name": "X small",
     "size": "0.6875rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vh",
    "vw"
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--field)",
   "text": "var(--wp--preset--color--ivory)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "letterSpacing": "0.04em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ivory)"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--persimmon)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.15"
    }
   },
   "button": {
    "color": {
     "background": "transparent",
     "text": "var(--wp--preset--color--ivory)"
    },
    "border": {
     "width": "1px",
     "style": "solid",
     "color": "var(--wp--preset--color--ivory)",
     "radius": "0"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "700",
     "letterSpacing": "0.12em",
     "textTransform": "uppercase"
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--ivory)",
      "text": "var(--wp--preset--color--field)"
     }
    }
   }
  }
 }
}