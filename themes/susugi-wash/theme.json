{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "1080px",
   "wideSize": "1280px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Cool grey band",
     "color": "#EBEBED"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#000000"
    },
    {
     "slug": "sub",
     "name": "Sub ink",
     "color": "#30353D"
    },
    {
     "slug": "hair",
     "name": "Hairline",
     "color": "#CFCAC2"
    },
    {
     "slug": "circle",
     "name": "Arrow circle",
     "color": "#F4F2EB"
    },
    {
     "slug": "main",
     "name": "Onando teal",
     "color": "#4A5C5E"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "italic",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "Manrope, \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "300 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Chapter title",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Lede",
     "size": "1.625rem"
    },
    {
     "slug": "x-large",
     "name": "Section headline",
     "size": "2.25rem"
    },
    {
     "slug": "figure",
     "name": "Figure",
     "size": "2.75rem"
    },
    {
     "slug": "xx-large",
     "name": "Wordmark",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "5.625rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "7.5rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "useRootPaddingAwareAlignments": false
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--sub)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.8",
   "fontWeight": "400",
   "letterSpacing": "0.01em"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.35",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.05"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "2",
     "fontWeight": "400"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--white)",
     "text": "var(--wp--preset--color--ink)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "600"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}