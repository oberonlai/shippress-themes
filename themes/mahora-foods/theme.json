{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1100px",
   "wideSize": "1100px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "panel",
     "name": "Pale panel",
     "color": "#F5F5F5"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#E8E8E8"
    },
    {
     "slug": "rule",
     "name": "Grey rule",
     "color": "#C8C8C8"
    },
    {
     "slug": "ink",
     "name": "Ink (text, footer)",
     "color": "#2D313F"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#656874"
    },
    {
     "slug": "orange",
     "name": "Orange (script, wedge)",
     "color": "#FF3E00"
    },
    {
     "slug": "orange-text",
     "name": "Orange text",
     "color": "#E63800"
    },
    {
     "slug": "amber",
     "name": "Amber",
     "color": "#FE9600"
    },
    {
     "slug": "sun",
     "name": "Sun",
     "color": "#FFC742"
    }
   ],
   "gradients": [
    {
     "slug": "wedge",
     "name": "Wedge",
     "gradient": "linear-gradient(90deg,#ff3e00,#fe9600)"
    },
    {
     "slug": "button",
     "name": "Button",
     "gradient": "linear-gradient(90deg,#fe9600,#ffc742)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Headings (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "300 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Work Sans)",
     "fontFamily": "\"Work Sans\", \"Noto Serif TC\", \"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Work Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/work-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "script",
     "name": "Script (Dancing Script)",
     "fontFamily": "\"Dancing Script\", cursive",
     "fontFace": [
      {
       "fontFamily": "Dancing Script",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dancing-script-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Chinese (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large (h2)",
     "size": "1.875rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.6rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large (h1)",
     "size": "4.25rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "XXL",
     "size": "6rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--orange-text)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "600",
     "lineHeight": "1.3"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.08"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "700",
     "fontSize": "1.0625rem"
    },
    "color": {
     "gradient": "var(--wp--preset--gradient--button)",
     "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
     "padding": {
      "top": "0",
      "bottom": "0",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    }
   },
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "600",
     "fontSize": "1.5rem"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  },
  {
   "name": "page-wide",
   "title": "Wide page",
   "postTypes": [
    "page"
   ]
  }
 ]
}
