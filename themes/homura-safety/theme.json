{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1170px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Base (page ground)", "color": "#FFFFFF" },
    { "slug": "pale", "name": "Pale band", "color": "#F6F6F6" },
    { "slug": "ink", "name": "Ink (text, footer)", "color": "#1B1612" },
    { "slug": "primary", "name": "Chestnut (buttons, notch tiles, booking band)", "color": "#5C4A3E" },
    { "slug": "primary-dark", "name": "Chestnut dark (hover)", "color": "#4A3B31" },
    { "slug": "photo-dark", "name": "Low-key photo dark", "color": "#1E1814" },
    { "slug": "hairline", "name": "Hairline", "color": "#EBEBEB" },
    { "slug": "ember", "name": "Ember (short rules, link dots)", "color": "#B8431F" },
    { "slug": "black", "name": "Black (language cell, pills)", "color": "#000000" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Libre Franklin)",
     "fontFamily": "\"Libre Franklin\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Libre Franklin", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/libre-franklin-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese headings subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "label", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Medium (H3, tagline)", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "Large (H2)", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
    { "slug": "x-large", "name": "Page title (H1)", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
    { "slug": "xx-large", "name": "Bar word (mobile)", "size": "4.5rem", "fluid": false },
    { "slug": "huge", "name": "Bar word (hero)", "size": "clamp(4.25rem, 16vw, 15rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M (card gap)", "size": "2.5rem" },
    { "slug": "50", "name": "L", "size": "3.5rem" },
    { "slug": "60", "name": "Section", "size": "5.625rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": { "blockGap": "1.25rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "lineHeight": "1.2" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700", "lineHeight": "1.35" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "700" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "700", "textDecoration": "none" },
    "spacing": { "padding": { "top": "1.125rem", "bottom": "1.125rem", "left": "2rem", "right": "2rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--hairline)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
