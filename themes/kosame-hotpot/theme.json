{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": false,
  "layout": {
   "contentSize": "590px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper",
     "color": "#FAFAFA"
    },
    {
     "slug": "paper-grain",
     "name": "Paper grain",
     "color": "#F4F4F4"
    },
    {
     "slug": "stage",
     "name": "Stage",
     "color": "#0B0908"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0F0B0A"
    },
    {
     "slug": "azuki",
     "name": "Azuki (brand)",
     "color": "#96514D"
    },
    {
     "slug": "azuki-deep",
     "name": "Azuki, deep",
     "color": "#7E423F"
    },
    {
     "slug": "wash",
     "name": "Wash",
     "color": "#E8D8D8"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "sage-line",
     "name": "Sage line",
     "color": "#DBDABE"
    },
    {
     "slug": "stone",
     "name": "Stone",
     "color": "#C4C3B5"
    },
    {
     "slug": "footer",
     "name": "Footer",
     "color": "#E7E7E7"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#727272"
    },
    {
     "slug": "bracket",
     "name": "Bracket",
     "color": "#8C8582"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#3E5B44"
    },
    {
     "slug": "success-bg",
     "name": "Success background",
     "color": "#E6EADF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Bricolage Grotesque)",
     "fontFamily": "\"Bricolage Grotesque\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Bricolage Grotesque",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/bricolage-grotesque-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (DM Sans)",
     "fontFamily": "\"DM Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "DM Sans",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dm-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Extra small",
     "size": ".75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.1875rem"
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "1.3125rem"
    },
    {
     "slug": "xx-large",
     "name": "2X large",
     "size": "1.5625rem"
    },
    {
     "slug": "huge",
     "name": "Huge",
     "size": "3rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "4.25rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "padding": true,
   "margin": true,
   "blockGap": true
  },
  "border": {
   "radius": true
  },
  "custom": {
   "ks": {
    "stageMs": "3500"
   }
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "2",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "top": "0",
    "right": "0",
    "bottom": "0",
    "left": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--azuki)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.3"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--azuki)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "500"
    },
    "spacing": {
     "padding": {
      "top": "12px",
      "bottom": "12px",
      "left": "28px",
      "right": "28px"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}