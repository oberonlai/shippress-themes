{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "980px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "White", "color": "#FFFFFF" },
    { "slug": "soft", "name": "Soft grey band", "color": "#E9E9E9" },
    { "slug": "card", "name": "Card grey", "color": "#F4F4F4" },
    { "slug": "line", "name": "Hairline", "color": "#EDEDED" },
    { "slug": "mouse", "name": "Mouse grey", "color": "#8E9194" },
    { "slug": "muted", "name": "Muted text", "color": "#707070" },
    { "slug": "ink", "name": "Ink", "color": "#333333" },
    { "slug": "black", "name": "Black", "color": "#000000" },
    { "slug": "dark", "name": "Dark", "color": "#1F1F1F" },
    { "slug": "cyan", "name": "Airflow cyan", "color": "#4DC0DB" },
    { "slug": "cyan-deep", "name": "Cyan, hover", "color": "#3FAFC9" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-tight-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "Manrope, \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": ["file:./assets/fonts/manrope-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "sans-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"] }
     ]
    },
    {
     "slug": "sans-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-jp-400-ja.woff2"] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem" },
    { "slug": "medium", "name": "Body", "size": "1.125rem" },
    { "slug": "large", "name": "Lead", "size": "1.3rem" },
    { "slug": "x-large", "name": "Heading 3", "size": "1.5rem" },
    { "slug": "xx-large", "name": "Heading 2", "size": "2.375rem" },
    { "slug": "label", "name": "Section label", "size": "2.4rem" },
    { "slug": "price", "name": "Price", "size": "3rem" },
    { "slug": "huge", "name": "Hero title", "size": "4.5rem" }
   ]
  },
  "spacing": {
   "units": ["px", "em", "rem", "%", "vw"],
   "spacingSizes": [
    { "slug": "20", "name": "S", "size": "1rem" },
    { "slug": "30", "name": "M", "size": "2rem" },
    { "slug": "40", "name": "L", "size": "3rem" },
    { "slug": "50", "name": "XL", "size": "4rem" },
    { "slug": "60", "name": "Section", "size": "6rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.8", "fontWeight": "400" },
  "spacing": { "padding": { "left": "clamp(1.25rem, 4vw, 2rem)", "right": "clamp(1.25rem, 4vw, 2rem)" }, "blockGap": "1.25rem" },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.2" }, "color": { "text": "var(--wp--preset--color--black)" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } }
  },
  "blocks": {
   "core/button": { "border": { "radius": "22px" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" } }
  }
 }
}
