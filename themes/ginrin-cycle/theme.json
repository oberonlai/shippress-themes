{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "mist",
          "name": "Steel mist (ground)",
          "color": "#DDE3E8"
        },
        {
          "slug": "paper",
          "name": "Paper (cards and panels)",
          "color": "#F5F6F4"
        },
        {
          "slug": "steel",
          "name": "Steel (deeper panels and rules)",
          "color": "#C9D1D8"
        },
        {
          "slug": "slate",
          "name": "Slate (quiet text on mist and paper)",
          "color": "#5C6670"
        },
        {
          "slug": "graphite",
          "name": "Graphite (text and dark panels)",
          "color": "#22282E"
        },
        {
          "slug": "ember",
          "name": "Burnt orange (small marks only)",
          "color": "#B4532A"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans (Rubik)",
          "fontFamily": "Rubik, \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Rubik",
              "fontStyle": "normal",
              "fontWeight": "300 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/rubik-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (IBM Plex Mono)",
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/ibm-plex-mono-regular-latin1.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/ibm-plex-mono-medium-latin1.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)"
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "clamp(1.125rem, 1.04rem + 0.36vw, 1.375rem)"
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.5rem, 1.22rem + 1.1vw, 2.125rem)"
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "clamp(2rem, 1.45rem + 2.3vw, 3.375rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.5rem, 1.5rem + 4.3vw, 5.25rem)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 6.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 9rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--graphite) 16%, transparent)",
      "line-strong": "color-mix(in srgb, var(--wp--preset--color--graphite) 42%, transparent)",
      "muted": "var(--wp--preset--color--slate)",
      "on-dark": "#DDE3E8",
      "on-dark-muted": "#9AA5AF",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "panel": "#22282E"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|mist",
      "text": "var:preset|color|graphite"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|graphite"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|slate"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "300",
          "lineHeight": "1.08",
          "letterSpacing": "-0.025em"
        },
        "color": {
          "text": "var:preset|color|graphite"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1.02",
          "letterSpacing": "-0.035em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.05"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "-0.015em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400",
          "letterSpacing": "-0.01em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "500",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500",
          "letterSpacing": "0"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|graphite",
          "text": "var:preset|color|paper"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500",
          "letterSpacing": "0.02em"
        },
        "border": {
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|slate",
            "text": "var:preset|color|paper"
          }
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:preset|color|slate"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "1.0625rem",
          "fontWeight": "500",
          "letterSpacing": "0.01em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|graphite"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|graphite"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:preset|color|slate"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "textTransform": "uppercase",
          "letterSpacing": "0.06em"
        }
      },
      "core/quote": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "300",
          "lineHeight": "1.45"
        },
        "border": {
          "left": {
            "color": "var:preset|color|ember",
            "width": "2px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line-strong"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full-width page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
