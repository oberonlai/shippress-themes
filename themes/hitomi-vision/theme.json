{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "640px", "wideSize": "1360px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground (sage grey)", "color": "#D6DCD6" },
				{ "slug": "dome", "name": "Dome (arc band)", "color": "#DEE3DE" },
				{ "slug": "mat", "name": "Mat (photo card)", "color": "#E4E8E4" },
				{ "slug": "strip", "name": "Strip (headline label)", "color": "#EEF1EE" },
				{ "slug": "footer", "name": "Footer ground", "color": "#C9D0C9" },
				{ "slug": "ink", "name": "Ink (text)", "color": "#3E4D43" },
				{ "slug": "sub", "name": "Sub text", "color": "#516258" },
				{ "slug": "line", "name": "Line", "color": "#8A938E" },
				{ "slug": "accent", "name": "Accent (muted teal)", "color": "#6A8A88" },
				{ "slug": "light", "name": "Light", "color": "#F4F6F4" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display and body (Newsreader)",
					"fontFamily": "Newsreader, \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Newsreader", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				},
				{
					"slug": "ui",
					"name": "UI, nav and labels (Figtree)",
					"fontFamily": "Figtree, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Caption", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "nav", "name": "Nav and button", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": false },
				{ "slug": "x-large", "name": "Section title", "size": "2rem", "fluid": false },
				{ "slug": "xx-large", "name": "Page head", "size": "2.75rem", "fluid": false },
				{ "slug": "huge", "name": "Hero (maximum 4.75rem)", "size": "clamp(2.75rem, 5.6vw, 4.75rem)", "fluid": false }
			]
		},
		"spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--display)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "2.2",
			"fontWeight": "400",
			"letterSpacing": "0.02em"
		},
		"spacing": {
			"padding": { "left": "clamp(1.25rem, 2.78vw, 2.5rem)", "right": "clamp(1.25rem, 2.78vw, 2.5rem)" },
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.6", "letterSpacing": "0" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "fontWeight": "300", "lineHeight": "1.12" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "1px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--line)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "var(--wp--preset--font-size--nav)", "fontWeight": "400", "letterSpacing": "0.06em", "lineHeight": "1.6" },
				"spacing": { "padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.25rem", "right": "1.25rem" } }
			}
		}
	}
}
