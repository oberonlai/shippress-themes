{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1200px", "wideSize": "1320px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "white", "name": "White (page ground)", "color": "#FFFFFF" },
    { "slug": "paper", "name": "Cool paper band", "color": "#F4F7F6" },
    { "slug": "wash", "name": "Wash (pale sky)", "color": "#DCEBEB" },
    { "slug": "slate", "name": "Slate (ink, rules, buttons, footer)", "color": "#314A57" },
    { "slug": "patina", "name": "Patina (secondary)", "color": "#4E6562" },
    { "slug": "teal", "name": "Teal (accent)", "color": "#22B0A4" },
    { "slug": "teal-ink", "name": "Teal ink (accent text)", "color": "#167A72" },
    { "slug": "lime", "name": "Hairline start", "color": "#A8D26B" },
    { "slug": "alert", "name": "Alert red (outline only)", "color": "#C62828" },
    { "slug": "ink", "name": "Text", "color": "#2B3335" },
    { "slug": "rule", "name": "Rule grey", "color": "#D5DCDD" },
    { "slug": "grey", "name": "Pictogram grey", "color": "#9AA3A6" }
   ],
   "gradients": [
    { "slug": "hairline", "name": "Hairline (yellow-green to teal)", "gradient": "linear-gradient(90deg, #A8D26B 0%, #22B0A4 100%)" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "zh-sans",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small (meta)", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Card title", "size": "1.125rem", "fluid": false },
    { "slug": "large", "name": "Lead / h3", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
    { "slug": "x-large", "name": "Section heading (h2)", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
    { "slug": "xx-large", "name": "Page title (h1)", "size": "2.5rem", "fluid": { "min": "2rem", "max": "2.5rem" } },
    { "slug": "hero", "name": "Hero catch line", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "vh", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M", "size": "2.5rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "Section", "size": "6.25rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--slate)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.3" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "300" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "600" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "500", "letterSpacing": "0.075em" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--slate)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--teal-ink)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--slate)", "text": "var(--wp--preset--color--white)" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "500", "textDecoration": "none" },
    "spacing": { "padding": { "top": "1.15rem", "bottom": "1.15rem", "left": "2rem", "right": "2.75rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--rule)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
