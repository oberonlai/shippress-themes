{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "mist",
          "name": "Mist (ground)",
          "color": "#EEF0EB"
        },
        {
          "slug": "paper",
          "name": "Paper (cards and the open menu)",
          "color": "#F7F8F5"
        },
        {
          "slug": "sage-pale",
          "name": "Pale sage (bands)",
          "color": "#DDE4DA"
        },
        {
          "slug": "sage",
          "name": "Sage (accent, the breath line, the booking band)",
          "color": "#9AAE9A"
        },
        {
          "slug": "moss",
          "name": "Moss (buttons and links)",
          "color": "#4A5E50"
        },
        {
          "slug": "stone",
          "name": "Stone (quiet text)",
          "color": "#56645B"
        },
        {
          "slug": "ink",
          "name": "Pine ink (text)",
          "color": "#2E3B34"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "pine-mist",
          "name": "Pine and mist",
          "colors": [
            "#2E3B34",
            "#EEF0EB"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Gowun Batang)",
          "fontFamily": "\"Gowun Batang\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Gowun Batang",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/gowun-batang-regular-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Gowun Batang",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/gowun-batang-bold-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Lexend)",
          "fontFamily": "Lexend, \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Lexend",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/lexend-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.25rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5.5rem",
          "fluid": {
            "min": "2.875rem",
            "max": "6.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 5vw, 8.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6rem, 4rem + 7vw, 12rem)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--ink) 14%, transparent)",
      "ease": "cubic-bezier(.33, .1, .25, 1)",
      "radius": {
        "soft": "1.25rem",
        "arch": "999px 999px 1.25rem 1.25rem",
        "pill": "999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|mist",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "300",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|moss"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1.08",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.14",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.35"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.45",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|moss",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "999px",
          "width": "0px",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.75rem",
            "bottom": "0.95rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.9375rem",
          "fontWeight": "400",
          "letterSpacing": "0.02em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.375rem",
          "fontWeight": "400",
          "letterSpacing": "0",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "400",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "400",
          "letterSpacing": "0.06em"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.06em"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|moss"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.7"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|stone"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.45"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.3"
        }
      },
      "core/image": {
        "border": {
          "radius": "var:custom|radius|soft"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "var:custom|radius|soft"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Page without title (the page holds its own heading)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
