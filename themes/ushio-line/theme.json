{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1220px",
			"wideSize": "1380px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#FFFFFF"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#DCE6EA"
				},
				{
					"slug": "slate",
					"name": "Slate (katsu-iro)",
					"color": "#3E4C55"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1A1A1A"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#55626A"
				},
				{
					"slug": "rust",
					"name": "Rope rust",
					"color": "#A8573F"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#C5CDD1"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "body",
					"name": "Text (Nunito Sans)",
					"fontFamily": "\"Nunito Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito Sans",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunitosans-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Label",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Nav label",
					"size": "1.375rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.75rem"
				},
				{
					"slug": "x-large",
					"name": "Section head",
					"size": "2.75rem"
				},
				{
					"slug": "xx-large",
					"name": "Band title",
					"size": "5.625rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "5.625rem"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "7.5rem"
				}
			]
		},
		"border": {
			"radius": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75"
		},
		"spacing": {
			"padding": {
				"left": "0",
				"right": "0"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--slate)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--slate)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "500"
				},
				"spacing": {
					"padding": {
						"top": "0",
						"bottom": "0",
						"left": "0",
						"right": "0"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--rule)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
