{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "660px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "ivory",
          "name": "Ivory (ground)",
          "color": "#FBF8F4"
        },
        {
          "slug": "blush",
          "name": "Blush (bands and cards)",
          "color": "#F3EAE1"
        },
        {
          "slug": "champagne",
          "name": "Champagne (lines and the knot)",
          "color": "#D9C3A5"
        },
        {
          "slug": "mauve",
          "name": "Mauve brown (accent)",
          "color": "#8C6A5D"
        },
        {
          "slug": "mauve-deep",
          "name": "Deep mauve (buttons and links)",
          "color": "#76574B"
        },
        {
          "slug": "taupe",
          "name": "Taupe (quiet text)",
          "color": "#685A53"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#3B302C"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Gloock)",
          "fontFamily": "Gloock, \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Gloock",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/gloock-regular-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Public Sans)",
          "fontFamily": "\"Public Sans\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Public Sans",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/public-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4.5rem, 3rem + 5vw, 8.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(6rem, 4rem + 7vw, 11rem)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--champagne) 70%, transparent)",
      "ease": "cubic-bezier(.33, .1, .25, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ivory",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "300",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|mauve-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "-0.005em"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.875rem, 1.4rem + 1.9vw, 3rem)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem)"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|mauve-deep",
          "text": "var:preset|color|ivory"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem)",
          "fontWeight": "400",
          "letterSpacing": "0.08em"
        },
        "border": {
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|ivory"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|ivory"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "color": {
          "text": "var:preset|color|taupe"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var:preset|color|taupe"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|champagne"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.35"
        },
        "border": {
          "left": {
            "width": "0px"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Page (wide, no title band)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
