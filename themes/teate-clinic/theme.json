{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1080px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "wash",
     "name": "Pale wash",
     "color": "#EEF3EF"
    },
    {
     "slug": "primary",
     "name": "Celadon",
     "color": "#6E8B74"
    },
    {
     "slug": "primary-strong",
     "name": "Celadon strong",
     "color": "#5B7762"
    },
    {
     "slug": "deep",
     "name": "Deep celadon",
     "color": "#3F5A47"
    },
    {
     "slug": "contrast",
     "name": "Ink",
     "color": "#22302A"
    },
    {
     "slug": "muted",
     "name": "Soft ink",
     "color": "#56615B"
    },
    {
     "slug": "accent",
     "name": "Ochre",
     "color": "#C69A5B"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#E1E8E3"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Outfit)",
     "fontFamily": "\"Outfit\", \"Figtree\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "300 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "\"Figtree\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "400 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Dates, sub-lines",
     "size": "0.8125rem"
    },
    {
     "slug": "s",
     "name": "Card labels",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "Box labels",
     "size": "1.125rem"
    },
    {
     "slug": "xl",
     "name": "Ledger labels, card tagline",
     "size": "1.375rem"
    },
    {
     "slug": "2xl",
     "name": "Band quote, story titles",
     "size": "1.75rem"
    },
    {
     "slug": "3xl",
     "name": "Section headline",
     "size": "2.5rem"
    },
    {
     "slug": "4xl",
     "name": "Inner page title",
     "size": "3.25rem"
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.25rem"
    }
   ]
  },
  "custom": {}
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--primary-strong)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--deep)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.25",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--primary-strong)",
     "text": "var(--wp--preset--color--base)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "600"
    },
    "border": {
     "radius": "8px"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--deep)",
      "text": "var(--wp--preset--color--base)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)"
    }
   }
  }
 }
}