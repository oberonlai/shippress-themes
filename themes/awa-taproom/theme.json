{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1340px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text, rules)", "color": "#1D1D1D" },
    { "slug": "umber", "name": "Umber (hero and close ground)", "color": "#3B2E28" },
    { "slug": "deep", "name": "Deep green (strip, footer)", "color": "#0B2A2A" },
    { "slug": "hairline", "name": "Hairline", "color": "#CFCFCF" },
    { "slug": "side", "name": "Side label grey", "color": "#BDBDBD" },
    { "slug": "muted", "name": "Muted text", "color": "#5A5A5A" },
    { "slug": "amber", "name": "Amber (the beer)", "color": "#C98A3C" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunitosans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "clamp(1.375rem, 1.1rem + 0.8vw, 1.625rem)", "fluid": false },
    { "slug": "x-large", "name": "Lead / heading", "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.25rem)", "fluid": false },
    { "slug": "xx-large", "name": "Wordmark (maximum 4.875rem)", "size": "clamp(2.75rem, 1.2rem + 4.4vw, 4.875rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1.0625rem", "lineHeight": "1.75", "fontWeight": "400" },
  "spacing": {
   "padding": { "left": "clamp(1.25rem, 3.5vw, 3.125rem)", "right": "clamp(1.25rem, 3.5vw, 3.125rem)" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.15", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "textTransform": "uppercase", "lineHeight": "1" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "textTransform": "uppercase" } },
   "h4": { "typography": { "fontSize": "1.0625rem" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "0.9375rem", "letterSpacing": "0.06em", "fontWeight": "700", "textTransform": "uppercase" },
    "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "2rem", "right": "2rem" } }
   }
  }
 }
}
