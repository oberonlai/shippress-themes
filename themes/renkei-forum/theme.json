{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "810px", "wideSize": "1350px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (ink black)", "color": "#0B0C0D" },
    { "slug": "panel", "name": "Panel", "color": "#26282A" },
    { "slug": "ink", "name": "Ink (marquee)", "color": "#3A3C3E" },
    { "slug": "rule", "name": "Hairline", "color": "#4A4C4F" },
    { "slug": "ghost", "name": "Ghost word", "color": "#1C1E20" },
    { "slug": "accent", "name": "Electric blue", "color": "#0C62ED" },
    { "slug": "accent-text", "name": "Blue for small text on dark", "color": "#4F8EFF" },
    { "slug": "text", "name": "Text", "color": "#FFFFFF" },
    { "slug": "muted", "name": "Secondary text", "color": "#A3A4A5" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "Manrope, \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] },
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-700-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "caption", "name": "Caption", "size": "0.75rem", "fluid": false },
    { "slug": "label", "name": "Label", "size": "0.8rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.9rem", "fluid": false },
    { "slug": "base", "name": "Body", "size": "1rem", "fluid": false },
    { "slug": "h3", "name": "H3 / session title", "size": "1.4625rem", "fluid": { "min": "1.25rem", "max": "1.4625rem" } },
    { "slug": "h2", "name": "H2 (bars)", "size": "3.375rem", "fluid": { "min": "2.25rem", "max": "3.375rem" } },
    { "slug": "h1", "name": "H1 (title band)", "size": "4.25rem", "fluid": { "min": "2.75rem", "max": "4.25rem" } },
    { "slug": "marquee", "name": "Marquee", "size": "6.1875rem", "fluid": { "min": "3.5rem", "max": "6.1875rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2.8125rem" },
    { "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 3.75rem)" },
    { "slug": "60", "name": "XL", "size": "clamp(3.5rem, 7vw, 6.5rem)" }
   ]
  },
  "blocks": {
   "core/button": { "border": { "radius": true } }
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--text)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "0"
  },
  "elements": {
   "link": {
    "color": { "text": "var(--wp--preset--color--text)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--accent-text)" } }
   },
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "800", "lineHeight": "0.9", "letterSpacing": "-0.05em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "700", "lineHeight": "1.4", "letterSpacing": "0.05em" } }
  },
  "blocks": {
   "core/button": {
    "border": { "radius": "999px" },
    "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "600" }
   }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header (title band)", "area": "header" },
  { "name": "header-home", "title": "Header, home (title band with H1)", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
