{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "band", "name": "Pale grey band", "color": "#F2F2F2" },
    { "slug": "contrast", "name": "Text", "color": "#333333" },
    { "slug": "charcoal", "name": "Mat charcoal (dark bands, threshold line)", "color": "#262B30" },
    { "slug": "charcoal-2", "name": "Charcoal raised (inputs on dark)", "color": "#2F353B" },
    { "slug": "teal", "name": "Teal (anchor bar, buttons)", "color": "#1B6F93" },
    { "slug": "teal-dark", "name": "Teal dark (hover)", "color": "#155873" },
    { "slug": "rule", "name": "Hairline", "color": "#D8D8D8" },
    { "slug": "mid", "name": "Mid grey (dashes)", "color": "#A6A6A6" },
    { "slug": "slate", "name": "Slate", "color": "#7D8B96" },
    { "slug": "pale", "name": "Wet pavement pale", "color": "#DCE1E5" },
    { "slug": "accent", "name": "Ochre rule (decoration only)", "color": "#FFC000" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "spacing": {
   "units": ["px", "rem", "%", "vw"]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Manrope)",
     "fontFamily": "\"Manrope\", \"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/manrope-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/public-sans-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-sans-jp-ja-400.woff2"]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "xs", "name": "Small print", "size": "0.8125rem" },
    { "slug": "s", "name": "Menu, notes", "size": "0.9375rem" },
    { "slug": "m", "name": "Body", "size": "1rem" },
    { "slug": "l", "name": "Card title", "size": "1.125rem" },
    { "slug": "xl", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
    { "slug": "section", "name": "Section headline", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
    { "slug": "title", "name": "Inner page title", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
    { "slug": "display", "name": "Home headline", "size": "4.5rem", "fluid": { "min": "2.3rem", "max": "4.5rem" } }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.7"
  },
  "spacing": {
   "blockGap": "0",
   "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" }
  },
  "elements": {
   "link": {
    "color": { "text": "var(--wp--preset--color--teal)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--teal-dark)" } }
   },
   "heading": {
    "color": { "text": "var(--wp--preset--color--contrast)" },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25",
     "letterSpacing": "0"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "fontWeight": "800",
     "lineHeight": "1.08",
     "letterSpacing": "-0.02em"
    }
   },
   "h2": {
    "typography": { "fontSize": "var(--wp--preset--font-size--section)" }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--l)",
     "lineHeight": "1.4"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--teal)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": { "radius": "0", "width": "0" },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1rem",
     "fontWeight": "700"
    },
    "spacing": {
     "padding": { "top": "0.8125rem", "bottom": "0.8125rem", "left": "1.75rem", "right": "1.75rem" }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--teal-dark)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "800"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--s)",
     "fontWeight": "600"
    }
   }
  }
 }
}
