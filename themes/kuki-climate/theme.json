{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1304px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (pale cool)",
     "color": "#EEF1EF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#1F2926"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#4A5652"
    },
    {
     "slug": "iron",
     "name": "Iron (frame, header, footer)",
     "color": "#2E3A36"
    },
    {
     "slug": "panel-a",
     "name": "Panel cool grey",
     "color": "#C1C7C3"
    },
    {
     "slug": "panel-b",
     "name": "Panel sand-grey",
     "color": "#C6C0B2"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#B9C0BC"
    },
    {
     "slug": "light",
     "name": "Light on iron",
     "color": "#F4F6F5"
    },
    {
     "slug": "light-2",
     "name": "Soft light on iron",
     "color": "#E3E8E5"
    },
    {
     "slug": "brass",
     "name": "Brass (visit dots)",
     "color": "#B8863B"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Manrope)",
     "fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.375rem, 1rem + 1vw, 1.75rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2rem, 1.2rem + 2.2vw, 3rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Page title (max 4.25rem)",
     "size": "clamp(2.25rem, 1rem + 3.5vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Hero (max 6rem)",
     "size": "clamp(2.5rem, 6.4vw, 6rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.85",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.2",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "fontWeight": "500"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.0625rem",
     "fontWeight": "500"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ground)",
     "text": "var(--wp--preset--color--iron)"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.02em",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}
