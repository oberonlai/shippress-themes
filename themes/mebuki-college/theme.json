{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1240px",
   "wideSize": "1340px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (cool paper)",
     "color": "#F7F8F3"
    },
    {
     "slug": "wash",
     "name": "Wash (mist band)",
     "color": "#EEF2E7"
    },
    {
     "slug": "base",
     "name": "White (header, cards, panels)",
     "color": "#FFFFFF"
    },
    {
     "slug": "accent",
     "name": "Moss (rule, buttons, discs)",
     "color": "#6A7A52"
    },
    {
     "slug": "accent-dark",
     "name": "Moss dark (hover)",
     "color": "#566443"
    },
    {
     "slug": "accent-soft",
     "name": "Sage tint (second card)",
     "color": "#C9D3B8"
    },
    {
     "slug": "sage",
     "name": "Sage (hairlines, numerals)",
     "color": "#9AA784"
    },
    {
     "slug": "ink",
     "name": "Ink (headings)",
     "color": "#2E3328"
    },
    {
     "slug": "text",
     "name": "Text (body)",
     "color": "#4A4F45"
    },
    {
     "slug": "muted",
     "name": "Muted (dates, small labels)",
     "color": "#6F7566"
    },
    {
     "slug": "line",
     "name": "Line (borders)",
     "color": "#E1E6D8"
    },
    {
     "slug": "clay",
     "name": "Clay (chalk tick)",
     "color": "#C9825B"
    },
    {
     "slug": "footer",
     "name": "Footer ground",
     "color": "#2E3328"
    },
    {
     "slug": "mist",
     "name": "Mist (text on footer)",
     "color": "#E8EDDF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/fraunces-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "400 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/sourcesans3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "XS (labels)",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "S (nav, pills, captions)",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "M (body)",
     "size": "1rem"
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.0625rem"
    },
    {
     "slug": "medium-large",
     "name": "H3 (card heading)",
     "size": "1.625rem"
    },
    {
     "slug": "large",
     "name": "Inner h1",
     "size": "3.5rem"
    },
    {
     "slug": "x-large",
     "name": "H2 (section heading)",
     "size": "3.75rem"
    },
    {
     "slug": "huge",
     "name": "Hero h1",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "50",
     "name": "Section",
     "size": "6.25rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.75",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.3",
     "letterSpacing": "0.04em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent-dark)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "100px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.2",
     "letterSpacing": "0.02em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.3",
     "letterSpacing": "0.06em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium-large)",
     "fontWeight": "400",
     "lineHeight": "1.3"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
