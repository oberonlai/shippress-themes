{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "Stone ground", "color": "#F6F5F0" },
    { "slug": "panel", "name": "Stone panel", "color": "#EFEDE6" },
    { "slug": "ink", "name": "Ink (text)", "color": "#372828" },
    { "slug": "band", "name": "Band ink", "color": "#2A2525" },
    { "slug": "accent", "name": "Bengara (small areas only)", "color": "#8A4B3A" },
    { "slug": "clay", "name": "Clay tint (leaf)", "color": "#E3C6B6" },
    { "slug": "numeral", "name": "Highlight numeral", "color": "#C99A86" },
    { "slug": "rule", "name": "Rule", "color": "#CFC9BF" },
    { "slug": "muted", "name": "Muted text", "color": "#6B605C" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Crimson Pro)",
     "fontFamily": "\"Crimson Pro\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Crimson Pro", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/crimsonpro-variable-latin.woff2"] },
      { "fontFamily": "Crimson Pro", "fontStyle": "italic", "fontWeight": "200 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/crimsonpro-italic-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter)",
     "fontFamily": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.875rem" },
    { "slug": "medium", "name": "Medium (body)", "size": "1rem" },
    { "slug": "large", "name": "Large", "size": "1.5rem" },
    { "slug": "x-large", "name": "Section title", "size": "clamp(1.9rem, 3vw, 2.25rem)" },
    { "slug": "xx-large", "name": "Large title", "size": "clamp(2.4rem, 4vw, 3rem)" },
    { "slug": "huge", "name": "Hero title", "size": "clamp(2.5rem, 4.7vw, 4.25rem)" },
    { "slug": "numeral", "name": "Numeral", "size": "7rem" }
   ]
  },
  "spacing": {
   "units": ["px", "rem", "em", "%", "vw"],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M", "size": "3rem" },
    { "slug": "50", "name": "L", "size": "4.875rem" },
    { "slug": "60", "name": "XL", "size": "7.75rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false, "presets": [] },
  "blocks": {
   "core/button": { "border": { "radius": true } }
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.9",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "0",
   "padding": { "left": "0", "right": "0" }
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.3", "letterSpacing": "0.01em" },
    "color": { "text": "var(--wp--preset--color--accent)" }
   },
   "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "1.125rem", "letterSpacing": "0" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--accent)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" },
    "border": { "radius": "6px" },
    "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.375rem", "right": "1.375rem" } }
   }
  },
  "blocks": {
   "core/image": { "border": { "radius": "16px" } },
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "0.9375rem", "letterSpacing": "0" } }
  }
 },
 "customTemplates": [ { "name": "page-inner", "title": "Inner page", "postTypes": [ "page" ] } ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
