{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1320px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "mist",
     "name": "Mist (ground)",
     "color": "#E9ECEC"
    },
    {
     "slug": "mist-deep",
     "name": "Deeper mist (bands, footer)",
     "color": "#DDE2E3"
    },
    {
     "slug": "steel",
     "name": "Steel (headings, rules, links)",
     "color": "#5C6B73"
    },
    {
     "slug": "ink",
     "name": "Ink (body text)",
     "color": "#2F3A40"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6E7B82"
    },
    {
     "slug": "clay",
     "name": "Clay (tabs, chips)",
     "color": "#DBC2B6"
    },
    {
     "slug": "field",
     "name": "Field white",
     "color": "#F4F6F6"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Headings (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC (zh-TW subset)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP (ja subset)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Large (H3)",
     "size": "1.5rem"
    },
    {
     "slug": "tagline",
     "name": "Hero tagline",
     "size": "2rem"
    },
    {
     "slug": "x-large",
     "name": "Page title",
     "size": "clamp(2rem, 3vw, 3rem)"
    },
    {
     "slug": "xx-large",
     "name": "Section title",
     "size": "clamp(2.75rem, 4.4vw, 4.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "5.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--mist)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.87",
   "letterSpacing": "0.04em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--steel)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "400",
     "lineHeight": "1.2",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.15"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.67",
     "letterSpacing": "0.02em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--steel)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--ink)"
     }
    }
   },
   "button": {
    "color": {
     "background": "transparent",
     "text": "var(--wp--preset--color--steel)"
    },
    "border": {
     "radius": "10px",
     "width": "1px",
     "style": "solid",
     "color": "var(--wp--preset--color--steel)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.875rem",
     "letterSpacing": "0.1em",
     "lineHeight": "1.4"
    },
    "spacing": {
     "padding": {
      "top": "0.875rem",
      "bottom": "0.875rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  },
  "blocks": {
   "core/navigation": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)",
     "letterSpacing": "0.12em"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}