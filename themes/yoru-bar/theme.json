{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "540px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (near-black)", "color": "#0D0D0D" },
				{ "slug": "lifted", "name": "Lifted ground (ink-blue)", "color": "#2A2C33" },
				{ "slug": "ink-blue", "name": "Ink-blue", "color": "#3A3E48" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "muted", "name": "Muted", "color": "#9A968E" },
				{ "slug": "tan", "name": "Tan (accent)", "color": "#B1A28B" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif (EB Garamond)",
					"fontFamily": "\"EB Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/eb-garamond-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "utility",
					"name": "Utility (Work Sans)",
					"fontFamily": "\"Work Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/work-sans-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "1.0625rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "2rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(3rem, 4.9vw, 4.375rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "3rem" },
				{ "slug": "50", "name": "L", "size": "6rem" },
				{ "slug": "60", "name": "XL", "size": "10rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"ease": "cubic-bezier(.47, 0, .745, .715)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--white)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "2.1",
			"letterSpacing": "0.05em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--white)" },
				":hover": { "color": { "text": "var(--wp--preset--color--tan)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "400", "lineHeight": "1", "letterSpacing": "0.01em" },
				"color": { "text": "var(--wp--preset--color--white)" }
			},
			"button": {
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--white)" },
				"color": { "background": "transparent", "text": "var(--wp--preset--color--white)" },
				"typography": { "fontSize": "1.125rem", "fontWeight": "500", "textTransform": "uppercase", "letterSpacing": "0.04em" }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "500", "letterSpacing": "0.08em", "textTransform": "uppercase", "fontSize": "1.125rem", "lineHeight": "1.15" }, "elements": { "link": { "typography": { "textDecoration": "none" } } } },
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } }
		}
	},
	"customTemplates": [
		{ "name": "page-inner", "title": "Inner page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
