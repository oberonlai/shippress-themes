{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1240px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground, cards, tiles)", "color": "#FFFFFF" },
    { "slug": "band", "name": "Grey band", "color": "#DBDBDB" },
    { "slug": "ink", "name": "Ink (text, stage ground)", "color": "#111010" },
    { "slug": "accent", "name": "Teal (buttons, icons, focus)", "color": "#006D80" },
    { "slug": "bark", "name": "Bark (footer, rules)", "color": "#5A4E46" },
    { "slug": "muted", "name": "Muted text", "color": "#5C5A58" },
    { "slug": "hairline", "name": "Hairline", "color": "#CCCCCC" },
    { "slug": "oat", "name": "Oat paper (form fields on bark)", "color": "#FAF9F7" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Onest)",
     "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Onest", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese headings subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-TW.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese headings subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Medium (card title)", "size": "1.3rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.4rem", "max": "1.75rem" } },
    { "slug": "x-large", "name": "Extra large (H2)", "size": "3.125rem", "fluid": { "min": "2.1rem", "max": "3.125rem" } },
    { "slug": "xx-large", "name": "Page stage H1", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } },
    { "slug": "huge", "name": "Home hero", "size": "6.25rem", "fluid": { "min": "2.75rem", "max": "6.25rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "3.125rem" },
    { "slug": "60", "name": "XL", "size": "4rem" },
    { "slug": "70", "name": "Section", "size": "6.25rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "300",
   "lineHeight": "2",
   "letterSpacing": "0.03em"
  },
  "spacing": { "blockGap": "1.5rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.6", "letterSpacing": "0.02em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.05" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "400", "lineHeight": "1.5" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "400", "lineHeight": "1.75" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent)", "text": "#FFFFFF" },
    "border": { "radius": "3px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "400", "letterSpacing": "0.1em", "textDecoration": "none" },
    "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "2rem", "right": "2rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "3px" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--hairline)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
