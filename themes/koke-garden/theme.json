{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Pale moss paper (ground)",
          "color": "#E8EBE3"
        },
        {
          "slug": "lichen",
          "name": "Lichen (footer, quiet cards)",
          "color": "#DCE1D4"
        },
        {
          "slug": "sage",
          "name": "Sage stone (stone cards, rules)",
          "color": "#B9C2AE"
        },
        {
          "slug": "moss",
          "name": "Moss (large type, marks and textures only)",
          "color": "#6B7A55"
        },
        {
          "slug": "deep-moss",
          "name": "Deep moss (small accent text, links, moss cards)",
          "color": "#4E5A3E"
        },
        {
          "slug": "ink",
          "name": "Deep moss ink (text)",
          "color": "#2C3528"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Alegreya)",
          "fontFamily": "Alegreya, Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Alegreya",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alegreya-latin.woff2"
              ]
            },
            {
              "fontFamily": "Alegreya",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alegreya-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Alegreya Sans)",
          "fontFamily": "\"Alegreya Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Alegreya Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alegreyasans-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Alegreya Sans",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alegreyasans-500-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.3125rem, 1.15rem + 0.6vw, 1.625rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.4vw, 2.75rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.375rem, 1.6rem + 3vw, 4.25rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.3125rem, 1.2rem + 0.4vw, 1.5625rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.1875rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep-moss)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.02em",
          "fontWeight": "500",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (quiet bar: wordmark and Menu button for the full-screen moss-paper menu)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (colophon: garden credits, studio details, small menu)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
