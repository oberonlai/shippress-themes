{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "customTemplates": [
  { "name": "page-wide", "title": "Page: full width sections", "postTypes": ["page"] }
 ],
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1380px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (cool paper)", "color": "#F0F2F7" },
    { "slug": "band", "name": "Surface band", "color": "#E8F0F0" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text)", "color": "#13253B" },
    { "slug": "muted", "name": "Muted ink", "color": "#4A5A6E" },
    { "slug": "blue", "name": "Accent blue (small areas)", "color": "#2E5DBC" },
    { "slug": "tekkon", "name": "Tekkon navy (badge)", "color": "#2E3A4B" },
    { "slug": "copper", "name": "Copper (one dot)", "color": "#B5683A" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (IBM Plex Serif)",
     "fontFamily": "\"IBM Plex Serif\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "IBM Plex Serif", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-serif-300-latin.woff2"] },
      { "fontFamily": "IBM Plex Serif", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-serif-400-latin.woff2"] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (IBM Plex Sans)",
     "fontFamily": "\"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "IBM Plex Sans", "fontStyle": "normal", "fontWeight": "400 600", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-sans-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "0.9375rem", "fluid": false },
    { "slug": "medium", "name": "Lead", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Row title", "size": "1.75rem", "fluid": false },
    { "slug": "x-large", "name": "Figures", "size": "2.5rem", "fluid": false },
    { "slug": "xx-large", "name": "Section heading", "size": "clamp(2.25rem, 4vw, 3.5rem)", "fluid": false },
    { "slug": "x-large-display", "name": "Page heading", "size": "clamp(2.6rem, 5vw, 4.25rem)", "fluid": false },
    { "slug": "display", "name": "Hero heading (maximum 5.5rem)", "size": "clamp(2.75rem, 6.1vw, 5.5rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": ["px", "em", "rem", "vh", "vw", "%"],
   "spacingSizes": [
    { "slug": "30", "name": "S", "size": "1rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "Section", "size": "6.25rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "0.9375rem",
   "lineHeight": "1.87",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.18", "letterSpacing": "-0.005em" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large-display)", "lineHeight": "1.14", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
   "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600", "lineHeight": "1.28", "letterSpacing": "0" } },
   "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1.125rem", "fontWeight": "600", "lineHeight": "1.4" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "border": { "radius": "29px" },
    "typography": { "fontSize": "0.9375rem", "fontWeight": "600", "letterSpacing": "0" }
   }
  }
 }
}
