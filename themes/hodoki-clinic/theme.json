{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#ECEFEA"
    },
    {
     "slug": "panel",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "pale",
     "name": "Pale",
     "color": "#F7F8F5"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#33403A"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5F6B65"
    },
    {
     "slug": "accent",
     "name": "Seiji-nezu accent (small areas only)",
     "color": "#6E847C"
    },
    {
     "slug": "accent-dark",
     "name": "Accent dark (filled pill)",
     "color": "#4F6159"
    },
    {
     "slug": "accent-soft",
     "name": "Accent soft (second pill, outlines)",
     "color": "#8FA398"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#DDE3DE"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "5.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "10rem"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Statement",
     "size": "2.25rem"
    },
    {
     "slug": "x-large",
     "name": "Hero title",
     "size": "clamp(2.5rem, 5vw, 4.25rem)"
    },
    {
     "slug": "xx-large",
     "name": "Label",
     "size": "clamp(3rem, 5.6vw, 5rem)"
    },
    {
     "slug": "display",
     "name": "Display phrase",
     "size": "clamp(4.25rem, 11.8vw, 10.625rem)"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page (no title block)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.5",
     "letterSpacing": "0.08em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent-dark)",
     "text": "#FFFFFF"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem",
     "letterSpacing": "0.06em"
    },
    "border": {
     "radius": "100px"
    },
    "spacing": {
     "padding": {
      "top": "0.7rem",
      "bottom": "0.7rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.875rem",
     "letterSpacing": "0.08em"
    }
   }
  }
 }
}
