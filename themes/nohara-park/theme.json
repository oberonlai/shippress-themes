{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1294px",
   "wideSize": "1350px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (page ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Band (ledger, journal, grounds)",
     "color": "#E7E9E4"
    },
    {
     "slug": "panel",
     "name": "Panel (caption cards)",
     "color": "#F2F3EF"
    },
    {
     "slug": "ink",
     "name": "Ink (text, rules)",
     "color": "#1F1F1F"
    },
    {
     "slug": "muted",
     "name": "Muted (units, roles)",
     "color": "#5C5C5C"
    },
    {
     "slug": "line",
     "name": "Light rule (price rows)",
     "color": "#D5D8D0"
    },
    {
     "slug": "olive",
     "name": "Sea-pine olive (pill, badge, links)",
     "color": "#5F6848"
    },
    {
     "slug": "olive-deep",
     "name": "Olive, hover",
     "color": "#4F5739"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#9A3A2C"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset, headings (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small (card line, month line)",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "card",
     "name": "Card title",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "medium-large",
     "name": "H3 / closing row",
     "size": "2rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2rem"
     }
    },
    {
     "slug": "large",
     "name": "Band H2 / book H2",
     "size": "3rem",
     "fluid": {
      "min": "2rem",
      "max": "3rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section heading (H2)",
     "size": "3.5rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Home headline (H1)",
     "size": "4.5rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "Section",
     "size": "7.5rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "400",
     "lineHeight": "1.08"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "400",
     "lineHeight": "1.1"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium-large)",
     "fontWeight": "500",
     "lineHeight": "1.2"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--card)",
     "fontWeight": "500",
     "lineHeight": "1.3"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--olive)"
    },
    "typography": {
     "textDecoration": "none"
    },
    ":hover": {
     "typography": {
      "textDecoration": "underline"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--olive)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "25px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "600",
     "textDecoration": "none"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "2rem",
      "right": "2rem"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "25px"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/separator": {
    "color": {
     "background": "var(--wp--preset--color--ink)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
