{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "1200px", "wideSize": "1312px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Ground", "color": "#FFFFFF" },
				{ "slug": "wash", "name": "Pale wash", "color": "#F3EFF2" },
				{ "slug": "tint", "name": "Second tint", "color": "#E9E3E7" },
				{ "slug": "contrast", "name": "Ink", "color": "#3B373A" },
				{ "slug": "muted", "name": "Muted", "color": "#6B6268" },
				{ "slug": "rule", "name": "Hairline", "color": "#C9C1C6" },
				{ "slug": "accent", "name": "Accent grey-violet", "color": "#6E5E68" },
				{ "slug": "accent-end", "name": "Accent gradient end", "color": "#7D6B77" },
				{ "slug": "accent-dark", "name": "Accent deep", "color": "#54474F" },
				{ "slug": "dot", "name": "Highlight dot", "color": "#A8879B" }
			],
			"gradients": [
				{ "slug": "slab", "name": "Slab", "gradient": "linear-gradient(100deg, #6E5E68, #7D6B77)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Libre Baskerville)",
					"fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Libre Baskerville", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-wght-latin.ttf" ] },
						{ "fontFamily": "Libre Baskerville", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Literata)",
					"fontFamily": "\"Literata\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese (Noto Serif TC subset)",
					"fontFamily": "\"Noto Serif TC\", \"PMingLiU\", \"MingLiU\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese (Noto Serif JP subset)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Body", "size": "1rem" },
				{ "slug": "medium", "name": "Lead", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Heading", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Band title", "size": "3.5rem" },
				{ "slug": "huge", "name": "Hero", "size": "4.5rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "3rem" },
				{ "slug": "50", "name": "XL", "size": "5.75rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.9",
			"letterSpacing": ".01em"
		},
		"spacing": { "blockGap": "1.25rem" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--accent)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } } },
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.35" }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.9375rem", "fontWeight": "500" }
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "0" } }
		}
	}
}
