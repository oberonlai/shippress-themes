   "title": "Home",
   "role": "front",
   "content": "<!-- wp:pattern {\"slug\":\"ueki-gardens/front-hero\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-benches\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-nursery\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-choose\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-saturday\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-services\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-after\"} /-->\n\n<!-- wp:pattern {\"slug\":\"ueki-gardens/front-visit\"} /-->"
  },
  {
   "slug": "in-season",
   "title": "In season",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">What is on the benches changes with the weather. These are the batches we are moving forward this winter, all grown on Alder Lane and acclimatised outdoors first.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">November</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Panicle hydrangea, winter heather bowls, hardy ferns for north balconies.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">From $22</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">December</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Potted rosemary and bay, hellebores, small evergreen shrubs for doorsteps.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">From $14</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">January</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Bare-root fruit shrubs, snowdrop pots, indoor foliage for bright windows.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">From $12</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">February</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Early herbs under glass, hardy perennials, repotting season begins.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">From $14</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">Updated weekly</span><span class=\"uk-pill\">Collect in store</span><span class=\"uk-pill\">Local delivery</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "shop",
   "title": "Plants",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">Everything we sell has spent a season on our benches. Browse by bench, or visit the nursery on Alder Lane and choose in person.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Shrubs &amp; trees</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Hardy woody plants, 3 L – 20 L pots, sun to part shade.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">24 plants</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Perennials</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Border plants and grasses that return every year.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">31 plants</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Herbs &amp; indoor</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Kitchen herbs, ferns and quiet foliage for apartments.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">29 plants</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Panicle hydrangea, 5 L</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Pale lime flower heads, a good shaded front-yard plant.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$38</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Winter heather bowl</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Muted white and pink heather in a shallow bowl.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$22</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Kitchen herb trio</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Basil, thyme and parsley, three small pots.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$14</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Peace lily, 17 cm</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Tolerates low light and a forgetful watering routine.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$28</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">WooCommerce ready</span><span class=\"uk-pill\">Pay online or in store</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "choosing-a-plant",
   "title": "Choosing a plant",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">Five questions we ask before anyone leaves with a plant. They take about two minutes and save most of the replacements we see.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Light</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Which way does the window or border face, and how many hours of direct sun does it get?</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Ask</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Space</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">How tall and wide will the plant be in three years, and what is around it?</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Ask</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Time</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">How often can you realistically water, feed and check on it?</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Ask</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Company</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Do pets, small children or neighbouring plants share the space?</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Ask</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Follow-up</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">We call thirty days after planting to see how it has settled.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Free</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"uk-inner__img\"} -->\n<figure class=\"wp-block-image size-full uk-inner__img\"><img src=\"/wp-content/themes/ueki-gardens/assets/images/c6.webp\" alt=\"A potted rosemary on a white bench.\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">Plant clinic Saturdays</span><span class=\"uk-pill\">Bring a photo</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "services",
   "title": "Services &amp; prices",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">Small, practical services from the same crew that grows the plants. Prices are in USD and include everything listed.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Local delivery</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Within 15 km of Alder Lane. Free on orders over $120.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$12</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Planting visit</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Two gardeners, first hour: soil, siting and watering in.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$65</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Repotting at the counter</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Per pot up to 30 cm, with fresh peat-free compost.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$8</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Plant clinic</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Saturdays 10:00–13:00. Bring a leaf or a photo.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">Free</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Saturday workshop</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Ninety minutes at the benches, materials included.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">$35</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">Book at the counter</span><span class=\"uk-pill\">hello@uekigardens.example</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "aftercare",
   "title": "Aftercare",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">A plant settles over a season, not a week. This is what we do after you take it home, and what we suggest you do.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Spring</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Feed lightly, repot anything that has filled its pot, move indoor plants back from cold glass.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">March – May</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Summer</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Water early, check pots weekly, shade tender foliage at midday.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">June – August</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Autumn</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Plant shrubs and perennials while the soil is still warm; cut back and mulch.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">September – November</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Winter</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Water less, keep leaves dust-free, move frost-tender pots to shelter.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">December – February</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"uk-inner__img\"} -->\n<figure class=\"wp-block-image size-full uk-inner__img\"><img src=\"/wp-content/themes/ueki-gardens/assets/images/c5.webp\" alt=\"Hands repotting a small fern into a terracotta pot.\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">30-day check-in call</span><span class=\"uk-pill\">Saturday clinic</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "about",
   "title": "About the nursery",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">Elena Marsh founded Ueki Gardens in 1998 on Alder Lane in Fernhill with one glasshouse and one idea: grow plants an ordinary household can keep alive. Today there are six glasshouse bays and forty-two benches, still run as an independent garden centre.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The name comes from <em>ueki</em>, the Japanese word for a plant grown to be kept in a pot or garden. Nothing else here is Japanese; we simply liked the word.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Elena Marsh</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Founder, Glasshouse</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">1998</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Tomás Reyes</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Head Grower, Shrubs &amp; Trees</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Priya Nair</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Grower, Perennials &amp; Herbs</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Jonah Feld</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Grower, Indoor Plants</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Amara Okoye</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Plant Clinic &amp; Aftercare Lead</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Lukas Brandt</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Delivery &amp; Planting Crew Lead</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Mei Lin Ho</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Workshop Coordinator</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\"></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "visit",
   "title": "Visit",
   "content": "<!-- wp:group {\"className\":\"uk-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-inner\"><!-- wp:paragraph {\"className\":\"uk-lead\"} -->\n<p class=\"uk-lead\">14 Alder Lane, Fernhill. The glasshouse doors are open every day and there is bicycle parking by the gate.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"uk-ledger\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-ledger\">\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Monday – Saturday</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Glasshouse, yard and counter</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">8:30–18:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Sunday</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Glasshouse and counter</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">10:00–17:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"uk-svc\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group uk-svc\"><!-- wp:paragraph {\"className\":\"uk-svc__n\"} -->\n<p class=\"uk-svc__n\">Plant clinic</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__d\"} -->\n<p class=\"uk-svc__d\">Saturday mornings at the counter</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"uk-svc__p\"} -->\n<p class=\"uk-svc__p\">10:00–13:00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Phone +1 555 014 8820 · hello@uekigardens.example</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"uk-pills\"} -->\n<p class=\"uk-pills\"><span class=\"uk-pill\">Bicycle rack</span><span class=\"uk-pill\">Step-free entrance</span><span class=\"uk-pill\">Dogs on leads welcome</span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"
  },
