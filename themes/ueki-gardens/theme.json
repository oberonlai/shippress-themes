{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FEFFFE"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0B110C"
    },
    {
     "slug": "body",
     "name": "Body",
     "color": "#3E3E3E"
    },
    {
     "slug": "main",
     "name": "Seiji moss",
     "color": "#748578"
    },
    {
     "slug": "band",
     "name": "Seiji band",
     "color": "#D5DDD7"
    },
    {
     "slug": "pale",
     "name": "Pale",
     "color": "#F2F5F3"
    },
    {
     "slug": "clay",
     "name": "Clay",
     "color": "#B8714E"
    }
   ]
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Figtree)",
     "fontFamily": "\"Figtree\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2199, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2199, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Traditional Chinese (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.6rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "4.375rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "clamp(3rem, 8.7vw, 7.8125rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vh",
    "vw"
   ],
   "defaultSpacingSizes": false,
   "spacingSizes": [
    {
     "slug": "10",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "clamp(1.25rem, 3vw, 2.5rem)"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "clamp(3rem, 6vw, 6rem)"
    },
    {
     "slug": "60",
     "name": "Section",
     "size": "clamp(6rem, 11vw, 10rem)"
    }
   ]
  },
  "custom": {
   "radius": "5px",
   "pill": "100px",
   "rule": "1px solid rgba(11,17,12,.2)",
   "ease": "cubic-bezier(.25,1,.5,1)"
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--body)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": {
    "left": "var(--wp--preset--spacing--40)",
    "right": "var(--wp--preset--spacing--40)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "500",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1",
     "textTransform": "uppercase"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--ground)"
    },
    "border": {
     "radius": "100px"
    },
    "typography": {
     "fontSize": "1rem",
     "fontWeight": "500"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}