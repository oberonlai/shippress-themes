{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "950px",
   "wideSize": "1312px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "white", "name": "White (ground, ticker bar)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (season board, newsletter, footer, text)", "color": "#130E15" },
    { "slug": "mist", "name": "Mist (menu overlay, journal, pills)", "color": "#EEECEF" },
    { "slug": "dim", "name": "Dim (marquee line and meta on ink)", "color": "#8F8A93" },
    { "slug": "plum", "name": "Plum (flood tile one, cue dot, focus)", "color": "#824880" },
    { "slug": "aubergine", "name": "Aubergine (flood tile two)", "color": "#3C1F3D" },
    { "slug": "lilac", "name": "Lilac (flood tile three)", "color": "#E3D8E4" },
    { "slug": "petal", "name": "Petal (text on aubergine)", "color": "#F4EEF4" },
    { "slug": "rule", "name": "Rule (hairlines)", "color": "#D8D3DA" },
    { "slug": "muted", "name": "Muted (notes on white)", "color": "#5E5862" },
    { "slug": "error", "name": "Error", "color": "#A3263B" },
    { "slug": "success", "name": "Success", "color": "#2F6B4F" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Playfair Display)",
     "fontFamily": "\"Playfair Display\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Playfair Display",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/playfair-display-variable.woff2" ]
      },
      {
       "fontFamily": "Playfair Display",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/playfair-display-italic-variable.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/source-sans-3-variable.woff2" ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "X-small", "size": ".75rem" },
    { "slug": "small", "name": "Small", "size": ".9375rem" },
    { "slug": "medium", "name": "Medium", "size": "1.125rem" },
    { "slug": "large", "name": "Large", "size": "1.25rem" },
    { "slug": "x-large", "name": "X-large", "size": "1.5rem" },
    { "slug": "xx-large", "name": "XX-large", "size": "3.125rem" },
    { "slug": "huge", "name": "Huge", "size": "4.25rem" },
    { "slug": "display", "name": "Display", "size": "4.625rem" }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "vw", "%" ],
   "spacingSizes": [
    { "slug": "20", "name": "1", "size": "8px" },
    { "slug": "30", "name": "2", "size": "16px" },
    { "slug": "40", "name": "3", "size": "32px" },
    { "slug": "50", "name": "4", "size": "64px" },
    { "slug": "60", "name": "5", "size": "96px" },
    { "slug": "70", "name": "6", "size": "128px" },
    { "slug": "80", "name": "7", "size": "160px" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.55",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.06"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.06",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.06",
     "letterSpacing": "-.01em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.2"
    }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--plum)" } }
   },
   "button": {
    "border": { "radius": "52px" },
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1.125rem",
     "fontWeight": "600",
     "letterSpacing": ".02em",
     "lineHeight": "1.1",
     "textTransform": "uppercase"
    },
    "spacing": {
     "padding": { "top": "14px", "bottom": "10px", "left": "40px", "right": "40px" }
    }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "52px" } },
   "core/image": { "border": { "radius": "0" } },
   "core/cover": { "border": { "radius": "0" } }
  }
 }
}
