{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "espresso", "name": "Espresso", "color": "#1A1410" },
        { "slug": "roast", "name": "Dark roast", "color": "#2A211A" },
        { "slug": "line", "name": "Counter line", "color": "#3D3128" },
        { "slug": "ceramic", "name": "Soft ceramic", "color": "#8B7355" },
        { "slug": "latte", "name": "Latte (muted text on dark)", "color": "#BFAE96" },
        { "slug": "amber", "name": "Roasted amber", "color": "#C47A3A" },
        { "slug": "amber-deep", "name": "Deep amber (links on cream)", "color": "#9A5523" },
        { "slug": "bark", "name": "Bark (muted text on cream)", "color": "#5E4B3A" },
        { "slug": "paper", "name": "Menu paper", "color": "#E8DECF" },
        { "slug": "cream", "name": "Warm cream", "color": "#F3EDE4" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Fraunces)",
          "fontFamily": "Fraunces, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (DM Sans)",
          "fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            { "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "100 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "hand",
          "name": "Hand-lettered (Caveat)",
          "fontFamily": "Caveat, \"Segoe Print\", \"Bradley Hand\", cursive",
          "fontFace": [
            { "fontFamily": "Caveat", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/caveat-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Extra small", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium (body)", "size": "1.0625rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)" },
        { "slug": "x-large", "name": "Extra large", "size": "clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem)" },
        { "slug": "xx-large", "name": "2X large", "size": "clamp(2.25rem, 1.5rem + 2.8vw, 4rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.75rem, 1.4rem + 5.4vw, 6.5rem)" },
        { "slug": "hand", "name": "Hand note", "size": "clamp(1.5rem, 1.3rem + 0.8vw, 2rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.5rem" },
        { "slug": "20", "name": "2", "size": "0.875rem" },
        { "slug": "30", "name": "3", "size": "1.5rem" },
        { "slug": "40", "name": "4", "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem)" },
        { "slug": "50", "name": "5", "size": "clamp(2.5rem, 1.6rem + 3vw, 4.5rem)" },
        { "slug": "60", "name": "6", "size": "clamp(3.5rem, 2rem + 5vw, 7rem)" },
        { "slug": "70", "name": "7", "size": "clamp(5rem, 3rem + 7vw, 10rem)" }
      ]
    },
    "custom": {
      "radius": "18px",
      "hairline": "1px solid var(--wp--preset--color--line)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|espresso",
      "text": "var:preset|color|cream"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": { "text": "currentColor" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|amber" } },
        ":focus": { "color": { "text": "var:preset|color|amber" } }
      },
      "heading": {
        "color": { "text": "inherit" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "380",
          "lineHeight": "1.08",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large", "lineHeight": "1.3", "letterSpacing": "0" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|medium", "lineHeight": "1.4", "letterSpacing": "0" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.08em", "textTransform": "uppercase" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "letterSpacing": "0.16em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|amber", "text": "var:preset|color|espresso" },
        "border": { "radius": "999px", "width": "1px", "style": "solid", "color": "var:preset|color|amber" },
        "spacing": { "padding": { "top": "0.85rem", "right": "1.6rem", "bottom": "0.85rem", "left": "1.6rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.02em", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|cream", "text": "var:preset|color|espresso" }, "border": { "color": "var:preset|color|cream" } },
        ":focus": { "color": { "background": "var:preset|color|cream", "text": "var:preset|color|espresso" }, "border": { "color": "var:preset|color|cream" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|latte" },
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.04em" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.5rem", "fontStyle": "italic", "fontWeight": "420", "letterSpacing": "-0.01em", "lineHeight": "1" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/navigation": {
        "typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500", "letterSpacing": "0.02em" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|latte" },
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.08em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.08em", "textTransform": "uppercase", "fontWeight": "600" },
        "elements": { "link": { "color": { "text": "var:preset|color|amber" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|latte" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.7" }
      },
      "core/query-title": {
        "typography": { "fontFamily": "var:preset|font-family|display" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|line" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "spacing": { "padding": { "left": "0px" } },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|large", "lineHeight": "1.45" }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.25" }
      },
      "core/image": {
        "border": { "radius": "var:custom|radius" }
      },
      "core/post-featured-image": {
        "border": { "radius": "var:custom|radius" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About", "postTypes": ["page"] },
    { "name": "page-menu", "title": "Menu", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Newsletter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
