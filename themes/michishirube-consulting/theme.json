{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Cloud white (ground)",
					"color": "#F5F7FA"
				},
				{
					"slug": "navy",
					"name": "Deep navy (main colour, large fields)",
					"color": "#1E3A5F"
				},
				{
					"slug": "mist",
					"name": "Mist blue grey (soft panels)",
					"color": "#E6ECF3"
				},
				{
					"slug": "ink",
					"name": "Midnight navy ink (text, side rail, footer)",
					"color": "#0E1B2E"
				},
				{
					"slug": "deep",
					"name": "Indigo blue (links and labels on light grounds)",
					"color": "#2A5585"
				},
				{
					"slug": "quiet",
					"name": "Slate grey (secondary text)",
					"color": "#4A5868"
				},
				{
					"slug": "pale",
					"name": "Pale steel blue (labels on ink and on navy)",
					"color": "#BFD0E3"
				},
				{
					"slug": "brass",
					"name": "Muted brass (small accents only: rail marker, rules)",
					"color": "#C9A66B"
				},
				{
					"slug": "field-ink",
					"name": "White (type on the navy field)",
					"color": "#FFFFFF"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (BIZ UDMincho)",
					"fontFamily": "\"BIZ UDMincho\", \"Hiragino Mincho ProN\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "BIZ UDMincho",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/biz-udmincho-700-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (BIZ UDMincho JA)",
					"fontFamily": "\"BIZ UDMincho JA\", \"Hiragino Mincho ProN\", serif",
					"fontFace": [
						{
							"fontFamily": "BIZ UDMincho JA",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/biz-udmincho-700-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"PMingLiU\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Crimson Pro)",
					"fontFamily": "\"Crimson Pro\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Crimson Pro",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/crimson-pro-400-latin.woff2"
							]
						},
						{
							"fontFamily": "Crimson Pro",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/crimson-pro-600-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
			"lineHeight": "1.8",
			"fontWeight": "300"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4.5vw, 3.5rem)",
				"right": "clamp(1.25rem, 4.5vw, 3.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.25",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "#F4F7F2"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontSize": "0.9375rem",
					"letterSpacing": "0.04em",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (top bar: workshop name, Request a survey button; the menu as a fixed side rail on wide screens)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (ink field: house name, synced house details and the menu)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
