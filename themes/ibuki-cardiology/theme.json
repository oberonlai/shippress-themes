{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1073px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text, blocks)",
     "color": "#131414"
    },
    {
     "slug": "main",
     "name": "Slate green (band)",
     "color": "#5F6F68"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#EEF0EF"
    },
    {
     "slug": "ghost",
     "name": "Ghost (hairlines)",
     "color": "#E7E7E8"
    },
    {
     "slug": "deep",
     "name": "Deep slate",
     "color": "#3D4843"
    },
    {
     "slug": "accent",
     "name": "Heart red (dots only)",
     "color": "#B4574F"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5A605D"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.5rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "3.5rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "5.5rem",
     "fluid": {
      "min": "3rem",
      "max": "5.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "clamp(3rem, 6vw, 5rem)"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(3rem, 9.5vw, 8.5rem)"
    }
   ]
  },
  "border": {
   "radius": false,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "500",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.1",
     "letterSpacing": "-0.04em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "letterSpacing": "-0.02em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "500"
    }
   }
  },
  "blocks": {
   "core/post-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600"
    }
   },
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "letterSpacing": "-0.03em"
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "1rem",
     "fontWeight": "500"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
