   "content": "<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-kv\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-statement\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-stalls\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-method\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-stories\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-room\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-fees\"} /-->\n\n<!-- wp:pattern {\"slug\":\"eiyo-clinic/front-close\"} /-->"
