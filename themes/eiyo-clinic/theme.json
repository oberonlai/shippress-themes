{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "680px", "wideSize": "1290px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "paper", "name": "Paper (cool mist)", "color": "#F1F3F0" },
				{ "slug": "ink", "name": "Ink", "color": "#303030" },
				{ "slug": "pine", "name": "Pine (main)", "color": "#2C4038" },
				{ "slug": "pine-deep", "name": "Pine deep", "color": "#22332C" },
				{ "slug": "pine-phrase", "name": "Pine phrase", "color": "#3A5247" },
				{ "slug": "sage", "name": "Sage", "color": "#6E8A7B" },
				{ "slug": "muted", "name": "Muted", "color": "#6F7471" },
				{ "slug": "rule", "name": "Rule", "color": "#D5DBD7" },
				{ "slug": "accent", "name": "Persimmon (dot)", "color": "#D26A45" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "instrument-sans",
					"name": "Headings (Instrument Sans)",
					"fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "public-sans",
					"name": "Body (Public Sans)",
					"fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.6875rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.3125rem" },
				{ "slug": "xx-large", "name": "Display", "size": "4.25rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "2.5rem" },
				{ "slug": "50", "name": "L", "size": "5rem" },
				{ "slug": "60", "name": "XL", "size": "8.75rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"ease": "cubic-bezier(.165, .84, .44, 1)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--public-sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--pine)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--instrument-sans)", "fontWeight": "600", "lineHeight": "1.6" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"border": { "radius": "4px" },
				"color": { "background": "var(--wp--preset--color--pine)", "text": "var(--wp--preset--color--base)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--instrument-sans)", "fontSize": "0.9375rem", "fontWeight": "500" },
				"spacing": { "padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.25rem", "right": "1.25rem" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--instrument-sans)", "fontWeight": "600", "fontSize": "1.375rem" } },
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.4" } }
		}
	},
	"customTemplates": [
		{ "name": "page-inner", "title": "Inner page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
