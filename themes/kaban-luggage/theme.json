{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1220px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "night",
     "name": "Night (dark ground)",
     "color": "#0D0C0A"
    },
    {
     "slug": "ink-band",
     "name": "Ink band",
     "color": "#1A1A1A"
    },
    {
     "slug": "paper",
     "name": "Paper",
     "color": "#EBE7E1"
    },
    {
     "slug": "paper-mid",
     "name": "Paper mid",
     "color": "#DBD4C8"
    },
    {
     "slug": "paper-deep",
     "name": "Paper deep",
     "color": "#D2CAB8"
    },
    {
     "slug": "ink",
     "name": "Ink (text on paper)",
     "color": "#251B0F"
    },
    {
     "slug": "muted",
     "name": "Muted (on dark)",
     "color": "#A2998C"
    },
    {
     "slug": "bark",
     "name": "Bark (accent)",
     "color": "#6B5848"
    },
    {
     "slug": "oxblood",
     "name": "Oxblood (sub-labels)",
     "color": "#8D0000"
    },
    {
     "slug": "oxblood-dark",
     "name": "Oxblood on dark",
     "color": "#B33A2E"
    },
    {
     "slug": "hairline",
     "name": "Olive hairline",
     "color": "#8A8466"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Outfit)",
     "fontFamily": "\"Outfit\", \"Albert Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2rem, 1.3rem + 1.9vw, 2.6rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.6rem, 1.6rem + 2.6vw, 4.5rem)",
     "fluid": false
    },
    {
     "slug": "colossal",
     "name": "Vertical title (maximum 7.5rem)",
     "size": "clamp(4.5rem, 7.5vw, 7.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.125rem",
   "lineHeight": "1.9",
   "fontWeight": "400",
   "letterSpacing": "0.03em"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4vw, 3rem)",
    "right": "clamp(1.25rem, 4vw, 3rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.4",
     "letterSpacing": "0.1em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "300",
     "lineHeight": "1.1",
     "letterSpacing": "0.02em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "300",
     "lineHeight": "1.25",
     "letterSpacing": "0.02em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.08em",
     "fontWeight": "400"
    },
    "spacing": {
     "padding": {
      "top": "0.9rem",
      "bottom": "0.9rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}
