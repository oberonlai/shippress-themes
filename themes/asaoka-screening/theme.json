{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "860px",
   "wideSize": "1220px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Ground (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "mist",
     "name": "Mist band",
     "color": "#EAF0EE"
    },
    {
     "slug": "tint",
     "name": "Tint",
     "color": "#D6E3DF"
    },
    {
     "slug": "teal",
     "name": "Slate teal (main)",
     "color": "#5E7D78"
    },
    {
     "slug": "deep",
     "name": "Deep teal",
     "color": "#3F5A56"
    },
    {
     "slug": "ink",
     "name": "Text",
     "color": "#2F3B39"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5E6B69"
    },
    {
     "slug": "coral",
     "name": "Coral (CTA and tab only)",
     "color": "#E9795C"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#D3DEDB"
    }
   ],
   "gradients": [
    {
     "slug": "long-pill",
     "name": "Long pill",
     "gradient": "linear-gradient(90deg,#5E7D78,#7FA39C)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Kaku Gothic ProN\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-600-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Chip",
     "size": "0.8125rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Lead",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "H3",
     "size": "1.75rem"
    },
    {
     "slug": "xx-large",
     "name": "H2",
     "size": "2.25rem"
    },
    {
     "slug": "xxx-large",
     "name": "Large title",
     "size": "3rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.6rem, 5vw, 4.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "XXL",
     "size": "7rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "glow",
     "name": "Teal glow",
     "shadow": "0 0 32px rgba(63,90,86,.10)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "var(--as-gutter, 20px)",
    "right": "var(--as-gutter, 20px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.3",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.15"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--teal)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--teal)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.7rem",
      "bottom": "0.7rem",
      "left": "1.6rem",
      "right": "1.6rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--deep)",
      "text": "#FFFFFF"
     }
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--rule)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}