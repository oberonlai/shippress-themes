{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "night",
          "name": "Night (green-black ground)",
          "color": "#121414"
        },
        {
          "slug": "bottle",
          "name": "Bottle green (cards, sections)",
          "color": "#1E2422"
        },
        {
          "slug": "parchment",
          "name": "Parchment (text)",
          "color": "#D8CDB4"
        },
        {
          "slug": "gold",
          "name": "Antique gold (hairlines, leaders, accents)",
          "color": "#A88B55"
        },
        {
          "slug": "quiet",
          "name": "Quiet parchment (secondary text)",
          "color": "#A39D8A"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Noto Serif Display)",
          "fontFamily": "\"Noto Serif Display\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Noto Serif Display",
              "fontStyle": "normal",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-serif-display-light-latin.woff2"
              ]
            },
            {
              "fontFamily": "Noto Serif Display",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-serif-display-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Noto Serif Display",
              "fontStyle": "italic",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-serif-display-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Josefin Sans)",
          "fontFamily": "\"Josefin Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Josefin Sans",
              "fontStyle": "normal",
              "fontWeight": "100 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/JosefinSans[wght].ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.4vw, 2.75rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.75rem, 1.8rem + 3.8vw, 5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--night)",
      "text": "var(--wp--preset--color--parchment)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.8",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 5vw, 4rem)",
        "right": "clamp(1.25rem, 5vw, 4rem)"
      },
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "300",
          "lineHeight": "1.2",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--parchment)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--parchment)"
        }
      },
      "button": {
        "color": {
          "background": "transparent",
          "text": "var(--wp--preset--color--parchment)"
        },
        "border": {
          "radius": "0",
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--gold)"
        },
        "typography": {
          "fontSize": "0.75rem",
          "letterSpacing": "0.24em",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "0.85rem",
            "left": "2rem",
            "right": "2rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (the name and menu in vertical type on the right edge)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (one hairline-gold line: name, address, hours, reservations)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
