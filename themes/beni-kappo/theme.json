{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "sumi", "name": "Sumi lacquer black (ground)", "color": "#110D0C" },
        { "slug": "urushi", "name": "Urushi (raised panel)", "color": "#1B1412" },
        { "slug": "kurobeni", "name": "Kurobeni (deep red-black panel)", "color": "#2B1210" },
        { "slug": "hairline", "name": "Hairline", "color": "#3B2B26" },
        { "slug": "shu", "name": "Shu red (buttons, noren)", "color": "#B8281D" },
        { "slug": "beni", "name": "Beni vermilion (accent text)", "color": "#E8553D" },
        { "slug": "kin", "name": "Kin gold leaf (highlights)", "color": "#CFA65A" },
        { "slug": "mute", "name": "Smoke (quiet text)", "color": "#B3A493" },
        { "slug": "washi", "name": "Washi off-white (text)", "color": "#F2E9DA" }
      ],
      "gradients": [
        { "slug": "lantern", "name": "Lantern glow", "gradient": "radial-gradient(44% 46% at 78% 42%, rgba(232,85,61,.26) 0%, rgba(17,13,12,0) 72%), radial-gradient(34% 38% at 12% 70%, rgba(207,166,90,.09) 0%, rgba(17,13,12,0) 72%)" },
        { "slug": "ember", "name": "Ember", "gradient": "linear-gradient(180deg, #2B1210 0%, #110D0C 100%)" },
        { "slug": "noren", "name": "Noren red", "gradient": "linear-gradient(180deg, #C42F22 0%, #8E1D14 100%)" }
      ],
      "duotone": [
        { "slug": "sumi-washi", "name": "Sumi and washi", "colors": ["#110D0C", "#F2E9DA"] },
        { "slug": "kurobeni-kin", "name": "Kurobeni and gold", "colors": ["#2B1210", "#E8C987"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Playfair Display)",
          "fontFamily": "\"Playfair Display\", \"Didot\", \"Bodoni 72\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Text (Schibsted Grotesk)",
          "fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "brush",
          "name": "Brush numerals (Kaushan Script)",
          "fontFamily": "\"Kaushan Script\", \"Brush Script MT\", cursive",
          "fontFace": [
            { "fontFamily": "Kaushan Script", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/kaushan-script-400-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.625rem" } },
        { "slug": "xx-large", "name": "Section title", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } },
        { "slug": "display", "name": "Display", "size": "6.5rem", "fluid": { "min": "3.25rem", "max": "7.5rem" } },
        { "slug": "numeral", "name": "Brush numeral", "size": "11rem", "fluid": { "min": "6.5rem", "max": "13rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Grain", "size": "0.5rem" },
        { "slug": "20", "name": "Slice", "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)" },
        { "slug": "30", "name": "Plate", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)" },
        { "slug": "40", "name": "Counter", "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)" },
        { "slug": "50", "name": "Course", "size": "clamp(3rem, 1.8rem + 4.2vw, 6.5rem)" },
        { "slug": "60", "name": "Interval", "size": "clamp(4.5rem, 2.4rem + 7vw, 10rem)" },
        { "slug": "70", "name": "Night", "size": "clamp(6rem, 3rem + 10.5vw, 15rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.2, .7, .1, 1)",
      "flicker": "7s"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|sumi",
      "text": "var:preset|color|washi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|beni" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|washi" } },
        ":focus": { "color": { "text": "var:preset|color|washi" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|washi" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "600",
          "lineHeight": "1.02",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "700", "lineHeight": "0.96", "letterSpacing": "-0.03em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "650", "lineHeight": "1", "letterSpacing": "-0.025em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "600" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "600", "letterSpacing": "-0.01em" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "700", "letterSpacing": "0" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "700", "letterSpacing": "0.22em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|shu", "text": "var:preset|color|washi" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|shu", "radius": "0px" },
        "spacing": { "padding": { "top": "1rem", "right": "1.9rem", "bottom": "1rem", "left": "1.9rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "700", "letterSpacing": "0.18em", "textTransform": "uppercase", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|washi", "text": "var:preset|color|sumi" }, "border": { "color": "var:preset|color|washi" } },
        ":focus": { "color": { "background": "var:preset|color|washi", "text": "var:preset|color|sumi" }, "border": { "color": "var:preset|color|washi" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "lineHeight": "1.55", "letterSpacing": "0.02em" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.5rem", "fontWeight": "700", "fontStyle": "italic", "letterSpacing": "-0.01em", "lineHeight": "1" },
        "elements": { "link": { "color": { "text": "var:preset|color|washi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.6875rem", "fontWeight": "600", "letterSpacing": "0.2em", "textTransform": "uppercase" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "600", "letterSpacing": "0.16em", "textTransform": "uppercase", "lineHeight": "1.3" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "650", "letterSpacing": "-0.02em", "lineHeight": "1.02" },
        "elements": { "link": { "color": { "text": "var:preset|color|washi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|kin" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "700", "letterSpacing": "0.2em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "700", "letterSpacing": "0.2em", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|beni" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.7" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "700" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|mute" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "500", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.2" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "600", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.05" }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/details": {
        "typography": { "fontSize": "var:preset|font-size|medium" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.3em;text-decoration-thickness:1px;transition:color .35s ease,text-decoration-color .35s ease}::selection{background:var(--wp--preset--color--shu);color:var(--wp--preset--color--washi)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About the counter", "postTypes": ["page"] },
    { "name": "page-menu", "title": "Menu: courses and sake", "postTypes": ["page"] },
    { "name": "page-reservations", "title": "Reservations", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Season letter (newsletter)", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
