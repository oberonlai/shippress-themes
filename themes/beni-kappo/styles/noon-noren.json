{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Noon Noren",
  "settings": {
    "color": {
      "palette": [
        { "slug": "sumi", "name": "Washi daylight (ground)", "color": "#F3ECE0" },
        { "slug": "urushi", "name": "Paper (raised panel)", "color": "#FBF7F0" },
        { "slug": "kurobeni", "name": "Persimmon blush (deep panel)", "color": "#EBDCCB" },
        { "slug": "hairline", "name": "Hairline", "color": "#D8C8B4" },
        { "slug": "shu", "name": "Shu red (buttons, noren)", "color": "#B8281D" },
        { "slug": "beni", "name": "Beni (accent text)", "color": "#A82618" },
        { "slug": "kin", "name": "Old gold", "color": "#76581F" },
        { "slug": "mute", "name": "Smoke (quiet text)", "color": "#5E524A" },
        { "slug": "washi", "name": "Sumi ink (text)", "color": "#1A1311" }
      ],
      "gradients": [
        { "slug": "lantern", "name": "Lantern glow", "gradient": "radial-gradient(44% 46% at 78% 42%, rgba(184,40,29,.10) 0%, rgba(243,236,224,0) 72%), radial-gradient(34% 38% at 12% 70%, rgba(118,88,31,.07) 0%, rgba(243,236,224,0) 72%)" },
        { "slug": "ember", "name": "Ember", "gradient": "linear-gradient(180deg, #EBDCCB 0%, #F3ECE0 100%)" },
        { "slug": "noren", "name": "Noren red", "gradient": "linear-gradient(180deg, #C42F22 0%, #8E1D14 100%)" }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|shu", "text": "#FBF7F0" },
        "border": { "color": "var:preset|color|shu" },
        ":hover": { "color": { "background": "var:preset|color|washi", "text": "var:preset|color|sumi" }, "border": { "color": "var:preset|color|washi" } },
        ":focus": { "color": { "background": "var:preset|color|washi", "text": "var:preset|color|sumi" }, "border": { "color": "var:preset|color|washi" } }
      }
    }
  }
}
