{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Ground (cool off-white)",
     "color": "#F6F5F2"
    },
    {
     "slug": "ink",
     "name": "Ink (frame, words, bands)",
     "color": "#1E2C30"
    },
    {
     "slug": "mist",
     "name": "Steel mist (second ground)",
     "color": "#D9E0E0"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#262629"
    },
    {
     "slug": "brick",
     "name": "Brick (small accents)",
     "color": "#A8432F"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5D6669"
    },
    {
     "slug": "rule",
     "name": "Rule (light)",
     "color": "#C9D0D0"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", \"Songti TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Card title",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Subtitle",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Heading",
     "size": "2.75rem",
     "fluid": {
      "min": "2rem",
      "max": "2.75rem"
     }
    },
    {
     "slug": "xxx-large",
     "name": "Section word",
     "size": "6.5rem",
     "fluid": {
      "min": "3.5rem",
      "max": "6.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "clamp(2rem, 4vw, 3rem)"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(3rem, 6vw, 5rem)"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(4.5rem, 8.3vw, 7.5rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": {
    "left": "var(--sj-frame, 8px)",
    "right": "var(--sj-frame, 8px)"
   },
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   }
  }
 }
}