{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "pine", "name": "Old pine (ground)", "color": "#3E5346" },
    { "slug": "pine-deep", "name": "Pine deep", "color": "#2E3D33" },
    { "slug": "sand", "name": "Sand (text on dark)", "color": "#E8E2D4" },
    { "slug": "stone", "name": "Stone (sheets)", "color": "#E3E5DD" },
    { "slug": "tan", "name": "Tan", "color": "#CDBE9F" },
    { "slug": "brass", "name": "Brass (accent)", "color": "#B8956A" },
    { "slug": "ink", "name": "Ink", "color": "#201F1D" },
    { "slug": "muted", "name": "Muted text", "color": "#5C625C" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Cormorant Garamond", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-variable-latin.woff2" ] },
      { "fontFamily": "Cormorant Garamond", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "noto-serif-tc",
     "name": "Noto Serif TC",
     "fontFamily": "\"Noto Serif TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "noto-serif-jp",
     "name": "Noto Serif JP",
     "fontFamily": "\"Noto Serif JP\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Text (EB Garamond)",
     "fontFamily": "\"EB Garamond\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "EB Garamond", "fontStyle": "normal", "fontWeight": "400 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/eb-garamond-variable-latin.woff2" ] },
      { "fontFamily": "EB Garamond", "fontStyle": "italic", "fontWeight": "400 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/eb-garamond-italic-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem" },
    { "slug": "base", "name": "Base", "size": "1.0625rem" },
    { "slug": "medium", "name": "Medium", "size": "1.25rem" },
    { "slug": "large", "name": "Large", "size": "2rem" },
    { "slug": "x-large", "name": "X-large", "size": "3rem" },
    { "slug": "xx-large", "name": "XX-large", "size": "4.5rem" },
    { "slug": "display", "name": "Display word", "size": "clamp(5.5rem, 13vw, 13rem)" }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vh", "vw", "%" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M", "size": "2.5rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "XL", "size": "6rem" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false, "presets": [] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--stone)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.8", "letterSpacing": "0.02em" },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.2" } },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "400" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "link": { "color": { "text": "currentColor" }, ":hover": { "typography": { "textDecoration": "none" } } },
   "button": {
    "border": { "radius": "4px" },
    "color": { "background": "transparent", "text": "var(--wp--preset--color--sand)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "500", "letterSpacing": "0.06em" }
   }
  },
  "blocks": {
   "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500" } },
   "core/image": { "border": { "radius": "0" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
