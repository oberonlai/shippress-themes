{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1264px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F7F8F2"
    },
    {
     "slug": "ground-2",
     "name": "Ground 2",
     "color": "#F1F2E9"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#2D2D2D"
    },
    {
     "slug": "olive",
     "name": "Main olive",
     "color": "#5F6348"
    },
    {
     "slug": "stone",
     "name": "Stone green",
     "color": "#8E9877"
    },
    {
     "slug": "sage",
     "name": "Sage",
     "color": "#A8AF8B"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#DDE3CF"
    },
    {
     "slug": "pollen",
     "name": "Pollen",
     "color": "#E8C766"
    },
    {
     "slug": "gold",
     "name": "Pollen gold",
     "color": "#C9A04A"
    },
    {
     "slug": "clay",
     "name": "Clay",
     "color": "#C27A52"
    },
    {
     "slug": "clay-soft",
     "name": "Soft clay",
     "color": "#F0B48C"
    },
    {
     "slug": "band",
     "name": "CTA band",
     "color": "#F3EBC6"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#D6D9C8"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5C5E52"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-400-zh-tw.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-700-zh-tw.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Caption",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Label",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1.125rem"
    },
    {
     "slug": "medium",
     "name": "Pull line",
     "size": "1.375rem"
    },
    {
     "slug": "large",
     "name": "Heading 3",
     "size": "2rem"
    },
    {
     "slug": "x-large",
     "name": "Heading 2",
     "size": "clamp(2rem, 3vw, 2.625rem)"
    },
    {
     "slug": "xx-large",
     "name": "Hero heading",
     "size": "clamp(2.75rem, 5vw, 4.5rem)"
    },
    {
     "slug": "number",
     "name": "Big number",
     "size": "5.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.8",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.25",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.12"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--olive)"
    }
   }
  }
 }
}