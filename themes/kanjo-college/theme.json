{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "680px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Ground", "color": "#EEF2F3" },
    { "slug": "band", "name": "Band", "color": "#DDE4E7" },
    { "slug": "slate", "name": "Slate", "color": "#5C6A72" },
    { "slug": "ink", "name": "Ink", "color": "#1F2A30" },
    { "slug": "accent", "name": "Ledger red", "color": "#B4533C" },
    { "slug": "panel", "name": "Panel", "color": "#F7F9F9" },
    { "slug": "tint-1", "name": "Tint 1", "color": "#DDE4E7" },
    { "slug": "tint-2", "name": "Tint 2", "color": "#E6E1DA" },
    { "slug": "tint-3", "name": "Tint 3", "color": "#D9E3E0" },
    { "slug": "tint-4", "name": "Tint 4", "color": "#E3E6EC" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Lead", "size": "1.125rem", "fluid": false },
    { "slug": "large", "name": "Card title", "size": "1.25rem", "fluid": false },
    { "slug": "x-large", "name": "Heading", "size": "clamp(2rem, 1.2rem + 2.2vw, 2.75rem)", "fluid": false },
    { "slug": "xx-large", "name": "Display (maximum 4.75rem)", "size": "clamp(2.75rem, 0.9rem + 5.2vw, 4.75rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": { "blockGap": "1.25rem" },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.08" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25", "letterSpacing": "0" } },
   "h4": { "typography": { "fontSize": "1.0625rem", "letterSpacing": "0" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "#FFFFFF" },
    "border": { "radius": "4px" },
    "typography": { "fontSize": "0.9375rem", "fontWeight": "600", "letterSpacing": "0" },
    "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" } }
   }
  }
 }
}
