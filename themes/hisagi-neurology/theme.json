{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "920px", "wideSize": "1312px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ground", "name": "Ground", "color": "#FBF8F3" },
        { "slug": "white", "name": "Window white", "color": "#FFFFFF" },
        { "slug": "wash", "name": "Wash", "color": "#EAF0F4" },
        { "slug": "ink", "name": "Ink", "color": "#3A4654" },
        { "slug": "text", "name": "Text", "color": "#5F6670" },
        { "slug": "mist", "name": "Mist", "color": "#A9BFD3" },
        { "slug": "disc", "name": "Disc", "color": "#F8E0D3" },
        { "slug": "aqua", "name": "Aqua", "color": "#9EDFE8" },
        { "slug": "mint", "name": "Mint", "color": "#BFE8D6" },
        { "slug": "lemon", "name": "Lemon", "color": "#F1EDB5" },
        { "slug": "point", "name": "Point", "color": "#5E8C9A" },
        { "slug": "line", "name": "Hairline", "color": "#C9D3DC" },
        { "slug": "footer", "name": "Footer", "color": "#E7EDF2" },
        { "slug": "iron", "name": "Iron", "color": "#3A4654" },
        { "slug": "error", "name": "Error", "color": "#B4483C" },
        { "slug": "success", "name": "Success", "color": "#3F7A66" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Manrope)",
          "fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Figtree)",
          "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "display-zh-tw",
          "name": "Traditional Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Japanese subset (Noto Sans JP)",
          "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.8125rem" },
        { "slug": "medium", "name": "Body", "size": "1.0625rem" },
        { "slug": "large", "name": "Large", "size": "1.75rem" },
        { "slug": "x-large", "name": "X-large", "size": "2.25rem" },
        { "slug": "xx-large", "name": "Headline", "size": "clamp(2.75rem, 1.6rem + 2.6vw, 4.25rem)" },
        { "slug": "largest", "name": "Largest", "size": "4.25rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "12px" },
        { "slug": "20", "name": "S", "size": "24px" },
        { "slug": "30", "name": "M", "size": "40px" },
        { "slug": "40", "name": "L", "size": "64px" },
        { "slug": "50", "name": "XL", "size": "128px" }
      ]
    },
    "custom": { "radius": "10px", "radiusPill": "9999px", "glow": "0 0 32px 8px rgba(58,70,84,.05)" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--text)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.9", "letterSpacing": "0.01em" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "400", "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.3", "letterSpacing": "0.01em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.4", "letterSpacing": "0.02em" } }
    },
    "spacing": { "blockGap": "24px" },
    "blocks": {
      "core/button": { "border": { "radius": "9999px" } }
    }
  },
  "customTemplates": [
    { "name": "page-inner", "title": "Page with photo head", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
