{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "850px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (page)", "color": "#FFFFFF" },
    { "slug": "band", "name": "Band (info bar, tabs, strips)", "color": "#ECEDE6" },
    { "slug": "stripe", "name": "Stripe (list rows)", "color": "#F2F2EE" },
    { "slug": "ink", "name": "Ink moss (headings, outlines, CTA band)", "color": "#3F4232" },
    { "slug": "moss", "name": "Brand moss (rules, icons)", "color": "#6A6A52" },
    { "slug": "text", "name": "Text", "color": "#2B2B26" },
    { "slug": "brick", "name": "Brick (the booking button only)", "color": "#C4411C" },
    { "slug": "line", "name": "Line (separators)", "color": "#D9DAD2" },
    { "slug": "field", "name": "Field border", "color": "#8C8C8C" },
    { "slug": "error", "name": "Error (forms)", "color": "#A3361A" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW headings)",
     "fontFamily": "\"Noto Sans TC\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja headings)",
     "fontFamily": "\"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Tabs and labels", "size": "0.875rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "h3", "name": "H3", "size": "1.25rem", "fluid": false },
    { "slug": "caption", "name": "Card caption", "size": "1.125rem", "fluid": false },
    { "slug": "statement", "name": "Panel statement", "size": "1.75rem", "fluid": false },
    { "slug": "large", "name": "H2", "size": "2rem", "fluid": false },
    { "slug": "xl", "name": "Band H2", "size": "3rem", "fluid": false },
    { "slug": "x-large", "name": "Page head H1", "size": "3.25rem", "fluid": false },
    { "slug": "xx-large", "name": "Hero H1", "size": "4.25rem", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M", "size": "2.5rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "XL (section padding)", "size": "6.5rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--text)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "2"
  },
  "spacing": { "blockGap": "1.25rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.3" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.15" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.5" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--moss)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--brick)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--x-small)", "fontWeight": "600", "textDecoration": "none", "lineHeight": "1.4" },
    "spacing": { "padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1.25rem", "right": "1.25rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--line)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
