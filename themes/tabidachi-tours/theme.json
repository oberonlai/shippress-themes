{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1400px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "wash",
     "name": "Wash",
     "color": "#F2F3F1"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#101214"
    },
    {
     "slug": "ink-soft",
     "name": "Ink soft",
     "color": "#4C4948"
    },
    {
     "slug": "gold",
     "name": "Mulberry gold",
     "color": "#B79B5B"
    },
    {
     "slug": "gold-ink",
     "name": "Gold ink",
     "color": "#7A6430"
    },
    {
     "slug": "tint-gold",
     "name": "Tint gold",
     "color": "#F3EBD2"
    },
    {
     "slug": "tint-celadon",
     "name": "Tint celadon",
     "color": "#E3EDE7"
    },
    {
     "slug": "tint-rose",
     "name": "Tint rose",
     "color": "#F3E5E3"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#D9DAD8"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#9A9B98"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "tiny",
     "name": "Tiny label",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "rail",
     "name": "Rail title",
     "size": "1.0625rem"
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.3125rem"
    },
    {
     "slug": "medium",
     "name": "Small title",
     "size": "1.5rem"
    },
    {
     "slug": "large",
     "name": "Card title",
     "size": "2.5rem"
    },
    {
     "slug": "x-large",
     "name": "Section title",
     "size": "3rem"
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "4.25rem"
    },
    {
     "slug": "hero",
     "name": "Hero title",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "Gutter",
     "size": "20px"
    },
    {
     "slug": "40",
     "name": "Inset",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "Section mobile",
     "size": "64px"
    },
    {
     "slug": "80",
     "name": "Section",
     "size": "112px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.6",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.05"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "300",
     "letterSpacing": "-1px"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.45"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "700",
     "fontSize": "0.9375rem"
    },
    "border": {
     "radius": "60px"
    },
    "spacing": {
     "padding": {
      "top": "0.5rem",
      "bottom": "0.5rem",
      "left": "1rem",
      "right": "1rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "8px"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem"
    }
   }
  }
 }
}