{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "navy",
          "name": "Navy wool (text, rail, bands)",
          "color": "#1B2230"
        },
        {
          "slug": "slate",
          "name": "Slate navy (cards on navy)",
          "color": "#2C3446"
        },
        {
          "slug": "chalk",
          "name": "Chalk (ground)",
          "color": "#E9E6E0"
        },
        {
          "slug": "card",
          "name": "Pale chalk (cards)",
          "color": "#F3F1EC"
        },
        {
          "slug": "brass",
          "name": "Muted brass (marks, ticks, hairlines)",
          "color": "#9C8B6E"
        },
        {
          "slug": "deep-brass",
          "name": "Deep brass (links, labels on chalk)",
          "color": "#6B5A3C"
        },
        {
          "slug": "pale-brass",
          "name": "Pale brass (small text on navy)",
          "color": "#BCAB88"
        },
        {
          "slug": "quiet",
          "name": "Quiet ink (secondary text)",
          "color": "#4A5161"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Libre Bodoni)",
          "fontFamily": "\"Libre Bodoni\", \"Bodoni Moda\", Didot, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Libre Bodoni",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/libre-bodoni-variable-latin.woff2"
              ]
            },
            {
              "fontFamily": "Libre Bodoni",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/libre-bodoni-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Geologica)",
          "fontFamily": "Geologica, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Geologica",
              "fontStyle": "normal",
              "fontWeight": "300 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/geologica-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.75rem, 1.45rem + 1.2vw, 2.5rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.4rem, 1.5rem + 3.2vw, 4.25rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--chalk)",
      "text": "var(--wp--preset--color--navy)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.72",
      "fontWeight": "300"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.12",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep-brass)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--navy)",
          "text": "var(--wp--preset--color--chalk)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.8125rem",
          "letterSpacing": "0.12em",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (navy side rail with a tape-measure scale)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (appointment hours table)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
