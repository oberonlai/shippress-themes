{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Evening Plum",
  "settings": {
    "color": {
      "palette": [
        { "slug": "washi", "name": "Evening (ground)", "color": "#211B1D" },
        { "slug": "paper", "name": "Lamp paper", "color": "#2B2326" },
        { "slug": "blush", "name": "Dusk plum", "color": "#33282C" },
        { "slug": "sakura", "name": "Night sakura", "color": "#C98A97" },
        { "slug": "hairline", "name": "Hairline", "color": "#43363A" },
        { "slug": "leaf-pale", "name": "Moss shadow", "color": "#2E3329" },
        { "slug": "kuki", "name": "Lantern green", "color": "#A4BD8F" },
        { "slug": "mute", "name": "Quiet text", "color": "#B7A7AB" },
        { "slug": "sumi", "name": "Paper ink", "color": "#F3E9E6" },
        { "slug": "beni", "name": "Plum rouge", "color": "#E7859B" }
      ],
      "gradients": [
        { "slug": "petal-light", "name": "Petal light", "gradient": "radial-gradient(70% 60% at 78% 18%, rgba(201,138,151,.18) 0%, rgba(33,27,29,0) 70%), radial-gradient(60% 50% at 8% 92%, rgba(164,189,143,.10) 0%, rgba(33,27,29,0) 70%)" },
        { "slug": "blush-fade", "name": "Blush fade", "gradient": "linear-gradient(180deg, #211B1D 0%, #33282C 100%)" }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|sumi", "text": "var:preset|color|washi" },
        "border": { "color": "var:preset|color|sumi" },
        ":hover": { "color": { "background": "var:preset|color|beni", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|beni" } },
        ":focus": { "color": { "background": "var:preset|color|beni", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|beni" } }
      }
    }
  }
}
