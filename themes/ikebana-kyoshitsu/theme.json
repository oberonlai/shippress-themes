{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "660px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "washi", "name": "Washi (ground)", "color": "#FAF5F2" },
        { "slug": "paper", "name": "Paper white", "color": "#FFFCFA" },
        { "slug": "blush", "name": "Blush", "color": "#F4E3E2" },
        { "slug": "sakura", "name": "Sakura pink", "color": "#E9B8C0" },
        { "slug": "hairline", "name": "Hairline", "color": "#E8D7D4" },
        { "slug": "leaf-pale", "name": "Pale leaf", "color": "#DDE5D3" },
        { "slug": "kuki", "name": "Kuki stem green", "color": "#6F8A5B" },
        { "slug": "mute", "name": "Quiet text", "color": "#74666A" },
        { "slug": "sumi", "name": "Sumi ink", "color": "#2A2627" },
        { "slug": "beni", "name": "Beni rouge (accent)", "color": "#B23A55" }
      ],
      "gradients": [
        { "slug": "petal-light", "name": "Petal light", "gradient": "radial-gradient(70% 60% at 78% 18%, rgba(233,184,192,.42) 0%, rgba(250,245,242,0) 70%), radial-gradient(60% 50% at 8% 92%, rgba(221,229,211,.55) 0%, rgba(250,245,242,0) 70%)" },
        { "slug": "blush-fade", "name": "Blush fade", "gradient": "linear-gradient(180deg, #FAF5F2 0%, #F4E3E2 100%)" }
      ],
      "duotone": [
        { "slug": "sumi-washi", "name": "Sumi and washi", "colors": ["#2A2627", "#FAF5F2"] },
        { "slug": "beni-blush", "name": "Beni and blush", "colors": ["#7E2236", "#F4E3E2"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display serif (Bodoni Moda)",
          "fontFamily": "\"Bodoni Moda\", \"Didot\", \"Bodoni 72\", \"Times New Roman\", serif",
          "fontFace": [
            { "fontFamily": "Bodoni Moda", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bodoni-moda-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Bodoni Moda", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bodoni-moda-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Jost)",
          "fontFamily": "Jost, \"Futura\", \"Century Gothic\", \"Helvetica Neue\", Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Jost", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jost-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
        { "slug": "xx-large", "name": "Section title", "size": "3.75rem", "fluid": { "min": "2.375rem", "max": "4.25rem" } },
        { "slug": "display", "name": "Display", "size": "6.5rem", "fluid": { "min": "3rem", "max": "7rem" } },
        { "slug": "giant", "name": "Wordmark", "size": "11rem", "fluid": { "min": "4rem", "max": "12rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Petal", "size": "0.5rem" },
        { "slug": "20", "name": "Leaf", "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)" },
        { "slug": "30", "name": "Stem", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)" },
        { "slug": "40", "name": "Branch", "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)" },
        { "slug": "50", "name": "Ma", "size": "clamp(3rem, 1.8rem + 4.2vw, 6.5rem)" },
        { "slug": "60", "name": "Wide ma", "size": "clamp(4.5rem, 2.4rem + 7vw, 10rem)" },
        { "slug": "70", "name": "Deep ma", "size": "clamp(6rem, 3rem + 10.5vw, 15rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "slow": "1.2s"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|washi",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "350",
      "lineHeight": "1.75",
      "letterSpacing": "0.01em"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|beni" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|sumi" } },
        ":focus": { "color": { "text": "var:preset|color|sumi" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|sumi" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "400", "lineHeight": "1", "letterSpacing": "-0.03em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "400", "lineHeight": "1.04", "letterSpacing": "-0.025em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "500", "letterSpacing": "0" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "500", "letterSpacing": "0" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "500", "letterSpacing": "0.22em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|sumi", "text": "var:preset|color|washi" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|sumi", "radius": "999px" },
        "spacing": { "padding": { "top": "0.95rem", "right": "1.9rem", "bottom": "0.95rem", "left": "1.9rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "500", "letterSpacing": "0.2em", "textTransform": "uppercase", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|beni", "text": "var:preset|color|paper" }, "border": { "color": "var:preset|color|beni" } },
        ":focus": { "color": { "background": "var:preset|color|beni", "text": "var:preset|color|paper" }, "border": { "color": "var:preset|color|beni" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|small", "lineHeight": "1.5" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.625rem", "fontWeight": "500", "fontStyle": "italic", "letterSpacing": "-0.01em", "lineHeight": "1" },
        "elements": { "link": { "color": { "text": "var:preset|color|sumi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.6875rem", "fontWeight": "500", "letterSpacing": "0.24em", "textTransform": "uppercase" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "500", "letterSpacing": "0.18em", "textTransform": "uppercase", "lineHeight": "1.3" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "400", "letterSpacing": "-0.02em", "lineHeight": "1.06" },
        "elements": { "link": { "color": { "text": "var:preset|color|sumi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "500", "letterSpacing": "0.2em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "500", "letterSpacing": "0.2em", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|beni" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.7" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "400" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|mute" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "400", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.25" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "400", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.1" }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/details": {
        "typography": { "fontSize": "var:preset|font-size|medium" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.28em;text-decoration-thickness:1px;transition:color .4s ease,text-decoration-color .4s ease}::selection{background:var(--wp--preset--color--sakura);color:var(--wp--preset--color--sumi)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About the school", "postTypes": ["page"] },
    { "name": "page-classes", "title": "Classes and levels", "postTypes": ["page"] },
    { "name": "page-schedule", "title": "Schedule and trial lesson", "postTypes": ["page"] },
    { "name": "page-teachers", "title": "Teachers and gallery", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Seasonal notes (newsletter)", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
