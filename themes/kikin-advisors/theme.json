{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "980px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "Ground (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "half",
     "name": "Half-ground (pale grey)",
     "color": "#F3F4F6"
    },
    {
     "slug": "band",
     "name": "Band (pale butter)",
     "color": "#F4EBC4"
    },
    {
     "slug": "ink",
     "name": "Ink (bars, outlines, text)",
     "color": "#45485A"
    },
    {
     "slug": "deep",
     "name": "Deep ink (pills, page-top disc)",
     "color": "#2B2E3D"
    },
    {
     "slug": "yellow",
     "name": "Close yellow (the one CTA pill)",
     "color": "#F2D84B"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#A9ADBF"
    },
    {
     "slug": "grid",
     "name": "Grid line",
     "color": "#E6E7EC"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B6E80"
    },
    {
     "slug": "periwinkle",
     "name": "Periwinkle (illustration fills)",
     "color": "#7C88B8"
    },
    {
     "slug": "paper",
     "name": "Grid-paper ground",
     "color": "#F8F8FA"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "400 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "zh",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "ja",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Kaku Gothic ProN\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Bar / large",
     "size": "1.875rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.5rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Numeral",
     "size": "4.5rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "4.5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(4.5rem, 8.34vw, 7.5rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "20px",
    "right": "20px"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "700",
     "lineHeight": "1.3"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}