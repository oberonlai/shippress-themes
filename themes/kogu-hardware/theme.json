{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "1290px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F7F6F0"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#141811"
    },
    {
     "slug": "charcoal",
     "name": "Charcoal",
     "color": "#4E4B4A"
    },
    {
     "slug": "hover",
     "name": "Hover",
     "color": "#EEEEE7"
    },
    {
     "slug": "muted",
     "name": "Muted label",
     "color": "#858781"
    },
    {
     "slug": "meta",
     "name": "Meta text",
     "color": "#6B6D67"
    },
    {
     "slug": "brass",
     "name": "Brass",
     "color": "#A9823A"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    }
    ,{
     "slug": "cjk-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    }
    ,{
     "slug": "cjk-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Kicker",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "Section title",
     "size": "2.1875rem"
    },
    {
     "slug": "xx-large",
     "name": "Panel title",
     "size": "3rem"
    },
    {
     "slug": "huge",
     "name": "Hero",
     "size": "clamp(2.5rem, 4.8vw, 4.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "5.5rem"
    },
    {
     "slug": "60",
     "name": "XXL",
     "size": "8.75rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "useRootPaddingAwareAlignments": false
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.9",
   "letterSpacing": "0.01em",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.4"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--charcoal)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1rem",
     "fontWeight": "500"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}