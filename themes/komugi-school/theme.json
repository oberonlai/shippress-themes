{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"customTemplates": [ { "name": "page-wide", "title": "Wide page", "postTypes": [ "page" ] } ],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1276px",
			"wideSize": "1276px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#FAFAFA"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#14110E"
				},
				{
					"slug": "main",
					"name": "Mock tea (媚茶)",
					"color": "#716454"
				},
				{
					"slug": "rule",
					"name": "Hairline",
					"color": "#DADADA"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5C554D"
				},
				{
					"slug": "wheat",
					"name": "Wheat",
					"color": "#A8845A"
				},
				{
					"slug": "band",
					"name": "Footer band",
					"color": "#F1EFEC"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-variable-latin.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-italic-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "ui",
					"name": "Labels (Outfit)",
					"fontFamily": "\"Outfit\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/outfit-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-zh",
					"name": "Noto Serif TC (zh-TW)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-ja",
					"name": "Noto Serif JP (ja)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.6875rem"
				},
				{
					"slug": "small",
					"name": "Nav",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "medium",
					"name": "Lead",
					"size": "1.25rem"
				},
				{
					"slug": "large",
					"name": "Row title",
					"size": "1.375rem"
				},
				{
					"slug": "x-large",
					"name": "Section heading",
					"size": "2.25rem"
				},
				{
					"slug": "xx-large",
					"name": "Statement",
					"size": "clamp(2.75rem, 5.6vw, 4.5rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "4rem"
				},
				{
					"slug": "60",
					"name": "Section",
					"size": "clamp(3.5rem, 7vw, 6.25rem)"
				}
			]
		},
		"border": {
			"radius": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--display)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--ks-gl, 20px)",
				"right": "var(--ks-gr, 20px)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.08"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.4",
					"letterSpacing": "0"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--main)"
					}
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "500",
					"fontSize": "0.875rem"
				},
				"border": {
					"radius": "9999px"
				}
			}
		}
	}
}