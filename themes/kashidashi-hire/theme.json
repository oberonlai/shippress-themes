{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1170px",
   "wideSize": "1335px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground, finder tiles)",
     "color": "#FFFFFF"
    },
    {
     "slug": "mist",
     "name": "Mist (notice bar, rows)",
     "color": "#F3F5F3"
    },
    {
     "slug": "panel",
     "name": "Panel (finder panel, margin wedges)",
     "color": "#E7EBE8"
    },
    {
     "slug": "idle",
     "name": "Idle tab and borders",
     "color": "#C9D0CA"
    },
    {
     "slug": "pine",
     "name": "Pine (tab, wedge, dock, buttons)",
     "color": "#465746"
    },
    {
     "slug": "deep",
     "name": "Deep pine (dock, footer, band)",
     "color": "#2E3A2F"
    },
    {
     "slug": "ink",
     "name": "Ink (strips, tags)",
     "color": "#151A16"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#2F3530"
    },
    {
     "slug": "rust",
     "name": "Rust (dot, small tags)",
     "color": "#B2552F"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Tag",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "s",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "m",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "l",
     "name": "Large",
     "size": "1.75rem",
     "fluid": {
      "min": "1.4rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "xl",
     "name": "H2",
     "size": "2.25rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "xxl",
     "name": "Figures",
     "size": "3rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3rem"
     }
    },
    {
     "slug": "display",
     "name": "Hero headline",
     "size": "4.5rem",
     "fluid": {
      "min": "2.5rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.125rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "6.25rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.7"
  },
  "spacing": {
   "blockGap": "1.25rem",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--m)",
     "fontWeight": "600",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--text)"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--pine)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--pine)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "0.9375rem",
     "fontWeight": "600",
     "textDecoration": "none"
    },
    "spacing": {
     "padding": {
      "top": "1rem",
      "bottom": "1rem",
      "left": "2rem",
      "right": "2rem"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/separator": {
    "color": {
     "background": "var(--wp--preset--color--idle)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}