{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "charcoal",
          "name": "Charcoal (text, dark \"lights down\" bands, the bottom bar)",
          "color": "#19191B"
        },
        {
          "slug": "stone",
          "name": "Smoke stone (ground)",
          "color": "#ECEAE6"
        },
        {
          "slug": "paper",
          "name": "Paper (cards, stubs, the colophon)",
          "color": "#F5F4F1"
        },
        {
          "slug": "grey",
          "name": "Warm grey (quiet meta text)",
          "color": "#67635E"
        },
        {
          "slug": "rust",
          "name": "Muted rust (small accents only: rules, active filter, stub notch)",
          "color": "#A5532F"
        },
        {
          "slug": "rust-deep",
          "name": "Deep rust (text links)",
          "color": "#8A4426"
        },
        {
          "slug": "brass",
          "name": "Soft brass (sparingly, on dark bands)",
          "color": "#B39A6E"
        },
        {
          "slug": "mist",
          "name": "Mist (hairlines)",
          "color": "#D3CFC8"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Space Grotesk)",
          "fontFamily": "\"Space Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/space-grotesk-variable.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Inter)",
          "fontFamily": "Inter, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (IBM Plex Mono)",
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/ibm-plex-mono-regular-latin1.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--stone)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "300",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--charcoal)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.25rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--rust-deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--charcoal)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "0.75rem",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase",
          "fontWeight": "400"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (bottom-docked bar)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (programme colophon)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}