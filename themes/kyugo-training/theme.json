{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": { "contentSize": "1080px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "palette": [
    { "slug": "white", "color": "#FFFFFF", "name": "White" },
    { "slug": "alt", "color": "#F7F8F8", "name": "Ground alt" },
    { "slug": "ink", "color": "#000000", "name": "Ink" },
    { "slug": "muted", "color": "#6F6F6F", "name": "Muted" },
    { "slug": "line", "color": "#F0F0F0", "name": "Hairline" },
    { "slug": "olive", "color": "#5A6148", "name": "Olive" },
    { "slug": "olive-mid", "color": "#6C7357", "name": "Olive mid" },
    { "slug": "olive-light", "color": "#8A9170", "name": "Olive light" },
    { "slug": "olive-deep", "color": "#474D38", "name": "Olive deep" },
    { "slug": "footer", "color": "#3E3E3E", "name": "Footer" }
   ]
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
     ]    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "caption", "size": "0.6875rem", "name": "Caption" },
    { "slug": "small", "size": "0.8125rem", "name": "Small" },
    { "slug": "base", "size": "1rem", "name": "Base" },
    { "slug": "medium", "size": "1.25rem", "name": "Medium" },
    { "slug": "large", "size": "1.75rem", "name": "Large" },
    { "slug": "x-large", "size": "2.125rem", "name": "Statement" },
    { "slug": "section", "size": "3rem", "name": "Section" },
    { "slug": "display", "size": "4rem", "name": "Display" },
    { "slug": "page", "size": "4.25rem", "name": "Page title" },
    { "slug": "hero", "size": "5rem", "name": "Hero" },
    { "slug": "stat", "size": "6.25rem", "name": "Stat" }
   ]
  },
  "spacing": {
   "units": ["px", "rem", "%", "vw"],
   "spacingSizes": [
    { "slug": "30", "size": "1rem", "name": "S" },
    { "slug": "40", "size": "2rem", "name": "M" },
    { "slug": "50", "size": "4rem", "name": "L" },
    { "slug": "60", "size": "7.5rem", "name": "XL" }
   ]
  },
  "border": { "radius": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.8" },
  "spacing": { "blockGap": "1.25rem" },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.25" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } }
  },
  "blocks": {
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
