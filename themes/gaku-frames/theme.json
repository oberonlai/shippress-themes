{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"customTemplates": [ { "name": "page-framed", "title": "Framed page", "postTypes": [ "page" ] } ],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1400px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Base (cool near-white)", "color": "#FAFAFA" },
				{ "slug": "ink", "name": "Ink", "color": "#1C1F23" },
				{ "slug": "tint", "name": "Pill and mount tint", "color": "#E8EBF0" },
				{ "slug": "dark", "name": "Bench card dark", "color": "#202220" },
				{ "slug": "main", "name": "Walnut (frames)", "color": "#5E5348" },
				{ "slug": "walnut-light", "name": "Walnut, top joint", "color": "#6B5F53" },
				{ "slug": "walnut-dark", "name": "Walnut, bottom joint", "color": "#4A4139" },
				{ "slug": "hairline", "name": "Hairline", "color": "#E3E5E8" },
				{ "slug": "muted", "name": "Muted text", "color": "#5F646B" },
				{ "slug": "accent", "name": "Brass (accent)", "color": "#B08A52" },
				{ "slug": "brass-light", "name": "Brass on dark", "color": "#C9A46C" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Outfit)",
					"fontFamily": "\"Outfit\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/outfit-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Nunito Sans)",
					"fontFamily": "\"Nunito Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunitosans-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW subset)",
					"fontFamily": "\"Noto Sans TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja subset)",
					"fontFamily": "\"Noto Sans JP\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "tiny", "name": "Tiny (pills, kickers)", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium (labels)", "size": "1.5rem" },
				{ "slug": "large", "name": "Large (sub-headlines)", "size": "2.5rem" },
				{ "slug": "x-large", "name": "Inner page head", "size": "clamp(2.75rem, 7vw, 6.5rem)" },
				{ "slug": "xx-large", "name": "Split headline", "size": "clamp(3rem, 9vw, 8.2rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "5rem" },
				{ "slug": "60", "name": "XL (section)", "size": "9rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"line": "1px",
			"ease": "cubic-bezier(.37, 0, .63, 1)",
			"rise": "cubic-bezier(.16, 1, .3, 1)",
			"radius": { "card": "2px", "pill": "999px" }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.75",
			"letterSpacing": "0.01em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--main)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.1", "letterSpacing": "-0.03em" }
			},
			"h1": { "typography": { "fontSize": "clamp(2.75rem, 7vw, 6.5rem)", "fontWeight": "300", "lineHeight": "0.92" } },
			"h2": { "typography": { "fontSize": "clamp(2rem, 3.2vw, 2.5rem)", "fontWeight": "500" } },
			"h3": { "typography": { "fontSize": "1.5rem", "fontWeight": "500", "lineHeight": "1.25" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--tint)", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "2px", "width": "0" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.8125rem", "fontWeight": "600", "letterSpacing": "0.04em", "textTransform": "uppercase" }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "letterSpacing": "0.04em" } },
			"core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--tiny)", "fontWeight": "600", "letterSpacing": "0.04em" } }
		}
	}
}
