{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1172px",
   "wideSize": "1340px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "wash",
     "name": "Pale panel",
     "color": "#F2F5F4"
    },
    {
     "slug": "util",
     "name": "Utility bar",
     "color": "#F5F5F5"
    },
    {
     "slug": "primary",
     "name": "Rust teal",
     "color": "#5A7E78"
    },
    {
     "slug": "deep",
     "name": "Deep teal",
     "color": "#2F4A45"
    },
    {
     "slug": "contrast",
     "name": "Ink",
     "color": "#15201E"
    },
    {
     "slug": "muted",
     "name": "Body grey",
     "color": "#4A5755"
    },
    {
     "slug": "quiet",
     "name": "Quiet grey",
     "color": "#667370"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#D9E0DE"
    },
    {
     "slug": "spark",
     "name": "Spark amber",
     "color": "#C8873A"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Eyebrow, captions",
     "size": "0.8125rem"
    },
    {
     "slug": "s",
     "name": "Small text",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "Lead",
     "size": "1.125rem"
    },
    {
     "slug": "xl",
     "name": "Banner sentence, tab labels",
     "size": "1.25rem"
    },
    {
     "slug": "2xl",
     "name": "Feature titles",
     "size": "1.5rem"
    },
    {
     "slug": "3xl",
     "name": "Section headline",
     "size": "1.875rem"
    },
    {
     "slug": "4xl",
     "name": "Statement",
     "size": "2rem"
    },
    {
     "slug": "5xl",
     "name": "Inner page title",
     "size": "2.5rem"
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.5rem"
    }
   ]
  },
  "custom": {}
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.6"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--primary)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.4"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--deep)",
     "text": "var(--wp--preset--color--base)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "700"
    },
    "border": {
     "radius": "4px"
    },
    "spacing": {
     "padding": {
      "top": "0.75rem",
      "bottom": "0.75rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--primary)",
      "text": "var(--wp--preset--color--base)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)"
    }
   }
  }
 }
}