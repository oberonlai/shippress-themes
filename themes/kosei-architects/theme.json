{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1360px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "pale", "name": "Pale panel", "color": "#F0EFED" },
				{ "slug": "pale-2", "name": "Pale 2 (footer, wide band)", "color": "#E6E3DF" },
				{ "slug": "accent-pale", "name": "Accent pale (block behind arch)", "color": "#E4E8EC" },
				{ "slug": "ink", "name": "Ink (text)", "color": "#222222" },
				{ "slug": "muted", "name": "Muted text", "color": "#6B6B6B" },
				{ "slug": "inactive", "name": "Inactive / frame lines", "color": "#A6A6A6" },
				{ "slug": "hairline", "name": "Hairline", "color": "#DDDDDD" },
				{ "slug": "accent", "name": "Blue-grey accent (small marks)", "color": "#5C6A78" },
				{ "slug": "accent-dark", "name": "Accent hover", "color": "#4A5663" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-serif-4-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/SourceSans3VF-Upright.ttf.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
				{ "slug": "medium", "name": "Section label", "size": "1.5rem", "fluid": false },
				{ "slug": "large", "name": "Row title", "size": "1.75rem", "fluid": false },
				{ "slug": "x-large", "name": "Heading", "size": "clamp(1.75rem, 1.2rem + 1.4vw, 2.25rem)", "fluid": false },
				{ "slug": "xx-large", "name": "Display (maximum 4.25rem)", "size": "clamp(2.5rem, 1rem + 4.6vw, 4.25rem)", "fluid": false }
			]
		},
		"spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.8", "letterSpacing": "0.03em", "fontWeight": "400" },
		"spacing": { "blockGap": "0" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.25", "letterSpacing": "0" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "300", "lineHeight": "1.2" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3", "letterSpacing": "0.01em" } },
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "#FFFFFF" },
				"border": { "radius": "0" },
				"typography": { "fontSize": "0.9375rem", "letterSpacing": "0.03em", "fontWeight": "600" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } }
			}
		}
	}
}
