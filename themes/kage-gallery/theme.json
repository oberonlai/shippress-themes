{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "gradients": [],
      "duotone": [],
      "palette": [
        {
          "slug": "wall",
          "name": "Wall white (ground)",
          "color": "#FAFAF8"
        },
        {
          "slug": "stone",
          "name": "Stone grey (panels)",
          "color": "#E4E4E0"
        },
        {
          "slug": "hairline",
          "name": "Hairline (shadow edges and rules)",
          "color": "#D3D2CC"
        },
        {
          "slug": "bronze",
          "name": "Muted bronze (large marks and frames)",
          "color": "#8B7B5C"
        },
        {
          "slug": "bronze-deep",
          "name": "Deep bronze (links and small labels)",
          "color": "#6B5C3F"
        },
        {
          "slug": "quiet",
          "name": "Quiet grey (secondary text)",
          "color": "#64645F"
        },
        {
          "slug": "charcoal",
          "name": "Charcoal (text)",
          "color": "#1C1C1B"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Gelasio)",
          "fontFamily": "Gelasio, \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Gelasio",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/gelasio-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Gelasio",
              "fontStyle": "italic",
              "fontWeight": "400 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/gelasio-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Inter Tight)",
          "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter Tight",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-tight-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Wall label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Page title",
          "size": "3.25rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Exhibition title",
          "size": "7rem",
          "fluid": {
            "min": "3rem",
            "max": "8.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 1rem + 1vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2.5rem, 1.8rem + 2.6vw, 4.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(5rem, 3rem + 7vw, 10rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--wall)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3.5rem)",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "top": "0",
        "bottom": "0"
      },
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--serif)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--bronze-deep)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--charcoal)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.15",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--charcoal)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "1.375rem"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--charcoal)",
          "text": "var(--wp--preset--color--wall)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.8125rem",
          "fontWeight": "500",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--bronze-deep)",
            "text": "var(--wp--preset--color--wall)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.75rem"
        },
        "color": {
          "text": "var(--wp--preset--color--quiet)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.875rem"
        }
      },
      "core/post-date": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.75rem"
        },
        "color": {
          "text": "var(--wp--preset--color--quiet)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--hairline)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (full-width sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}