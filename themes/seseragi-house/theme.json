{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "796px",
			"wideSize": "1296px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#F7F7F3"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#212529"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#E5E4DF"
				},
				{
					"slug": "stone",
					"name": "Stone",
					"color": "#C0BDB0"
				},
				{
					"slug": "white-tea",
					"name": "White tea",
					"color": "#C0A48A"
				},
				{
					"slug": "tea-deep",
					"name": "Tea deep",
					"color": "#7D6650"
				},
				{
					"slug": "river",
					"name": "River",
					"color": "#3C4743"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5A5E62"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#B23A3A"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display and body (Spectral)",
					"fontFamily": "\"Spectral\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/spectral-300-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/spectral-400-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/spectral-500-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/spectral-600-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/spectral-400-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "label",
					"name": "Labels (Karla)",
					"fontFamily": "\"Karla\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Karla",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/karla-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1rem"
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "1.5rem"
				},
				{
					"slug": "vertical",
					"name": "Vertical title",
					"size": "2rem"
				},
				{
					"slug": "large",
					"name": "Section heading",
					"size": "2.375rem"
				},
				{
					"slug": "x-large",
					"name": "Inner page H1",
					"size": "4.25rem"
				},
				{
					"slug": "xx-large",
					"name": "Home H1",
					"size": "4.5rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--display)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.875",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "0.08em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem",
					"fontWeight": "500",
					"letterSpacing": "0.02em"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--label)",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0"
				}
			}
		},
		"spacing": {
			"blockGap": "0"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
