{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1400px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Ground",
     "color": "#FBFCF7"
    },
    {
     "slug": "band",
     "name": "Pale band",
     "color": "#F3F4EC"
    },
    {
     "slug": "white",
     "name": "Card white",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#423E3E"
    },
    {
     "slug": "slate",
     "name": "Slate (secondary)",
     "color": "#5E6B73"
    },
    {
     "slug": "accent",
     "name": "Accent blue (marks, labels)",
     "color": "#0000F9"
    },
    {
     "slug": "ghost",
     "name": "Ghost line",
     "color": "#F0F1E4"
    },
    {
     "slug": "notice",
     "name": "Notice pill",
     "color": "#EEEFE8"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6E7377"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#E3E5DC"
    },
    {
     "slug": "mist-a",
     "name": "Mist light",
     "color": "#E6EBEE"
    },
    {
     "slug": "mist-b",
     "name": "Mist mid",
     "color": "#D3DCE1"
    },
    {
     "slug": "mist-c",
     "name": "Mist sage",
     "color": "#E9EDE6"
    }
   ],
   "gradients": [
    {
     "slug": "mist",
     "name": "Mist band",
     "gradient": "linear-gradient(160deg, #E6EBEE 0%, #D3DCE1 55%, #E9EDE6 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "1.75rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "2.75rem",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Hero (maximum 4.5rem)",
     "size": "clamp(2.5rem, 5vw, 4.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.9",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1rem, 2vw, 1.25rem)",
    "right": "clamp(1rem, 2vw, 1.25rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.6",
     "letterSpacing": "0.05em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "fontWeight": "400",
     "lineHeight": "1.15"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.25rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontSize": "1rem",
     "letterSpacing": "0.1em",
     "fontWeight": "400"
    },
    "spacing": {
     "padding": {
      "top": "0.5rem",
      "bottom": "0.5rem",
      "left": "1.25rem",
      "right": "1.25rem"
     }
    }
   }
  }
 }
}