{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "920px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "mist",
     "name": "Mist (ground)",
     "color": "#F3F5F3"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "dark",
     "name": "Dark ground",
     "color": "#1F2B2D"
    },
    {
     "slug": "main",
     "name": "Tetsu-onando (main)",
     "color": "#2F484C"
    },
    {
     "slug": "ink",
     "name": "Text ink",
     "color": "#3A4446"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#5C6668"
    },
    {
     "slug": "accent",
     "name": "Brick (labels)",
     "color": "#A86A5A"
    },
    {
     "slug": "accent-soft",
     "name": "Brick on dark",
     "color": "#D9B3A8"
    },
    {
     "slug": "mark",
     "name": "Mark green",
     "color": "#3F6B58"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Cormorant Garamond",
       "fontWeight": "300 700",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Cormorant Garamond",
       "fontWeight": "300 700",
       "fontStyle": "italic",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "text",
     "name": "Text (Newsreader)",
     "fontFamily": "\"Newsreader\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontWeight": "200 800",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontWeight": "200 800",
       "fontStyle": "italic",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "zh-display",
     "name": "Noto Serif TC (zh-TW headings)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontWeight": "400 500",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "ja-display",
     "name": "Noto Serif JP (ja headings)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontWeight": "400 500",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.75rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.6rem",
     "fluid": {
      "min": "1.9rem",
      "max": "2.6rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "4.5rem",
     "fluid": {
      "min": "2.6rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "3rem"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "4.5rem"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "6rem"
    },
    {
     "slug": "80",
     "name": "7",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--mist)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--text)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.9"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--dark)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.04"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--main)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--dark)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)",
     "letterSpacing": "0.06em"
    },
    "color": {
     "background": "var(--wp--preset--color--main)",
     "text": "var(--wp--preset--color--white)"
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "8px"
    }
   },
   "core/button": {
    "border": {
     "radius": "2px"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}