{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1120px", "wideSize": "1344px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Paper (page ground)", "color": "#F3F2F0" },
    { "slug": "base", "name": "White (booking bar, inputs)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (photo stage, book block, footer)", "color": "#1B1411" },
    { "slug": "text", "name": "Text (body)", "color": "#3B302A" },
    { "slug": "muted", "name": "Muted (labels)", "color": "#6A5F57" },
    { "slug": "accent", "name": "Brown (buttons, links, time labels)", "color": "#6B4E3D" },
    { "slug": "accent-dark", "name": "Brown dark (hover)", "color": "#4F382B" },
    { "slug": "amber", "name": "Lamp amber (disc, line drawings)", "color": "#D8B04A" },
    { "slug": "line", "name": "Hairline", "color": "#DAD7D2" },
    { "slug": "footer", "name": "Footer ground", "color": "#1B1411" },
    { "slug": "mist", "name": "Text on ink", "color": "#F3F2F0" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (EB Garamond)",
     "fontFamily": "\"EB Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "EB Garamond", "fontStyle": "normal", "fontWeight": "400 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ebgaramond-variable-latin.woff2" ] },
      { "fontFamily": "EB Garamond", "fontStyle": "italic", "fontWeight": "400 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ebgaramond-italic-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "\"Karla\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Karla", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/karla-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "xs", "name": "XS (labels)", "size": "0.6875rem" },
    { "slug": "s", "name": "S (small)", "size": "0.875rem" },
    { "slug": "m", "name": "M (body)", "size": "1rem" },
    { "slug": "lead", "name": "Lead", "size": "1.25rem" },
    { "slug": "medium-large", "name": "H3 (room, story)", "size": "1.75rem" },
    { "slug": "large", "name": "Inner page title", "size": "3.5rem" },
    { "slug": "x-large", "name": "Wordmark", "size": "3.5rem" },
    { "slug": "huge", "name": "Hero h1", "size": "4.75rem" }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "S", "size": "1rem" },
    { "slug": "30", "name": "M", "size": "2.5rem" },
    { "slug": "40", "name": "L", "size": "5rem" },
    { "slug": "50", "name": "Section", "size": "7.5rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--text)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.9"
  },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.1", "letterSpacing": "0.01em" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--accent)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--ground)" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "0.875rem", "letterSpacing": "0.12em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.1" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--medium-large)", "lineHeight": "1.3", "letterSpacing": "0.3em" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium-large)", "lineHeight": "1.3" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
