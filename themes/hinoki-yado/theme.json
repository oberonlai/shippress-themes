{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "hinoki", "name": "Hinoki cream (ground)", "color": "#F3EDE1" },
        { "slug": "washi", "name": "Washi paper", "color": "#FAF7F0" },
        { "slug": "hairline", "name": "Hairline", "color": "#DCD3C2" },
        { "slug": "steam", "name": "Onsen steam grey", "color": "#B8BCB5" },
        { "slug": "stone", "name": "River stone", "color": "#63665E" },
        { "slug": "moss", "name": "Moss green", "color": "#56633F" },
        { "slug": "moss-deep", "name": "Deep moss", "color": "#2F3826" },
        { "slug": "sumi", "name": "Sumi ink", "color": "#22241F" },
        { "slug": "kaki", "name": "Persimmon (accent)", "color": "#C8643B" }
      ],
      "gradients": [
        { "slug": "steam", "name": "Steam", "gradient": "radial-gradient(120% 80% at 20% 0%, rgba(250,247,240,.95) 0%, rgba(243,237,225,0) 60%), radial-gradient(90% 70% at 90% 100%, rgba(184,188,181,.45) 0%, rgba(243,237,225,0) 70%)" },
        { "slug": "dusk-moss", "name": "Dusk over moss", "gradient": "linear-gradient(180deg, #2F3826 0%, #22241F 100%)" }
      ],
      "duotone": [
        { "slug": "sumi-washi", "name": "Sumi and washi", "colors": ["#22241F", "#FAF7F0"] },
        { "slug": "moss-cream", "name": "Moss and hinoki", "colors": ["#2F3826", "#F3EDE1"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display serif (Cormorant)",
          "fontFamily": "Cormorant, \"Cormorant Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Cormorant", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Cormorant", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "small-caps",
          "name": "Small caps (Cormorant SC)",
          "fontFamily": "\"Cormorant SC\", Cormorant, Georgia, serif",
          "fontFace": [
            { "fontFamily": "Cormorant SC", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-sc-500-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Cormorant SC", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-sc-600-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Figtree)",
          "fontFamily": "Figtree, \"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.8125rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large", "name": "Lead", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.625rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
        { "slug": "xx-large", "name": "Section title", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } },
        { "slug": "display", "name": "Display", "size": "7rem", "fluid": { "min": "3.25rem", "max": "7.5rem" } },
        { "slug": "giant", "name": "Wordmark", "size": "12rem", "fluid": { "min": "4.5rem", "max": "13rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Breath", "size": "0.5rem" },
        { "slug": "20", "name": "Gutter", "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)" },
        { "slug": "30", "name": "Small", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)" },
        { "slug": "40", "name": "Medium", "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)" },
        { "slug": "50", "name": "Large", "size": "clamp(3rem, 1.8rem + 4.2vw, 6.5rem)" },
        { "slug": "60", "name": "Corridor", "size": "clamp(4.5rem, 2.4rem + 7vw, 10rem)" },
        { "slug": "70", "name": "Long corridor", "size": "clamp(6rem, 3rem + 10.5vw, 15rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.22, .61, .36, 1)",
      "slow": "1.4s",
      "onDark": "#FAF7F0"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|hinoki",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "350",
      "lineHeight": "1.75",
      "letterSpacing": "0.005em"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|moss" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|sumi" } },
        ":focus": { "color": { "text": "var:preset|color|sumi" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|sumi" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.06",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "300", "lineHeight": "0.98", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "300", "lineHeight": "1.02", "letterSpacing": "-0.015em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "500", "letterSpacing": "0" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "600", "letterSpacing": "0" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.16em", "textTransform": "lowercase" } },
      "button": {
        "color": { "background": "var:preset|color|moss-deep", "text": "var:preset|color|washi" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|moss-deep", "radius": "999px" },
        "spacing": { "padding": { "top": "0.9rem", "right": "1.75rem", "bottom": "0.9rem", "left": "1.75rem" } },
        "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "1.0625rem", "fontWeight": "600", "letterSpacing": "0.14em", "textTransform": "lowercase", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|sumi", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|sumi" } },
        ":focus": { "color": { "background": "var:preset|color|sumi", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|sumi" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|stone" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|small", "lineHeight": "1.5" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.75rem", "fontWeight": "500", "letterSpacing": "0.01em", "lineHeight": "1" },
        "elements": { "link": { "color": { "text": "var:preset|color|sumi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|stone" },
        "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.18em", "textTransform": "lowercase" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "1.0625rem", "fontWeight": "600", "letterSpacing": "0.14em", "textTransform": "lowercase", "lineHeight": "1.3" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "400", "letterSpacing": "-0.01em", "lineHeight": "1.06" },
        "elements": { "link": { "color": { "text": "var:preset|color|sumi" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|stone" },
        "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.14em", "textTransform": "lowercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|stone" },
        "typography": { "fontFamily": "var:preset|font-family|small-caps", "fontSize": "var:preset|font-size|small", "fontWeight": "600", "letterSpacing": "0.14em", "textTransform": "lowercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|moss" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|stone" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.7" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "300" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|stone" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "400", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.25" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontWeight": "300", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.08" }
      },
      "core/image": {
        "border": { "radius": "2px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.3em;text-decoration-thickness:1px;transition:color .4s ease,text-decoration-color .4s ease}::selection{background:var(--wp--preset--color--moss);color:var(--wp--preset--color--washi)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "The inn (about)", "postTypes": ["page"] },
    { "name": "page-rooms", "title": "Rooms", "postTypes": ["page"] },
    { "name": "page-onsen-dining", "title": "Onsen & dining", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Seasonal letter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Enquire & reserve", "postTypes": ["page"] }
  ]
}
