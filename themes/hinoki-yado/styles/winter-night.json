{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Winter Night",
  "settings": {
    "color": {
      "palette": [
        { "slug": "hinoki", "name": "Snow night (ground)", "color": "#171B1D" },
        { "slug": "washi", "name": "Lantern paper", "color": "#20262A" },
        { "slug": "hairline", "name": "Hairline", "color": "#343C40" },
        { "slug": "steam", "name": "Breath grey", "color": "#4C5559" },
        { "slug": "stone", "name": "Frost stone", "color": "#A3ABA8" },
        { "slug": "moss", "name": "Lichen", "color": "#A9BC93" },
        { "slug": "moss-deep", "name": "Deep night", "color": "#0F1213" },
        { "slug": "sumi", "name": "Snow", "color": "#EDEAE2" },
        { "slug": "kaki", "name": "Lantern persimmon", "color": "#E3804F" }
      ],
      "gradients": [
        { "slug": "steam", "name": "Steam", "gradient": "radial-gradient(120% 80% at 20% 0%, rgba(76,85,89,.55) 0%, rgba(23,27,29,0) 60%), radial-gradient(90% 70% at 90% 100%, rgba(227,128,79,.10) 0%, rgba(23,27,29,0) 70%)" },
        { "slug": "dusk-moss", "name": "Dusk over moss", "gradient": "linear-gradient(180deg, #0F1213 0%, #171B1D 100%)" }
      ]
    },
    "custom": {
      "onDark": "#EDEAE2"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|sumi", "text": "var:preset|color|hinoki" },
        "border": { "color": "var:preset|color|sumi" },
        ":hover": { "color": { "background": "var:preset|color|kaki", "text": "var:preset|color|moss-deep" }, "border": { "color": "var:preset|color|kaki" } },
        ":focus": { "color": { "background": "var:preset|color|kaki", "text": "var:preset|color|moss-deep" }, "border": { "color": "var:preset|color|kaki" } }
      }
    }
  }
}
