{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1280px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (cool pale grey)",
     "color": "#E9EDF0"
    },
    {
     "slug": "paper",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (tetsu-kon navy)",
     "color": "#1E2A3A"
    },
    {
     "slug": "ink-hover",
     "name": "Ink hover",
     "color": "#2C3B50"
    },
    {
     "slug": "text",
     "name": "Body text",
     "color": "#3A4553"
    },
    {
     "slug": "signal",
     "name": "Signal red (labels, numerals, rail)",
     "color": "#D9001E"
    },
    {
     "slug": "signal-deep",
     "name": "Signal red hover",
     "color": "#B80019"
    },
    {
     "slug": "signal-tint",
     "name": "Signal tint",
     "color": "#FCEBEC"
    },
    {
     "slug": "slate",
     "name": "Overlay blue",
     "color": "#98AADE"
    },
    {
     "slug": "rose",
     "name": "Overlay rose",
     "color": "#DE8289"
    },
    {
     "slug": "aqua",
     "name": "Overlay aqua",
     "color": "#78D7DD"
    },
    {
     "slug": "straw",
     "name": "Overlay straw",
     "color": "#EDC880"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.625rem",
     "fluid": {
      "min": "1.3rem",
      "max": "1.625rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section statement",
     "size": "2.625rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.625rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "4.25rem",
     "fluid": {
      "min": "2.5rem",
      "max": "4.25rem"
     }
    },
    {
     "slug": "huge",
     "name": "Section word",
     "size": "clamp(4.25rem, 9vw, 8.5rem)",
     "fluid": false
    },
    {
     "slug": "hero",
     "name": "Hero lockup",
     "size": "clamp(5.25rem, 10.5vw, 10.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(4.5rem, 10vw, 8.75rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--signal)"
     }
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.35"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "50px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "1rem"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "fontSize": "1.5rem"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-bare",
   "title": "Page with its own head",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}