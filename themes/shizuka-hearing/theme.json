{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "680px", "wideSize": "1272px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "mist", "name": "Mist", "color": "#F2F2F2" },
				{ "slug": "band", "name": "Band", "color": "#C5D1D5" },
				{ "slug": "ink", "name": "Ink", "color": "#49565E" },
				{ "slug": "deep", "name": "Deep ink", "color": "#2F3A40" },
				{ "slug": "primary", "name": "Slate blue", "color": "#51676B" },
				{ "slug": "slate", "name": "Dark slate", "color": "#3A464D" },
				{ "slug": "accent", "name": "Accent", "color": "#0086BF" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display", "name": "Manrope", "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215" } ]
				},
				{
					"slug": "body", "name": "Public Sans", "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "300 600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215" } ]
				},
				{
					"slug": "noto-tc", "name": "Noto Sans TC", "fontFamily": "\"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] } ]
				},
				{
					"slug": "noto-jp", "name": "Noto Sans JP", "fontFamily": "\"Noto Sans JP\", \"Noto Sans TC\", system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] } ]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.375rem" },
				{ "slug": "large", "name": "Large", "size": "2.125rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "XX large", "size": "4.375rem" },
				{ "slug": "huge", "name": "Huge", "size": "6.75rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "3rem" },
				{ "slug": "50", "name": "L", "size": "5.75rem" },
				{ "slug": "60", "name": "XL", "size": "10.5rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.9", "fontWeight": "400" },
		"spacing": { "blockGap": "0" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--ink)" }, ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.4", "letterSpacing": "0.01em" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.95" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.22" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": { "color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
