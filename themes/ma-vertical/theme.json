{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "640px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "paper", "name": "Washi paper", "color": "#F6F3EC" },
        { "slug": "paper-deep", "name": "Kinari (unbleached)", "color": "#ECE7DC" },
        { "slug": "ink", "name": "Sumi ink", "color": "#1F1E1C" },
        { "slug": "ink-soft", "name": "Usuzumi (pale ink)", "color": "#4A4743" },
        { "slug": "grey", "name": "Nezumi (mouse grey)", "color": "#8C877E" },
        { "slug": "hairline", "name": "Hairline", "color": "#D8D2C6" },
        { "slug": "shu", "name": "Shu vermilion", "color": "#B5523B" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Shippori Mincho)",
          "fontFamily": "\"Shippori Mincho\", \"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", \"YuMincho\", \"Noto Serif CJK JP\", \"Source Han Serif JP\", serif",
          "fontFace": [
            { "fontFamily": "Shippori Mincho", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/shippori-mincho-400-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Shippori Mincho", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/shippori-mincho-500-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Shippori Mincho", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/shippori-mincho-600-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Zen Kaku Gothic New)",
          "fontFamily": "\"Zen Kaku Gothic New\", \"Noto Sans JP\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", \"YuGothic\", \"Noto Sans CJK JP\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Zen Kaku Gothic New", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/zen-kaku-gothic-new-400-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Zen Kaku Gothic New", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/zen-kaku-gothic-new-500-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Extra small", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium (body)", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)" },
        { "slug": "x-large", "name": "Extra large (heading)", "size": "clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem)" },
        { "slug": "xx-large", "name": "2X large (title)", "size": "clamp(2.125rem, 1.5rem + 2.4vw, 3.5rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.5rem, 1.4rem + 4vw, 5.25rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "1 Hair", "size": "0.5rem" },
        { "slug": "20", "name": "2 Inch", "size": "0.75rem" },
        { "slug": "30", "name": "3 Foot", "size": "1.25rem" },
        { "slug": "40", "name": "4 Ma", "size": "clamp(1.5rem, 1rem + 1.5vw, 2.5rem)" },
        { "slug": "50", "name": "5 Ma", "size": "clamp(2.5rem, 1.5rem + 3vw, 4rem)" },
        { "slug": "60", "name": "6 Ma", "size": "clamp(3.5rem, 2rem + 5vw, 6.5rem)" },
        { "slug": "70", "name": "7 Ma", "size": "clamp(5rem, 3rem + 7vw, 10rem)" },
        { "slug": "80", "name": "8 Ma", "size": "clamp(6rem, 3rem + 10vw, 14rem)" }
      ]
    },
    "custom": {
      "tategaki": {
        "measure": "14em",
        "measureLong": "22em"
      },
      "hairline": "1px solid var(--wp--preset--color--hairline)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "2",
      "letterSpacing": "0.04em"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|ink" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var:preset|color|shu" }
        },
        ":focus": {
          "color": { "text": "var:preset|color|shu" }
        }
      },
      "heading": {
        "color": { "text": "var:preset|color|ink" },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "500",
          "lineHeight": "1.6",
          "letterSpacing": "0.08em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.4" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
      "h5": { "typography": { "fontSize": "var:preset|font-size|small" } },
      "h6": { "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.2em" } },
      "button": {
        "color": { "background": "transparent", "text": "var:preset|color|ink" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|ink", "radius": "0px" },
        "spacing": { "padding": { "top": "0.9rem", "right": "2.25rem", "bottom": "0.9rem", "left": "2.25rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.24em", "lineHeight": "1.6" },
        ":hover": {
          "color": { "background": "var:preset|color|ink", "text": "var:preset|color|paper" }
        },
        ":focus": {
          "color": { "background": "var:preset|color|ink", "text": "var:preset|color|paper" }
        }
      },
      "caption": {
        "color": { "text": "var:preset|color|grey" },
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.12em" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "var:preset|font-size|large", "fontWeight": "500", "letterSpacing": "0.2em", "lineHeight": "1.4" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|grey" },
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.16em" }
      },
      "core/navigation": {
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.22em", "lineHeight": "1.6" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "500", "letterSpacing": "0.1em", "lineHeight": "1.6" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|grey" },
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.16em" }
      },
      "core/post-terms": {
        "typography": { "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.16em" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|ink-soft" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "2" }
      },
      "core/query-title": {
        "typography": { "fontFamily": "var:preset|font-family|serif" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "var:preset|font-size|large", "lineHeight": "2" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/image": {
        "border": { "radius": "0px" }
      }
    },
    "css": "a{text-underline-offset:0.3em;text-decoration-thickness:1px;transition:color .3s ease}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "post-meta", "title": "Post meta", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Newsletter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
