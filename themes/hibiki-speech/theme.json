{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "wash",
					"name": "Wash",
					"color": "#F4F4F4"
				},
				{
					"slug": "arch",
					"name": "Arch",
					"color": "#ECECEC"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#000000"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#4F4F4F"
				},
				{
					"slug": "yellow",
					"name": "Sunflower yellow",
					"color": "#EFC926"
				},
				{
					"slug": "blue",
					"name": "Crayon blue",
					"color": "#1E7AC6"
				},
				{
					"slug": "link",
					"name": "Link blue",
					"color": "#0062AB"
				},
				{
					"slug": "teal",
					"name": "Teal",
					"color": "#02B990"
				},
				{
					"slug": "leaf",
					"name": "Leaf green",
					"color": "#62AF5E"
				},
				{
					"slug": "orange",
					"name": "Crayon orange",
					"color": "#F56300"
				},
				{
					"slug": "pink",
					"name": "Badge pink",
					"color": "#E8478B"
				},
				{
					"slug": "slate",
					"name": "Slate",
					"color": "#4F6465"
				},
				{
					"slug": "outline",
					"name": "Card outline",
					"color": "#F7E7A0"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#E4E4E4"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Hanken Grotesk)",
					"fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Public Sans)",
					"fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-zh",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-400-zh-tw.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-700-zh-tw.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-ja",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-400-ja.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-700-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Label",
					"size": "0.8125rem"
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Lead",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Statement",
					"size": "1.375rem"
				},
				{
					"slug": "x-large",
					"name": "Heading 2",
					"size": "2rem"
				},
				{
					"slug": "xx-large",
					"name": "Hero heading",
					"size": "clamp(2.75rem, 5vw, 4.5rem)"
				},
				{
					"slug": "number",
					"name": "Big number",
					"size": "3.5rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "4rem"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "clamp(3.5rem, 7vw, 7.5rem)"
				}
			]
		},
		"border": {
			"radius": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "crayon",
					"name": "Crayon",
					"shadow": "3px 3px 0 rgba(162,162,162,.16)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75",
			"letterSpacing": "0.02em"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "0",
				"right": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"letterSpacing": "0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "0.04em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.8"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--slate)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--yellow)",
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700"
				}
			}
		}
	}
}