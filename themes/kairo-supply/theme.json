{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1392px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#0A0C0E" },
				{ "slug": "panel", "name": "Panel", "color": "#F9F9F9" },
				{ "slug": "grid", "name": "Grid", "color": "#E3E6E9" },
				{ "slug": "tick", "name": "Tick", "color": "#B9C1C7" },
				{ "slug": "ghost", "name": "Ghost", "color": "#F4F6F7" },
				{ "slug": "steel", "name": "Steel", "color": "#5C6E7A" },
				{ "slug": "steel-text", "name": "Steel text", "color": "#3E4A52" },
				{ "slug": "accent", "name": "Accent", "color": "#296EDF" },
				{ "slug": "muted", "name": "Muted", "color": "#BDC3C7" }
			]
		},
		"typography": {
			"fluid": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter Tight", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-tight-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Hanken Grotesk", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "text-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
					]
				},
				{
					"slug": "text-ja",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] },
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-700-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Label", "size": "0.6875rem" },
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "tag", "name": "Tagline", "size": "1.5625rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "Display", "size": "3.5rem" },
				{ "slug": "huge", "name": "Wordmark", "size": "clamp(5.5rem, 17.5vw, 16rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "4rem" },
				{ "slug": "60", "name": "XL", "size": "6.5rem" },
				{ "slug": "70", "name": "XXL", "size": "10rem" }
			]
		},
		"border": { "radius": true },
		"shadow": { "defaultPresets": false, "presets": [] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.6" },
		"spacing": { "padding": { "left": "24px", "right": "24px" }, "blockGap": "1.25rem" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "1.375rem" } },
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "9999px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "500", "textDecoration": "none" },
				"spacing": { "padding": { "top": "9px", "bottom": "9px", "left": "32px", "right": "32px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "lineHeight": "1.35" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800" } }
		}
	},
	"customTemplates": [
		{ "name": "page-inner", "title": "Inner page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
