{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1100px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "soft",
     "name": "Soft ground",
     "color": "#F4F4F3"
    },
    {
     "slug": "rule",
     "name": "Rule grey",
     "color": "#E5E5E3"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#111111"
    },
    {
     "slug": "steel",
     "name": "Steel",
     "color": "#5C6E7A"
    },
    {
     "slug": "sky",
     "name": "Sky steel",
     "color": "#88A5BE"
    },
    {
     "slug": "band",
     "name": "Pale steel band",
     "color": "#DCE3E8"
    },
    {
     "slug": "deep",
     "name": "Deep slate",
     "color": "#244A62"
    },
    {
     "slug": "signal",
     "name": "Signal yellow",
     "color": "#FFD900"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B7177"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Heading (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "sans-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "sans-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "H3",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section word",
     "size": "3.5rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "4.5rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "7.5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(6rem, 15vw, 13.75rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "card",
     "name": "Card",
     "shadow": "0 20px 60px rgba(0,0,0,.12)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "1.25em"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--steel)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.08",
     "letterSpacing": "0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.02"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "2.25rem"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.25"
    }
   },
   "button": {
    "border": {
     "radius": "1000px"
    },
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--ground)"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "500"
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}