{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Warm paper (ground)",
          "color": "#FBF1E7"
        },
        {
          "slug": "shu",
          "name": "Shu vermilion (main colour, large fields)",
          "color": "#EB6101"
        },
        {
          "slug": "pale",
          "name": "Pale vermilion (soft panels)",
          "color": "#F8D3B8"
        },
        {
          "slug": "ink",
          "name": "Sumi brown-black (text, header, footer)",
          "color": "#1E1009"
        },
        {
          "slug": "deep",
          "name": "Deep vermilion (links, buttons on paper)",
          "color": "#A63E00"
        },
        {
          "slug": "quiet",
          "name": "Smoked wood (secondary text)",
          "color": "#5C4234"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Reggae One)",
          "fontFamily": "\"Reggae One\", \"Hiragino Sans\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Reggae One",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/reggae-one-regular.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Sawarabi Gothic)",
          "fontFamily": "\"Sawarabi Gothic\", \"Hiragino Sans\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Sawarabi Gothic",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/sawarabi-gothic-regular.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.8",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.06em",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (sumi bar: shop name, Reserve a seat button and the menu button that opens a full-screen vermilion overlay)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (sumi field: shop name, synced shop details and links)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
