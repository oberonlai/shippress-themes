{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#F3F1EF"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#313131"
				},
				{
					"slug": "celadon",
					"name": "Celadon",
					"color": "#5E7A70"
				},
				{
					"slug": "celadon-dark",
					"name": "Celadon dark",
					"color": "#4F6A60"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#D9D9D9"
				},
				{
					"slug": "dotted",
					"name": "Dotted rule",
					"color": "#D7D3D0"
				},
				{
					"slug": "unfilled",
					"name": "Unfilled grey",
					"color": "#C9C4BF"
				},
				{
					"slug": "yellow",
					"name": "Doodle yellow",
					"color": "#FDD79A"
				},
				{
					"slug": "lilac",
					"name": "Doodle lilac",
					"color": "#DAD0EC"
				},
				{
					"slug": "peach",
					"name": "Doodle peach",
					"color": "#FAACA8"
				},
				{
					"slug": "mint",
					"name": "Celadon tint",
					"color": "#DCE5E0"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Manrope)",
					"fontFamily": "\"Manrope\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Public Sans)",
					"fontFamily": "\"Public Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-500.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Label",
					"size": "0.8125rem"
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Statement",
					"size": "1.375rem"
				},
				{
					"slug": "large",
					"name": "Section title",
					"size": "1.75rem"
				},
				{
					"slug": "x-large",
					"name": "Page title",
					"size": "2.25rem"
				},
				{
					"slug": "xx-large",
					"name": "Hero title",
					"size": "4.25rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "10",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "20",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "30",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "40",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "50",
					"size": "3rem"
				},
				{
					"slug": "60",
					"name": "60",
					"size": "4rem"
				},
				{
					"slug": "70",
					"name": "70",
					"size": "5rem"
				},
				{
					"slug": "80",
					"name": "80",
					"size": "8.75rem"
				}
			]
		},
		"border": {
			"radius": true
		},
		"custom": {
			"radius": {
				"card": "32px",
				"photo": "24px",
				"pill": "999px",
				"button": "6px",
				"square": "8px"
			},
			"ease": "cubic-bezier(.23, 1, .32, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--celadon-dark)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.6",
					"letterSpacing": "0.04em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"lineHeight": "1.5"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "6px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"fontSize": "0.9375rem"
				}
			}
		}
	}
}