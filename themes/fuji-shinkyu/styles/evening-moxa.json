{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Evening Moxa",
  "settings": {
    "color": {
      "palette": [
        { "slug": "washi", "name": "Evening (ground)", "color": "#1C1622" },
        { "slug": "paper", "name": "Lamp paper", "color": "#251D2C" },
        { "slug": "mist", "name": "Dusk lilac", "color": "#2C2333" },
        { "slug": "fuji-pale", "name": "Shadow wisteria", "color": "#3A2F45" },
        { "slug": "hairline", "name": "Hairline", "color": "#443850" },
        { "slug": "fuji", "name": "Night wisteria", "color": "#9C86C4" },
        { "slug": "kin", "name": "Moxa glow (points)", "color": "#D8BC7E" },
        { "slug": "mute", "name": "Quiet text", "color": "#B3A8BF" },
        { "slug": "shion", "name": "Lantern violet", "color": "#C4AEE6" },
        { "slug": "murasaki", "name": "Paper ink", "color": "#F1EAF6" }
      ],
      "gradients": [
        { "slug": "halo", "name": "Halo", "gradient": "radial-gradient(48% 62% at 82% 22%, rgba(156,134,196,.20) 0%, rgba(28,22,34,0) 70%), radial-gradient(40% 50% at 6% 96%, rgba(216,188,126,.10) 0%, rgba(28,22,34,0) 70%)" },
        { "slug": "dawn", "name": "Dawn", "gradient": "linear-gradient(180deg, #1C1622 0%, #2C2333 100%)" }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|murasaki", "text": "var:preset|color|washi" },
        "border": { "color": "var:preset|color|murasaki" },
        ":hover": { "color": { "background": "var:preset|color|shion", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|shion" } },
        ":focus": { "color": { "background": "var:preset|color|shion", "text": "var:preset|color|washi" }, "border": { "color": "var:preset|color|shion" } }
      }
    }
  }
}
