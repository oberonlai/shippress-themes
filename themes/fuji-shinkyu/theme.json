{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "640px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "washi", "name": "Washi white (ground)", "color": "#FAF8FC" },
        { "slug": "paper", "name": "Paper", "color": "#FFFFFF" },
        { "slug": "mist", "name": "Lilac mist", "color": "#F1EDF6" },
        { "slug": "fuji-pale", "name": "Pale wisteria", "color": "#E6DEF1" },
        { "slug": "hairline", "name": "Hairline", "color": "#DDD5E7" },
        { "slug": "fuji", "name": "Fuji wisteria", "color": "#B7A3D8" },
        { "slug": "kin", "name": "Kin muted gold (points)", "color": "#A88848" },
        { "slug": "mute", "name": "Grey-lilac text", "color": "#665D73" },
        { "slug": "shion", "name": "Shion violet (accent text)", "color": "#6A4C93" },
        { "slug": "murasaki", "name": "Murasaki plum (ink)", "color": "#33213F" }
      ],
      "gradients": [
        { "slug": "halo", "name": "Halo", "gradient": "radial-gradient(48% 62% at 82% 22%, rgba(183,163,216,.34) 0%, rgba(250,248,252,0) 70%), radial-gradient(40% 50% at 6% 96%, rgba(230,222,241,.75) 0%, rgba(250,248,252,0) 70%)" },
        { "slug": "dawn", "name": "Dawn", "gradient": "linear-gradient(180deg, #FAF8FC 0%, #F1EDF6 100%)" }
      ],
      "duotone": [
        { "slug": "murasaki-washi", "name": "Murasaki and washi", "colors": ["#33213F", "#FAF8FC"] },
        { "slug": "shion-mist", "name": "Shion and mist", "colors": ["#4A3466", "#F1EDF6"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Urbanist)",
          "fontFamily": "Urbanist, \"Avenir Next\", \"Futura\", \"Century Gothic\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Urbanist", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/urbanist-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Urbanist", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/urbanist-italic-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Text (Manrope)",
          "fontFamily": "Manrope, \"Helvetica Neue\", Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
        { "slug": "xx-large", "name": "Section title", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "4rem" } },
        { "slug": "display", "name": "Display", "size": "6rem", "fluid": { "min": "3rem", "max": "6.75rem" } },
        { "slug": "giant", "name": "Wordmark", "size": "10rem", "fluid": { "min": "3.75rem", "max": "11rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Point", "size": "0.5rem" },
        { "slug": "20", "name": "Breath", "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)" },
        { "slug": "30", "name": "Pulse", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)" },
        { "slug": "40", "name": "Ring", "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)" },
        { "slug": "50", "name": "Ma", "size": "clamp(3rem, 1.8rem + 4.2vw, 6.5rem)" },
        { "slug": "60", "name": "Wide ma", "size": "clamp(4.5rem, 2.4rem + 7vw, 10rem)" },
        { "slug": "70", "name": "Deep ma", "size": "clamp(6rem, 3rem + 10.5vw, 15rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.33, 0, .2, 1)",
      "breath": "10s"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|washi",
      "text": "var:preset|color|murasaki"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.75",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|shion" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|murasaki" } },
        ":focus": { "color": { "text": "var:preset|color|murasaki" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|murasaki" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "300",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "200", "lineHeight": "1", "letterSpacing": "-0.035em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "250", "lineHeight": "1.04", "letterSpacing": "-0.03em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "300" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "500", "letterSpacing": "-0.01em" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "600", "letterSpacing": "0" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "letterSpacing": "0.2em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "var:preset|color|murasaki", "text": "var:preset|color|washi" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|murasaki", "radius": "999px" },
        "spacing": { "padding": { "top": "0.95rem", "right": "1.85rem", "bottom": "0.95rem", "left": "1.85rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "600", "letterSpacing": "0.16em", "textTransform": "uppercase", "lineHeight": "1.2" },
        ":hover": { "color": { "background": "var:preset|color|shion", "text": "var:preset|color|paper" }, "border": { "color": "var:preset|color|shion" } },
        ":focus": { "color": { "background": "var:preset|color|shion", "text": "var:preset|color|paper" }, "border": { "color": "var:preset|color|shion" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "lineHeight": "1.55", "letterSpacing": "0.01em" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.375rem", "fontWeight": "400", "letterSpacing": "0.08em", "lineHeight": "1", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|murasaki" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.6875rem", "fontWeight": "500", "letterSpacing": "0.18em", "textTransform": "uppercase" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.8125rem", "fontWeight": "500", "letterSpacing": "0.14em", "textTransform": "uppercase", "lineHeight": "1.3" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "300", "letterSpacing": "-0.025em", "lineHeight": "1.06" },
        "elements": { "link": { "color": { "text": "var:preset|color|murasaki" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "500", "letterSpacing": "0.16em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|x-small", "fontWeight": "500", "letterSpacing": "0.16em", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|shion" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|mute" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.7" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "200" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|mute" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "300", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.25" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "200", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.1" }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/details": {
        "typography": { "fontSize": "var:preset|font-size|medium" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.3em;text-decoration-thickness:1px;transition:color .5s ease,text-decoration-color .5s ease}::selection{background:var(--wp--preset--color--fuji-pale);color:var(--wp--preset--color--murasaki)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About the clinic", "postTypes": ["page"] },
    { "name": "page-treatments", "title": "Treatments and prices", "postTypes": ["page"] },
    { "name": "page-booking", "title": "Booking and first visit", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Seasonal letter (newsletter)", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
