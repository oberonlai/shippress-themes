{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "760px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground", "color": "#E9EDF0" },
    { "slug": "surface", "name": "Surface (paper strip)", "color": "#F6F7F8" },
    { "slug": "ink", "name": "Ink", "color": "#12222D" },
    { "slug": "muted", "name": "Muted text", "color": "#6E7F8A" },
    { "slug": "accent", "name": "Hanada blue (accent)", "color": "#4E7A93" },
    { "slug": "accent-dark", "name": "Accent hover", "color": "#3F6A82" },
    { "slug": "tint", "name": "Accent tint", "color": "#DCE7EE" },
    { "slug": "line", "name": "Line", "color": "#C9D1D6" },
    { "slug": "white", "name": "White (card border)", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display",
     "name": "Display (Libre Baskerville)",
     "fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Libre Baskerville", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-wght.ttf" ] },
      { "fontFamily": "Libre Baskerville", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-Italic-wght.ttf" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Work Sans)",
     "fontFamily": "\"Work Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Work Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/work-sans-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.875rem" },
    { "slug": "medium", "name": "Body", "size": "1rem" },
    { "slug": "large", "name": "Large", "size": "1.25rem" },
    { "slug": "x-large", "name": "Card title", "size": "1.625rem" },
    { "slug": "xx-large", "name": "Section strip", "size": "clamp(1.9rem, 3.2vw, 2.75rem)" },
    { "slug": "huge", "name": "Page strip", "size": "clamp(2.4rem, 4.4vw, 4.25rem)" },
    { "slug": "display", "name": "Display", "size": "clamp(2.6rem, 5.2vw, 5.25rem)" },
    { "slug": "giant", "name": "Giant section title", "size": "clamp(3rem, 9vw, 7.5rem)" }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "%", "vw" ] },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.8", "letterSpacing": "0.02em" },
  "spacing": { "blockGap": "0px", "padding": { "left": "0px", "right": "0px" } },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.4" }, "color": { "text": "var(--wp--preset--color--ink)" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } } },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent)", "text": "#FFFFFF" },
    "border": { "radius": "1000px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "1rem", "letterSpacing": "0.05em" },
    "spacing": { "padding": { "top": "13px", "bottom": "13px", "left": "28px", "right": "28px" } },
    ":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)", "text": "#FFFFFF" } }
   }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
