{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "cloud",
     "name": "Cloud (blobs)",
     "color": "#ECF0F2"
    },
    {
     "slug": "cloud-soft",
     "name": "Cloud soft (circuit ground)",
     "color": "#F5F7F8"
    },
    {
     "slug": "navy",
     "name": "Navy (ink, menu disc, footer)",
     "color": "#001650"
    },
    {
     "slug": "band",
     "name": "Navy band (lesson strip)",
     "color": "#081858"
    },
    {
     "slug": "band-disc",
     "name": "Band disc",
     "color": "#14286A"
    },
    {
     "slug": "text",
     "name": "Body text",
     "color": "#1B2433"
    },
    {
     "slug": "steel",
     "name": "Steel (meta text)",
     "color": "#4E6874"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#8FA7B3"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DCE3E6"
    },
    {
     "slug": "orange",
     "name": "Windsock orange",
     "color": "#D9632B"
    },
    {
     "slug": "orange-text",
     "name": "Orange text",
     "color": "#B4531F"
    },
    {
     "slug": "orange-on-navy",
     "name": "Orange on navy",
     "color": "#E07A45"
    },
    {
     "slug": "ochre",
     "name": "Ochre (lark)",
     "color": "#C9923E"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh-TW",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "0.9375rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.0375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Heading 3",
     "size": "clamp(1.5rem, 2.4vw, 2.0625rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading 2",
     "size": "clamp(2rem, 3.4vw, 2.5625rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display (maximum 5.0625rem)",
     "size": "clamp(2.75rem, 5.6vw, 5.0625rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.76",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.2",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--navy)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "800",
     "lineHeight": "0.98",
     "letterSpacing": "-0.03em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.22"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.3"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--navy)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "100px"
    },
    "typography": {
     "fontSize": "0.96875rem",
     "fontWeight": "700",
     "fontFamily": "var(--wp--preset--font-family--display)"
    },
    "spacing": {
     "padding": {
      "top": "0.9rem",
      "bottom": "0.9rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}
