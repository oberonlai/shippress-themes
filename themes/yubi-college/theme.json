{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "900px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "White (header, cells, panels)", "color": "#FFFFFF" },
    { "slug": "ground", "name": "Ground (card sections)", "color": "#F6F6F6" },
    { "slug": "wash", "name": "Wash (aqua band)", "color": "#E7F5FC" },
    { "slug": "wash-deep", "name": "Wash deep (hero floor)", "color": "#D0EAF7" },
    { "slug": "primary", "name": "Primary blue (stubs, links, labels)", "color": "#0E3684" },
    { "slug": "blue", "name": "Blue (ribbon body, pill mid, numerals)", "color": "#4766B3" },
    { "slug": "dusk", "name": "Dusk (pill end)", "color": "#A9A8D0" },
    { "slug": "lilac", "name": "Lilac (triangle start)", "color": "#C9CCEA" },
    { "slug": "ink", "name": "Ink (headings, cell borders)", "color": "#090909" },
    { "slug": "text", "name": "Text (body)", "color": "#2A2E37" },
    { "slug": "muted", "name": "Muted (notes, labels)", "color": "#5E6370" },
    { "slug": "date", "name": "Date grey", "color": "#8A8E98" },
    { "slug": "line", "name": "Line (rules)", "color": "#D6D9DF" },
    { "slug": "alert", "name": "Alert (the one New label)", "color": "#FF4949" },
    { "slug": "footer", "name": "Footer ground (kon-ao)", "color": "#3E4C6A" },
    { "slug": "mist", "name": "Mist (muted text on footer)", "color": "#C9D1E3" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/source-serif-4-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunitosans-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "xs", "name": "XS (labels)", "size": "0.75rem" },
    { "slug": "s", "name": "S (nav, card text)", "size": "0.875rem" },
    { "slug": "m", "name": "M (body)", "size": "1rem" },
    { "slug": "lead", "name": "Lead", "size": "1.0625rem" },
    { "slug": "medium", "name": "H3 (card title)", "size": "1.25rem" },
    { "slug": "section", "name": "H2 (section heading)", "size": "2.75rem" },
    { "slug": "x-large", "name": "Inner h1 / taster h2", "size": "3.5rem" },
    { "slug": "huge", "name": "Hero h1", "size": "4.5rem" }
   ]
  },
  "spacing": {
   "units": ["px", "rem", "%", "vw"],
   "spacingSizes": [
    { "slug": "20", "name": "S", "size": "1rem" },
    { "slug": "30", "name": "M", "size": "2rem" },
    { "slug": "40", "name": "L", "size": "4rem" },
    { "slug": "50", "name": "Section", "size": "7.5rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.85",
   "letterSpacing": "0.01em"
  },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.27", "letterSpacing": "0.02em" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--primary)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--blue)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
    "border": { "radius": "999px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "1rem" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2", "letterSpacing": "0.02em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--section)", "lineHeight": "1.27", "letterSpacing": "0.02em" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.4" } }
  }
 },
 "customTemplates": [
  { "name": "page-inner", "title": "Inner page (no title)", "postTypes": ["page"] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
