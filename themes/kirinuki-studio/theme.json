{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1248px", "wideSize": "1408px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "mist-1", "name": "Mist sage (hero left)", "color": "#BFC9BD" },
    { "slug": "mist-2", "name": "Mist blush (hero right)", "color": "#CFC4B4" },
    { "slug": "ground", "name": "Ground", "color": "#EDEDEA" },
    { "slug": "sheet", "name": "Sheet", "color": "#FAFAF8" },
    { "slug": "base", "name": "White (header bar, ruled sheets)", "color": "#FFFFFF" },
    { "slug": "rule", "name": "Rule (grid lines)", "color": "#E6E6E2" },
    { "slug": "rule-2", "name": "Rule 2 (dividers)", "color": "#D6D5CF" },
    { "slug": "ink", "name": "Ink (text, dark band, footer, CTA)", "color": "#151614" },
    { "slug": "headline", "name": "Headline plum-grey", "color": "#47393F" },
    { "slug": "muted", "name": "Muted (labels)", "color": "#4F4A40" },
    { "slug": "stone", "name": "Stone (brand)", "color": "#A69E89" },
    { "slug": "stone-dark", "name": "Stone dark (small caps, focus)", "color": "#6E6754" },
    { "slug": "chip-plum", "name": "Chip plum", "color": "#6E4E6C" },
    { "slug": "chip-ochre", "name": "Chip ochre", "color": "#85652A" },
    { "slug": "chip-rose", "name": "Chip rose", "color": "#94495D" },
    { "slug": "chip-green", "name": "Chip green", "color": "#34684F" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Albert Sans\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibstedgrotesk-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albertsans-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "xs", "name": "XS (sub-labels, chips)", "size": "0.75rem" },
    { "slug": "s", "name": "S (captions, small buttons)", "size": "0.875rem" },
    { "slug": "m", "name": "M (body)", "size": "1rem" },
    { "slug": "l", "name": "L (row headings)", "size": "1.375rem" },
    { "slug": "xl", "name": "XL (section titles)", "size": "1.5rem" },
    { "slug": "lead", "name": "Lead (statement lead)", "size": "2rem" },
    { "slug": "title", "name": "Title (page titles)", "size": "3.5rem" },
    { "slug": "hero", "name": "Hero (hero headline)", "size": "5.5rem" }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "S", "size": "1rem" },
    { "slug": "30", "name": "M", "size": "2rem" },
    { "slug": "40", "name": "L", "size": "4rem" },
    { "slug": "50", "name": "Sheet gap", "size": "8rem" }
   ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
  "elements": {
   "heading": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--stone-dark)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--base)" },
    "border": { "radius": "1000px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "1rem" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--title)", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)", "lineHeight": "1.75" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--l)", "lineHeight": "1.4" } }
  }
 },
 "customTemplates": [
  { "name": "page-bare", "title": "Page without title (patterns carry their own heading)", "postTypes": [ "page" ] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
