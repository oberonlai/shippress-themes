{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "640px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        { "slug": "night", "name": "Night (ground)", "color": "#0E0F11" },
        { "slug": "shadow", "name": "Shadow", "color": "#16181B" },
        { "slug": "hairline", "name": "Hairline", "color": "#2A2D32" },
        { "slug": "slate", "name": "Slate grey", "color": "#80868E" },
        { "slug": "silver", "name": "Silver", "color": "#B9BEC4" },
        { "slug": "frost", "name": "Frost white", "color": "#ECEEF0" },
        { "slug": "cyanotype", "name": "Cyanotype (accent)", "color": "#7FA7B3" }
      ],
      "duotone": [
        { "slug": "silver-gelatin", "name": "Silver gelatin", "colors": ["#0E0F11", "#ECEEF0"] },
        { "slug": "cyanotype", "name": "Cyanotype", "colors": ["#0E1A20", "#CFE0E5"] }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display serif (Instrument Serif)",
          "fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Instrument Serif", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Instrument Serif", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-italic-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Instrument Sans)",
          "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (DM Mono)",
          "fontFamily": "\"DM Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
          "fontFace": [
            { "fontFamily": "DM Mono", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-mono-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Caption", "size": "0.6875rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Body", "size": "1rem" },
        { "slug": "large", "name": "Lead", "size": "clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem)" },
        { "slug": "x-large", "name": "Heading", "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem)" },
        { "slug": "xx-large", "name": "Section title", "size": "clamp(2.5rem, 1.4rem + 3.4vw, 5rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(3.25rem, 1.2rem + 6.4vw, 8.5rem)" },
        { "slug": "giant", "name": "Wordmark", "size": "clamp(4rem, 0.5rem + 14vw, 15rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "Hairline gap", "size": "0.5rem" },
        { "slug": "20", "name": "Gutter", "size": "clamp(1rem, 0.8rem + 0.6vw, 1.5rem)" },
        { "slug": "30", "name": "Small", "size": "clamp(1.5rem, 1.2rem + 1vw, 2.25rem)" },
        { "slug": "40", "name": "Medium", "size": "clamp(2rem, 1.4rem + 2vw, 3.5rem)" },
        { "slug": "50", "name": "Large", "size": "clamp(3rem, 1.8rem + 4vw, 6rem)" },
        { "slug": "60", "name": "Pause", "size": "clamp(4.5rem, 2.5rem + 6.5vw, 9.5rem)" },
        { "slug": "70", "name": "Ma", "size": "clamp(6rem, 3rem + 10vw, 14rem)" },
        { "slug": "80", "name": "Long ma", "size": "clamp(8rem, 4rem + 14vw, 20rem)" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.16, .84, .3, 1)",
      "frame": "1px solid var(--wp--preset--color--hairline)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|night",
      "text": "var:preset|color|silver"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7",
      "letterSpacing": "0.002em"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|frost" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var:preset|color|cyanotype" } },
        ":focus": { "color": { "text": "var:preset|color|cyanotype" } }
      },
      "heading": {
        "color": { "text": "var:preset|color|frost" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.04",
          "letterSpacing": "-0.012em"
        }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "0.95", "letterSpacing": "-0.025em" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1", "letterSpacing": "-0.02em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large", "letterSpacing": "0" } },
      "h5": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "fontWeight": "500", "letterSpacing": "0" } },
      "h6": { "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "fontWeight": "400", "letterSpacing": "0.14em", "textTransform": "uppercase" } },
      "button": {
        "color": { "background": "transparent", "text": "var:preset|color|frost" },
        "border": { "width": "1px", "style": "solid", "color": "var:preset|color|slate", "radius": "999px" },
        "spacing": { "padding": { "top": "0.85rem", "right": "1.6rem", "bottom": "0.85rem", "left": "1.6rem" } },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "fontWeight": "400", "letterSpacing": "0.14em", "textTransform": "uppercase", "lineHeight": "1.4" },
        ":hover": { "color": { "background": "var:preset|color|frost", "text": "var:preset|color|night" }, "border": { "color": "var:preset|color|frost" } },
        ":focus": { "color": { "background": "var:preset|color|frost", "text": "var:preset|color|night" }, "border": { "color": "var:preset|color|frost" } }
      },
      "caption": {
        "color": { "text": "var:preset|color|slate" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.08em", "lineHeight": "1.7", "textTransform": "uppercase" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.625rem", "fontWeight": "400", "letterSpacing": "-0.01em", "lineHeight": "1" },
        "elements": { "link": { "color": { "text": "var:preset|color|frost" }, "typography": { "textDecoration": "none" } } }
      },
      "core/site-tagline": {
        "color": { "text": "var:preset|color|slate" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.14em", "textTransform": "uppercase" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.14em", "textTransform": "uppercase", "lineHeight": "1.4" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "400", "letterSpacing": "-0.015em", "lineHeight": "1.05" },
        "elements": { "link": { "color": { "text": "var:preset|color|frost" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|slate" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.12em", "textTransform": "uppercase" }
      },
      "core/post-terms": {
        "color": { "text": "var:preset|color|slate" },
        "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|x-small", "letterSpacing": "0.12em", "textTransform": "uppercase" },
        "elements": { "link": { "color": { "text": "var:preset|color|silver" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|slate" },
        "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.65" }
      },
      "core/query-title": {
        "typography": { "fontSize": "var:preset|font-size|display" }
      },
      "core/term-description": {
        "color": { "text": "var:preset|color|slate" }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|hairline" },
        "border": { "width": "0px" }
      },
      "core/quote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.2" },
        "color": { "text": "var:preset|color|frost" },
        "spacing": { "padding": { "left": "0px" } }
      },
      "core/pullquote": {
        "border": { "width": "0px" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.05" }
      },
      "core/image": {
        "border": { "radius": "0px" }
      },
      "core/table": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/search": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      }
    },
    "css": "a{text-underline-offset:0.25em;text-decoration-thickness:1px;transition:color .3s ease,text-decoration-color .3s ease}::selection{background:var(--wp--preset--color--cyanotype);color:var(--wp--preset--color--night)}"
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-about", "title": "About the photographer", "postTypes": ["page"] },
    { "name": "page-work", "title": "Work (series index)", "postTypes": ["page"] },
    { "name": "page-series", "title": "Series (photo sequence)", "postTypes": ["page"] },
    { "name": "page-newsletter", "title": "Newsletter", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
