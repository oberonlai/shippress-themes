{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1208px",
			"wideSize": "1288px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#FFFFFF"
				},
				{
					"slug": "band",
					"name": "Pale band",
					"color": "#F6F7F7"
				},
				{
					"slug": "slate",
					"name": "Slate panel",
					"color": "#3B4044"
				},
				{
					"slug": "grey",
					"name": "Plan grey",
					"color": "#6E7174"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1A1C1E"
				},
				{
					"slug": "body",
					"name": "Body",
					"color": "#3F4448"
				},
				{
					"slug": "meta",
					"name": "Meta grey",
					"color": "#828282"
				},
				{
					"slug": "line",
					"name": "Hairline",
					"color": "#DBDBDB"
				},
				{
					"slug": "alum",
					"name": "Aluminium",
					"color": "#C9CDD0"
				},
				{
					"slug": "accent",
					"name": "Glass blue",
					"color": "#0078A8"
				},
				{
					"slug": "accent-hover",
					"name": "Glass blue, hover",
					"color": "#006690"
				}
			],
			"gradients": []
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Onest)",
					"fontFamily": "\"Onest\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (DM Sans)",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Eyebrow, labels",
					"size": "0.75rem"
				},
				{
					"slug": "s",
					"name": "Small text",
					"size": "0.875rem"
				},
				{
					"slug": "m",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "l",
					"name": "Lead, captions",
					"size": "1.125rem"
				},
				{
					"slug": "xl",
					"name": "H3",
					"size": "1.25rem"
				},
				{
					"slug": "2xl",
					"name": "Section headline",
					"size": "1.75rem"
				},
				{
					"slug": "3xl",
					"name": "Strip caption",
					"size": "2rem"
				},
				{
					"slug": "4xl",
					"name": "Inner page title",
					"size": "3rem"
				},
				{
					"slug": "display",
					"name": "Hero headline",
					"size": "4.5rem"
				}
			]
		},
		"custom": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontWeight": "400",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-hover)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.875rem",
					"fontWeight": "500"
				},
				"border": {
					"radius": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"bottom": "0.5rem",
						"left": "0.875rem",
						"right": "0.875rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			}
		}
	}
}
