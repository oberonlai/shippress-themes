{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#FFFFFF"
				},
				{
					"slug": "ground-2",
					"name": "Ground 2",
					"color": "#FAFAFA"
				},
				{
					"slug": "tint",
					"name": "Mauve tint",
					"color": "#ECE7EF"
				},
				{
					"slug": "main",
					"name": "Grape mouse",
					"color": "#5E4D6B"
				},
				{
					"slug": "pale",
					"name": "Pale mauve",
					"color": "#DDD3E4"
				},
				{
					"slug": "amber",
					"name": "Amber (the one CTA)",
					"color": "#C4701A"
				},
				{
					"slug": "amber-dark",
					"name": "Amber dark",
					"color": "#A95F14"
				},
				{
					"slug": "ink",
					"name": "Heading ink",
					"color": "#222222"
				},
				{
					"slug": "body",
					"name": "Body text",
					"color": "#555555"
				},
				{
					"slug": "grey",
					"name": "Grey",
					"color": "#E5E5E5"
				},
				{
					"slug": "marquee",
					"name": "Marquee grey",
					"color": "#8C8591"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "3rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "4rem"
				}
			]
		},
		"typography": {
			"fluid": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter Tight",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-tight-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Albert Sans",
					"fontFamily": "\"Albert Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/albert-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-500-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.25rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "X-large",
					"size": "2.125rem"
				},
				{
					"slug": "xx-large",
					"name": "Product name",
					"size": "4.5rem"
				}
			],
			"defaultFontSizes": false
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.9",
			"letterSpacing": "0.02em"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.25rem, 4vw, 3.25rem)",
					"lineHeight": "1.3",
					"letterSpacing": "0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--main)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "0.04em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"color": {
					"text": "var(--wp--preset--color--main)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--main)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--amber)",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "36px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"letterSpacing": "0.05em",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "1.125rem",
						"bottom": "1.125rem",
						"left": "2rem",
						"right": "2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--amber-dark)",
						"text": "#FFFFFF"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
