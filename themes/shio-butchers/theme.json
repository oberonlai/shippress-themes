{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1200px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "paper", "name": "Paper", "color": "#EFEBDD" },
        { "slug": "stage", "name": "Stage grey", "color": "#F5F5F5" },
        { "slug": "line", "name": "Hairline", "color": "#EDEDED" },
        { "slug": "line-strong", "name": "Input line", "color": "#DCDCDC" },
        { "slug": "ink", "name": "Ink", "color": "#0D0B0A" },
        { "slug": "body", "name": "Body text", "color": "#444444" },
        { "slug": "bark", "name": "Bark", "color": "#6B5346" },
        { "slug": "brass", "name": "Brass", "color": "#B09D60" },
        { "slug": "alert", "name": "Alert red", "color": "#ED4831" },
        { "slug": "dark", "name": "Dark wood", "color": "#3B2F2A" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Schibsted Grotesk)",
          "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Albert Sans)",
          "fontFamily": "\"Albert Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] },
            { "fontFamily": "Albert Sans", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-italic-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Japanese subset (Noto Sans JP)",
          "fontFamily": "\"Noto Sans JP\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "tab", "name": "Tab", "size": "0.625rem" },
        { "slug": "label", "name": "Label", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.8125rem" },
        { "slug": "row", "name": "Row", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "0.9375rem" },
        { "slug": "rail", "name": "Rail heading", "size": "1.0625rem" },
        { "slug": "h3", "name": "Heading 3", "size": "1.25rem" },
        { "slug": "figure", "name": "Figure", "size": "2.25rem" },
        { "slug": "h2", "name": "Section title", "size": "1.75rem" },
        { "slug": "page", "name": "Page title", "size": "3rem" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.75rem, 5.6vw, 4.5rem)" },
        { "slug": "display", "name": "Display", "size": "4.5rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "12px" },
        { "slug": "20", "name": "S", "size": "20px" },
        { "slug": "30", "name": "M", "size": "40px" },
        { "slug": "40", "name": "L", "size": "64px" },
        { "slug": "50", "name": "XL", "size": "100px" }
      ]
    },
    "custom": { "radius": "0", "container": "1200px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--body)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "1.75" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--bark)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--page)", "fontWeight": "700", "lineHeight": "1.08" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)" } }
    },
    "spacing": { "blockGap": "20px" },
    "blocks": {
      "core/button": { "border": { "radius": "0" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
