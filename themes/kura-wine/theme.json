{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "640px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (slate ink)", "color": "#282B33" },
				{ "slug": "section", "name": "Section field", "color": "#33363E" },
				{ "slug": "text", "name": "Text", "color": "#E2DCD0" },
				{ "slug": "bright", "name": "Bright text", "color": "#F1ECE3" },
				{ "slug": "muted", "name": "Muted", "color": "#94918A" },
				{ "slug": "umber", "name": "Umber (煤竹)", "color": "#6A5A48" },
				{ "slug": "wine", "name": "Wine (accent)", "color": "#7A1E22" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "utility",
					"name": "Utility (Karla)",
					"fontFamily": "\"Karla\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Karla",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/karla-variable-latin.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(2.5rem, 5.2vw, 4.5rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2.5rem" },
				{ "slug": "50", "name": "L", "size": "5rem" },
				{ "slug": "60", "name": "XL", "size": "7rem" },
				{ "slug": "70", "name": "XXL", "size": "10rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"ease": "cubic-bezier(.165,.84,.44,1)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7",
			"letterSpacing": "0.05em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--text)" },
				":hover": { "color": { "text": "var(--wp--preset--color--bright)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "300", "lineHeight": "1.15", "letterSpacing": "0" },
				"color": { "text": "var(--wp--preset--color--bright)" }
			},
			"button": {
				"border": { "radius": "0" },
				"color": { "background": "var(--wp--preset--color--text)", "text": "var(--wp--preset--color--base)" },
				"typography": { "fontSize": "0.875rem" }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--utility)", "fontWeight": "500", "letterSpacing": "0.2em", "textTransform": "uppercase", "fontSize": "0.9375rem" }, "elements": { "link": { "typography": { "textDecoration": "none" } } } },
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } }
		}
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
