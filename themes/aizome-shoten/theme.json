{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "kinari",
          "name": "Kinari paper (ground)",
          "color": "#F3EDE0"
        },
        {
          "slug": "paper",
          "name": "Fresh page",
          "color": "#FAF6EC"
        },
        {
          "slug": "kami",
          "name": "Aged page",
          "color": "#E6DAC0"
        },
        {
          "slug": "asagi",
          "name": "Asagi pale blue",
          "color": "#C9DCE3"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#D8CFBD"
        },
        {
          "slug": "ai",
          "name": "Ai indigo",
          "color": "#1F3A5F"
        },
        {
          "slug": "kon",
          "name": "Kon deep indigo",
          "color": "#13233A"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#5C6470"
        },
        {
          "slug": "sumi",
          "name": "Sumi ink",
          "color": "#1B1B1F"
        },
        {
          "slug": "kaki",
          "name": "Kaki persimmon (accent)",
          "color": "#D9622B"
        }
      ],
      "gradients": [
        {
          "slug": "indigo-vat",
          "name": "Indigo vat",
          "gradient": "linear-gradient(180deg, #1F3A5F 0%, #13233A 100%)"
        },
        {
          "slug": "page-edge",
          "name": "Page edge",
          "gradient": "linear-gradient(180deg, #F3EDE0 0%, #E6DAC0 100%)"
        },
        {
          "slug": "asagi-wash",
          "name": "Asagi wash",
          "gradient": "linear-gradient(180deg, #F3EDE0 0%, #C9DCE3 100%)"
        }
      ],
      "duotone": [
        {
          "slug": "ai-kinari",
          "name": "Indigo and kinari",
          "colors": [
            "#13233A",
            "#F3EDE0"
          ]
        },
        {
          "slug": "sumi-kami",
          "name": "Sumi and aged page",
          "colors": [
            "#1B1B1F",
            "#E6DAC0"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display grotesque (Archivo)",
          "fontFamily": "Archivo, \"Archivo Narrow\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontStyle": "normal",
              "fontWeight": "400 900",
              "fontStretch": "62% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/archivo-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "serif",
          "name": "Book serif (Newsreader)",
          "fontFamily": "Newsreader, \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Newsreader",
              "fontStyle": "italic",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Catalogue mono (DM Mono)",
          "fontFamily": "\"DM Mono\", \"SFMono-Regular\", Menlo, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-mono-400-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-mono-500-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.1875rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.1875rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.5rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.625rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "4.5rem",
          "fluid": {
            "min": "2.5rem",
            "max": "5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "8rem",
          "fluid": {
            "min": "3.25rem",
            "max": "9rem"
          }
        },
        {
          "slug": "giant",
          "name": "Wordmark",
          "size": "16rem",
          "fluid": {
            "min": "5rem",
            "max": "17rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Leading",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Line",
          "size": "clamp(1rem, 0.8rem + 0.7vw, 1.5rem)"
        },
        {
          "slug": "30",
          "name": "Paragraph",
          "size": "clamp(1.5rem, 1.2rem + 1.1vw, 2.5rem)"
        },
        {
          "slug": "40",
          "name": "Gutter",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 4rem)"
        },
        {
          "slug": "50",
          "name": "Margin",
          "size": "clamp(3rem, 1.8rem + 4.2vw, 6rem)"
        },
        {
          "slug": "60",
          "name": "Chapter",
          "size": "clamp(4rem, 2.2rem + 6.5vw, 9rem)"
        },
        {
          "slug": "70",
          "name": "Part",
          "size": "clamp(5.5rem, 3rem + 9vw, 13rem)"
        }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "slow": "0.9s"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|kinari",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|serif",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|ai"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|kaki"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|kaki"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ai"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "800",
          "lineHeight": "0.98",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "800",
          "lineHeight": "0.9",
          "letterSpacing": "-0.02em",
          "textTransform": "uppercase"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "800",
          "lineHeight": "0.92",
          "letterSpacing": "-0.015em",
          "textTransform": "uppercase"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "700",
          "lineHeight": "1.02"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "0"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700",
          "lineHeight": "1.3",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ai",
          "text": "var:preset|color|paper"
        },
        "border": {
          "width": "2px",
          "style": "solid",
          "color": "var:preset|color|ai",
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "right": "1.6rem",
            "bottom": "0.9rem",
            "left": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.8125rem",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|kaki",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|kaki"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|kaki",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|kaki"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.75rem",
          "letterSpacing": "0.04em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.5rem",
          "fontWeight": "900",
          "letterSpacing": "-0.01em",
          "lineHeight": "1",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ai"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.6875rem",
          "fontWeight": "400",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.8125rem",
          "fontWeight": "500",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "800",
          "letterSpacing": "-0.015em",
          "lineHeight": "0.98"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ai"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "400",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "400",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|kaki"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.55"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "800",
          "textTransform": "uppercase"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|ai"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontStyle": "italic",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.2"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontStyle": "italic",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.05"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/search": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.2em;text-decoration-thickness:1px;transition:color .3s ease,text-decoration-color .3s ease}::selection{background:var(--wp--preset--color--asagi);color:var(--wp--preset--color--kon)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the shop and press",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-events",
      "title": "Readings and events",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (The Slip)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and visit",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
