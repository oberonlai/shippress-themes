{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Indigo Night",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "kinari",
          "name": "Night indigo (ground)",
          "color": "#111D30"
        },
        {
          "slug": "paper",
          "name": "Lamp-lit page",
          "color": "#17263D"
        },
        {
          "slug": "kami",
          "name": "Shadow page",
          "color": "#0B1524"
        },
        {
          "slug": "asagi",
          "name": "Moon blue",
          "color": "#2E4A6E"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#2A3A55"
        },
        {
          "slug": "ai",
          "name": "Paper ink",
          "color": "#E9E1CF"
        },
        {
          "slug": "kon",
          "name": "Deepest indigo",
          "color": "#070F1C"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#9FAABA"
        },
        {
          "slug": "sumi",
          "name": "Kinari text",
          "color": "#F3EDE0"
        },
        {
          "slug": "kaki",
          "name": "Lantern persimmon",
          "color": "#EE7A43"
        }
      ],
      "gradients": [
        {
          "slug": "indigo-vat",
          "name": "Indigo vat",
          "gradient": "linear-gradient(180deg, #17263D 0%, #070F1C 100%)"
        },
        {
          "slug": "page-edge",
          "name": "Page edge",
          "gradient": "linear-gradient(180deg, #111D30 0%, #0B1524 100%)"
        },
        {
          "slug": "asagi-wash",
          "name": "Asagi wash",
          "gradient": "linear-gradient(180deg, #111D30 0%, #2E4A6E 100%)"
        }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|ai",
          "text": "var:preset|color|kon"
        },
        "border": {
          "color": "var:preset|color|ai"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|kaki",
            "text": "var:preset|color|kon"
          },
          "border": {
            "color": "var:preset|color|kaki"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|kaki",
            "text": "var:preset|color|kon"
          },
          "border": {
            "color": "var:preset|color|kaki"
          }
        }
      }
    },
    "css": "body::before{mix-blend-mode:screen;opacity:.08}body{--az-on-dark:var(--wp--preset--color--sumi)}.az-press .wp-block-button.is-style-outline .wp-block-button__link{color:var(--az-on-dark)}.az-press .is-style-label,.az-footer .is-style-label{color:var(--wp--preset--color--mute)}"
  }
}
