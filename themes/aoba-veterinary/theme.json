{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ground", "name": "Ground", "color": "#F8F8F8" },
				{ "slug": "band", "name": "Band", "color": "#F5F5F5" },
				{ "slug": "ink", "name": "Ink", "color": "#222222" },
				{ "slug": "text", "name": "Text", "color": "#333333" },
				{ "slug": "quiet", "name": "Quiet text", "color": "#555555" },
				{ "slug": "accent", "name": "Seiheki grey-green", "color": "#5F726E" },
				{ "slug": "mist", "name": "Mist", "color": "#C5D0CC" },
				{ "slug": "rule", "name": "Rule", "color": "#E2E2E2" },
				{ "slug": "rule-strong", "name": "Strong rule", "color": "#D0D0D0" }
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Display (Libre Baskerville)",
					"fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Libre Baskerville",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/LibreBaskerville-wght-latin.ttf" ]
						},
						{
							"fontFamily": "Libre Baskerville",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf" ]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Text (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sourcesans3-variable-latin.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.1875rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "1.875rem" },
				{ "slug": "xx-large", "name": "XX large", "size": "2.75rem" },
				{ "slug": "huge", "name": "Huge", "size": "4.25rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		},
		"border": {
			"radius": true
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|white",
			"text": "var:preset|color|text"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1rem, 4vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "1.0625rem",
			"fontWeight": "400",
			"lineHeight": "1.75",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|accent" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "700",
					"lineHeight": "1.4",
					"letterSpacing": "0"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.6" } },
			"h2": { "typography": { "fontSize": "1.75rem", "lineHeight": "1.4" } },
			"h3": { "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "1.1875rem", "lineHeight": "1.5" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|base" } },
			"button": {
				"color": { "background": "transparent", "text": "var:preset|color|ink" },
				"border": { "radius": "0px", "width": "1px", "style": "solid", "color": "var:preset|color|accent" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "0.9375rem",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"textDecoration": "none"
				},
				"spacing": { "padding": { "top": "0.75rem", "right": "1.5rem", "bottom": "0.75rem", "left": "1.5rem" } },
				":hover": { "color": { "background": "var:preset|color|accent", "text": "var:preset|color|white" } }
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "0px" } },
			"core/cover": { "border": { "radius": "0px" } },
			"core/separator": { "color": { "text": "var:preset|color|rule" } },
			"core/post-title": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "1.375rem", "fontWeight": "400", "lineHeight": "1.3" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page", "postTypes": [ "page" ] }
	]
}
