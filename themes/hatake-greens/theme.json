{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "sub",
     "name": "Sage white (cards, strips)",
     "color": "#EEF0EA"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#1F251C"
    },
    {
     "slug": "main",
     "name": "Pine sage (triangle, titles)",
     "color": "#4E5A48"
    },
    {
     "slug": "accent",
     "name": "Leaf (pill, dots, tags)",
     "color": "#6E8A5B"
    },
    {
     "slug": "leaf",
     "name": "Light leaf (on photos)",
     "color": "#CFE0C4"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5F665A"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#D9DDD3"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Tag",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Label",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Card title",
     "size": "1.625rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Hero headline",
     "size": "clamp(2rem, 1.4rem + 1.5vw, 3rem)",
     "fluid": false
    },
    {
     "slug": "xxx-large",
     "name": "Statement (maximum 4.5rem)",
     "size": "clamp(2.75rem, 1.6rem + 3.6vw, 4.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.8",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "700",
     "lineHeight": "1.5"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.45"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--main)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontSize": "0.875rem",
     "fontWeight": "600",
     "letterSpacing": "0.06em"
    },
    "spacing": {
     "padding": {
      "top": "0.6rem",
      "bottom": "0.6rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}