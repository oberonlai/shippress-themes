{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1120px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Warm white (ground)",
     "color": "#FFFCF2"
    },
    {
     "slug": "ukon",
     "name": "Ukon turmeric yellow (main colour, large fields)",
     "color": "#FABF14"
    },
    {
     "slug": "mist",
     "name": "Pale turmeric (soft panels)",
     "color": "#FEF0C2"
    },
    {
     "slug": "ink",
     "name": "Sumi brown-black (text, the rail, dark bands)",
     "color": "#1E1A12"
    },
    {
     "slug": "deep",
     "name": "Deep ochre (links and labels on light grounds)",
     "color": "#7A5400"
    },
    {
     "slug": "quiet",
     "name": "Smoked brown (secondary text)",
     "color": "#574F3E"
    },
    {
     "slug": "pale",
     "name": "Light turmeric (labels on ink)",
     "color": "#FBD25A"
    },
    {
     "slug": "ai",
     "name": "Indigo (small marks)",
     "color": "#27375A"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Zen Kaku Gothic Antique)",
     "fontFamily": "\"Zen Kaku Gothic Antique\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Zen Kaku Gothic Antique",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/zen-kaku-gothic-antique-700-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese kana and kanji subset (Zen Kaku Gothic Antique JA)",
     "fontFamily": "\"Zen Kaku Gothic Antique JA\", \"Hiragino Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Zen Kaku Gothic Antique JA",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/zen-kaku-gothic-antique-700-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
    "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.2",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em",
     "fontWeight": "700"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header (top bar: workshop name, Request a survey button; the menu as a fixed side rail on wide screens)",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer (ink field: house name, synced house details and the menu)",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (sections, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
