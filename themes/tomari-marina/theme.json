{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "mist",
					"name": "Mist (ground)",
					"color": "#E4E8E6"
				},
				{
					"slug": "ink",
					"name": "Deep harbour ink (text, dark bands)",
					"color": "#1E2A33"
				},
				{
					"slug": "teal",
					"name": "Ink teal (crew band)",
					"color": "#3E4A48"
				},
				{
					"slug": "white",
					"name": "White (type on photographs)",
					"color": "#FFFFFF"
				},
				{
					"slug": "navy",
					"name": "Navy (rules, chip, links)",
					"color": "#003C88"
				},
				{
					"slug": "red",
					"name": "Signal red (pennant mark only)",
					"color": "#C30D23"
				},
				{
					"slug": "tab",
					"name": "Tab yellow (open-today tab only)",
					"color": "#FFE58A"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#B9C2BF"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5C6866"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Newsreader)",
					"fontFamily": "Newsreader, \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "300 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-italic-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "body",
					"name": "Text (Literata)",
					"fontFamily": "Literata, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-italic-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.8125rem"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem"
				},
				{
					"slug": "medium",
					"name": "Label",
					"size": "1.375rem"
				},
				{
					"slug": "large",
					"name": "Tagline",
					"size": "1.875rem"
				},
				{
					"slug": "x-large",
					"name": "Bracket label",
					"size": "clamp(1.75rem, 1rem + 2.1vw, 2.75rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section heading",
					"size": "clamp(2.5rem, 1rem + 3.9vw, 4.25rem)"
				},
				{
					"slug": "huge",
					"name": "Display",
					"size": "clamp(4.25rem, 8.8vw, 7.9375rem)"
				},
				{
					"slug": "numeral",
					"name": "Numeral",
					"size": "clamp(6rem, 11.8vw, 10.625rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "2.125rem"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(4rem, 2rem + 6vw, 8.4375rem)"
				},
				{
					"slug": "60",
					"name": "Section end",
					"size": "clamp(5rem, 2rem + 9vw, 13.25rem)"
				}
			]
		},
		"border": {
			"radius": false
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|mist",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "400",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|navy"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "300",
					"lineHeight": "1"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|huge",
					"letterSpacing": "0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "400"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var:preset|color|ink"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "currentColor",
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|medium"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "0"
				}
			}
		}
	}
}