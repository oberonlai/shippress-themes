{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1044px",
   "wideSize": "1260px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#F3EEE6"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#333333"
    },
    {
     "slug": "main",
     "name": "Vine green",
     "color": "#4A6358"
    },
    {
     "slug": "main-2",
     "name": "Vine green, lighter",
     "color": "#5E7A6C"
    },
    {
     "slug": "tile",
     "name": "Tile green",
     "color": "#5B7568"
    },
    {
     "slug": "sub",
     "name": "Sage",
     "color": "#7E968A"
    },
    {
     "slug": "light",
     "name": "Leaf",
     "color": "#82997A"
    },
    {
     "slug": "accent",
     "name": "Wine (accent)",
     "color": "#6E2A3A"
    },
    {
     "slug": "wash-a",
     "name": "Wash deep",
     "color": "#E9EFE9"
    },
    {
     "slug": "wash-b",
     "name": "Wash light",
     "color": "#F7F9F5"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#E6E6E6"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6B6B6B"
    }
   ],
   "gradients": [
    {
     "slug": "type",
     "name": "Type gradient",
     "gradient": "linear-gradient(to right, #2E453A, #62806A)"
    },
    {
     "slug": "band",
     "name": "Band gradient",
     "gradient": "linear-gradient(to top right, #4A6358, #5E7A6C)"
    },
    {
     "slug": "wash",
     "name": "Wash",
     "gradient": "linear-gradient(to bottom right, #E9EFE9, #F7F9F5)"
    }
   ]
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.0625rem"
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "2.6rem"
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "5.0625rem"
    }
   ],
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "italic",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.25rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.375rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "5.625rem"
    },
    {
     "slug": "70",
     "name": "XXL",
     "size": "6.75rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "bar",
     "name": "Bar",
     "shadow": "0 4px 20px rgba(0,0,0,.08)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.875",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "var(--wp--preset--spacing--30)",
    "right": "var(--wp--preset--spacing--30)"
   },
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.3"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "clamp(3rem, 5.06vw, 5.0625rem)",
     "fontStyle": "italic",
     "fontWeight": "600",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.35"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.6875rem",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--main)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "9px"
    },
    "typography": {
     "fontSize": "0.95rem",
     "fontWeight": "600"
    }
   }
  },
  "blocks": {
   "core/button": {
    "spacing": {
     "padding": {
      "top": "1.2rem",
      "bottom": "1.2rem",
      "left": "1.7rem",
      "right": "1.7rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Full-width page (sections)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
