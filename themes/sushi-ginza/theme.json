{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "navy",
          "name": "Navy (headings, text, dark bands)",
          "color": "#0C1B2A"
        },
        {
          "slug": "paper",
          "name": "Paper (ground)",
          "color": "#F7F7F5"
        },
        {
          "slug": "hinoki",
          "name": "Hinoki (pale wood panels)",
          "color": "#E9E1D3"
        },
        {
          "slug": "slate",
          "name": "Slate (quiet meta text)",
          "color": "#56677A"
        },
        {
          "slug": "salmon",
          "name": "Muted salmon (tiny accents only: rules, plate rings)",
          "color": "#C8664A"
        },
        {
          "slug": "mist",
          "name": "Mist (hairlines)",
          "color": "#C9CDD2"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (DM Serif Display)",
          "fontFamily": "\"DM Serif Display\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "DM Serif Display",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-serif-display-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Inter)",
          "fontFamily": "Inter, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--navy)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.12",
          "letterSpacing": "-0.005em"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.25rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--navy)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.8125rem",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (masthead)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (two-tone split)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}