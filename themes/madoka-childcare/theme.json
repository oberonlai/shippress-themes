{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1284px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FBFAF3"
    },
    {
     "slug": "band",
     "name": "Band (torn sections)",
     "color": "#F3DDBD"
    },
    {
     "slug": "card",
     "name": "Light card",
     "color": "#FDF8E6"
    },
    {
     "slug": "walnut",
     "name": "Walnut (accent, small areas)",
     "color": "#7A6858"
    },
    {
     "slug": "spot",
     "name": "Spot (badge, time blobs)",
     "color": "#E2E1A2"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#372828"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6F625A"
    },
    {
     "slug": "white",
     "name": "White (label tabs)",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4.875rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "8rem"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Headings (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "H3",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "H2",
     "size": "2.25rem"
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "3rem"
    },
    {
     "slug": "huge",
     "name": "Hero",
     "size": "4.3125rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  },
  "custom": {
   "mc": {
    "wrap": "1284px",
    "heroInset": "27px",
    "secS": "clamp(3.5rem, 5.4vw, 4.875rem)",
    "secL": "clamp(6rem, 14vw, 12.75rem)",
    "bandGap": "6.625rem",
    "colGap": "3.625rem",
    "radius": "1.25rem",
    "shadow": "4px 4px 0 rgba(0,0,0,.12)",
    "hop": ".4s cubic-bezier(0,.95,.51,1.37)"
   }
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.9",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "500",
     "lineHeight": "1.6",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--walnut)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--walnut)"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "1.25rem"
    }
   }
  }
 }
}