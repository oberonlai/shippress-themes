{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1080px",
			"wideSize": "1080px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "blush",
					"name": "Blush (ground)",
					"color": "#F3EDE6"
				},
				{
					"slug": "tan",
					"name": "Tan (band)",
					"color": "#E7DED3"
				},
				{
					"slug": "white",
					"name": "White (plates)",
					"color": "#FFFFFF"
				},
				{
					"slug": "charcoal",
					"name": "Charcoal",
					"color": "#1B1512"
				},
				{
					"slug": "label",
					"name": "Label",
					"color": "#8C6F57"
				},
				{
					"slug": "chestnut",
					"name": "Chestnut (accent)",
					"color": "#852E19"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "albert-sans",
					"name": "Headings (Albert Sans)",
					"fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/albert-sans-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "onest",
					"name": "Body (Onest)",
					"fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "nav",
					"name": "Nav",
					"size": "0.8125rem"
				},
				{
					"slug": "label",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.125rem"
				},
				{
					"slug": "statement",
					"name": "Statement",
					"size": "1.75rem"
				},
				{
					"slug": "large",
					"name": "Reserve heading",
					"size": "2.25rem"
				},
				{
					"slug": "x-large",
					"name": "Heading (H2)",
					"size": "2.75rem"
				},
				{
					"slug": "xx-large",
					"name": "Page title",
					"size": "3.5rem"
				},
				{
					"slug": "number",
					"name": "Room number",
					"size": "4.25rem"
				},
				{
					"slug": "display",
					"name": "Display (H1)",
					"size": "4.75rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "6rem"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "12rem"
				}
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blush)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--onest)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.8",
			"letterSpacing": "0.01em"
		},
		"spacing": {
			"padding": {
				"left": "0",
				"right": "0"
			},
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--charcoal)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--albert-sans)",
					"fontWeight": "300",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--charcoal)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--chestnut)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--chestnut)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--albert-sans)",
					"fontWeight": "700",
					"fontSize": "0.8125rem",
					"letterSpacing": "0.086em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "#6E2514",
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"lineHeight": "1.35",
					"letterSpacing": "0"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}