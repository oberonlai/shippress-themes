{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F6F1E7"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#82642A"
				},
				{
					"slug": "deep",
					"name": "Deep ink",
					"color": "#5C4518"
				},
				{
					"slug": "clay",
					"name": "Clay panel",
					"color": "#D4BF96"
				},
				{
					"slug": "cream",
					"name": "Cream",
					"color": "#F6F1E8"
				},
				{
					"slug": "cinnamon",
					"name": "Cinnamon",
					"color": "#BE8F68"
				},
				{
					"slug": "ghost",
					"name": "Ghost",
					"color": "#ECE3D2"
				},
				{
					"slug": "ticket",
					"name": "Ticket",
					"color": "#FFFDF8"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Outfit)",
					"fontFamily": "\"Outfit\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/outfit-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Rubik)",
					"fontFamily": "\"Rubik\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rubik-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2197, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW subset)",
					"fontFamily": "\"Noto Sans TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja subset)",
					"fontFamily": "\"Noto Sans JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Tiny (kickers)",
					"size": "0.8125rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1rem"
				},
				{
					"slug": "label",
					"name": "Label",
					"size": "1.125rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.5rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2.25rem"
				},
				{
					"slug": "x-large",
					"name": "Inner page H1",
					"size": "3.5rem"
				},
				{
					"slug": "xx-large",
					"name": "Home H1",
					"size": "4.5rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.15",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.25",
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "999px"
				}
			}
		},
		"spacing": {
			"blockGap": "0"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}