{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "994px", "wideSize": "1067px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "band", "name": "Band", "color": "#F9F9F9" },
    { "slug": "ink", "name": "Ink (text, rules)", "color": "#2B3440" },
    { "slug": "steel", "name": "Steel (tile, call cell, request band, footer)", "color": "#3A4654" },
    { "slug": "signal", "name": "Signal (CTA, badge, square, rules)", "color": "#EF3340" },
    { "slug": "signal-deep", "name": "Signal pressed (header CTA, hover, tab)", "color": "#C8102E" },
    { "slug": "rule", "name": "Rule", "color": "#E6E6E6" },
    { "slug": "rule-strong", "name": "Rule strong", "color": "#CCCCCC" },
    { "slug": "muted", "name": "Muted text", "color": "#6B7480" },
    { "slug": "mist", "name": "Mist (text on steel)", "color": "#D9DEE3" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Inter Tight\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] },
      { "fontFamily": "Albert Sans", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-italic-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body and labels (Inter Tight)",
     "fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-tight-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese headings subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese headings subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Body", "size": "0.9375rem", "fluid": false },
    { "slug": "medium", "name": "Card title", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
    { "slug": "large", "name": "Section heading", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
    { "slug": "x-large", "name": "Figure", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
    { "slug": "xx-large", "name": "Hero heading", "size": "4.25rem", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "%", "vw", "vh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "3.5rem" },
    { "slug": "60", "name": "Section", "size": "clamp(4.5rem, 7.8vw, 7rem)" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false, "presets": [] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.86"
  },
  "spacing": { "padding": { "left": "clamp(1.25rem, 4vw, 2rem)", "right": "clamp(1.25rem, 4vw, 2rem)" }, "blockGap": "1.25rem" },
  "elements": {
   "link": {
    "color": { "text": "var(--wp--preset--color--signal-deep)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } },
    "typography": { "textDecoration": "underline" }
   },
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.35", "letterSpacing": "-0.01em" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.12" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.35" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.4" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--signal)", "text": "var(--wp--preset--color--paper)" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "1.25rem" }
   }
  },
  "blocks": {
   "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "1.25rem" } },
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" } }
  }
 },
 "customTemplates": [
  { "name": "page-bare", "title": "Page with its own head and the request band", "postTypes": [ "page" ] },
  { "name": "page-plain", "title": "Page with its own head, no request band", "postTypes": [ "page" ] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
