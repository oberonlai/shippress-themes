{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "948px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ground", "name": "Ground", "color": "#F0F2F1" },
        { "slug": "paper", "name": "Paper white", "color": "#FFFFFF" },
        { "slug": "ink", "name": "Ink", "color": "#0A0F0F" },
        { "slug": "ink-2", "name": "Ink grey", "color": "#696A6B" },
        { "slug": "ink-3", "name": "Dot grey", "color": "#818283" },
        { "slug": "line", "name": "Hairline", "color": "#BDBDBD" },
        { "slug": "accent", "name": "Seal red", "color": "#AA0813" },
        { "slug": "tide", "name": "Tide", "color": "#3E5556" },
        { "slug": "deep", "name": "Deep sea", "color": "#26373A" },
        { "slug": "sea-glass", "name": "Sea glass", "color": "#B9CDD0" },
        { "slug": "ice", "name": "Ice", "color": "#E3E9E7" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Onest)",
          "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Onest", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Albert Sans)",
          "fontFamily": "\"Albert Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] },
            { "fontFamily": "Albert Sans", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-italic-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Japanese subset (Noto Sans JP)",
          "fontFamily": "\"Noto Sans JP\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "mini", "name": "Mini address", "size": "0.6875rem" },
        { "slug": "label", "name": "Label", "size": "0.75rem" },
        { "slug": "caption", "name": "Caption", "size": "0.8375rem" },
        { "slug": "nav", "name": "Small nav", "size": "0.9rem" },
        { "slug": "body", "name": "Body", "size": "1.03125rem" },
        { "slug": "h3", "name": "Heading 3", "size": "1.3125rem" },
        { "slug": "h2", "name": "Heading 2", "size": "2.125rem" },
        { "slug": "time", "name": "Time", "size": "2.5rem" },
        { "slug": "h1-inner", "name": "Page title", "size": "3.25rem" },
        { "slug": "xx-large", "name": "Display", "size": "clamp(2.75rem, 1.4rem + 3.8vw, 4.5rem)" },
        { "slug": "display", "name": "Largest", "size": "4.5rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw", "svh" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "12px" },
        { "slug": "20", "name": "S", "size": "24px" },
        { "slug": "30", "name": "M", "size": "48px" },
        { "slug": "40", "name": "L", "size": "5rem" },
        { "slug": "50", "name": "XL", "size": "9.5rem" }
      ]
    },
    "custom": { "radius": "0" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "2", "letterSpacing": "0.02em" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.25" } },
      "link": { "color": { "text": "var(--wp--preset--color--tide)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.06", "letterSpacing": "-0.005em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)", "letterSpacing": "0.04em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "600", "lineHeight": "1.5", "letterSpacing": "0.04em" } }
    },
    "spacing": { "blockGap": "20px" },
    "blocks": {
      "core/button": { "border": { "radius": "0" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
