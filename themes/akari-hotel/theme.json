{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ink", "name": "Ink (ground)", "color": "#121212" },
				{ "slug": "base", "name": "Off-white (light ground)", "color": "#FBFBFA" },
				{ "slug": "white", "name": "White (text on ink)", "color": "#FFFFFF" },
				{ "slug": "ash", "name": "Ash (body on ink)", "color": "#A0A0A0" },
				{ "slug": "line", "name": "Hairline grey", "color": "#808080" },
				{ "slug": "accent", "name": "Kyubai mauve (small accents)", "color": "#7A6E80" },
				{ "slug": "tint", "name": "Mauve tint (focus)", "color": "#E9E6EB" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Cormorant Garamond)",
					"fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/cormorant-garamond-variable-latin.woff2"] },
						{ "fontFamily": "Cormorant Garamond", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"] }
					]
				},
				{
					"slug": "text",
					"name": "Text (Nunito Sans)",
					"fontFamily": "\"Nunito Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunitosans-variable-latin.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Label", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.125rem" },
				{ "slug": "h3", "name": "H3", "size": "clamp(1.6rem, 2.86vw, 2.57rem)" },
				{ "slug": "h2", "name": "H2", "size": "clamp(2rem, 3.6vw, 3.25rem)" },
				{ "slug": "wordmark", "name": "Hero wordmark", "size": "clamp(2.75rem, 6.25vw, 5.625rem)" },
				{ "slug": "chapter", "name": "Chapter word", "size": "clamp(4.5rem, 11.43vw, 10.3rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "3.5rem" },
				{ "slug": "60", "name": "XL", "size": "clamp(6rem, 10vw, 9rem)" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--text)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.05", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--wordmark)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h-2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h-3)", "lineHeight": "1", "letterSpacing": "-0.03em" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.125rem", "fontWeight": "500", "lineHeight": "1.2" },
				"spacing": { "padding": { "top": "0.5rem", "bottom": "0.5rem", "left": "1.75rem", "right": "1.75rem" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--label)", "fontWeight": "600" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
