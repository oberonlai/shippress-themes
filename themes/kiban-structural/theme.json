{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "46rem", "wideSize": "90rem" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#0D0D0D" },
				{ "slug": "mid", "name": "Mid grey (meta text)", "color": "#6A6A68" },
				{ "slug": "light", "name": "Light grey-blue", "color": "#C9D0D2" },
				{ "slug": "card", "name": "Card tint", "color": "#F7F6F6" },
				{ "slug": "card-2", "name": "Card tint, darker end", "color": "#EFEDED" },
				{ "slug": "band", "name": "Band overlay", "color": "#16181A" },
				{ "slug": "dot", "name": "Marker green (dots only)", "color": "#47C94A" }
			],
			"gradients": [
				{ "slug": "card", "name": "Card tint", "gradient": "linear-gradient(160deg, #F7F6F6 0%, #EFEDED 100%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Albert Sans)",
					"fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Albert Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/albert-sans-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Instrument Sans)",
					"fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small (13px)", "size": "0.8125rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
				{ "slug": "medium", "name": "H3 (24px)", "size": "1.5rem", "fluid": false },
				{ "slug": "large", "name": "Tagline (25px)", "size": "1.5625rem", "fluid": false },
				{ "slug": "x-large", "name": "H2 (40px)", "size": "clamp(1.875rem, 1.2rem + 1.9vw, 2.5rem)", "fluid": false },
				{ "slug": "xx-large", "name": "Band lines (56px)", "size": "clamp(2rem, 1rem + 4vw, 3.5rem)", "fluid": false },
				{ "slug": "display", "name": "Inner page word", "size": "clamp(4.5rem, 13vw, 11rem)", "fluid": false },
				{ "slug": "kv", "name": "Wordmark (250px)", "size": "clamp(6rem, 17.4vw, 15.625rem)", "fluid": false }
			]
		},
		"spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.5", "fontWeight": "400" },
		"spacing": { "blockGap": "0" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.2" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.33" } },
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "#FFFFFF" },
				"border": { "radius": "16px" },
				"typography": { "fontSize": "0.8125rem", "fontWeight": "600" },
				"spacing": { "padding": { "top": "0.25rem", "bottom": "0.25rem", "left": "0.875rem", "right": "0.875rem" } }
			}
		}
	}
}
