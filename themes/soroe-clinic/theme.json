{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground (cool paper)",
     "color": "#F4F7F6"
    },
    {
     "slug": "mist",
     "name": "Mist (page gutter)",
     "color": "#E1EAEB"
    },
    {
     "slug": "white",
     "name": "White (cells, chips)",
     "color": "#FFFFFF"
    },
    {
     "slug": "slate",
     "name": "Slate (band, line, pills)",
     "color": "#44698A"
    },
    {
     "slug": "slate-deep",
     "name": "Slate deep (hover)",
     "color": "#385872"
    },
    {
     "slug": "numeral",
     "name": "Numeral tint (on band)",
     "color": "#DCE6E3"
    },
    {
     "slug": "numeral-light",
     "name": "Numeral tint (on white)",
     "color": "#D3DEDF"
    },
    {
     "slug": "ink",
     "name": "Ink (headings, text)",
     "color": "#1E2A2F"
    },
    {
     "slug": "muted",
     "name": "Muted (notes, roles)",
     "color": "#5E7178"
    },
    {
     "slug": "line",
     "name": "Line (hairlines)",
     "color": "#C8D6D8"
    },
    {
     "slug": "ghost",
     "name": "Ghost (vertical word)",
     "color": "#E4EBEA"
    },
    {
     "slug": "coral",
     "name": "Coral (end dot only)",
     "color": "#C9826A"
    },
    {
     "slug": "footer",
     "name": "Footer ground",
     "color": "#2B3B41"
    },
    {
     "slug": "footer-text",
     "name": "Footer text",
     "color": "#E6EEEF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "XS (labels)",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "S (nav, captions)",
     "size": "0.8125rem"
    },
    {
     "slug": "m",
     "name": "M (body)",
     "size": "1rem"
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.0625rem"
    },
    {
     "slug": "medium-large",
     "name": "H3",
     "size": "1.75rem"
    },
    {
     "slug": "large",
     "name": "H2 section",
     "size": "2.5rem"
    },
    {
     "slug": "xx-large",
     "name": "Inner h1",
     "size": "3.25rem"
    },
    {
     "slug": "x-large",
     "name": "Figures",
     "size": "4rem"
    },
    {
     "slug": "huge",
     "name": "Hero h1",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "50",
     "name": "Section",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--mist)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.9",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.4",
     "letterSpacing": "0.04em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--slate-deep)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--slate)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "100px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "400",
     "lineHeight": "1.15",
     "letterSpacing": "0"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.4",
     "letterSpacing": "0.04em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium-large)",
     "lineHeight": "1.5",
     "letterSpacing": "0.06em"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}