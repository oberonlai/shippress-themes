{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "700px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "concrete",
					"name": "Stone white",
					"color": "#EEEDE9"
				},
				{
					"slug": "kerb",
					"name": "Mist blue",
					"color": "#E3E9F0"
				},
				{
					"slug": "paper",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1E2321"
				},
				{
					"slug": "quiet",
					"name": "Quiet grey",
					"color": "#565B58"
				},
				{
					"slug": "slate",
					"name": "Patent blue",
					"color": "#0D3770"
				},
				{
					"slug": "sage",
					"name": "Patent blue (accent)",
					"color": "#0D3770"
				},
				{
					"slug": "sage-light",
					"name": "Pale blue",
					"color": "#B9C7DD"
				},
				{
					"slug": "amber",
					"name": "Olive grey",
					"color": "#6C6C54"
				},
				{
					"slug": "amber-light",
					"name": "Pale olive",
					"color": "#CFCDBF"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (EB Garamond)",
					"fontFamily": "\"EB Garamond\", Garamond, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-VF.woff2"
							]
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-Italic-VF.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Text (Schibsted Grotesk)",
					"fontFamily": "\"Schibsted Grotesk\", \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/SchibstedGrotesk-VF.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "clamp(1rem, 0.97rem + 0.15vw, 1.0625rem)"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "clamp(1.1875rem, 1.08rem + 0.45vw, 1.4375rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.6rem, 1.3rem + 1.1vw, 2.25rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section title",
					"size": "clamp(2rem, 1.5rem + 1.9vw, 3.125rem)"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(3rem, 1.2rem + 4.4vw, 4.5rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(3.5rem, 2.2rem + 3.6vw, 5.5rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|concrete",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 3.5rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 3.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|sage"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "-0.012em"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400",
					"lineHeight": "1.18"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|concrete"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|slate",
						"text": "var:preset|color|concrete"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "1.5rem",
					"fontWeight": "400",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.06em"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.06em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontStyle": "italic",
					"fontSize": "var:preset|font-size|large"
				}
			},
			"core/separator": {
				"color": {
					"text": "color-mix(in srgb, var(--wp--preset--color--ink) 18%, transparent)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (sections only)",
			"postTypes": [
				"page"
			]
		}
	]
}
