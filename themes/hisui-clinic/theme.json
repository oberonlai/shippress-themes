{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1320px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (page ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "base-2",
     "name": "Pale ground (visit band)",
     "color": "#F8FAF8"
    },
    {
     "slug": "tint",
     "name": "Celadon tint (rows, footer)",
     "color": "#E8EFED"
    },
    {
     "slug": "deep",
     "name": "Deep celadon (links, rules, buttons)",
     "color": "#165C48"
    },
    {
     "slug": "band",
     "name": "Band green (department band)",
     "color": "#3A8770"
    },
    {
     "slug": "celadon",
     "name": "Celadon (quiet secondary)",
     "color": "#6E8B84"
    },
    {
     "slug": "ink",
     "name": "Headings",
     "color": "#1F2A27"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#333333"
    },
    {
     "slug": "muted",
     "name": "Muted (numerals, dates)",
     "color": "#848484"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#E0E0E0"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A23B2C"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "\"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "zh-subset",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
     ]
    },
    {
     "slug": "ja-subset",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small (dates, pills)",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "H3",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Band title / page title",
     "size": "2.25rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section heading (H2)",
     "size": "3.125rem",
     "fluid": {
      "min": "2rem",
      "max": "3.125rem"
     }
    },
    {
     "slug": "numeral",
     "name": "Numerals",
     "size": "3.375rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.375rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Home headline (H1)",
     "size": "4.5rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh",
    "svh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "Section",
     "size": "7.5rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.3"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "fontWeight": "600"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "700"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "fontWeight": "600",
     "lineHeight": "1.5"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "600"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--band)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--deep)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "600",
     "textDecoration": "none"
    },
    "spacing": {
     "padding": {
      "top": "0.7rem",
      "bottom": "0.7rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "999px"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/separator": {
    "color": {
     "background": "var(--wp--preset--color--line)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}