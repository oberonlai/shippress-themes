{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "660px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper (ground)",
          "color": "#F7F5F0"
        },
        {
          "slug": "kozo",
          "name": "Kozo (surface)",
          "color": "#ECE7DD"
        },
        {
          "slug": "sumi",
          "name": "Sumi (text)",
          "color": "#1F2026"
        },
        {
          "slug": "ai",
          "name": "Ai indigo (primary)",
          "color": "#2E3A63"
        },
        {
          "slug": "ai-pale",
          "name": "Pale indigo (tint)",
          "color": "#DDE1EA"
        },
        {
          "slug": "kaki",
          "name": "Persimmon (a dot, never text)",
          "color": "#E8A07A"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "sumi-paper",
          "name": "Sumi and paper",
          "colors": [
            "#1F2026",
            "#F7F5F0"
          ]
        },
        {
          "slug": "ai-paper",
          "name": "Indigo and paper",
          "colors": [
            "#1D2647",
            "#F7F5F0"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Cormorant)",
          "fontFamily": "Cormorant, \"Hiragino Mincho ProN\", \"Yu Mincho\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Cormorant",
              "fontStyle": "italic",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Zen Kaku Gothic New)",
          "fontFamily": "\"Zen Kaku Gothic New\", \"Hiragino Sans\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Kaku Gothic New",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-kaku-gothic-new-400-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Zen Kaku Gothic New",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-kaku-gothic-new-500-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": {
            "min": "0.96875rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.125rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.375rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.5rem",
          "fluid": {
            "min": "2.375rem",
            "max": "4rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6rem",
          "fluid": {
            "min": "3rem",
            "max": "7rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 10rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 15%, transparent)",
      "mute": "color-mix(in srgb, var(--wp--preset--color--sumi) 74%, var(--wp--preset--color--paper))",
      "footer": {
        "background": "#1D2647",
        "text": "#F2EFE8",
        "mute": "#B4BAD0"
      },
      "band": {
        "background": "#2E3A63",
        "text": "#F7F5F0"
      },
      "ease": "cubic-bezier(.19, 1, .22, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.8"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|ai"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|sumi"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.12",
          "letterSpacing": "-0.005em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "300",
          "lineHeight": "1",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "300",
          "lineHeight": "1.06",
          "letterSpacing": "-0.015em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.35"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "500",
          "lineHeight": "1.4"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ai",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|ai"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.75rem",
            "bottom": "0.95rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "0.75rem",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.04em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.625rem",
          "fontWeight": "500",
          "letterSpacing": "0.01em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.06em",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.75rem",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ai"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:custom|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:custom|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.45",
          "fontStyle": "italic"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.25"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.28em;text-decoration-thickness:1px;transition:color .4s ease}::selection{background:var(--wp--preset--color--ai-pale);color:var(--wp--preset--color--sumi)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the atelier",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-workshops",
      "title": "Workshops",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (The Deckle Edge)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and visit",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
