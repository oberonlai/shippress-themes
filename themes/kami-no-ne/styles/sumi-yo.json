        },
        {
          "slug": "kozo",
          "name": "Lamp shadow (surface)",
          "color": "#1F222C"
        },
        {
          "slug": "sumi",
          "name": "Paper (text)",
          "color": "#ECE8DF"
        },
        {
          "slug": "ai",
          "name": "Moonlit indigo (primary)",
          "color": "#AEBAE0"
        },
        {
          "slug": "ai-pale",
