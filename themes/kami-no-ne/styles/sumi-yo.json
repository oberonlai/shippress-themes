{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Sumi-yo",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "paper",
          "name": "Ink night (ground)",
