      ],
      "duotone": [
        {
          "slug": "sumi-paper",
          "name": "Night and paper",
          "colors": [
            "#16181F",
            "#ECE8DF"
          ]
        },
        {
          "slug": "ai-paper",
          "name": "Night and indigo",
          "colors": [
            "#16181F",
            "#AEBAE0"
          ]
        }
      ]
    },
    "custom": {
      "footer": {
        "background": "#0F1116",
        "text": "#ECE8DF",
