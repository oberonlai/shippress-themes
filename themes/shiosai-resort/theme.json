{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "640px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper (ground)",
     "color": "#F4F8F9"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (CTA cells, bands)",
     "color": "#23414D"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#1F2F36"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5B6E76"
    },
    {
     "slug": "sea",
     "name": "Sea (lines, markers)",
     "color": "#84B9CB"
    },
    {
     "slug": "sea-pale",
     "name": "Sea pale (header cell, footer text)",
     "color": "#DCE6E9"
    },
    {
     "slug": "line",
     "name": "Line (hairlines)",
     "color": "#D5E2E7"
    },
    {
     "slug": "dot",
     "name": "Dot (pager, inactive)",
     "color": "#9FB4BC"
    },
    {
     "slug": "apricot",
     "name": "Apricot (the disc)",
     "color": "#F2C9B4"
    },
    {
     "slug": "flag-green",
     "name": "Flag green",
     "color": "#6E9F7C"
    },
    {
     "slug": "flag-yellow",
     "name": "Flag yellow",
     "color": "#D9B65A"
    },
    {
     "slug": "flag-red",
     "name": "Flag red",
     "color": "#C26A5A"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A23B3B"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F6B53"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "Figtree, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "zh-TW subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "ja subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "2rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Chapter title (4.25rem)",
     "size": "clamp(2.5rem, 1.2rem + 3.6vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Hero (4.875rem)",
     "size": "clamp(2.75rem, 1.1rem + 4.4vw, 4.875rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.7",
   "fontWeight": "400",
   "letterSpacing": "0.01em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.12",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--text)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.12"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "2rem",
     "fontWeight": "400",
     "lineHeight": "1.25",
     "letterSpacing": "-0.005em"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.5rem",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "0"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.8125rem",
     "fontWeight": "600",
     "letterSpacing": "0.1em",
     "textTransform": "uppercase",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}
