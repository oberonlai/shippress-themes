{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "700px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Pale celadon paper (chips, light text grounds)",
     "color": "#F3F7F6"
    },
    {
     "slug": "mist",
     "name": "Celadon mist (page ground)",
     "color": "#DDEBE8"
    },
    {
     "slug": "seiheki",
     "name": "Seiheki blue-green (main colour: hero, side rail, bands, page heads)",
     "color": "#478384"
    },
    {
     "slug": "ink",
     "name": "Lacquer ink (text and the footer)",
     "color": "#0F2222"
    },
    {
     "slug": "deep",
     "name": "Deep seiheki (links, buttons, labels)",
     "color": "#24585A"
    },
    {
     "slug": "quiet",
     "name": "Slate (secondary text)",
     "color": "#475B5B"
    },
    {
     "slug": "pale",
     "name": "Pale seiheki (panels, labels on ink)",
     "color": "#BFE0DB"
    },
    {
     "slug": "shu",
     "name": "Shu vermilion lacquer (small marks)",
     "color": "#A6382A"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Zen Maru Gothic)",
     "fontFamily": "\"Zen Maru Gothic\", \"Hiragino Maru Gothic ProN\", \"Helvetica Neue\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Zen Maru Gothic",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/zen-maru-gothic-700-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese kanji and kana subset (Zen Maru Gothic JA)",
     "fontFamily": "\"Zen Maru Gothic JA\", \"Hiragino Maru Gothic ProN\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Zen Maru Gothic JA",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/zen-maru-gothic-700-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--mist)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4vw, 3rem)",
    "right": "clamp(1.25rem, 4vw, 3rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.2",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--deep)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.04em",
     "fontWeight": "700"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header (white app bar: logo and name, account, cart and the Shop button; on wide screens the menu runs down a fixed seiheki side rail)",
   "area": "header"
  },
  {
   "name": "checkout-header",
   "title": "Checkout header (shop name and a secure-checkout note)",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer (seiheki strip with the workshop line, then the ink field with the synced workshop details and the menu)",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page (sections, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}
