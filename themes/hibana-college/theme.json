{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1180px", "wideSize": "1180px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (navy-black)", "color": "#080D1B" },
				{ "slug": "contrast", "name": "Text (white)", "color": "#FFFFFF" },
				{ "slug": "muted", "name": "Secondary text", "color": "#BFC0C6" },
				{ "slug": "rule", "name": "Rule (mid-ink)", "color": "#5C5A5E" },
				{ "slug": "warm", "name": "Warm highlight", "color": "#C9A27A" },
				{ "slug": "accent", "name": "Weld glow", "color": "#D9824B" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Literata)",
					"fontFamily": "\"Literata\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "text",
					"name": "Text (Work Sans)",
					"fontFamily": "\"Work Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Work Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/work-sans-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "X-small", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.875rem" },
				{ "slug": "x-large", "name": "X-large", "size": "clamp(2.25rem, 4vw, 3.125rem)" },
				{ "slug": "xx-large", "name": "XX-large", "size": "clamp(2.75rem, 11vw, 4.375rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "20px" },
				{ "slug": "30", "name": "M", "size": "48px" },
				{ "slug": "40", "name": "L", "size": "96px" },
				{ "slug": "50", "name": "XL", "size": "140px" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--text)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.8", "fontWeight": "300" },
		"spacing": { "blockGap": "20px" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--contrast)" } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.1" }, "color": { "text": "var(--wp--preset--color--contrast)" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.0" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
