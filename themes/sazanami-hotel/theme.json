{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1296px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "mist", "name": "Mist (ground)", "color": "#EEF0F1" },
				{ "slug": "mist-2", "name": "Mist 2 (rooms ground)", "color": "#E3E7E9" },
				{ "slug": "fog", "name": "Fog (mid ground, hairlines)", "color": "#C9CFD2" },
				{ "slug": "slate", "name": "Slate (primary)", "color": "#4A5560" },
				{ "slug": "lake-night", "name": "Lake night (dark ground)", "color": "#242B31" },
				{ "slug": "ink", "name": "Ink (text, footer)", "color": "#1B2126" },
				{ "slug": "sub", "name": "Sub (captions, notes)", "color": "#6B757D" },
				{ "slug": "glint", "name": "Glint (accent on dark)", "color": "#A9BCC6" },
				{ "slug": "white", "name": "White (form surface)", "color": "#FFFFFF" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-serif-4-variable-latin.woff2" ] },
						{ "fontFamily": "Source Serif 4", "fontStyle": "italic", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Noto Serif TC (zh-TW)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Noto Serif JP (ja)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "kicker", "name": "Kicker, chip", "size": "0.6875rem" },
				{ "slug": "note", "name": "Note, caption", "size": "0.75rem" },
				{ "slug": "nav", "name": "Navigation", "size": "0.875rem" },
				{ "slug": "body", "name": "Body, verse", "size": "1rem" },
				{ "slug": "chapter", "name": "Chapter word", "size": "1.125rem" },
				{ "slug": "h3", "name": "Heading 3", "size": "1.5rem" },
				{ "slug": "h2", "name": "Heading 2", "size": "2.25rem" },
				{ "slug": "display", "name": "Display (page title)", "size": "4.25rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "2.5rem" },
				{ "slug": "50", "name": "XL", "size": "4.5rem" },
				{ "slug": "60", "name": "Chapter", "size": "8.75rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.8"
		},
		"spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.2" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--slate)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--slate)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "400", "fontSize": "0.8125rem" },
				":hover": { "color": { "background": "var(--wp--preset--color--lake-night)", "text": "var(--wp--preset--color--white)" } }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.06" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)", "lineHeight": "1.2" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "400", "lineHeight": "1.4", "letterSpacing": "0.12em" } }
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--nav)", "fontWeight": "400", "lineHeight": "1", "textTransform": "lowercase" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
