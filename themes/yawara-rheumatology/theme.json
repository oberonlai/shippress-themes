{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "White (ground)",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink (navy)",
					"color": "#001446"
				},
				{
					"slug": "body",
					"name": "Body text",
					"color": "#1A1F2B"
				},
				{
					"slug": "label",
					"name": "Label grey-blue",
					"color": "#6B7694"
				},
				{
					"slug": "haze",
					"name": "Haze band",
					"color": "#E6F0F7"
				},
				{
					"slug": "tide",
					"name": "Tide (accent line)",
					"color": "#53727D"
				},
				{
					"slug": "clay",
					"name": "Clay (single CTA)",
					"color": "#B85F00"
				},
				{
					"slug": "chip",
					"name": "Notice chip",
					"color": "#FDE8E8"
				},
				{
					"slug": "chip-ink",
					"name": "Notice chip text",
					"color": "#C00000"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#DDE3EA"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Figtree)",
					"fontFamily": "\"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-variable-latin.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-italic-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Public Sans)",
					"fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "caption",
					"name": "Caption tab",
					"size": "0.625rem",
					"fluid": false
				},
				{
					"slug": "tab-sub",
					"name": "Tab sub-label",
					"size": "0.725rem",
					"fluid": false
				},
				{
					"slug": "notice",
					"name": "Notice",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "nav",
					"name": "Nav / links",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "lead",
					"name": "Lead",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "slogan",
					"name": "Slogan",
					"size": "1.72rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.72rem"
					}
				},
				{
					"slug": "heading",
					"name": "Heading 2",
					"size": "2.25rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "figure",
					"name": "Figure numeral",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"svh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "2XL",
					"size": "4.5rem"
				},
				{
					"slug": "70",
					"name": "3XL",
					"size": "8rem"
				}
			]
		},
		"border": {
			"radius": false
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"gut": "clamp(1.25rem, 5.55vw, 5rem)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.8"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--tide)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--slogan)",
					"letterSpacing": "0.3em",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading)",
					"letterSpacing": "0.12em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"letterSpacing": "0.1em",
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--clay)",
					"text": "#FFFFFF"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "0.875rem",
					"fontWeight": "500",
					"letterSpacing": "0.08em"
				},
				"border": {
					"radius": "0"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)",
						"text": "#FFFFFF"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			}
		},
		"css": ""
	},
	"customTemplates": [],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
