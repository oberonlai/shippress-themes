{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1440px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (light ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Black (dark ground, ink)",
     "color": "#000000"
    },
    {
     "slug": "grey",
     "name": "Grey (body copy on white)",
     "color": "#767676"
    },
    {
     "slug": "main",
     "name": "Burnt brown (hover, focus)",
     "color": "#6A5348"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", Helvetica, Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/SchibstedGrotesk-VF.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Outfit)",
     "fontFamily": "Outfit, \"Noto Sans TC\", \"Noto Sans JP\", Helvetica, Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Card title",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Statement",
     "size": "clamp(1.625rem, 1rem + 1.7vw, 2.5rem)",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Section title",
     "size": "clamp(2.75rem, 6.5vw, 5.875rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Hero line 1",
     "size": "clamp(2.9rem, 8.2vw, 7.375rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Hero line 2",
     "size": "clamp(3.2rem, 9.03vw, 8.125rem)",
     "fluid": false
    },
    {
     "slug": "colossal",
     "name": "Marquee",
     "size": "clamp(5rem, 16.3vw, 14.6875rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.0",
     "letterSpacing": "-0.03em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "700",
     "letterSpacing": "0",
     "lineHeight": "1.3"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "transparent",
     "text": "var(--wp--preset--color--ink)"
    },
    "border": {
     "radius": "999px",
     "width": "1px",
     "style": "solid",
     "color": "currentColor"
    },
    "typography": {
     "fontSize": "1rem",
     "fontWeight": "500"
    },
    "spacing": {
     "padding": {
      "top": "10px",
      "bottom": "10px",
      "left": "43px",
      "right": "43px"
     }
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}
