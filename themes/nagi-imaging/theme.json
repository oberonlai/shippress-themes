{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "customTemplates": [{"name": "page-wide", "title": "Wide page", "postTypes": ["page"]}],
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "760px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "mist", "name": "Slate mist (band)", "color": "#C5D1D5" },
    { "slug": "light", "name": "Light grey", "color": "#F2F2F2" },
    { "slug": "ink", "name": "Ink (text)", "color": "#49565E" },
    { "slug": "main", "name": "Slate (hover, buttons)", "color": "#516064" },
    { "slug": "muted", "name": "Muted text", "color": "#5E6B72" },
    { "slug": "rule", "name": "Rule", "color": "#D8DFE2" },
    { "slug": "accent", "name": "Blue (focus ring, tiny dot)", "color": "#0A86BE" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Atkinson Hyperlegible)",
     "fontFamily": "\"Atkinson Hyperlegible\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Atkinson Hyperlegible",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/atkinson-400-latin.woff2" ]
      },
      {
       "fontFamily": "Atkinson Hyperlegible",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/atkinson-700-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Caption", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Label", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "2.25rem", "fluid": false },
    { "slug": "x-large", "name": "Statement", "size": "2.75rem", "fluid": false },
    { "slug": "strip", "name": "Headline strip", "size": "2.625rem", "fluid": false },
    { "slug": "xx-large", "name": "Huge word (maximum 6.75rem)", "size": "clamp(3rem, 7.5vw, 6.75rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vh", "vw", "%" ]
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.85",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "36px", "right": "36px" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.2",
     "letterSpacing": "0"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "200" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "200", "lineHeight": "1.21" } },
   "h3": { "typography": { "fontSize": "1.5rem" } },
   "h4": { "typography": { "fontSize": "1.25rem", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--main)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "#FFFFFF" },
    "border": { "radius": "23px" },
    "typography": { "fontSize": "0.9375rem", "letterSpacing": "0.04em", "fontWeight": "700" },
    "spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.6rem", "right": "1.6rem" } }
   }
  }
 }
}
