{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "mist",
     "name": "Mist (light band)",
     "color": "#EEF1F4"
    },
    {
     "slug": "graphite",
     "name": "Graphite (dark)",
     "color": "#14171F"
    },
    {
     "slug": "steel",
     "name": "Steel (band)",
     "color": "#3A4A5E"
    },
    {
     "slug": "light-steel",
     "name": "Light steel (rules)",
     "color": "#A3B0BC"
    },
    {
     "slug": "crimson",
     "name": "Signal crimson (marks only)",
     "color": "#C42B3A"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#1F232B"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5B6573"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Libre Franklin)",
     "fontFamily": "\"Libre Franklin\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Libre Franklin",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/libre-franklin-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "serif",
     "name": "Serif (Gelasio)",
     "fontFamily": "\"Gelasio\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Gelasio",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/gelasio-latin.woff2"
       ]
      },
      {
       "fontFamily": "Gelasio",
       "fontStyle": "italic",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/gelasio-italic-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.75rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2.1rem, 1rem + 2.6vw, 2.75rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Band heading",
     "size": "clamp(2.75rem, 5vw, 4.5rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Cover heading (maximum 8.5rem)",
     "size": "clamp(4.25rem, 9vw, 8.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--display)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 4vw, 3rem)",
    "right": "clamp(1.25rem, 4vw, 3rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.05",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--graphite)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.0625rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--graphite)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--graphite)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.8125rem",
     "letterSpacing": "0.14em",
     "fontWeight": "600",
     "textTransform": "uppercase"
    }
   }
  }
 }
}