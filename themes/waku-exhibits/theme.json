{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": false,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "tint",
     "name": "Tint (alternate band)",
     "color": "#F3F1F5"
    },
    {
     "slug": "ink",
     "name": "Ink (text, footer)",
     "color": "#2E2B33"
    },
    {
     "slug": "main",
     "name": "Lilac-grey (labels, rules, dots)",
     "color": "#6E6478"
    },
    {
     "slug": "accent",
     "name": "Tape orange (the one CTA dot)",
     "color": "#D9663B"
    },
    {
     "slug": "tag",
     "name": "Tag grey",
     "color": "#8F8896"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Onest)",
     "fontFamily": "\"Onest\", \"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    }
   ,
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.625rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "3rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "clamp(2.8rem, 5.2vw, 4.5rem)"
    },
    {
     "slug": "xx-large",
     "name": "XX-large (statement)",
     "size": "clamp(3rem, 6.4vw, 5.5rem)"
    },
    {
     "slug": "word",
     "name": "Section word",
     "size": "clamp(6rem, 16vw, 16rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "4rem"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "6.5rem"
    }
   ]
  },
  "border": {
   "radius": false
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.78"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.2"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.875rem",
     "fontWeight": "700"
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {}
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": []
}