{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Full-width page (sections only)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1136px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#0E1716"
    },
    {
     "slug": "point",
     "name": "Rust teal (point colour)",
     "color": "#5F8884"
    },
    {
     "slug": "red",
     "name": "Signal red (enrol buttons)",
     "color": "#E8121F"
    },
    {
     "slug": "mint",
     "name": "Mint (tabs, chips)",
     "color": "#49EBD2"
    },
    {
     "slug": "pale",
     "name": "Pale teal",
     "color": "#A9C7C3"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#E5E5E5"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5A6866"
    },
    {
     "slug": "pink",
     "name": "Pink tint",
     "color": "#FCEEF0"
    }
   ],
   "gradients": [
    {
     "slug": "wash",
     "name": "Pastel wash",
     "gradient": "linear-gradient(115deg, #FCEEF0 0%, #EEF8F5 48%, #FBF9E3 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Onest)",
     "fontFamily": "\"Onest\", \"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem",
     "fluid": {
      "min": "1.0625rem",
      "max": "1.25rem"
     }
    },
    {
     "slug": "large",
     "name": "Row headline",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section subtitle",
     "size": "2.125rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2.125rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Section word",
     "size": "3.5rem",
     "fluid": {
      "min": "2.5rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "display",
     "name": "Hashtag",
     "size": "5rem",
     "fluid": {
      "min": "2.25rem",
      "max": "5rem"
     }
    },
    {
     "slug": "huge",
     "name": "Hero and numbers",
     "size": "5.5rem",
     "fluid": {
      "min": "2.5rem",
      "max": "5.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "5.5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(5.5rem, 9.7vw, 8.75rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "custom": {
   "hk": {
    "rXl": "88px",
    "rL": "33px",
    "rM": "22px",
    "glow": "0 0 55px rgba(223,212,159,.3)",
    "easeBounce": "cubic-bezier(.34,1.56,.64,1)",
    "easeFrame": "cubic-bezier(.83,0,.17,1)"
   }
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0px",
    "right": "0px"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.3"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--point)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "999px"
    },
    "color": {
     "background": "var(--wp--preset--color--paper)",
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontWeight": "700",
     "fontFamily": "var(--wp--preset--font-family--body)"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "999px"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}