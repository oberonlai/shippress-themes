{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1264px", "wideSize": "1264px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Stone (ground)", "color": "#F5F6F3" },
				{ "slug": "surface", "name": "White (surface)", "color": "#FFFFFF" },
				{ "slug": "text", "name": "Text", "color": "#30332D" },
				{ "slug": "ink", "name": "Ink (rules and dark band)", "color": "#1D211B" },
				{ "slug": "accent", "name": "Yanagi-nezumi (small accents)", "color": "#747864" },
				{ "slug": "sage", "name": "Pale sage", "color": "#B9BDB0" },
				{ "slug": "spot", "name": "Task-lamp tan (spot)", "color": "#C39C6D" },
				{ "slug": "muted", "name": "Muted text", "color": "#5C6056" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Schibsted Grotesk)",
					"fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"] }
					]
				},
				{
					"slug": "cjk-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"] },
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"] }
					]
				},
				{
					"slug": "cjk-ja",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-jp-ja-400.woff2"] },
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-jp-ja-700.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Inter)",
					"fontFamily": "\"Inter\", \"Noto Sans TC\", \"Noto Sans JP\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-variable-latin.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Sub-label", "size": "0.6875rem" },
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Section title", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "Service name", "size": "clamp(2.8125rem, 4.17vw, 3.75rem)" },
				{ "slug": "huge", "name": "Hero heading", "size": "clamp(3rem, 7.2vw, 6.5rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2.375rem" },
				{ "slug": "50", "name": "L", "size": "4.5rem" },
				{ "slug": "60", "name": "XL", "size": "clamp(4.5rem, 8.33vw, 7.5rem)" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "500",
			"lineHeight": "2",
			"letterSpacing": "0.5px"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "0.5px" },
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "fontWeight": "800", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--text)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--surface)" },
				"border": { "radius": "20px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.875rem", "fontWeight": "700", "lineHeight": "1", "letterSpacing": "0.5px" },
				"spacing": { "padding": { "top": "10px", "bottom": "10px", "left": "26px", "right": "26px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--surface)" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "700", "lineHeight": "1.4" } }
		}
	},
	"customTemplates": [
		{ "name": "page-hc", "title": "Page with photo head", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
