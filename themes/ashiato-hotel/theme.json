{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1376px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "wash", "name": "Wash (pale sage)", "color": "#F4F7F2" },
				{ "slug": "pale-sage", "name": "Pale sage", "color": "#E4ECE2" },
				{ "slug": "sage", "name": "Sage", "color": "#769E6F" },
				{ "slug": "deep-sage", "name": "Deep sage", "color": "#4F6E49" },
				{ "slug": "sage-row", "name": "Sage ground (footer)", "color": "#97A791" },
				{ "slug": "paw-on-sage", "name": "Paw on sage", "color": "#B9C6B4" },
				{ "slug": "ink", "name": "Ink", "color": "#232A22" },
				{ "slug": "body", "name": "Body text", "color": "#4A5248" },
				{ "slug": "muted", "name": "Small text", "color": "#6B7268" },
				{ "slug": "grey", "name": "Grey", "color": "#959595" },
				{ "slug": "rule", "name": "Rule", "color": "#C8C8C8" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "lexend",
					"name": "Headings (Lexend)",
					"fontFamily": "\"Lexend\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lexend",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/lexend-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "public-sans",
					"name": "Body (Public Sans)",
					"fontFamily": "\"Public Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2" ] }
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] },
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-700.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Label", "size": "0.8125rem" },
				{ "slug": "small", "name": "Small", "size": "0.9375rem" },
				{ "slug": "body", "name": "Body", "size": "1.0625rem" },
				{ "slug": "card", "name": "Card title", "size": "1.375rem" },
				{ "slug": "lede", "name": "Lede", "size": "1.75rem" },
				{ "slug": "h2", "name": "Heading", "size": "2.5rem" },
				{ "slug": "h2-large", "name": "Heading large", "size": "3.125rem" },
				{ "slug": "inner-h1", "name": "Page title", "size": "4.25rem" },
				{ "slug": "hero", "name": "Hero title", "size": "5.5rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "2.5rem" },
				{ "slug": "50", "name": "XL", "size": "4.5rem" },
				{ "slug": "60", "name": "XXL", "size": "7.5rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--public-sans)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.9"
		},
		"spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "0" },
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--lexend)", "fontWeight": "300", "lineHeight": "1.25" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--deep-sage)" },
				":hover": { "color": { "text": "var(--wp--preset--color--sage)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--deep-sage)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--public-sans)", "fontWeight": "600", "fontSize": "1rem" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--card)", "fontWeight": "400", "lineHeight": "1.4" } }
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "1.125rem", "fontWeight": "600", "lineHeight": "1" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--deep-sage)" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
