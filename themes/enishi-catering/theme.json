{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F5F3EE"
    },
    {
     "slug": "surface",
     "name": "Surface (course band, prices)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1F1B1B"
    },
    {
     "slug": "body",
     "name": "Body text",
     "color": "#333333"
    },
    {
     "slug": "accent",
     "name": "Accent (small areas only)",
     "color": "#7A5E5E"
    },
    {
     "slug": "chip",
     "name": "Chip",
     "color": "#ECE9E3"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#DDDDDD"
    },
    {
     "slug": "step",
     "name": "Step line",
     "color": "#999999"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "7.5rem"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Headings (EB Garamond)",
     "fontFamily": "\"EB Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/eb-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "italic",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/eb-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-zh",
     "name": "Headings, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-ja",
     "name": "Headings, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "Karla, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Karla",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/karla-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.75rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.0625rem"
    },
    {
     "slug": "h3",
     "name": "Course title",
     "size": "2rem"
    },
    {
     "slug": "statement",
     "name": "Statement",
     "size": "2rem"
    },
    {
     "slug": "label",
     "name": "Vertical label",
     "size": "2.75rem"
    },
    {
     "slug": "section",
     "name": "Section title",
     "size": "clamp(2.5rem, 5vw, 5.5rem)"
    },
    {
     "slug": "hero",
     "name": "Hero",
     "size": "clamp(2.75rem, 5vw, 4.5rem)"
    },
    {
     "slug": "display",
     "name": "Page title",
     "size": "clamp(4.25rem, 8vw, 8.75rem)"
    },
    {
     "slug": "huge",
     "name": "Largest",
     "size": "4.5rem"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--body)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "400",
     "lineHeight": "1.2",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}