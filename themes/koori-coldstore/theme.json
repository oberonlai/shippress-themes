{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1100px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F3F5F4"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1E2A29"
    },
    {
     "slug": "patina",
     "name": "Patina (brand)",
     "color": "#5A7572"
    },
    {
     "slug": "patina-deep",
     "name": "Patina, deep",
     "color": "#46605D"
    },
    {
     "slug": "patina-pale",
     "name": "Patina, pale",
     "color": "#BFD3CF"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#56625F"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#D5DDDB"
    },
    {
     "slug": "fill",
     "name": "Fill",
     "color": "#E6ECEA"
    },
    {
     "slug": "secondary",
     "name": "Secondary",
     "color": "#DCE5E3"
    },
    {
     "slug": "amber",
     "name": "Amber",
     "color": "#D98A2B"
    },
    {
     "slug": "footer",
     "name": "Footer",
     "color": "#4A5553"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#B3412F"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F6B4F"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Onest)",
     "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": ".875rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.375rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "2.25rem"
    },
    {
     "slug": "xx-large",
     "name": "Heading 1",
     "size": "clamp(2.5rem, 1.2rem + 3.6vw, 4.5rem)"
    },
    {
     "slug": "giant",
     "name": "Giant word",
     "size": "clamp(4.25rem, 1.75rem + 6.4vw, 7.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "12px"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "24px"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "50px"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "80px"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "140px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "24px"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "400",
     "lineHeight": "1.08",
     "letterSpacing": "-0.015em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "fontWeight": "500",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--patina-deep)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--patina)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem"
    },
    "border": {
     "radius": "8px"
    },
    "spacing": {
     "padding": {
      "top": "12px",
      "bottom": "12px",
      "left": "22px",
      "right": "22px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--patina-deep)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/navigation": {
    "typography": {
     "fontSize": "1.0625rem",
     "fontWeight": "500"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}