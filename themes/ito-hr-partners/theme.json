{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1280px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Pale band",
     "color": "#EFF2F4"
    },
    {
     "slug": "slate",
     "name": "Slate (pill, people band)",
     "color": "#647582"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#2A2C33"
    },
    {
     "slug": "muted",
     "name": "Muted ink",
     "color": "#585B63"
    },
    {
     "slug": "accent",
     "name": "Chitose green (small accents)",
     "color": "#3F5E4A"
    },
    {
     "slug": "accent-hover",
     "name": "Accent hover",
     "color": "#557A62"
    },
    {
     "slug": "accent-deep",
     "name": "Accent deep",
     "color": "#2F4A39"
    },
    {
     "slug": "tint",
     "name": "Accent tint",
     "color": "#E3EAE5"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (PT Serif)",
     "fontFamily": "\"PT Serif\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "PT Serif",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/pt-serif-400-latin.woff2"
       ]
      },
      {
       "fontFamily": "PT Serif",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/pt-serif-700-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (PT Sans)",
     "fontFamily": "\"PT Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "PT Sans",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/pt-sans-400-latin.woff2"
       ]
      },
      {
       "fontFamily": "PT Sans",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/pt-sans-700-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.125rem"
    },
    {
     "slug": "tag",
     "name": "Tag",
     "size": "1.375rem",
     "fluid": {
      "min": "1.125rem",
      "max": "1.375rem"
     }
    },
    {
     "slug": "large",
     "name": "H3",
     "size": "1.6875rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.6875rem"
     }
    },
    {
     "slug": "x-large",
     "name": "H2",
     "size": "clamp(2rem, 3.1vw, 2.75rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Intro H2",
     "size": "clamp(2.25rem, 3.8vw, 3.375rem)",
     "fluid": false
    },
    {
     "slug": "display-s",
     "name": "Inner H1",
     "size": "clamp(2.4rem, 4.4vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "display",
     "name": "Hero H1",
     "size": "clamp(2.5rem, 5.6vw, 5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(3.5rem, 7.6vw, 6.875rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "letterSpacing": "0.01em"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.4",
     "letterSpacing": "0.02em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display-s)",
     "lineHeight": "1.2",
     "letterSpacing": "0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "letterSpacing": "0.01em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--accent)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent-hover)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "4px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "700",
     "letterSpacing": "0.06em",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "1.25rem",
      "bottom": "1.25rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "10px"
    }
   },
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700"
    }
   }
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
