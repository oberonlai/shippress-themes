{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1380px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Mist ground",
     "color": "#E6EAEB"
    },
    {
     "slug": "ground-2",
     "name": "Mist ground, deeper",
     "color": "#DDE2E4"
    },
    {
     "slug": "card",
     "name": "Card",
     "color": "#F4F5F6"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1F262C"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#5E666D"
    },
    {
     "slug": "slate",
     "name": "Slate (brand)",
     "color": "#4E5964"
    },
    {
     "slug": "copper",
     "name": "Copper (tags only)",
     "color": "#B8582B"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#9A3A2C"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#3E6B52"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Mark",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "s",
     "name": "S",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "m",
     "name": "M",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "l",
     "name": "L",
     "size": "1.875rem",
     "fluid": false
    },
    {
     "slug": "xl",
     "name": "XL",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "xxl",
     "name": "XXL",
     "size": "clamp(2.5rem, 3.6vw, 3.5rem)",
     "fluid": false
    },
    {
     "slug": "hero",
     "name": "Hero (4.75rem)",
     "size": "clamp(2.75rem, 4.6vw + 0.5rem, 4.75rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xxl)",
     "lineHeight": "1.12"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--l)",
     "lineHeight": "1.6"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--m)",
     "fontWeight": "500",
     "lineHeight": "1.5"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--s)",
     "fontWeight": "500"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--slate)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.8125rem",
     "letterSpacing": "0.04em",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0",
      "bottom": "0",
      "left": "16px",
      "right": "12px"
     }
    }
   }
  }
 }
}
