{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground", "color": "#F2F3F0" },
    { "slug": "band", "name": "Warm band", "color": "#ECEAE3" },
    { "slug": "ink", "name": "Ink", "color": "#1F2420" },
    { "slug": "pine", "name": "Pine (small accents)", "color": "#3F7A5C" },
    { "slug": "muted", "name": "Muted text", "color": "#5D625C" },
    { "slug": "rule", "name": "Soft rule", "color": "#D5D8D1" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] },
      { "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Outfit)",
     "fontFamily": "\"Outfit\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Outfit", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/outfit-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.8125rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
    { "slug": "base", "name": "Body", "size": "1rem", "fluid": false },
    { "slug": "lead", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
    { "slug": "heading-s", "name": "H3", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
    { "slug": "heading-m", "name": "H2", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
    { "slug": "band", "name": "Band heading", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
    { "slug": "glyph", "name": "Glyph word", "size": "5rem", "fluid": { "min": "3rem", "max": "5rem" } },
    { "slug": "heading-l", "name": "Hero", "size": "4.5rem", "fluid": { "min": "2.6rem", "max": "4.5rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 4rem)" },
    { "slug": "60", "name": "XL", "size": "clamp(4rem, 8vw, 7rem)" },
    { "slug": "70", "name": "Section", "size": "clamp(4rem, 12vw, 13.5rem)" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false, "presets": [] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "letterSpacing": "0.05em",
   "fontWeight": "400"
  },
  "spacing": { "padding": { "left": "clamp(1.25rem, 4vw, 2rem)", "right": "clamp(1.25rem, 4vw, 2rem)" }, "blockGap": "1.5rem" },
  "elements": {
   "link": { "color": { "text": "var(--wp--preset--color--pine)" }, ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } } },
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "0" } },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-l)", "lineHeight": "1.04", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-m)", "fontWeight": "400" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-s)", "lineHeight": "1.3" } },
   "button": { "border": { "radius": "7px" }, "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--white)" }, "typography": { "fontSize": "0.875rem", "fontWeight": "500", "letterSpacing": "0.06em" } }
  },
  "blocks": {
   "core/image": { "border": { "radius": "0" } },
   "core/cover": { "border": { "radius": "0" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
