{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "720px", "wideSize": "1320px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "warm", "name": "Warm white (cards, pills)", "color": "#F7F5F2" },
    { "slug": "ink", "name": "Ink (text, band, footer)", "color": "#222222" },
    { "slug": "accent", "name": "Mustard (small areas only)", "color": "#B8973F" },
    { "slug": "accent-text", "name": "Mustard text", "color": "#7A6326" },
    { "slug": "sub", "name": "Green (eyebrows, tags)", "color": "#509146" },
    { "slug": "tint", "name": "Mustard tint", "color": "#F6F0E1" },
    { "slug": "green-tint", "name": "Green tint", "color": "#E8EEE5" },
    { "slug": "rule", "name": "Rule", "color": "#E1E0E0" },
    { "slug": "muted", "name": "Muted text", "color": "#5F5C55" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Alegreya Sans)",
     "fontFamily": "\"Alegreya Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Alegreya Sans", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/alegreya-sans-400-latin.woff2"] },
      { "fontFamily": "Alegreya Sans", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/alegreya-sans-500-latin.woff2"] },
      { "fontFamily": "Alegreya Sans", "fontStyle": "normal", "fontWeight": "600 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/alegreya-sans-700-latin.woff2"] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Alegreya)",
     "fontFamily": "\"Alegreya\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Alegreya", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/alegreya-variable-latin.woff2"] },
      { "fontFamily": "Alegreya", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/alegreya-italic-variable-latin.woff2"] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (stage 2)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (stage 2)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.875rem" },
    { "slug": "base", "name": "Base", "size": "1rem" },
    { "slug": "medium", "name": "Medium (body)", "size": "1.125rem" },
    { "slug": "large", "name": "Large (statement body)", "size": "1.25rem" },
    { "slug": "x-large", "name": "Card title", "size": "1.9438rem" },
    { "slug": "xx-large", "name": "Section title", "size": "3.0406rem" },
    { "slug": "statement", "name": "Statement", "size": "3.25rem" },
    { "slug": "display", "name": "Display (hero)", "size": "4.5rem" }
   ]
  },
  "spacing": {
   "units": ["px", "rem", "em", "%", "vw"],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "3.75rem" },
    { "slug": "60", "name": "XL", "size": "6.25rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false, "presets": [] },
  "blocks": {
   "core/button": { "border": { "radius": true } }
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.9",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": { "left": "clamp(1.5rem, 4.1667vw, 3.75rem)", "right": "clamp(1.5rem, 4.1667vw, 3.75rem)" }
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--base)" },
    "border": { "radius": "10px" },
    "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.375rem", "right": "1.375rem" } }
   }
  },
  "blocks": {
   "core/image": { "border": { "radius": "10px" } },
   "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "fontSize": "0.9375rem" } },
   "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700" } }
  }
 },
 "customTemplates": [
  { "name": "page-inner", "title": "Inner page (own head)", "postTypes": ["page"] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
