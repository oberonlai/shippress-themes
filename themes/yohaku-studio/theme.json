{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper white (ground)",
          "color": "#FAFAF8"
        },
        {
          "slug": "mist",
          "name": "Light grey (bands, rules)",
          "color": "#E6E5E1"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#161616"
        },
        {
          "slug": "graphite",
          "name": "Graphite (secondary text)",
          "color": "#5C5B57"
        },
        {
          "slug": "ochre",
          "name": "Muted ochre (marks only, never text)",
          "color": "#B08A2E"
        },
        {
          "slug": "deep-ochre",
          "name": "Deep ochre (small accent text, links)",
          "color": "#7A5F1E"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Hedvig Letters Serif)",
          "fontFamily": "\"Hedvig Letters Serif\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Hedvig Letters Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hedvig-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Geist)",
          "fontFamily": "Geist, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Geist",
              "fontStyle": "normal",
              "fontWeight": "300 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/geist-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (Geist Mono, figure numbers)",
          "fontFamily": "\"Geist Mono\", ui-monospace, Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "Geist Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/geistmono-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.75rem, 1.45rem + 1.2vw, 2.5rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.01em",
          "fontWeight": "500",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (magazine masthead: dateline, wordmark, ruled menu row)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (start-a-project band over the studio details)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
