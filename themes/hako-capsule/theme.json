{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "620px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Base",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1E1E1E"
    },
    {
     "slug": "pale",
     "name": "Pale band",
     "color": "#F7F7F7"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#E6E6E6"
    },
    {
     "slug": "grey",
     "name": "Label grey",
     "color": "#9D9D9D"
    },
    {
     "slug": "grey-dark",
     "name": "Grey, text",
     "color": "#6E6E6E"
    },
    {
     "slug": "silver",
     "name": "Silver mouse",
     "color": "#AFAFB0"
    },
    {
     "slug": "silver-wash",
     "name": "Silver wash",
     "color": "#EFEFEF"
    },
    {
     "slug": "amber",
     "name": "Amber point",
     "color": "#E8A33D"
    },
    {
     "slug": "ink-soft",
     "name": "Ink, soft",
     "color": "#2A2A2A"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#A63A2E"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F5D46"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Geist)",
     "fontFamily": "Geist, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Geist",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/geist-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC (zh-TW subset)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP (ja subset)",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "label",
     "name": "Label",
     "size": ".75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "cell",
     "name": "Table cell",
     "size": ".9375rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.03125rem"
    },
    {
     "slug": "large",
     "name": "Heading 3",
     "size": "1.4375rem"
    },
    {
     "slug": "x-large",
     "name": "Section title",
     "size": "clamp(1.75rem, 1rem + 2vw, 2.625rem)"
    },
    {
     "slug": "numeral",
     "name": "Numeral",
     "size": "clamp(2.5rem, 2rem + 1vw, 3rem)"
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "clamp(2.5rem, 1.2rem + 3.6vw, 4.25rem)"
    },
    {
     "slug": "huge",
     "name": "Home title",
     "size": "clamp(2.75rem, 1.1rem + 4.4vw, 4.5rem)"
    },
    {
     "slug": "wordmark",
     "name": "Wordmark",
     "size": "clamp(1.5rem, 1rem + 1.6vw, 3.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "12px"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "24px"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "40px"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "80px"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "120px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "fontWeight": "300",
   "lineHeight": "1.87",
   "letterSpacing": ".01em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.1"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "300",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "300",
     "lineHeight": "1",
     "letterSpacing": ".14em",
     "textTransform": "uppercase"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "fontWeight": "400",
     "lineHeight": "1.3"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--grey-dark)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--base)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "500",
     "fontSize": "var(--wp--preset--font-size--small)",
     "letterSpacing": ".12em",
     "textTransform": "uppercase"
    },
    "border": {
     "radius": "999px"
    },
    "spacing": {
     "padding": {
      "top": "13px",
      "bottom": "13px",
      "left": "28px",
      "right": "28px"
     }
    },
    ":hover": {
     "color": {
      "background": "#3A3A3A",
      "text": "var(--wp--preset--color--base)"
     }
    }
   }
  },
  "blocks": {
   "core/navigation": {
    "typography": {
     "fontSize": "1rem",
     "fontWeight": "300",
     "letterSpacing": ".1em",
     "textTransform": "uppercase"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
