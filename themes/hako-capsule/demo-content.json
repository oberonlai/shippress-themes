   "role": "front",
   "content": "<!-- wp:pattern {\"slug\":\"hako-capsule/front-stage\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-story\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-wall\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-compare\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-band\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-minute\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-rules\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-notes\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-letter\"} /-->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/front-book\"} /-->"
  },
  {
   "slug": "about",
   "title": "About",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">ABOUT</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Hako Capsule was founded in 2019 by Mara Okafor at 3 Platform Lane in Easthaven, 80 metres from the East Exit of Easthaven Central Station. It has 84 places, 10 private shower rooms, 84 lockers and a staffed luggage room.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "pods",
   "title": "Pods & Cabins",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">PODS & CABINS</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">48 Standard Pods at €42, 16 Wide Pods at €54, 12 Quiet-Floor Pods at €48 and 8 Single Cabins with a lockable door at €72 a night. Every price is per person and includes a towel set.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "prices",
   "title": "Compare & Prices",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">COMPARE & PRICES</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Standard Pod €42, Wide Pod €54, Quiet-Floor Pod €48, Single Cabin €72 per night. Day-use Pod €24 for four hours between 10:00 and 18:00. Shower only €9 for 45 minutes.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "showers",
   "title": "Day-use Showers",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">DAY-USE SHOWERS</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Ten private shower rooms open from 06:00 to 23:00. A shower is €9 for 45 minutes, towel set included, and a Day-use Pod is €24 for four hours between 10:00 and 18:00.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "house-rules",
   "title": "House Rules",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">HOUSE RULES</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Shoes off at the step. Quiet hours 22:00–07:00. Calls in the lounge only. No food in pod rooms. One guest per pod. Luggage in lockers or the luggage room. Check-out 10:00. Photo ID at check-in.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "access",
   "title": "Access",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">ACCESS</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">From the East Exit of Easthaven Central Station it is 80 metres, about a minute on foot, along Platform Lane to 3 Platform Lane. The front desk is open 24 hours; check-in is 15:00–02:00.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "night-desk",
   "title": "Night Desk",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">NIGHT DESK</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Mara Okafor (manager), Lucas Ferreira (night-desk lead), Jonah Weiss (night clerk), Priya Raman (housekeeping), Sofia Martel (linen and showers), Daniel Osei (maintenance) and Lin Hart (reservations).</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "faq",
   "title": "FAQ",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">FAQ</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Check-in is 15:00–02:00 and check-out is 10:00. Photo ID is needed at check-in. Free cancellation until 18:00 on the day of arrival.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "book",
   "title": "Book",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">BOOK</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">Email the night desk with the night, the pod type and your arrival time, or walk in: the desk is open 24 hours.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hk-pill hk-pill--line\"} -->\n<p class=\"hk-pill hk-pill--line\"><a href=\"mailto:stay@hako-capsule.example?subject=Night%20request\">Email the night desk</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
   "template": "page"
  },
  {
   "slug": "letter",
   "title": "The Last Train Letter",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"hk-sec hk-sec--stub\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull hk-sec hk-sec--stub\"><!-- wp:group {\"className\":\"hk-title sp-reveal sp-reveal--wipe\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-title sp-reveal sp-reveal--wipe\"><!-- wp:heading {\"level\":2,\"className\":\"hk-title__h\"} -->\n<h2 class=\"wp-block-heading hk-title__h\">THE LAST TRAIN LETTER</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"hk-narrow\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hk-narrow\"><!-- wp:paragraph {\"className\":\"hk-body\"} -->\n<p class=\"hk-body\">One short note a month with late-arrival tips and shower-hour changes.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:pattern {\"slug\":\"hako-capsule/letter-form\"} /--></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
