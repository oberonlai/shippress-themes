{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1340px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#221E1F" },
				{ "slug": "paper", "name": "Paper", "color": "#F2F1E9" },
				{ "slug": "muted", "name": "Muted", "color": "#A09E9F" },
				{ "slug": "muted-dark", "name": "Muted on light", "color": "#767476" },
				{ "slug": "slate", "name": "Slate", "color": "#4E5561" }
			]
		},
		"typography": {
			"fluid": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-serif-latin.woff2" ]
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-serif-italic-latin.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Body", "size": "1rem" },
				{ "slug": "card", "name": "Card title", "size": "2rem" },
				{ "slug": "statement", "name": "Statement", "size": "2.375rem" },
				{ "slug": "h1", "name": "Hero", "size": "clamp(2.125rem, 1.6rem + 1.6vw, 3.125rem)" },
				{ "slug": "display", "name": "Display", "size": "clamp(3rem, 2rem + 4.5vw, 5.625rem)" },
				{ "slug": "figure", "name": "Figure", "size": "clamp(5rem, 3rem + 7vw, 9.375rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.25rem, 3.5vw, 3.125rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 6vw, 6.25rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4.5rem, 10vw, 8.75rem)" }
			]
		},
		"border": { "radius": true },
		"shadow": { "defaultPresets": false, "presets": [] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.8",
			"letterSpacing": "0.028em"
		},
		"spacing": {
			"padding": { "left": "clamp(1.25rem, 3.5vw, 3.125rem)", "right": "clamp(1.25rem, 3.5vw, 3.125rem)" },
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--slate)" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.24", "letterSpacing": "0.01em" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--statement)", "lineHeight": "1.4", "letterSpacing": "0" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--card)", "lineHeight": "1.2", "letterSpacing": "0" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "3px" },
				"typography": { "fontSize": "0.875rem", "fontWeight": "600" }
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "3px" } },
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.375rem", "fontWeight": "400", "letterSpacing": "0.12em", "textTransform": "uppercase", "lineHeight": "1" }
			}
		}
	}
}
