{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Lilac paper (ground)",
          "color": "#FBF7FA"
        },
        {
          "slug": "murasaki",
          "name": "Kyo-murasaki (main colour, large fields)",
          "color": "#9D5B8B"
        },
        {
          "slug": "mist",
          "name": "Pale murasaki (soft panels)",
          "color": "#F2E6EF"
        },
        {
          "slug": "ink",
          "name": "Aubergine ink (text and footer)",
          "color": "#22141F"
        },
        {
          "slug": "deep",
          "name": "Deep murasaki (links and labels on light grounds)",
          "color": "#6E3561"
        },
        {
          "slug": "quiet",
          "name": "Plum grey (secondary text)",
          "color": "#5C4B57"
        },
        {
          "slug": "pale",
          "name": "Pale lilac (labels on ink, large type on murasaki)",
          "color": "#F4D9EA"
        },
        {
          "slug": "field-ink",
          "name": "White (type on the murasaki field)",
          "color": "#FFFFFF"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Chokokutai)",
          "fontFamily": "\"Chokokutai\", \"Zen Maru Gothic JA\", \"Hiragino Maru Gothic ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Chokokutai",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/chokokutai-400-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Display, Japanese kana subset (Chokokutai JA)",
          "fontFamily": "\"Chokokutai JA\", \"Zen Maru Gothic JA\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Chokokutai JA",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/chokokutai-400-ja.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-ja-kanji",
          "name": "Display, Japanese kanji subset (Zen Maru Gothic JA)",
          "fontFamily": "\"Zen Maru Gothic JA\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Maru Gothic JA",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-maru-gothic-700-ja.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Display, Traditional Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Noto Sans TC",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Epilogue)",
          "fontFamily": "\"Epilogue\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Epilogue",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/epilogue-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Epilogue",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/epilogue-600-latin.woff2"
              ]
            },
            {
              "fontFamily": "Epilogue",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/epilogue-700-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.8",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--murasaki)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "2px"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.04em",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (top bar: the menu split around the centred studio name, Ask for a quote button)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (ink field: house name, synced house details and the menu)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
