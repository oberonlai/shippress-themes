{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1400px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "White (strip, cards, form surface)",
					"color": "#FFFFFF"
				},
				{
					"slug": "ground",
					"name": "Ground (page)",
					"color": "#F7F6F5"
				},
				{
					"slug": "ground-2",
					"name": "Ground 2 (alternate sections)",
					"color": "#F2F1EB"
				},
				{
					"slug": "panel",
					"name": "Panel (olive-grey)",
					"color": "#DDDDCB"
				},
				{
					"slug": "cell",
					"name": "Cell (inside panels)",
					"color": "#EBEBDE"
				},
				{
					"slug": "bar",
					"name": "Negishi olive (header strip, chips, icons)",
					"color": "#938B4B"
				},
				{
					"slug": "olive-dark",
					"name": "Olive for small text",
					"color": "#7A7339"
				},
				{
					"slug": "wine",
					"name": "Wine (ticket accent, CTA)",
					"color": "#5B2A38"
				},
				{
					"slug": "ink",
					"name": "Ink (text)",
					"color": "#1A1C14"
				},
				{
					"slug": "footer",
					"name": "Footer ink",
					"color": "#23261B"
				},
				{
					"slug": "line",
					"name": "Form border",
					"color": "#B9B8A6"
				}
			],
			"gradients": [
				{
					"slug": "olive-wine",
					"name": "Olive to wine",
					"gradient": "linear-gradient(90deg,#938B4B,#5B2A38)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Work Sans)",
					"fontFamily": "\"Work Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/work-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-ja-400.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS (stamps, meta)",
					"size": "0.8125rem"
				},
				{
					"slug": "s",
					"name": "S (small body)",
					"size": "0.9375rem"
				},
				{
					"slug": "m",
					"name": "M (body)",
					"size": "1.0625rem"
				},
				{
					"slug": "l",
					"name": "L (cell titles)",
					"size": "1.375rem"
				},
				{
					"slug": "xl",
					"name": "XL (caps section words)",
					"size": "2rem"
				},
				{
					"slug": "2xl",
					"name": "2XL (section titles)",
					"size": "3rem"
				},
				{
					"slug": "3xl",
					"name": "3XL (count numerals)",
					"size": "3.5rem"
				},
				{
					"slug": "4xl",
					"name": "4XL (H1)",
					"size": "4.5rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "1.25rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "2.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "4rem"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "6rem"
				}
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "0",
				"right": "0"
			},
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--4xl)",
					"lineHeight": "1.02",
					"letterSpacing": "-0.015em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--l)",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--wine)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--olive-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--wine)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--s)"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "1.2em"
					}
				}
			}
		}
	}
}
