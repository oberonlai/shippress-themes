{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1100px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "white", "name": "White", "color": "#FFFFFF" },
    { "slug": "wash", "name": "Slate-mist wash", "color": "#E4EAED" },
    { "slug": "page", "name": "Pale page", "color": "#F7F7F7" },
    { "slug": "page-cool", "name": "Cool pale page", "color": "#F2F5F6" },
    { "slug": "slate", "name": "Slate (accent)", "color": "#5E6A72" },
    { "slug": "slate-light", "name": "Slate light", "color": "#7E8F98" },
    { "slug": "mist", "name": "Halo mist", "color": "#B9CCD3" },
    { "slug": "ink", "name": "Ink", "color": "#404040" },
    { "slug": "ink-deep", "name": "Deep ink", "color": "#2A3236" },
    { "slug": "line", "name": "Line", "color": "#CCCCCA" },
    { "slug": "point", "name": "Booking orange", "color": "#F2B230" }
   ],
   "gradients": [
    { "slug": "bowl", "name": "Slate bowl", "gradient": "linear-gradient(245deg, #7E8F98 0%, #B9CCD3 100%)" },
    { "slug": "point", "name": "Booking point", "gradient": "linear-gradient(90deg, #FF9D00 0%, #F2B230 100%)" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "2rem", "fluid": false },
    { "slug": "x-large", "name": "X-large", "size": "3rem", "fluid": false },
    { "slug": "xx-large", "name": "XX-large (figures, maximum)", "size": "4.25rem", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vh", "vw", "%" ]
  },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.8",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": { "padding": { "left": "0", "right": "0" }, "blockGap": "1.25rem" },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.5", "letterSpacing": "0.06em" },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "clamp(2.25rem, 3.4vw, 3rem)", "fontWeight": "300", "lineHeight": "1.35", "letterSpacing": "0.04em" } },
   "h2": { "typography": { "fontSize": "clamp(1.75rem, 2.6vw, 2.25rem)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500", "lineHeight": "1.5", "letterSpacing": "0.04em" } },
   "link": { "color": { "text": "var(--wp--preset--color--slate)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "border": { "radius": "10px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "fontWeight": "500", "letterSpacing": "0.06em" }
   }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ],
 "customTemplates": [
  { "name": "page-plain", "title": "Page with wash head", "postTypes": [ "page" ] }
 ]
}
