{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1208px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "main",
     "name": "Main blue",
     "color": "#0066BB"
    },
    {
     "slug": "tint",
     "name": "Tint band",
     "color": "#E5F0F8"
    },
    {
     "slug": "card",
     "name": "Card tint",
     "color": "#E5EEF8"
    },
    {
     "slug": "warm",
     "name": "Warm panel",
     "color": "#FDEFE3"
    },
    {
     "slug": "accent",
     "name": "Accent orange",
     "color": "#E86F00"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#212529"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#DDDDDD"
    },
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "defaultFontSizes": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display",
     "fontFamily": "\"Plus Jakarta Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Plus Jakarta Sans",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/plus-jakarta-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"Plus Jakarta Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Plus Jakarta Sans\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body",
     "fontFamily": "\"DM Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "DM Sans",
       "fontStyle": "normal",
       "fontWeight": "100 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dm-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": ".875rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "2.5rem"
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "blockGap": true
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "#FFFFFF",
   "text": "#212529"
  },
  "spacing": {
   "blockGap": "0"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.5",
   "letterSpacing": ".02em"
  },
  "elements": {
   "link": {
    "color": {
     "text": "#0066BB"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.5"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "clamp(2.25rem, 3.6vw, 3rem)",
     "lineHeight": "1.3"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "2.5rem"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.25rem"
    }
   },
   "button": {
    "color": {
     "background": "#0066BB",
     "text": "#FFFFFF"
    },
    "typography": {
     "fontSize": ".875rem",
     "fontWeight": "700"
    },
    "border": {
     "radius": "8px"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}