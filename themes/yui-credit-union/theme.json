{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Stone (ground)",
     "color": "#F2F0EF"
    },
    {
     "slug": "paper",
     "name": "White (panels)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#222222"
    },
    {
     "slug": "main",
     "name": "Pine (small accents)",
     "color": "#5E7350"
    },
    {
     "slug": "tint",
     "name": "Pine tint",
     "color": "#E3E8DD"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#CFC9C4"
    },
    {
     "slug": "plum",
     "name": "Plum (focus only)",
     "color": "#94486A"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5A5753"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Merriweather)",
     "fontFamily": "Merriweather, Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Merriweather",
       "fontWeight": "300 400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/merriweather-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Merriweather",
       "fontWeight": "300 400",
       "fontStyle": "italic",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/merriweather-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "text",
     "name": "Text (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontWeight": "100 900",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.5rem"
     }
    },
    {
     "slug": "x-large",
     "name": "X-Large",
     "size": "2.25rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XX-Large",
     "size": "3.25rem",
     "fluid": {
      "min": "2.4rem",
      "max": "3.25rem"
     }
    },
    {
     "slug": "huge",
     "name": "Huge (hero)",
     "size": "4.25rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.25rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--text)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.75"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.18"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "fontSize": "1.25rem"
    }
   }
  }
 }
}