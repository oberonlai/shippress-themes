{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "violet",
          "name": "Deep violet (the ground)",
          "color": "#2B1A4A"
        },
        {
          "slug": "amber",
          "name": "Amber (the on-air light: accents, buttons, the newsletter band; text on violet or night)",
          "color": "#F5C542"
        },
        {
          "slug": "cream",
          "name": "Cream (type on violet, light panels)",
          "color": "#F7F3EA"
        },
        {
          "slug": "night",
          "name": "Night (deeper panels and the footer)",
          "color": "#1D1133"
        },
        {
          "slug": "plum",
          "name": "Plum (raised cards and rules on violet)",
          "color": "#3D2A63"
        },
        {
          "slug": "haze",
          "name": "Haze (quiet text on violet, night and plum)",
          "color": "#B3A6CC"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "violet-amber",
          "name": "Violet and amber",
          "colors": [
            "#1D1133",
            "#F5C542"
          ]
        },
        {
          "slug": "violet-cream",
          "name": "Violet and cream",
          "colors": [
            "#1D1133",
            "#F7F3EA"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Darker Grotesque)",
          "fontFamily": "\"Darker Grotesque\", \"Arial Narrow\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Darker Grotesque",
              "fontStyle": "normal",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/darker-grotesque-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Work Sans)",
          "fontFamily": "\"Work Sans\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Work Sans",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/work-sans-variable-latin.woff2"
              ]
            },
            {
              "fontFamily": "Work Sans",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/work-sans-italic-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.5rem",
          "fluid": {
            "min": "1.875rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "4.5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5.25rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "8rem",
          "fluid": {
            "min": "3.5rem",
            "max": "9.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.5rem + 2vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4rem, 3rem + 4vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(5rem, 4rem + 5vw, 9rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "ease": "cubic-bezier(.2, .8, .2, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|violet",
      "text": "var:preset|color|cream"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1rem, 4vw, 3rem)",
        "bottom": "0px",
        "left": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|amber"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|cream"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|cream"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|cream"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "800",
          "lineHeight": "0.95",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "900",
          "lineHeight": "0.86"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "0.9"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|amber",
          "text": "var:preset|color|violet"
        },
        "border": {
          "radius": "999px",
          "width": "2px",
          "style": "solid",
          "color": "var:preset|color|amber"
        },
        "spacing": {
          "padding": {
            "top": "0.7rem",
            "right": "1.5rem",
            "bottom": "0.8rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.25rem",
          "fontWeight": "800",
          "letterSpacing": "0.01em",
          "lineHeight": "1"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|cream",
            "text": "var:preset|color|violet"
          },
          "border": {
            "color": "var:preset|color|cream"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|cream",
            "text": "var:preset|color|violet"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|haze"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "900",
          "lineHeight": "0.8",
          "textTransform": "uppercase"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.3rem",
          "fontWeight": "700"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "700",
          "lineHeight": "1.02"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|plum"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (masthead: dateline, giant wordmark, menu row)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (newsletter band, station details, menu)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full width (sections fill the screen)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
