{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ],
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1364px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground", "color": "#F9F9F9" },
    { "slug": "ink", "name": "Ink (text)", "color": "#2B2B2B" },
    { "slug": "panel", "name": "Panel (grain)", "color": "#E3E3E3" },
    { "slug": "dark", "name": "Dark warm grey", "color": "#44413C" },
    { "slug": "mid", "name": "Light warm grey", "color": "#908F8B" },
    { "slug": "muted", "name": "Muted text", "color": "#6E6C68" },
    { "slug": "card", "name": "White card", "color": "#FFFFFF" },
    { "slug": "accent", "name": "Kuruchiku brown (labels)", "color": "#6B5346" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Libre Baskerville)",
     "fontFamily": "\"Libre Baskerville\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Libre Baskerville", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-wght-latin.ttf" ] },
      { "fontFamily": "Libre Baskerville", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Work Sans)",
     "fontFamily": "\"Work Sans\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Work Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/work-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Label", "size": "0.75rem" },
    { "slug": "small", "name": "List", "size": "0.875rem" },
    { "slug": "base", "name": "Body", "size": "1rem" },
    { "slug": "medium", "name": "Lead", "size": "1.0625rem" },
    { "slug": "large", "name": "Card title", "size": "1.375rem" },
    { "slug": "x-large", "name": "Passage heading", "size": "clamp(1.75rem, 2.4vw + 0.8rem, 2.25rem)" },
    { "slug": "xx-large", "name": "Statement", "size": "clamp(2.5rem, 5.2vw, 4.25rem)" }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vw", "%" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.5rem" },
    { "slug": "30", "name": "S", "size": "1rem" },
    { "slug": "40", "name": "M", "size": "2.375rem" },
    { "slug": "50", "name": "L", "size": "6rem" },
    { "slug": "60", "name": "XL", "size": "10rem" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false, "presets": [] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.75",
   "letterSpacing": "0.01em"
  },
  "spacing": { "blockGap": "1.5rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.12", "letterSpacing": "-0.01em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.35" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--card)" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "1rem", "fontWeight": "500" }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
