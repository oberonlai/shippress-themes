{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1152px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground (white)", "color": "#FFFFFF" },
				{ "slug": "navy", "name": "Navy (main)", "color": "#073061" },
				{ "slug": "blue", "name": "Link blue", "color": "#1D4E89" },
				{ "slug": "orange", "name": "Orange (hairlines)", "color": "#FA723D" },
				{ "slug": "ink", "name": "Ink", "color": "#222222" },
				{ "slug": "charcoal", "name": "Charcoal", "color": "#4A4744" },
				{ "slug": "rule", "name": "Rule grey", "color": "#E3E6EB" },
				{ "slug": "soft", "name": "Soft band", "color": "#F4F6F8" },
				{ "slug": "stone", "name": "Arrow grey", "color": "#9C958E" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "figtree",
					"name": "Headings (Figtree)",
					"fontFamily": "Figtree, \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-italic-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "manrope",
					"name": "Body (Manrope)",
					"fontFamily": "Manrope, \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "sans-zh",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ]
						}
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.75rem" },
				{ "slug": "base", "name": "Base", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "1.625rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "Display", "size": "4.25rem" },
				{ "slug": "huge", "name": "Numeral", "size": "10rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "3rem" },
				{ "slug": "50", "name": "L", "size": "4.5rem" },
				{ "slug": "60", "name": "XL", "size": "7rem" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] },
		"custom": {
			"ease": "cubic-bezier(0, .56, .44, 1)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.95",
			"letterSpacing": "0.04em"
		},
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "var(--wp--preset--color--navy)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--figtree)", "fontWeight": "400", "lineHeight": "1.5", "letterSpacing": "0.02em" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--blue)" },
				"color": { "background": "transparent", "text": "var(--wp--preset--color--blue)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--figtree)", "fontSize": "0.75rem", "fontWeight": "500", "textTransform": "uppercase", "letterSpacing": "0.1em" },
				"spacing": { "padding": { "top": "0.65rem", "bottom": "0.65rem", "left": "1.75rem", "right": "1.75rem" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--figtree)", "fontWeight": "600", "letterSpacing": "0.02em", "fontSize": "1rem", "lineHeight": "1.2" }, "elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--ink)" } } } },
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.3" } }
		}
	},
	"customTemplates": [
		{ "name": "page-inner", "title": "Inner page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
