{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground", "color": "#FFFFFF" },
				{ "slug": "band", "name": "Pale band", "color": "#EDF2EF" },
				{ "slug": "ink", "name": "Ink", "color": "#333333" },
				{ "slug": "quiet", "name": "Secondary text", "color": "#5F5F5F" },
				{ "slug": "line", "name": "Rule", "color": "#CCCCCC" },
				{ "slug": "accent", "name": "Old bamboo", "color": "#6A7A58" },
				{ "slug": "accent-dark", "name": "Old bamboo dark", "color": "#4E5A40" },
				{ "slug": "footer", "name": "Footer green-ink", "color": "#39412F" }
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Display (Spectral)",
					"fontFamily": "\"Spectral\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Spectral", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/spectral-light-latin.woff2" ] },
						{ "fontFamily": "Spectral", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/spectral-regular-latin.woff2" ] },
						{ "fontFamily": "Spectral", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/spectral-italic-latin.woff2" ] }
					]
				},
				{
					"slug": "sans",
					"name": "Text (IBM Plex Sans)",
					"fontFamily": "\"IBM Plex Sans\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "IBM Plex Sans", "fontStyle": "normal", "fontWeight": "100 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-variable.woff2" ] }
					]
				},
				{
					"slug": "display-zh", "name": "Chinese subset (Noto Serif TC)", "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja", "name": "Japanese subset (Noto Serif JP)", "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "medium", "name": "Body", "size": "1rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Heading", "size": "3rem" },
				{ "slug": "xx-large", "name": "Hero", "size": "4.5rem" },
				{ "slug": "ghost", "name": "Ghost word", "size": "11.5rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "3rem" },
				{ "slug": "50", "name": "XL", "size": "6.25rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"spacing": { "padding": { "left": "1.5rem", "right": "1.5rem" }, "blockGap": "1.5rem" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-dark)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "500", "lineHeight": "1.5" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.25", "fontWeight": "400" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "letterSpacing": "0.1em" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600", "lineHeight": "1.7" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "#FFFFFF" },
				"border": { "radius": "10px" },
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "28px", "right": "28px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)", "text": "#FFFFFF" } }
			}
		}
	}
}
