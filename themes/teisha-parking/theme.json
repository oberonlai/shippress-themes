{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1320px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Pale band",
     "color": "#EEF0F1"
    },
    {
     "slug": "wash",
     "name": "Wash grey",
     "color": "#DDE1E3"
    },
    {
     "slug": "pale",
     "name": "Footer ground",
     "color": "#F4F5F5"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1A1A1A"
    },
    {
     "slug": "navy",
     "name": "Navy (pills, bands, numerals)",
     "color": "#2C3A4A"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5A6370"
    },
    {
     "slug": "amber",
     "name": "Booth amber (one dot)",
     "color": "#C98F4A"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "600 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Extra small",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "s",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "l",
     "name": "Large",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "xl",
     "name": "H2",
     "size": "2rem",
     "fluid": false
    },
    {
     "slug": "xxl",
     "name": "Step numeral",
     "size": "2.75rem",
     "fluid": false
    },
    {
     "slug": "display",
     "name": "Display (ledger numerals)",
     "size": "clamp(4.25rem, 9vw, 8.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "%"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--navy)"
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.35"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "clamp(2.75rem, 5.2vw, 4.5rem)",
     "fontWeight": "300",
     "lineHeight": "1.05"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)",
     "letterSpacing": "0.02em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.25rem",
     "lineHeight": "1.4"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}