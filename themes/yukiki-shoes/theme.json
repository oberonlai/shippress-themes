{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Band",
     "color": "#F4F2F0"
    },
    {
     "slug": "tile",
     "name": "Tile",
     "color": "#E8E6E3"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1D1A18"
    },
    {
     "slug": "body",
     "name": "Body text",
     "color": "#4A423C"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#767069"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#D5D0CB"
    },
    {
     "slug": "dot",
     "name": "Dot",
     "color": "#CCCCCC"
    },
    {
     "slug": "main",
     "name": "Main (coal bamboo)",
     "color": "#6B5A4E"
    },
    {
     "slug": "accent",
     "name": "Accent (oxblood)",
     "color": "#8F3A2C"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "40",
     "name": "S",
     "size": "32px"
    },
    {
     "slug": "50",
     "name": "M",
     "size": "72px"
    },
    {
     "slug": "60",
     "name": "L",
     "size": "96px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Sub-label",
     "size": "0.6875rem"
    },
    {
     "slug": "s",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "0.9375rem"
    },
    {
     "slug": "l",
     "name": "Lead",
     "size": "1.0625rem"
    },
    {
     "slug": "md",
     "name": "H3",
     "size": "1.25rem"
    },
    {
     "slug": "lg",
     "name": "Section head",
     "size": "2rem"
    },
    {
     "slug": "xl",
     "name": "Statement",
     "size": "3rem"
    },
    {
     "slug": "xxl",
     "name": "Hero headline",
     "size": "clamp(2.75rem, 5.2vw, 4.5rem)"
    }
   ]
  },
  "custom": {}
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--body)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.6"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.1"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--base)",
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "500"
    },
    "border": {
     "radius": "0",
     "width": "1px",
     "style": "solid",
     "color": "var(--wp--preset--color--ink)"
    },
    "spacing": {
     "padding": {
      "top": "0.75rem",
      "bottom": "0.75rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--ink)",
      "text": "var(--wp--preset--color--base)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)"
    }
   }
  }
 }
}