{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "buckwheat",
          "name": "Buckwheat grey (ground)",
          "color": "#ECEDE8"
        },
        {
          "slug": "grey-green",
          "name": "Pale grey-green (the rail, panels)",
          "color": "#DADDD3"
        },
        {
          "slug": "paper",
          "name": "Paper (tray tiles)",
          "color": "#F6F6F2"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#232622"
        },
        {
          "slug": "husk",
          "name": "Muted husk green (large type and marks only)",
          "color": "#6E7A5C"
        },
        {
          "slug": "deep-husk",
          "name": "Deep husk (links and small labels)",
          "color": "#4E5A3F"
        },
        {
          "slug": "quiet",
          "name": "Quiet grey (secondary text)",
          "color": "#565B52"
        },
        {
          "slug": "hairline",
          "name": "Hairline (tray frames and rules only)",
          "color": "#BFC4B6"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Kaisei HarunoUmi)",
          "fontFamily": "\"Kaisei HarunoUmi\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Kaisei HarunoUmi",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/harunoumi-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Kaisei HarunoUmi",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/harunoumi-500-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Murecho)",
          "fontFamily": "Murecho, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Murecho",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/murecho-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.1875rem, 1.1rem + 0.4vw, 1.4375rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.875rem, 1.5rem + 1.5vw, 2.875rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.5rem, 1.7rem + 3.2vw, 4.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--buckwheat)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.8",
      "fontWeight": "350"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.3",
          "letterSpacing": "0.02em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.375rem, 1.25rem + 0.5vw, 1.75rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.1875rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep-husk)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--buckwheat)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.8125rem",
          "letterSpacing": "0.12em",
          "fontWeight": "500",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (the name and the menu in vertical type on a pale grey-green rail at the right edge)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (watercolour street map beside the address card with the noren line, today's note and the hours)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
