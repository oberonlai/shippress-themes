  {
   "slug": "courses",
   "title": "Courses",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Courses</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Six languages, three course shapes: the evening course, the daytime intensive and the workplace group. Full course pages follow in the next release.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "pathways-work",
   "title": "Work & cross-border teams",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Work & cross-border teams</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">A shared working language for people and teams, with an on-site workplace group of up to six at €1,980 and private lessons at €62.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "pathways-settlement",
   "title": "Settlement & daily life",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Settlement & daily life</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Dutch and other languages for appointments, housing and schools: the conversation club is €150 and the evening course €590.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "pathways-exams",
   "title": "Exam preparation",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Exam preparation</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">An eight-week block at €470 aimed at a stated CEFR level. The school makes no claim that you will pass.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "teachers",
   "title": "Teachers",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Teachers</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Eight teachers across six languages, led by Noor Abadi, director of studies since 2016.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "levels-placement",
   "title": "Levels & placement",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Levels & placement</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Every learner is placed on the CEFR scale from A1 to C2 in a free 45-minute interview, with a level review at week 5.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "fees-intake",
   "title": "Fees & intake",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">Fees & intake</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Prices in EUR. Four intakes in 2026: 12 January, 13 April, 7 September and 9 November.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
  },
