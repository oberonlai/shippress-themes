  {
   "slug": "about",
   "title": "About the school",
   "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"kl-sec kl-pagehead\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group alignfull kl-sec kl-pagehead\"><!-- wp:group {\"className\":\"kl-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap\"><!-- wp:paragraph {\"className\":\"kl-label\"} -->\n<p class=\"kl-label\">Kotoba Language</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"kl-h1\"} -->\n<h1 class=\"wp-block-heading kl-h1\">About the school</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"kl-lede\"} -->\n<p class=\"kl-lede\">Kotoba Language opened in 2016 for adults who are in the middle of a move or a job. Classes hold a maximum of 8.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"kl-wrap kl-stubclose\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group kl-wrap kl-stubclose\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"kl-pill-btn\"} -->\n<div class=\"wp-block-button kl-pill-btn\"><a class=\"wp-block-button__link wp-element-button\" href=\"/enquiry/\">Enquire</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
