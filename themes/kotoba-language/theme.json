{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Ground",
     "color": "#F2F1EE"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0D0C0A"
    },
    {
     "slug": "pill",
     "name": "Pill",
     "color": "#15130F"
    },
    {
     "slug": "accent",
     "name": "Kuwazome (small areas only)",
     "color": "#6E5C4C"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5B564E"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#D9D7D1"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "5.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "11rem"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (EB Garamond)",
     "fontFamily": "\"EB Garamond\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ebgaramond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "EB Garamond",
       "fontStyle": "italic",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/ebgaramond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/SourceSans3VF-Upright.ttf.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.6875rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Sub-head",
     "size": "1.75rem"
    },
    {
     "slug": "x-large",
     "name": "Section heading",
     "size": "2.75rem"
    },
    {
     "slug": "xx-large",
     "name": "Page head",
     "size": "4.5rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.6",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.12",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--pill)",
     "text": "#FFFFFF"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.875rem"
    },
    "border": {
     "radius": "999px"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "500",
     "fontSize": "0.9375rem"
    }
   }
  }
 }
}