{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1440px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "Paper (page ground)", "color": "#F7F6F5" },
    { "slug": "band", "name": "Warm band (alt ground, header after the fold, footer)", "color": "#EFEAE6" },
    { "slug": "ink", "name": "Ink (text, underlines)", "color": "#070B0D" },
    { "slug": "wine", "name": "Wine (glyphs, notice card, arrows)", "color": "#941E57" },
    { "slug": "glow", "name": "Rose glow (lead glow)", "color": "#F3E6EA" },
    { "slug": "lilac", "name": "Lilac wash (one band)", "color": "#E6E5EF" },
    { "slug": "muted", "name": "Muted (years, captions)", "color": "#55524F" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "Fraunces, \"Source Serif 4\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/fraunces-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Source Serif 4)",
     "fontFamily": "\"Source Serif 4\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/source-serif-4-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small (nav, chips, labels)", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Tagline, leads", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "Section heads", "size": "1.75rem", "fluid": false },
    { "slug": "x-large", "name": "Time and date numerals", "size": "3.5rem", "fluid": false },
    { "slug": "xx-large", "name": "Headline (H1)", "size": "4.25rem", "fluid": false }
   ]
  },
  "spacing": {
   "units": ["px", "em", "rem", "vh", "vw", "%"]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.6",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "-0.005em"
    }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.12" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.25" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--wine)", "text": "#FFFFFF" },
    "border": { "radius": "999px" },
    "typography": { "fontSize": "0.8125rem", "fontWeight": "400" },
    "spacing": { "padding": { "top": "6px", "bottom": "6px", "left": "20px", "right": "20px" } }
   }
  }
 },
 "customTemplates": [
  { "name": "page-inner", "title": "Inner page", "postTypes": ["page"] }
 ]
}
