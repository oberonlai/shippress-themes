  {
   "slug": "services",
   "title": "Services",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Services</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">Stage, lighting, sound and show-calling for corporate gatherings, built from the empty hall up.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-ledger\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-ledger\"><!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 01 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Sales kick-offs</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Half-day and full-day plenaries</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">From one hall and 300 guests to a full-day plenary with breakout rooms. One crew, one run sheet, from load-in at 06:00 to strike.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 02 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Award nights</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Up to 600 guests</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">A staged reveal for every category, broadcast-ready lighting and a stage manager who calls each cue so the evening keeps its pace.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 03 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Product launches</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Up to 250 guests and a live stream</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Covered plinth, timed reveal, press audio feeds and a stream with a proper backup path.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 04 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Technical production only</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Per day, on site</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Already have a creative agency? Hire our technical director, lighting designer, sound engineers and riggers for the build and the show.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">Every service starts with the same discovery brief, so you know what the room needs before anything is ordered.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "work",
   "title": "Work",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Work</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">Three recent productions, told by the people who ran them.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-ledger\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-ledger\"><!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 01 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Northline Logistics annual kick-off</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">900 guests, 2025</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">A two-day plenary in a converted warehouse hall. Rigging started at dawn and doors opened at 18:30 with the stage already rehearsed.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 02 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Halden Engineering awards night</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">420 guests, 2026</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Twelve categories, one run sheet and a lighting plot that kept faces readable for the camera and the room.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 03 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Vesta Audio product launch</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">250 guests and a live stream, 2026</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">A reveal timed to the second, with the stream, the room audio and the press feed each on their own path.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\"><a href=\"/category/case-studies/\">Read the case studies in the journal</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "process",
   "title": "Process",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Process</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">From a first brief to a clean hall, in about six weeks.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-ledger\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-ledger\"><!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 01 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Brief</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Week 0</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">You send a brief. We reply within two working days with a first schedule and a rough budget.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 02 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Concept and budget</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Weeks 1–2</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">A half-day discovery workshop, then one page with scope, plan and price.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 03 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Build and rehearse</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Weeks 3–5</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Drawings, line checks and a rehearsal against the real cues.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 04 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Show day</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Load-in 06:00, doors 18:30</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">The same printed run sheet every time. A named person for each line.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 05 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Strike and report</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Plus five days</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Overnight strike, hall handed back as found, then a written report.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "fees",
   "title": "Fees",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Fees</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">Starting prices in euros, excluding VAT. Your quote follows the brief.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-ledger\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-ledger\"><!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 01 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Discovery brief workshop</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">€1,800</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">A half-day scoping session covering technical needs, venue limits and milestones.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 02 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Half-day kick-off</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">From €18,000</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Staging, sound, lighting and stage management for up to 300 guests.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 03 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Full-day kick-off</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">From €32,000</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Plenary hall production, breakout-room audio-visual systems and a full technical crew.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 04 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Award night</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">From €45,000</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Custom stage set, broadcast lighting and live cue calling for up to 600 attendees.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 05 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Product launch show</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">From €38,000</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Staging reveals, synchronised lighting, press audio feeds and live streaming for up to 250 guests.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 06 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Technical production only</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">€6,500 per day</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">An on-site technical director, lighting designer, sound engineers and rigging management.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "about",
   "title": "About",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">About</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">A production studio in Port Ellery, founded in 2014 by Mara Lindqvist.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">Moyooshi Productions began with one rule: the hall is built before the doors open and left as it was found. The studio and the cable-and-case warehouse share one building at Harbour Works, so crews load out from there at 06:00 on show days.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">Since 2014 we have produced 214 events with a crew of 38 on call, from 250-guest launches to a 1,600-seat plenary hall.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-ledger\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-ledger\"><!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 01 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Mara Lindqvist</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Founder, Executive Producer</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Leads executive production and creative direction.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 02 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Tomasz Okafor</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Stage Manager</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Calls the show from the prompt desk, cue by cue.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 03 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Ines Duarte</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Technical Director</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Power, rigging, audio line checks and safety on site.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 04 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Kenji Arata</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Lighting Designer</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Designs rigs that work for the room and the camera.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 05 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Priya Raman</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Producer, Awards</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Runs award nights from run sheet to reveal.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 06 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Lucas Weber</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Logistics and Strike Lead</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Dispatch, load-out and handing the hall back.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\": \"mp-row\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row\"><!-- wp:paragraph {\"className\":\"mp-row__n\"} -->\n<p class=\"mp-row__n\">( 07 )</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\": \"mp-row__b\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-row__b\"><!-- wp:heading {\"level\":3,\"className\":\"mp-row__t\"} -->\n<h3 class=\"wp-block-heading mp-row__t\">Amara Osei</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__s\"} -->\n<p class=\"mp-row__s\">Client Lead</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-row__p\"} -->\n<p class=\"mp-row__p\">Takes you from brief to budget to debrief.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "contact",
   "title": "Contact",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Contact</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">Send a brief and we answer within two working days.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">Studio and warehouse: Unit 4, Harbour Works, 18 Quay Road, Port Ellery. Open Monday to Friday 09:00–18:00; on call 06:00–24:00 on show days.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">Email brief@moyooshi.example. Tell us the date, the venue, the number of guests and what the day has to achieve.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shippress/form {\"kind\": \"contact\", \"fallback\": \"<a class=\\\"wp-element-button\\\" href=\\\"mailto:brief@moyooshi.example?subject=Event brief\\\">Email brief@moyooshi.example</a>\"} /--></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "newsletter",
   "title": "Newsletter",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Newsletter</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">Practical notes on stage production, run sheets and venue engineering.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">A short note from the cue desk, now and then. No filler.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shippress/form {\"kind\": \"newsletter\", \"email\": \"brief@moyooshi.example\", \"label\": \"Email address\", \"submit\": \"Subscribe\", \"notice\": \"Opens your email app. Send the request to subscribe; you are not subscribed yet.\", \"subject\": \"Newsletter sign-up\"} /--></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
  },
  {
   "slug": "privacy",
   "title": "Privacy",
   "content": "<!-- wp:group {\"className\": \"mp-sec mp-pagebody\", \"layout\": {\"type\": \"default\"}} -->\n<section class=\"wp-block-group mp-sec mp-pagebody\"><!-- wp:group {\"className\": \"mp-frame\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-frame\"><!-- wp:group {\"className\": \"mp-giant mp-giant--page\", \"layout\": {\"type\": \"default\"}} -->\n<div class=\"wp-block-group mp-giant mp-giant--page\"><!-- wp:heading {\"level\":1,\"className\":\"mp-giant__w\"} -->\n<h1 class=\"wp-block-heading mp-giant__w\">Privacy</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"mp-giant__s\"} -->\n<p class=\"mp-giant__s\">How a brief or a sign-up request is handled.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">This is sample copy for a demonstration site. When you email a brief or a sign-up request, your mail app sends it to brief@moyooshi.example and we use it only to reply to you.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"mp-lead\"} -->\n<p class=\"mp-lead\">We do not sell or share contact details. Ask us to delete your message at any time by writing to the same address.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
