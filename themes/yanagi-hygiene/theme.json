{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1400px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "white",
     "name": "White ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "wash",
     "name": "Pale wash",
     "color": "#E8F4E4"
    },
    {
     "slug": "wash-deep",
     "name": "Deep wash (skyline)",
     "color": "#D3E6D0"
    },
    {
     "slug": "green",
     "name": "Brand green",
     "color": "#449A52"
    },
    {
     "slug": "pine",
     "name": "Pine charcoal",
     "color": "#4A5852"
    },
    {
     "slug": "ink",
     "name": "Deep ink (text)",
     "color": "#1F2926"
    },
    {
     "slug": "panel",
     "name": "Grey panel",
     "color": "#EBEBEB"
    },
    {
     "slug": "frame",
     "name": "Panel frame",
     "color": "#CCCCCC"
    },
    {
     "slug": "amber",
     "name": "Work-light orange",
     "color": "#F26B3A"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5E6A64"
    },
    {
     "slug": "rule",
     "name": "Rule green",
     "color": "#9DB8A4"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-tc",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-jp",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Hero",
     "size": "3.5rem",
     "fluid": false
    },
    {
     "slug": "xxx-large",
     "name": "Title (maximum 4.25rem)",
     "size": "4.25rem",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.3",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "fontWeight": "300",
     "lineHeight": "1.5",
     "letterSpacing": "0.08em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "fontWeight": "600",
     "lineHeight": "1.35"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--pine)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--pine)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "1rem",
     "fontWeight": "700",
     "letterSpacing": "0.02em"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-landing",
   "title": "Page with title lockup",
   "postTypes": [
    "page"
   ]
  }
 ]
}