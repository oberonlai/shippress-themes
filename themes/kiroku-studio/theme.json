{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "black",
          "name": "Black (the ground)",
          "color": "#0B0B0C"
        },
        {
          "slug": "white",
          "name": "White (type, light panels)",
          "color": "#FFFFFF"
        },
        {
          "slug": "green",
          "name": "Neon green (accents on black; behind black text; never as text on white)",
          "color": "#3DF07A"
        },
        {
          "slug": "coal",
          "name": "Coal (raised cards on black)",
          "color": "#161618"
        },
        {
          "slug": "graphite",
          "name": "Graphite (rules on black; decoration only)",
          "color": "#2C2C31"
        },
        {
          "slug": "smoke",
          "name": "Smoke (quiet text on black)",
          "color": "#A6A6AE"
        },
        {
          "slug": "paper",
          "name": "Paper (light panel ground)",
          "color": "#F3F3F0"
        },
        {
          "slug": "ink-muted",
          "name": "Muted ink (quiet text on white and paper)",
          "color": "#55555C"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "black-green",
          "name": "Black and neon green",
          "colors": [
            "#0B0B0C",
            "#3DF07A"
          ]
        },
        {
          "slug": "black-white",
          "name": "Black and white",
          "colors": [
            "#0B0B0C",
            "#FFFFFF"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Bricolage Grotesque)",
          "fontFamily": "\"Bricolage Grotesque\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bricolage-grotesque-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Figtree)",
          "fontFamily": "Figtree, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Figtree",
              "fontStyle": "normal",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/figtree-variable-latin.woff2"
              ]
            },
            {
              "fontFamily": "Figtree",
              "fontStyle": "italic",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/figtree-italic-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "4rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "7rem",
          "fluid": {
            "min": "3.25rem",
            "max": "9rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.5rem + 2vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4rem, 3rem + 4vw, 7.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(5.5rem, 4rem + 6vw, 10rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "ease": "cubic-bezier(.2, .8, .2, 1)",
      "rule": "1px solid #2C2C31"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|black",
      "text": "var:preset|color|white"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|green"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|white"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|white"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "0.98",
          "letterSpacing": "-0.035em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "800",
          "lineHeight": "0.9"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "0.95"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.15",
          "letterSpacing": "-0.015em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.3",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|green",
          "text": "var:preset|color|black"
        },
        "border": {
          "radius": "999px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|green"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.5rem",
            "bottom": "0.85rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1rem",
          "fontWeight": "600",
          "letterSpacing": "-0.01em",
          "lineHeight": "1.1"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|white",
            "text": "var:preset|color|black"
          },
          "border": {
            "color": "var:preset|color|white"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|white",
            "text": "var:preset|color|black"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|smoke"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.375rem",
          "fontWeight": "800",
          "letterSpacing": "-0.04em",
          "lineHeight": "1"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.0625rem",
          "fontWeight": "600"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "600",
          "lineHeight": "1.12",
          "letterSpacing": "-0.025em"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|graphite"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (logo top-left, numbered index in the corner)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (studio details and the giant wordmark)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full width (sections fill the screen)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
