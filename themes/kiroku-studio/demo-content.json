      "parent": "work",
      "template": "page-wide",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-head ks-head--case\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-head ks-head--case\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-head__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-head__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Case 02 / 04 — Exhibition identity · Projection · Film</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"ks-head__title\"} -->\n<h1 class=\"wp-block-heading ks-head__title\">Kosa Gallery</h1>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"ks-head__foot ks-head__foot--case\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-head__foot ks-head__foot--case\"><!-- wp:paragraph {\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead\">Opening titles for a concrete room. A projected title sequence that turns the gallery itself into the poster.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"ks-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-facts\"><!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Client</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Kosa Gallery</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Year</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">2025</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">We made</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Exhibition identity, projection film, signage</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Team</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Ren Kuroda, Sol Herrera, Jonas Weller</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"full\",\"className\":\"ks-case__media\"} -->\n<figure class=\"wp-block-image alignfull size-full ks-case__media\"><img src=\"{{theme}}/assets/images/case2.jpg\" alt=\"A bare board-marked concrete room with a tilted green rectangle of projected light on the far wall\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-prose ks-case__body\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-prose ks-case__body\"><!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">The brief</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Kosa is a gallery in a former water tank: one tall concrete room and nothing else. For its tenth year it asked us for an identity that would not hang posters on its walls.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What we made</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-dash\"} -->\n<ul class=\"wp-block-list is-style-dash\"><!-- wp:list-item -->\n<li>A projected title sequence: one green plane that walks around the room and stops where the next work hangs</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Wayfinding projected from the ceiling instead of printed signs</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A printed programme in one colour, folded like the plane on the wall</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Social films cut from the projection rehearsals</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote {\"className\":\"ks-pull\"} -->\n<blockquote class=\"wp-block-quote ks-pull\"><!-- wp:paragraph -->\n<p>The room became the poster. We did not print a single one.</p>\n<!-- /wp:paragraph --><cite>Hiro Tamaki, director, Kosa Gallery</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What happened next</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The sequence opened all six exhibitions of the anniversary year and now plays every evening at closing time.</p>\n<!-- /wp:paragraph --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-section--flush\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-section--flush\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-stats ks-stats--three\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-stats ks-stats--three\"><!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">6</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">exhibitions opened</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">0</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">posters printed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">18 min</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">projection loop</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-next\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-next\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-next__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-next__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Next record</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-next__title\"} -->\n<h2 class=\"wp-block-heading ks-next__title\"><a href=\"/work/nami-paper/\">Nami Paper Co. →</a></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ks-next__line\"} -->\n<p class=\"ks-next__line\">Swatches that move.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
