      "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-head ks-head--case\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-head ks-head--case\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-head__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-head__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Case 01 / 04 — Identity · Packaging · Motion</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"ks-head__title\"} -->\n<h1 class=\"wp-block-heading ks-head__title\">Oboro Lighting</h1>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"ks-head__foot ks-head__foot--case\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-head__foot ks-head__foot--case\"><!-- wp:paragraph {\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead\">A brand that switches on. Twelve lamps, one light line: an identity drawn by the product itself.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"ks-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-facts\"><!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Client</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Oboro Lighting</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Year</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">2026</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">We made</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Identity, packaging system, launch film</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Team</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Aya Morikawa, Ren Kuroda, Mio Tanabe</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"full\",\"className\":\"ks-case__media\"} -->\n<figure class=\"wp-block-image alignfull size-full ks-case__media\"><img src=\"{{theme}}/assets/images/case1.jpg\" alt=\"Matte grey boxes on black plinths, crossed by a single bright green line of light\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-prose ks-case__body\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-prose ks-case__body\"><!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">The brief</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Oboro make small lamps by hand in a workshop in Saitama. After forty years of selling to architects, they wanted to sell to the people who live under the lamps, without looking like every other lighting brand on the shelf.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What we made</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-dash\"} -->\n<ul class=\"wp-block-list is-style-dash\"><!-- wp:list-item -->\n<li>A logotype built from a 3 px line, the width of the lamp's own LED strip</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Packaging in one grey card, the line printed in fluorescent ink so it glows under shop lights</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A 40-second launch film shot with a single moving light and no cuts</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A type system in Bricolage-style grotesque with a narrow cut for spec sheets</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote {\"className\":\"ks-pull\"} -->\n<blockquote class=\"wp-block-quote ks-pull\"><!-- wp:paragraph -->\n<p>They didn't give us a logo. They gave us a way to switch the brand on.</p>\n<!-- /wp:paragraph --><cite>Kaori Oboro, managing director, Oboro Lighting</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What happened next</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The launch film ran in twelve shops on a loop. Online orders from people who were not architects went from a handful a month to most of the business within a season.</p>\n<!-- /wp:paragraph --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-section--flush\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-section--flush\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-stats ks-stats--three\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-stats ks-stats--three\"><!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">3 px</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">the line everything is drawn from</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">40 s</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">launch film, one take</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">4×</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">direct orders in six months</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-next\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-next\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-next__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-next__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Next record</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-next__title\"} -->\n<h2 class=\"wp-block-heading ks-next__title\"><a href=\"/work/kosa-gallery/\">Kosa Gallery →</a></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ks-next__line\"} -->\n<p class=\"ks-next__line\">Opening titles for a concrete room.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
