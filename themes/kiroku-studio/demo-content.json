      "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-head ks-head--case\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-head ks-head--case\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-head__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-head__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Case 03 / 04 — Packaging · Social films · Sample book</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"ks-head__title\"} -->\n<h1 class=\"wp-block-heading ks-head__title\">Nami Paper Co.</h1>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"ks-head__foot ks-head__foot--case\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-head__foot ks-head__foot--case\"><!-- wp:paragraph {\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead\">Swatches that move. A sample book you can watch: every paper filmed in the hand.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"ks-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-facts\"><!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Client</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Nami Paper Co.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Year</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">2025</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">We made</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Sample book, packaging, social film series</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Team</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Aya Morikawa, Mio Tanabe, Sol Herrera</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"full\",\"className\":\"ks-case__media\"} -->\n<figure class=\"wp-block-image alignfull size-full ks-case__media\"><img src=\"{{theme}}/assets/images/case3.jpg\" alt=\"Hands laying out deckled paper swatches on a dark table, one swatch lit neon green\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-prose ks-case__body\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-prose ks-case__body\"><!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">The brief</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Nami Paper make 48 papers in a mill by the sea. Designers loved the papers once they touched them, but online every sample looked like a flat grey square.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What we made</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-dash\"} -->\n<ul class=\"wp-block-list is-style-dash\"><!-- wp:list-item -->\n<li>A sample book with a cut-out window on every page, so the paper is touched before it is read</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Forty-eight eight-second films: each paper bent, torn and lit in the same hand</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Shipping boxes that open like the book</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>An order form that remembers which swatches you lingered on</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote {\"className\":\"ks-pull\"} -->\n<blockquote class=\"wp-block-quote ks-pull\"><!-- wp:paragraph -->\n<p>Our papers finally look like they feel.</p>\n<!-- /wp:paragraph --><cite>Emi Nakase, head of sales, Nami Paper Co.</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What happened next</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Sample requests doubled in the first quarter, and the films became the mill's whole social channel.</p>\n<!-- /wp:paragraph --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-section--flush\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-section--flush\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-stats ks-stats--three\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-stats ks-stats--three\"><!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">48</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">papers, 48 films</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">8 s</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">per film</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">2×</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">sample requests</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-next\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-next\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-next__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-next__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Next record</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-next__title\"} -->\n<h2 class=\"wp-block-heading ks-next__title\"><a href=\"/work/hikari-night-walk/\">Hikari Night Walk →</a></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ks-next__line\"} -->\n<p class=\"ks-next__line\">Long-exposure idents.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
    },
    {
      "slug": "hikari-night-walk",
      "title": "Hikari Night Walk",
      "parent": "work",
      "template": "page-wide",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-head ks-head--case\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-head ks-head--case\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-head__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-head__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Case 04 / 04 — Idents · Title sequence · Event identity</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"ks-head__title\"} -->\n<h1 class=\"wp-block-heading ks-head__title\">Hikari Night Walk</h1>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"ks-head__foot ks-head__foot--case\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-head__foot ks-head__foot--case\"><!-- wp:paragraph {\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead\">Long-exposure idents. Idents painted with light, one long exposure at a time.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"ks-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-facts\"><!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Client</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Hikari Night Walk</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Year</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">2024</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">We made</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Event identity, idents, title sequence</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-fact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-fact\"><!-- wp:paragraph {\"className\":\"ks-fact__key\"} -->\n<p class=\"ks-fact__key\">Team</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-fact__value\"} -->\n<p class=\"ks-fact__value\">Ren Kuroda, Jonas Weller, Sol Herrera</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"full\",\"className\":\"ks-case__media\"} -->\n<figure class=\"wp-block-image alignfull size-full ks-case__media\"><img src=\"{{theme}}/assets/images/case4.jpg\" alt=\"Ribbons of green light drawn by a long exposure against a black background\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-prose ks-case__body\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-prose ks-case__body\"><!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">The brief</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Hikari Night Walk is a three-night light festival along a river. It needed idents for screens, stations and social channels, made in a month, that felt like the festival rather than like an advert for it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What we made</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"is-style-dash\"} -->\n<ul class=\"wp-block-list is-style-dash\"><!-- wp:list-item -->\n<li>Twenty idents drawn with handheld lights and a camera left open for thirty seconds</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A title sequence that writes the festival's name in one stroke of light</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>An event mark traced from a single exposure</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Station screens timed to the last trains home</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote {\"className\":\"ks-pull\"} -->\n<blockquote class=\"wp-block-quote ks-pull\"><!-- wp:paragraph -->\n<p>People filmed our idents on their phones. That had never happened before.</p>\n<!-- /wp:paragraph --><cite>Daichi Mori, producer, Hikari Night Walk</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:heading {\"className\":\"ks-case__h\"} -->\n<h2 class=\"wp-block-heading ks-case__h\">What happened next</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The festival kept the light-drawing as its identity and now runs a public light-painting night before the walk.</p>\n<!-- /wp:paragraph --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-section ks-section--flush\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-section ks-section--flush\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-stats ks-stats--three\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-stats ks-stats--three\"><!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">20</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">idents</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">30 s</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">per exposure</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"ks-stat\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ks-stat\"><!-- wp:paragraph {\"className\":\"ks-stat__num\"} -->\n<p class=\"ks-stat__num\">3</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"ks-stat__label\"} -->\n<p class=\"ks-stat__label\">nights, 210,000 visitors</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"ks-next\",\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ks-next\"><!-- wp:group {\"align\":\"wide\",\"className\":\"ks-next__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide ks-next__inner\"><!-- wp:paragraph {\"className\":\"is-style-label\"} -->\n<p class=\"is-style-label\">Next record</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"ks-next__title\"} -->\n<h2 class=\"wp-block-heading ks-next__title\"><a href=\"/work/oboro-lighting/\">Oboro Lighting →</a></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ks-next__line\"} -->\n<p class=\"ks-next__line\">A brand that switches on.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->"
