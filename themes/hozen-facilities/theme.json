{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1312px", "wideSize": "1312px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Ground", "color": "#F5F7F9" },
				{ "slug": "surface", "name": "White (header card, chips)", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink (text, rules, dark pill)", "color": "#2E303C" },
				{ "slug": "band", "name": "Pale band (contact, footer)", "color": "#EDEFF3" },
				{ "slug": "accent", "name": "Blue-grey (labels)", "color": "#5E6E78" },
				{ "slug": "action", "name": "Action blue (fault pill only)", "color": "#0067B6" },
				{ "slug": "muted", "name": "Muted text", "color": "#62646D" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Proza Libre)",
					"fontFamily": "\"Proza Libre\", \"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Proza Libre", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/proza-libre-400-latin.woff2"] },
						{ "fontFamily": "Proza Libre", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/proza-libre-500-latin.woff2"] },
						{ "fontFamily": "Proza Libre", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/proza-libre-400-italic-latin.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Figtree)",
					"fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/figtree-variable-latin.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pill text", "size": "0.875rem" },
				{ "slug": "meta", "name": "Meta", "size": "0.9375rem" },
				{ "slug": "base", "name": "Body", "size": "1.0625rem" },
				{ "slug": "label", "name": "Label", "size": "1rem" },
				{ "slug": "medium", "name": "Caption title", "size": "1.375rem" },
				{ "slug": "large", "name": "Sub-head", "size": "1.625rem" },
				{ "slug": "x-large", "name": "Section title", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Page title", "size": "3rem" },
				{ "slug": "huge", "name": "Hero heading", "size": "clamp(2.6rem, 5.3vw, 4.75rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "2.5rem" },
				{ "slug": "50", "name": "L", "size": "5rem" },
				{ "slug": "60", "name": "XL", "size": "clamp(4.5rem, 11.1vw, 10rem)" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "2",
			"letterSpacing": "0.02em"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "500", "lineHeight": "1", "letterSpacing": "0" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.12", "letterSpacing": "-0.005em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.5" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--action)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--surface)" },
				"border": { "radius": "24px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "400", "lineHeight": "1", "letterSpacing": "0.05em" },
				"spacing": { "padding": { "top": "10px", "bottom": "10px", "left": "20px", "right": "20px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--meta)", "fontWeight": "500", "lineHeight": "1.5", "letterSpacing": "0.02em" } }
		}
	},
	"customTemplates": [],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
