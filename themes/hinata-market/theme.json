{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper",
     "color": "#FBFAF8"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#2E2119"
    },
    {
     "slug": "ink-soft",
     "name": "Ink, soft",
     "color": "#5E4A3D"
    },
    {
     "slug": "russet",
     "name": "Russet (brand)",
     "color": "#A86F4C"
    },
    {
     "slug": "russet-deep",
     "name": "Russet, deep",
     "color": "#8A5638"
    },
    {
     "slug": "russet-pale",
     "name": "Russet, pale",
     "color": "#E3B999"
    },
    {
     "slug": "leaf",
     "name": "Leaf",
     "color": "#3F5B45"
    },
    {
     "slug": "point",
     "name": "Point",
     "color": "#D9553A"
    },
    {
     "slug": "wash",
     "name": "Wash",
     "color": "#F2ECE6"
    },
    {
     "slug": "dark",
     "name": "Dark panel",
     "color": "#3A2B22"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#B23A26"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#3F5B45"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "400 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC subset",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP subset",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Label",
     "size": ".75rem"
    },
    {
     "slug": "sm",
     "name": "Small",
     "size": ".9375rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "md",
     "name": "Row title",
     "size": "1.25rem"
    },
    {
     "slug": "lg",
     "name": "Heading 3",
     "size": "1.75rem"
    },
    {
     "slug": "xl",
     "name": "Heading 2",
     "size": "2.125rem"
    },
    {
     "slug": "xxl",
     "name": "Page title",
     "size": "clamp(2.5rem, 5vw, 3.25rem)"
    },
    {
     "slug": "giant",
     "name": "Date numeral",
     "size": "clamp(5.5rem, 12vw, 9.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "12px"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "24px"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "48px"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "80px"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "120px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "500",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.3"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)",
     "fontWeight": "600",
     "lineHeight": "1.5",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)",
     "fontWeight": "700",
     "lineHeight": "1.3"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--md)",
     "fontWeight": "700",
     "lineHeight": "1.6"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--russet-deep)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--russet-deep)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "700",
     "fontSize": "var(--wp--preset--font-size--sm)"
    },
    "border": {
     "radius": "999px"
    },
    "spacing": {
     "padding": {
      "top": "10px",
      "bottom": "10px",
      "left": "24px",
      "right": "24px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--ink)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/navigation": {
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "600"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}