{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "mist",
					"name": "Mist (page)",
					"color": "#EEF2EC"
				},
				{
					"slug": "paper",
					"name": "Pale mist (cards)",
					"color": "#F6F8F4"
				},
				{
					"slug": "sage",
					"name": "Sage glass (panels)",
					"color": "#CFDCCB"
				},
				{
					"slug": "hairline",
					"name": "Glass edge hairline",
					"color": "#B4C5AF"
				},
				{
					"slug": "quiet",
					"name": "Quiet green-grey (secondary text)",
					"color": "#4F5D53"
				},
				{
					"slug": "ink",
					"name": "Deep ink (text, buttons)",
					"color": "#233026"
				},
				{
					"slug": "bottle",
					"name": "Bottle green (display, rules, marks)",
					"color": "#6E8B6A"
				},
				{
					"slug": "bottle-deep",
					"name": "Deep bottle green (links, small labels)",
					"color": "#46604A"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Display (Cardo)",
					"fontFamily": "Cardo, \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cardo",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cardo-regular-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Cardo",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cardo-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Cardo",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cardo-bold-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "sans",
					"name": "Text (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/SourceSans3VF-Upright.ttf.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "clamp(1rem, 0.96rem + 0.18vw, 1.0625rem)"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "clamp(1.125rem, 1.04rem + 0.36vw, 1.375rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.55rem, 1.25rem + 1.1vw, 2.2rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section title",
					"size": "clamp(2.1rem, 1.5rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(2.6rem, 1.6rem + 4.2vw, 5.4rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(3.5rem, 2.2rem + 4.6vw, 6.5rem)"
				},
				{
					"slug": "60",
					"name": "Large section",
					"size": "clamp(4.5rem, 2.6rem + 7vw, 9rem)"
				}
			]
		},
		"custom": {
			"line": "color-mix(in srgb, var(--wp--preset--color--ink) 13%, transparent)",
			"line-strong": "color-mix(in srgb, var(--wp--preset--color--ink) 30%, transparent)",
			"muted": "var(--wp--preset--color--quiet)",
			"on-dark": "#EEF2EC",
			"on-dark-muted": "#CFDCCB",
			"ease": "cubic-bezier(.2, .7, .2, 1)",
			"panel": "#233026"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|mist",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.7",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|bottle-deep"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.18",
					"letterSpacing": "-0.005em",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.22",
					"letterSpacing": "-0.005em",
					"fontWeight": "400"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "-0.005em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"letterSpacing": "0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|mist"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.06em"
				},
				"border": {
					"radius": "0px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|bottle-deep",
						"text": "var:preset|color|mist"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontSize": "1.25rem",
					"fontWeight": "400",
					"letterSpacing": "0.12em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"textTransform": "uppercase",
					"letterSpacing": "0.14em"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"lineHeight": "1.45"
				},
				"border": {
					"left": {
						"color": "var:preset|color|bottle",
						"width": "2px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:custom|line-strong"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "checkout-header",
			"title": "Checkout header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (sections)",
			"postTypes": [
				"page"
			]
		}
	]
}
