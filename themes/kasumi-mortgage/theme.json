{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "700px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "concrete",
					"name": "Mist paper (ground)",
					"color": "#F3F1EC"
				},
				{
					"slug": "kerb",
					"name": "Stone (panels)",
					"color": "#E6E3DC"
				},
				{
					"slug": "paper",
					"name": "Paper (fields)",
					"color": "#FAF9F6"
				},
				{
					"slug": "ink",
					"name": "Ink (text)",
					"color": "#1F2529"
				},
				{
					"slug": "quiet",
					"name": "Quiet ink (secondary text)",
					"color": "#5A6166"
				},
				{
					"slug": "slate",
					"name": "Deep slate (dark band)",
					"color": "#2E3B43"
				},
				{
					"slug": "sage",
					"name": "Sabi slate blue (links, labels)",
					"color": "#536A77"
				},
				{
					"slug": "sage-light",
					"name": "Pale slate (text on the dark band)",
					"color": "#C6CED3"
				},
				{
					"slug": "amber",
					"name": "Faded brass (small marks only)",
					"color": "#A08A5E"
				},
				{
					"slug": "amber-light",
					"name": "Pale brass (marks on the dark band)",
					"color": "#BFAF8C"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Text (Inter)",
					"fontFamily": "Inter, \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "clamp(1rem, 0.97rem + 0.15vw, 1.0625rem)"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "clamp(1.1875rem, 1.08rem + 0.45vw, 1.4375rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.6rem, 1.3rem + 1.1vw, 2.25rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section title",
					"size": "clamp(2.25rem, 1.6rem + 2.5vw, 3.6rem)"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(2.75rem, 1.5rem + 3.8vw, 4.5rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(4rem, 2.6rem + 5vw, 7.5rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|concrete",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 3.5rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 3.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|sage"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "350",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.04",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400",
					"lineHeight": "1.18"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|concrete"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|slate",
						"text": "var:preset|color|concrete"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "1.5rem",
					"fontWeight": "400",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.06em"
				},
				"color": {
					"text": "var:preset|color|quiet"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.06em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontStyle": "italic",
					"fontSize": "var:preset|font-size|large"
				}
			},
			"core/separator": {
				"color": {
					"text": "color-mix(in srgb, var(--wp--preset--color--ink) 18%, transparent)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (sections only)",
			"postTypes": [
				"page"
			]
		}
	]
}
