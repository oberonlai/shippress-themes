{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1440px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "mist",
     "name": "Mist (alt ground)",
     "color": "#F4F7F9"
    },
    {
     "slug": "ink",
     "name": "Ink (text, 1px rules)",
     "color": "#1F2A30"
    },
    {
     "slug": "steel",
     "name": "Steel blue (primary)",
     "color": "#7FA3B5"
    },
    {
     "slug": "steel-mid",
     "name": "Steel mid",
     "color": "#4F7F99"
    },
    {
     "slug": "deep",
     "name": "Deep blue",
     "color": "#2F4B5C"
    },
    {
     "slug": "sky",
     "name": "Sky",
     "color": "#CFE0E8"
    },
    {
     "slug": "blush",
     "name": "Blush",
     "color": "#F1CFC6"
    }
   ],
   "gradients": [
    {
     "slug": "top-band",
     "name": "Top band",
     "gradient": "linear-gradient(90deg,#7FA3B5 0%,#7FA3B5 45%,#4F7F99 75%,#2F4B5C 100%)"
    },
    {
     "slug": "bottom-band",
     "name": "Bottom band",
     "gradient": "linear-gradient(180deg,#F1CFC6 0%,#E3DCE0 40%,#CFE0E8 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Plus Jakarta Sans)",
     "fontFamily": "\"Plus Jakarta Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Plus Jakarta Sans",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/plus-jakarta-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Noto Sans)",
     "fontFamily": "\"Noto Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.5rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Extra large",
     "size": "2.25rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XX large",
     "size": "3rem",
     "fluid": {
      "min": "2rem",
      "max": "3rem"
     }
    },
    {
     "slug": "xxx-large",
     "name": "Hero",
     "size": "6.25rem",
     "fluid": {
      "min": "2.5rem",
      "max": "6.25rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(5rem, 9.7vw, 8.75rem)"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.9",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0px",
    "right": "0px"
   },
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.25"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xxx-large)",
     "lineHeight": "1"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--deep)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "typography": {
     "fontWeight": "700"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}