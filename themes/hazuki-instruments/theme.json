{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1274px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "band", "name": "Pale band", "color": "#F6F6F6" },
    { "slug": "foot", "name": "Footer ground", "color": "#FAFAFA" },
    { "slug": "ink", "name": "Ink (text)", "color": "#1E2328" },
    { "slug": "muted", "name": "Muted text", "color": "#6B737B" },
    { "slug": "date", "name": "Date grey", "color": "#8C939A" },
    { "slug": "line", "name": "Hairline", "color": "#E3E5E8" },
    { "slug": "main", "name": "Steel (label bar)", "color": "#5C6A78" },
    { "slug": "accent", "name": "Brass (small dot)", "color": "#B0702E" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (IBM Plex Sans)",
     "fontFamily": "\"IBM Plex Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "IBM Plex Sans",
       "fontStyle": "normal",
       "fontWeight": "100 700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/ibm-plex-sans-variable-latin.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "0.9375rem", "fluid": false },
    { "slug": "medium", "name": "Caption", "size": "1.0625rem", "fluid": false },
    { "slug": "large", "name": "Large", "size": "1.5rem", "fluid": false },
    { "slug": "x-large", "name": "Heading", "size": "clamp(1.75rem, 1.2rem + 1.5vw, 2.375rem)", "fluid": false },
    { "slug": "xx-large", "name": "Display", "size": "clamp(2.25rem, 1.4rem + 2.6vw, 3.25rem)", "fluid": false },
    { "slug": "huge", "name": "Statement (maximum 4.5rem)", "size": "clamp(2.6rem, 1.3rem + 4.4vw, 4.5rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vh", "vw", "%" ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "0.9375rem",
   "lineHeight": "1.7",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(20px, 5.3vw, 76px)",
    "right": "clamp(20px, 5.3vw, 76px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.15",
     "letterSpacing": "-0.01em"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.1" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--main)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "0.9375rem", "letterSpacing": "0.05em", "fontWeight": "400" },
    "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } }
   }
  }
 }
}
