{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper white (ground)",
          "color": "#F5F7FB"
        },
        {
          "slug": "ruri",
          "name": "Ruri lapis blue (main colour, large fields)",
          "color": "#1E50A2"
        },
        {
          "slug": "mist",
          "name": "Pale ruri (soft panels)",
          "color": "#E3EAF5"
        },
        {
          "slug": "ink",
          "name": "Night ink (text and footer)",
          "color": "#0F1B33"
        },
        {
          "slug": "deep",
          "name": "Deep ruri (links and labels on light grounds)",
          "color": "#1A4488"
        },
        {
          "slug": "quiet",
          "name": "Slate (secondary text)",
          "color": "#4A5468"
        },
        {
          "slug": "pale",
          "name": "Shell pink (labels on ruri and ink)",
          "color": "#F6D3BE"
        },
        {
          "slug": "field-ink",
          "name": "Paper (type on the ruri field)",
          "color": "#F5F7FB"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (BIZ UDPMincho)",
          "fontFamily": "\"BIZ UDPMincho\", \"Hiragino Mincho ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "BIZ UDPMincho",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/biz-udpmincho-400-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Display, Japanese subset (BIZ UDPMincho JA)",
          "fontFamily": "\"BIZ UDPMincho JA\", \"Hiragino Mincho ProN\", serif",
          "fontFace": [
            {
              "fontFamily": "BIZ UDPMincho JA",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/biz-udpmincho-400-ja.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Display, Traditional Chinese subset (Noto Serif TC)",
          "fontFamily": "\"Noto Serif TC\", \"PingFang TC\", serif",
          "fontFace": [
            {
              "fontFamily": "Noto Serif TC",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Bricolage Grotesque)",
          "fontFamily": "\"Bricolage Grotesque\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bricolage-grotesque-400-latin.woff2"
              ]
            },
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bricolage-grotesque-600-latin.woff2"
              ]
            },
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/bricolage-grotesque-700-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.8",
      "fontWeight": "300"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ruri)",
          "text": "#F5F7FB"
        },
        "border": {
          "radius": "2px"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.04em",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (top bar: the menu split around the centred studio name, Ask for a quote button)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (ink field: house name, synced house details and the menu)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
