{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "mist",
          "name": "Celadon mist (ground)",
          "color": "#EEF3F0"
        },
        {
          "slug": "porcelain",
          "name": "Porcelain (plinths, cards)",
          "color": "#F9FBFA"
        },
        {
          "slug": "seiji-pale",
          "name": "Pale celadon",
          "color": "#D7E7E1"
        },
        {
          "slug": "seiji",
          "name": "Celadon glaze",
          "color": "#A3C9BD"
        },
        {
          "slug": "kiln",
          "name": "Deep kiln teal (links, buttons)",
          "color": "#1E5A56"
        },
        {
          "slug": "clay-pale",
          "name": "Pale clay",
          "color": "#ECE7DF"
        },
        {
          "slug": "clay",
          "name": "Unglazed stoneware",
          "color": "#D8D0C4"
        },
        {
          "slug": "clay-deep",
          "name": "Fired clay (small text)",
          "color": "#6B5F52"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#D3DDD9"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#4D5C59"
        },
        {
          "slug": "ink",
          "name": "Iron-black ink",
          "color": "#182120"
        }
      ],
      "gradients": [
        {
          "slug": "glaze-pool",
          "name": "Glaze pool",
          "gradient": "radial-gradient(120% 90% at 50% 100%, #A3C9BD 0%, #D7E7E1 45%, #EEF3F0 80%)"
        },
        {
          "slug": "morning-gallery",
          "name": "Morning gallery",
          "gradient": "linear-gradient(180deg, #F9FBFA 0%, #EEF3F0 100%)"
        },
        {
          "slug": "kiln-dusk",
          "name": "Kiln dusk",
          "gradient": "linear-gradient(160deg, #1E5A56 0%, #182120 100%)"
        },
        {
          "slug": "clay-wall",
          "name": "Clay wall",
          "gradient": "linear-gradient(180deg, #ECE7DF 0%, #D8D0C4 100%)"
        }
      ],
      "duotone": [
        {
          "slug": "ink-celadon",
          "name": "Ink and celadon",
          "colors": [
            "#182120",
            "#D7E7E1"
          ]
        },
        {
          "slug": "kiln-mist",
          "name": "Kiln and mist",
          "colors": [
            "#1E5A56",
            "#EEF3F0"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "writingMode": false,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Brygada 1918)",
          "fontFamily": "\"Brygada 1918\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Brygada 1918",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/brygada-1918-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Brygada 1918",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/brygada-1918-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Hanken Grotesk)",
          "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.15rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.125rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.375rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.75rem",
          "fluid": {
            "min": "2.375rem",
            "max": "4.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6.5rem",
          "fluid": {
            "min": "3.125rem",
            "max": "8rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Hairline gap",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1.125rem)"
        },
        {
          "slug": "30",
          "name": "Gutter",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Plinth padding",
          "size": "clamp(1.75rem, 1.1rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 5vw, 7.5rem)"
        },
        {
          "slug": "60",
          "name": "Gallery air",
          "size": "clamp(5rem, 3rem + 8vw, 11rem)"
        }
      ]
    },
    "custom": {
      "radius": {
        "plinth": "6px",
        "arch": "999px 999px 6px 6px",
        "pill": "999px"
      },
      "shadow": {
        "plinth": "0 1px 0 rgba(24,33,32,.04), 0 30px 60px -38px rgba(30,90,86,.38)"
      },
      "ease": "cubic-bezier(.22, .61, .21, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|mist",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.68"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|kiln"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.06",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "0.98",
          "letterSpacing": "-0.03em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.1"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.25",
          "letterSpacing": "-0.005em",
          "fontWeight": "500"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.35",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|kiln",
          "text": "var:preset|color|porcelain"
        },
        "border": {
          "radius": "999px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|kiln"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "right": "1.75rem",
            "bottom": "0.95rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.875rem",
          "fontWeight": "600",
          "letterSpacing": "0.06em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|porcelain"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|porcelain"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.8125rem",
          "lineHeight": "1.5",
          "letterSpacing": "0.01em"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.5rem",
          "fontWeight": "400",
          "letterSpacing": "-0.01em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "0.75rem",
          "letterSpacing": "0.04em",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "500",
          "letterSpacing": "0.02em",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.06"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|kiln"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.6"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "400"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|hairline"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontStyle": "italic",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.05"
        }
      },
      "core/image": {
        "border": {
          "radius": "6px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "6px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.24em;text-decoration-thickness:1px;transition:color .3s ease,text-decoration-color .3s ease}::selection{background:var(--wp--preset--color--seiji);color:var(--wp--preset--color--ink)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the shop",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-kilns",
      "title": "The kilns (makers)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-care-guide",
      "title": "Care guide",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (Kiln Letter)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and viewing room",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
