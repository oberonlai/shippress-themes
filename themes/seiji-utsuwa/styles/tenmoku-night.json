{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Tenmoku Night",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "mist",
          "name": "Kiln night (ground)",
          "color": "#141B1A"
        },
        {
          "slug": "porcelain",
          "name": "Night plinth",
          "color": "#1C2524"
        },
        {
          "slug": "seiji-pale",
          "name": "Shadowed celadon",
          "color": "#24322F"
        },
        {
          "slug": "seiji",
          "name": "Celadon glaze",
          "color": "#8FBDB0"
        },
        {
          "slug": "kiln",
          "name": "Moonlit celadon (links, buttons)",
          "color": "#A9D3C7"
        },
        {
          "slug": "clay-pale",
          "name": "Ash",
          "color": "#2A2723"
        },
        {
          "slug": "clay",
          "name": "Fired clay",
          "color": "#4A433B"
        },
        {
          "slug": "clay-deep",
          "name": "Warm ash (small text)",
          "color": "#C2B6A6"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#2F3B39"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#A9B8B4"
        },
        {
          "slug": "ink",
          "name": "Porcelain white (text)",
          "color": "#EEF3F0"
        }
      ],
      "gradients": [
        {
          "slug": "glaze-pool",
          "name": "Glaze pool",
          "gradient": "radial-gradient(120% 90% at 50% 100%, #2E4A44 0%, #1C2524 50%, #141B1A 85%)"
        },
        {
          "slug": "morning-gallery",
          "name": "Night gallery",
          "gradient": "linear-gradient(180deg, #1C2524 0%, #141B1A 100%)"
        },
        {
          "slug": "kiln-dusk",
          "name": "Kiln dusk",
          "gradient": "linear-gradient(160deg, #24322F 0%, #0E1312 100%)"
        },
        {
          "slug": "clay-wall",
          "name": "Ash wall",
          "gradient": "linear-gradient(180deg, #2A2723 0%, #1C2524 100%)"
        }
      ]
    },
    "custom": {
      "shadow": {
        "plinth": "0 1px 0 rgba(0,0,0,.2), 0 30px 60px -34px rgba(0,0,0,.75)"
      }
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|kiln",
          "text": "var:preset|color|mist"
        },
        "border": {
          "color": "var:preset|color|kiln"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|mist"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|mist"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        }
      }
    }
  }
}
