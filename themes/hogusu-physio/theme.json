{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "ink",
          "name": "Deep sea ink (text, dark bands)",
          "color": "#1F3330"
        },
        {
          "slug": "mist",
          "name": "Sea-glass mist (ground)",
          "color": "#EFF3F2"
        },
        {
          "slug": "sage",
          "name": "Sea-glass wash (panels)",
          "color": "#D8E3E1"
        },
        {
          "slug": "teal",
          "name": "Muted deep teal (lines, dots, numerals)",
          "color": "#4F7C76"
        },
        {
          "slug": "teal-deep",
          "name": "Deep teal (small text links)",
          "color": "#355C56"
        },
        {
          "slug": "moss",
          "name": "Slate teal (quiet meta text)",
          "color": "#4A5E5B"
        },
        {
          "slug": "paper",
          "name": "Paper (cards)",
          "color": "#F8FAF9"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Wix Madefor Display)",
          "fontFamily": "\"Wix Madefor Display\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Wix Madefor Display",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/WixMadeforDisplay[wght].ttf"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Wix Madefor Text)",
          "fontFamily": "\"Wix Madefor Text\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Wix Madefor Text",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/WixMadeforText[wght].ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.75rem, 1.45rem + 1.2vw, 2.5rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.375rem, 1.7rem + 2.8vw, 4rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--mist)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.75",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4vw, 3rem)",
        "right": "clamp(1.25rem, 4vw, 3rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.22",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--teal-deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--mist)"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.02em",
          "fontWeight": "500",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (utility strip over the main bar)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (Book a visit band over the clinic details)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
