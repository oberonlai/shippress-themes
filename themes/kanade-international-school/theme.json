{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page (page head in content)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F6F7F4"
    },
    {
     "slug": "stone",
     "name": "Stone",
     "color": "#E9ECE7"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1F2A2E"
    },
    {
     "slug": "accent",
     "name": "Celadon",
     "color": "#7FA393"
    },
    {
     "slug": "deep",
     "name": "Celadon deep",
     "color": "#4F7465"
    },
    {
     "slug": "slate",
     "name": "Slate",
     "color": "#8C9DA8"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#D5DAD4"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5B6662"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ]
  },
  "typography": {
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Literata",
     "fontFamily": "Literata, Georgia, 'Times New Roman', serif",
     "fontFace": [
      {
       "fontFamily": "Literata",
       "fontWeight": "300",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/literata-light-latin.woff2"
       ]
      },
      {
       "fontFamily": "Literata",
       "fontWeight": "400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/literata-regular-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Fira Sans",
     "fontFamily": "'Fira Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
     "fontFace": [
      {
       "fontFamily": "Fira Sans",
       "fontWeight": "400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/firasans-regular-latin.woff2"
       ]
      },
      {
       "fontFamily": "Fira Sans",
       "fontWeight": "500",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/firasans-medium-latin.woff2"
       ]
      },
      {
       "fontFamily": "Fira Sans",
       "fontWeight": "600",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/firasans-semibold-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.0625rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.75rem"
    },
    {
     "slug": "x-large",
     "name": "X-Large",
     "size": "2.75rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-Large",
     "size": "clamp(2.75rem, 5.2vw, 4.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.7"
  },
  "spacing": {
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.15"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--deep)"
    }
   }
  }
 }
}
