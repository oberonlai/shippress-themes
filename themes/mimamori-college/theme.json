{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1100px", "wideSize": "1100px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "White (ground)", "color": "#FFFFFF" },
				{ "slug": "band-cream", "name": "Band cream", "color": "#F6F6EB" },
				{ "slug": "band-blue", "name": "Band blue", "color": "#D6E6F1" },
				{ "slug": "notice", "name": "Notice blush", "color": "#F5DBD2" },
				{ "slug": "footer", "name": "Footer grey", "color": "#F0F0F0" },
				{ "slug": "contrast", "name": "Text", "color": "#333333" },
				{ "slug": "primary", "name": "Link blue", "color": "#014B80" },
				{ "slug": "primary-2", "name": "Link blue 2", "color": "#016FBD" },
				{ "slug": "headline", "name": "Headline blue", "color": "#2C6FB7" },
				{ "slug": "accent", "name": "Accent orange", "color": "#CD491C" },
				{ "slug": "muted", "name": "Muted plum-grey", "color": "#6E5D68" },
				{ "slug": "line", "name": "Hairline", "color": "#C5C5C5" },
				{ "slug": "rule-1", "name": "Rule 1 blue", "color": "#518DE0" },
				{ "slug": "rule-2", "name": "Rule 2 pink", "color": "#F07690" },
				{ "slug": "rule-3", "name": "Rule 3 green", "color": "#7DC21B" },
				{ "slug": "rule-4", "name": "Rule 4 amber", "color": "#EE9A40" },
				{ "slug": "rule-5", "name": "Rule 5 orange", "color": "#EA5504" },
				{ "slug": "title-1", "name": "Title 1", "color": "#2B68BD" },
				{ "slug": "title-2", "name": "Title 2", "color": "#B83C58" },
				{ "slug": "title-3", "name": "Title 3", "color": "#4A7A0C" },
				{ "slug": "title-4", "name": "Title 4", "color": "#A35C0F" },
				{ "slug": "title-5", "name": "Title 5", "color": "#BF4404" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "text",
					"name": "Text (Mulish)",
					"fontFamily": "\"Mulish\", \"Noto Serif TC\", \"Noto Serif JP\", serif",
					"fontFace": [
						{ "fontFamily": "Mulish", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/mulish-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset, headings (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "text-zh",
					"name": "Chinese subset, text (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset, headings (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-ja-400.woff2" ] }
					]
				},
				{
					"slug": "text-ja",
					"name": "Japanese subset, text (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "X-small", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "X-large", "size": "clamp(2rem, 3.06vw, 2.75rem)" },
				{ "slug": "xx-large", "name": "XX-large", "size": "clamp(3rem, 6vw, 4.25rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "16px" },
				{ "slug": "30", "name": "M", "size": "32px" },
				{ "slug": "40", "name": "L", "size": "56px" },
				{ "slug": "50", "name": "XL", "size": "80px" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--text)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "26px", "fontWeight": "400" },
		"spacing": { "blockGap": "20px" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--primary)" } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.4" }, "color": { "text": "var(--wp--preset--color--contrast)" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "300", "lineHeight": "1.6" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.5" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
