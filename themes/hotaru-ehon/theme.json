{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Lilac paper (ground)",
          "color": "#FFF8F6"
        },
        {
          "slug": "imayo",
          "name": "Imayo pink (main colour, large fields)",
          "color": "#D0576B"
        },
        {
          "slug": "mist",
          "name": "Pale imayo (soft panels)",
          "color": "#FBE4E6"
        },
        {
          "slug": "ink",
          "name": "Aubergine ink (text and footer)",
          "color": "#1F0F14"
        },
        {
          "slug": "deep",
          "name": "Deep imayo (links and labels on light grounds)",
          "color": "#9C2E43"
        },
        {
          "slug": "quiet",
          "name": "Plum grey (secondary text)",
          "color": "#5E4248"
        },
        {
          "slug": "pale",
          "name": "Pale petal (labels on ink)",
          "color": "#FFE1E6"
        },
        {
          "slug": "field-ink",
          "name": "Ink (type on the imayo field)",
          "color": "#1F0F14"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Cherry Bomb One)",
          "fontFamily": "\"Cherry Bomb One\", \"Zen Maru Gothic JA\", \"Hiragino Maru Gothic ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Cherry Bomb One",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cherry-bomb-one-400-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Display, Japanese kana subset (Cherry Bomb One JA)",
          "fontFamily": "\"Cherry Bomb One JA\", \"Zen Maru Gothic JA\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Cherry Bomb One JA",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cherry-bomb-one-400-ja.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-ja-kanji",
          "name": "Display, Japanese kanji subset (Zen Maru Gothic JA)",
          "fontFamily": "\"Zen Maru Gothic JA\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Maru Gothic JA",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-maru-gothic-700-ja.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Display, Traditional Chinese subset (Noto Sans TC)",
          "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Noto Sans TC",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Quicksand)",
          "fontFamily": "\"Quicksand\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Quicksand",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Quicksand-VariableFont_wght.ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.8",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--imayo)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "2px"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.04em",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (top bar: the menu split around the centred studio name, Ask for a quote button)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (ink field: house name, synced house details and the menu)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
