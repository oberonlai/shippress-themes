{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1000px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Ground (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "alt",
     "name": "Alt ground",
     "color": "#F3F5F7"
    },
    {
     "slug": "mist",
     "name": "Mist (CTA band)",
     "color": "#DDE4EA"
    },
    {
     "slug": "steel",
     "name": "Nando steel (main)",
     "color": "#465D73"
    },
    {
     "slug": "steel-dark",
     "name": "Steel dark",
     "color": "#34485B"
    },
    {
     "slug": "ink",
     "name": "Text",
     "color": "#1F2A33"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5B6873"
    },
    {
     "slug": "rust",
     "name": "Rust (accent)",
     "color": "#B5541C"
    },
    {
     "slug": "grey",
     "name": "Chip grey",
     "color": "#8C969F"
    },
    {
     "slug": "violet",
     "name": "Chip violet-grey",
     "color": "#6A6385"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#C7D0D8"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Montserrat)",
     "fontFamily": "\"Montserrat\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Montserrat",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/montserrat-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Traditional Chinese (Noto Sans TC subset)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese (Noto Sans JP subset)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Kaku Gothic ProN\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-600-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Chip",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.375rem"
    },
    {
     "slug": "x-large",
     "name": "H3",
     "size": "1.25rem"
    },
    {
     "slug": "xx-large",
     "name": "H2",
     "size": "clamp(2rem, 3.2vw, 2.75rem)"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.5rem, 4.6vw, 4.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "3.75rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.75"
  },
  "spacing": {
   "padding": {
    "left": "var(--kl-gutter, 15px)",
    "right": "var(--kl-gutter, 15px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.2"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "fontWeight": "700",
     "lineHeight": "1.1",
     "letterSpacing": "0.08em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "letterSpacing": "0.01em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "fontWeight": "700",
     "lineHeight": "2",
     "letterSpacing": "0.2em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--steel)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--steel)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "3px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--steel-dark)",
      "text": "#FFFFFF"
     }
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--rule)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}