{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "1000px", "wideSize": "1240px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground", "color": "#FBFAFB" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (bar, borders, letter band)", "color": "#0E0C0F" },
    { "slug": "heading", "name": "Heading", "color": "#2B2730" },
    { "slug": "body", "name": "Body text", "color": "#4B4750" },
    { "slug": "muted", "name": "Muted (meta, sub-labels)", "color": "#8C8790" },
    { "slug": "rule", "name": "Hairline", "color": "#C0BCC3" },
    { "slug": "band", "name": "Lilac-grey band", "color": "#ECE8EE" },
    { "slug": "plum", "name": "Grape grey (main)", "color": "#65586A" },
    { "slug": "accent", "name": "Last-copy red", "color": "#B4473A" },
    { "slug": "on-ink-muted", "name": "Muted on ink", "color": "#B9B3BD" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "\"Newsreader\", \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Literata)",
     "fontFamily": "\"Literata\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Meta (12px)", "size": "0.75rem", "fluid": false },
    { "slug": "small", "name": "Small (14px)", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base (16px)", "size": "1rem", "fluid": false },
    { "slug": "medium", "name": "Lede", "size": "1.125rem", "fluid": false },
    { "slug": "large", "name": "Price", "size": "1.5rem", "fluid": false },
    { "slug": "x-large", "name": "Section head (28px)", "size": "1.75rem", "fluid": false },
    { "slug": "xx-large", "name": "Row title", "size": "clamp(1.75rem, 1rem + 2vw, 2.25rem)", "fluid": false },
    { "slug": "page-title", "name": "Page title", "size": "clamp(2.25rem, 1.2rem + 2.8vw, 3.25rem)", "fluid": false },
    { "slug": "display", "name": "Display (maximum 4.5rem)", "size": "clamp(2.75rem, 1.2rem + 3.9vw, 4.5rem)", "fluid": false }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "vh", "vw", "%" ] }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--body)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "lineHeight": "1.8", "fontWeight": "400" },
  "spacing": {
   "padding": { "left": "clamp(1.25rem, 4vw, 3rem)", "right": "clamp(1.25rem, 4vw, 3rem)" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "0" },
    "color": { "text": "var(--wp--preset--color--heading)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.04", "letterSpacing": "-0.015em" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15" } },
   "h4": { "typography": { "fontSize": "1rem", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700" } },
   "link": { "color": { "text": "var(--wp--preset--color--heading)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "1rem", "fontWeight": "700", "letterSpacing": "0" },
    "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } }
   }
  }
 }
}
