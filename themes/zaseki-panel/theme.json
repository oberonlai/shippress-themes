{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1120px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Cool white (ground)",
     "color": "#F7F7F5"
    },
    {
     "slug": "contrast",
     "name": "Ink (text)",
     "color": "#2A2624"
    },
    {
     "slug": "band",
     "name": "Grey band",
     "color": "#ECEBE8"
    },
    {
     "slug": "strip",
     "name": "Strip grey",
     "color": "#CCCCCC"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#D8D8D8"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5E5652"
    },
    {
     "slug": "accent",
     "name": "Russet (lines, CTA, footer field)",
     "color": "#8C5648"
    },
    {
     "slug": "accent-dark",
     "name": "Russet dark (hover)",
     "color": "#74463A"
    },
    {
     "slug": "clay",
     "name": "Clay (hero panel, notice)",
     "color": "#E9DAD3"
    },
    {
     "slug": "clay-deep",
     "name": "Clay deep (held desk)",
     "color": "#D9B3A4"
    },
    {
     "slug": "tile-clay",
     "name": "Clay tile",
     "color": "#E2C3B6"
    },
    {
     "slug": "sage",
     "name": "Sage (free desk, tile)",
     "color": "#C3D3C6"
    },
    {
     "slug": "stone",
     "name": "Stone (taken desk)",
     "color": "#CFCBC1"
    },
    {
     "slug": "sand",
     "name": "Sand tile",
     "color": "#DDDACB"
    },
    {
     "slug": "stripe-pale",
     "name": "Pale stripe",
     "color": "#F1E4DD"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Outfit)",
     "fontFamily": "\"Outfit\", \"Nunito Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Extra small (labels, legal)",
     "size": "0.75rem"
    },
    {
     "slug": "s",
     "name": "Small (menu, one-liners)",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "Large (section labels, values)",
     "size": "1.125rem"
    },
    {
     "slug": "xl",
     "name": "Tile title",
     "size": "2rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2rem"
     }
    },
    {
     "slug": "2xl",
     "name": "Section headline",
     "size": "2.75rem",
     "fluid": {
      "min": "2rem",
      "max": "2.75rem"
     }
    },
    {
     "slug": "3xl",
     "name": "Inner page title",
     "size": "3.25rem",
     "fluid": {
      "min": "2.25rem",
      "max": "3.25rem"
     }
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.5rem",
     "fluid": {
      "min": "2.75rem",
      "max": "4.5rem"
     }
    },
    {
     "slug": "wordmark",
     "name": "Footer wordmark",
     "size": "6rem",
     "fluid": {
      "min": "3.5rem",
      "max": "6rem"
     }
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.04"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--2xl)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)",
     "fontWeight": "500",
     "lineHeight": "1.2"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "0",
     "width": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "600"
    },
    "spacing": {
     "padding": {
      "top": "0.8125rem",
      "bottom": "0.8125rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--accent-dark)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "letterSpacing": "0.04em",
     "textTransform": "uppercase"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--s)",
     "fontWeight": "600"
    }
   }
  }
 }
}