      "slug": "home",
      "title": "Home",
      "role": "front",
      "content": "<!-- wp:pattern {\"slug\":\"zaseki-panel/front-hero\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-floor\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-hold\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-band\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-box\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-install\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-price\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-pilots\"} /-->\n\n<!-- wp:pattern {\"slug\":\"zaseki-panel/front-questions\"} /-->"
    },
    {
      "slug": "panel",
      "title": "The panel",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">The panel</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">One wall panel per floor, 55 × 38 cm, 14 mm deep and 2.1 kg, with a matte pale face. It shows a floor plan of up to 120 desks in three colours: sage for free, clay for held, stone for taken.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "install",
      "title": "Install",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Install</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Every building install takes one day per floor: a survey two to three weeks before, then the bracket, the desk tags and a 20-minute walk-through for front-desk staff.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "pricing",
      "title": "Pricing",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Pricing</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">The first batch is 300 panels, installed between 6 April and 25 June 2027. A panel is EUR 1,480 and a building install EUR 640, excluding VAT. The deposit is EUR 200 per panel, refundable in full until your build slot is confirmed.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "pre-order",
      "title": "Pre-order",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Pre-order</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Email the pre-order desk at hello@zaseki-panel.example with your building, the number of floors and the desks per floor. We reply within two working days. The desk is open Mon–Fri 09:00–17:30 (CET).</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "pilots",
      "title": "Pilot notes",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Pilot notes</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Three buildings piloted the panel before batch 1: Quayside Works, Lindenhof Commons and Oriel House.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "about",
      "title": "About",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">About</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Zaseki Panel is a small hardware maker founded in 2022 by Mara Lindqvist and Kwame Asante at Ferrow Yard, Unit 4, 18 Canal Street, Norrbridge.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "questions",
      "title": "Questions",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Questions</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Does the panel need Wi-Fi? Yes, to talk to the desk tags and receive floor-plan updates. Can we cancel a pre-order? Yes, the EUR 200 deposit is refundable in full until your build slot is confirmed.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
