    },
    {
      "slug": "newsletter",
      "title": "Waitlist",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Waitlist</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Join the waitlist for batch 2. We send at most one email a month, about build slots and new batches.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "contact",
      "title": "Contact",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Contact</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">Ferrow Yard, Unit 4, 18 Canal Street, Norrbridge. Email hello@zaseki-panel.example, phone +00 44 555 0172. Pre-order desk: Mon–Fri 09:00–17:30 (CET). Workshop visits: Thursdays 14:00–16:00, by appointment.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "privacy",
      "title": "Privacy",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Privacy</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">We use your email address only to reply about your pre-order or waitlist request.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
    {
      "slug": "terms",
      "title": "Terms",
      "content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"zp-sec zp-article\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group zp-sec zp-article\">\n<!-- wp:group {\"className\":\"zp-wrap zp-wrap--c\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group zp-wrap zp-wrap--c\">\n<!-- wp:paragraph {\"className\":\"zp-label\"} -->\n<p class=\"zp-label\">Zaseki Panel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"zp-h2 zp-h2--page\"} -->\n<h1 class=\"wp-block-heading zp-h2 zp-h2--page\">Terms</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"zp-prose\"} -->\n<p class=\"zp-prose\">A deposit of EUR 200 per panel is refundable in full until your build slot is confirmed. The balance is invoiced after the walk-through and payable in 30 days.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
    },
