{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1080px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "greige",
     "name": "Greige (ground, header)",
     "color": "#E6E3E0"
    },
    {
     "slug": "greige-deep",
     "name": "Greige deep (chip box, weekend band)",
     "color": "#D8D3CE"
    },
    {
     "slug": "rule",
     "name": "Rule (hairlines)",
     "color": "#BDB7B1"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#343434"
    },
    {
     "slug": "forest",
     "name": "Forest (footer, newsletter panel)",
     "color": "#222F25"
    },
    {
     "slug": "terracotta",
     "name": "Terracotta (reserve button)",
     "color": "#8B5A44"
    },
    {
     "slug": "tokusa",
     "name": "Tokusa (numerals, focus)",
     "color": "#3B7960"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "muted",
     "name": "Muted (captions, meta)",
     "color": "#6E6A66"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#9E3B2A"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#2F5E4A"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Lora)",
     "fontFamily": "Lora, \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Lora",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/lora-variable.woff2"
       ]
      },
      {
       "fontFamily": "Lora",
       "fontStyle": "italic",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/lora-italic-variable.woff"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Work Sans)",
     "fontFamily": "\"Work Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Work Sans",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/work-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-small",
     "size": ".75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": ".8125rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem"
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "1.75rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "2.75rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "4.25rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "1",
     "size": "8px"
    },
    {
     "slug": "30",
     "name": "2",
     "size": "16px"
    },
    {
     "slug": "40",
     "name": "3",
     "size": "24px"
    },
    {
     "slug": "50",
     "name": "4",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "5",
     "size": "72px"
    },
    {
     "slug": "70",
     "name": "6",
     "size": "120px"
    },
    {
     "slug": "80",
     "name": "7",
     "size": "200px"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--greige)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "2",
   "fontWeight": "300"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.4"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "lineHeight": "1.05",
     "letterSpacing": "-.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.6",
     "letterSpacing": ".06em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "letterSpacing": ".04em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--tokusa)"
     }
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--terracotta)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": ".9375rem",
     "fontWeight": "500",
     "letterSpacing": ".1em",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "18px",
      "bottom": "18px",
      "left": "32px",
      "right": "32px"
     }
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "0"
    }
   },
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   }
  }
 }
}