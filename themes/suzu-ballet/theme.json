{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Page (near white)",
     "color": "#F8F7F5"
    },
    {
     "slug": "tint",
     "name": "Hero tint (greige)",
     "color": "#EDE6E0"
    },
    {
     "slug": "soft",
     "name": "Soft band",
     "color": "#F0EFEB"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "panel",
     "name": "Mauve panel and hairline",
     "color": "#C6B9C1"
    },
    {
     "slug": "main",
     "name": "Grape mouse (button)",
     "color": "#5C4A55"
    },
    {
     "slug": "ink",
     "name": "Text mauve",
     "color": "#5B4652"
    },
    {
     "slug": "deep",
     "name": "Deep text",
     "color": "#393035"
    },
    {
     "slug": "deeper",
     "name": "Deepest",
     "color": "#282125"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Outfit)",
     "fontFamily": "\"Outfit\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-zh",
     "name": "Traditional Chinese (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Outfit\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "heading-ja",
     "name": "Japanese (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Outfit\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small (14px)",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base (16px)",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium (20px)",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large (26px)",
     "size": "1.625rem"
    },
    {
     "slug": "x-large",
     "name": "X-large (56px)",
     "size": "clamp(2.25rem, 4.2vw, 3.5rem)"
    },
    {
     "slug": "xx-large",
     "name": "XX-large (90px)",
     "size": "clamp(2.6rem, 6vw, 5.625rem)"
    },
    {
     "slug": "huge",
     "name": "Huge (120px hero)",
     "size": "clamp(2.75rem, 8.4vw, 7.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vh",
    "vw"
   ],
   "defaultSpacingSizes": false,
   "spacingSizes": [
    {
     "slug": "20",
     "name": "Small",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "Gap",
     "size": "clamp(1.25rem, 3vw, 2.75rem)"
    },
    {
     "slug": "40",
     "name": "Block",
     "size": "clamp(2rem, 4.4vw, 4rem)"
    },
    {
     "slug": "50",
     "name": "Section (120px)",
     "size": "clamp(4rem, 8.3vw, 7.5rem)"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var:preset|color|base",
   "text": "var:preset|color|ink"
  },
  "spacing": {
   "blockGap": "1.25rem",
   "padding": {
    "top": "0px",
    "bottom": "0px",
    "left": "clamp(1.25rem, 4.86vw, 4.375rem)",
    "right": "clamp(1.25rem, 4.86vw, 4.375rem)"
   }
  },
  "typography": {
   "fontFamily": "var:preset|font-family|body",
   "fontSize": "var:preset|font-size|base",
   "fontWeight": "300",
   "lineHeight": "1.6",
   "letterSpacing": "0.02em"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var:preset|color|ink"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "var:preset|color|main"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var:preset|font-family|heading",
     "fontWeight": "200",
     "lineHeight": "1",
     "textTransform": "uppercase",
     "letterSpacing": "0.01em"
    },
    "color": {
     "text": "var:preset|color|ink"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var:preset|font-size|huge",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var:preset|color|deep"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var:preset|font-size|xx-large"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var:preset|font-size|medium",
     "fontFamily": "var:preset|font-family|body",
     "fontWeight": "400",
     "lineHeight": "1.6",
     "textTransform": "none",
     "letterSpacing": "0.02em"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var:preset|font-size|base",
     "fontFamily": "var:preset|font-family|body",
     "fontWeight": "400",
     "textTransform": "none"
    }
   },
   "button": {
    "color": {
     "background": "var:preset|color|main",
     "text": "var:preset|color|white"
    },
    "typography": {
     "fontSize": "var:preset|font-size|small",
     "fontWeight": "400",
     "letterSpacing": "0.04em"
    },
    "border": {
     "radius": "30px"
    },
    "spacing": {
     "padding": {
      "top": "0.7rem",
      "bottom": "0.7rem",
      "left": "1.6rem",
      "right": "1.6rem"
     }
    }
   },
   "caption": {
    "typography": {
     "fontSize": "var:preset|font-size|small"
    }
   }
  },
  "blocks": {
   "core/site-title": {
    "typography": {
     "fontFamily": "var:preset|font-family|heading",
     "fontSize": "1.375rem",
     "fontWeight": "300",
     "textTransform": "uppercase",
     "letterSpacing": "0.32em"
    },
    "elements": {
     "link": {
      "typography": {
       "textDecoration": "none"
      },
      "color": {
       "text": "var:preset|color|deep"
      }
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Full-width page (sections only)",
   "postTypes": [
    "page"
   ]
  }
 ]
}