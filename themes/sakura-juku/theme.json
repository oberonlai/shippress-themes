{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "white",
          "name": "White (the page)",
          "color": "#FFFFFF"
        },
        {
          "slug": "sakura",
          "name": "Sakura pink (cards, stickers and shapes; ink text on it, never small pink text on white)",
          "color": "#F7B7C3"
        },
        {
          "slug": "blue",
          "name": "Clear blue (buttons, links and blue cards; white text on it)",
          "color": "#1E6FD9"
        },
        {
          "slug": "ink",
          "name": "Ink (text)",
          "color": "#1B2A4A"
        },
        {
          "slug": "blush",
          "name": "Blush (pale pink panels)",
          "color": "#FDEEF1"
        },
        {
          "slug": "sky",
          "name": "Sky (pale blue panels)",
          "color": "#EAF2FC"
        },
        {
          "slug": "deep-blue",
          "name": "Deep blue (links and small blue text on blush or sky)",
          "color": "#1556AE"
        },
        {
          "slug": "slate",
          "name": "Slate (quiet text)",
          "color": "#4A5675"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Zen Maru Gothic)",
          "fontFamily": "\"Zen Maru Gothic\", \"Hiragino Maru Gothic ProN\", \"Arial Rounded MT Bold\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Zen Maru Gothic",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-maru-gothic-medium-latin-kana.woff2"
              ]
            },
            {
              "fontFamily": "Zen Maru Gothic",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zen-maru-gothic-bold-latin-kana.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Nunito)",
          "fontFamily": "Nunito, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Nunito",
              "fontStyle": "normal",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/nunito-variable-latin.woff2"
              ]
            },
            {
              "fontFamily": "Nunito",
              "fontStyle": "italic",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/nunito-italic-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.375rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "3.25rem",
          "fluid": {
            "min": "2.375rem",
            "max": "4.25rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "clamp(2rem, 4vw, 3rem)"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "clamp(3rem, 7vw, 5.5rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1rem, 4vw, 2.5rem)",
        "right": "clamp(1rem, 4vw, 2.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--deep-blue)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.25",
          "letterSpacing": "0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.12"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.125rem)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--blue)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "800",
          "fontSize": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)",
          "lineHeight": "1.3"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--deep-blue)",
            "text": "var(--wp--preset--color--white)"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--wp--preset--color--ink)",
            "offset": "3px",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "text": "var(--wp--preset--color--slate)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        }
      },
      "core/navigation": {
        "typography": {
          "fontWeight": "800",
          "fontSize": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--sakura)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full width (bento sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
