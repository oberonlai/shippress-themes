{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1400px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper (ground)",
     "color": "#DDD9DC"
    },
    {
     "slug": "ink",
     "name": "Ink (hero, footer)",
     "color": "#1A1417"
    },
    {
     "slug": "band",
     "name": "Band (reservation)",
     "color": "#211A1E"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6A6166"
    },
    {
     "slug": "on-dark",
     "name": "On dark (headings)",
     "color": "#F4F1F3"
    },
    {
     "slug": "on-dark-body",
     "name": "On dark (body)",
     "color": "#E8E3E6"
    },
    {
     "slug": "plum",
     "name": "Plum (numerals, focus)",
     "color": "#6B5460"
    },
    {
     "slug": "plum-light",
     "name": "Plum light (on dark)",
     "color": "#B9A3AF"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#8E2F3A"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#3F5E4A"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Cormorant\", Garamond, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "italic",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Libre Baskerville)",
     "fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Libre Baskerville",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LibreBaskerville-wght-latin.ttf"
       ]
      },
      {
       "fontFamily": "Libre Baskerville",
       "fontStyle": "italic",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "0.9375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2rem, 1.2rem + 1.9vw, 2.75rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Statement (maximum 4.25rem)",
     "size": "clamp(2.75rem, 1.4rem + 3vw, 4.25rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "0.9375rem",
   "lineHeight": "1.75",
   "fontWeight": "400",
   "letterSpacing": "-0.005em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "clamp(2.375rem, 1.6rem + 2.2vw, 3.25rem)",
     "lineHeight": "1.08"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.5rem",
     "lineHeight": "1.25",
     "letterSpacing": "0"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem",
     "lineHeight": "1.3"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--on-dark)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "400",
     "letterSpacing": "0.01em"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}