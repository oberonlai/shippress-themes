{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "640px", "wideSize": "1370px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "paper", "name": "Paper (page ground)", "color": "#ECE8E8" },
    { "slug": "ink", "name": "Ink (text)", "color": "#3B2B31" },
    { "slug": "plum", "name": "Plum (buttons, dots, spec border)", "color": "#6B5A5E" },
    { "slug": "deep", "name": "Deep (dark band, footer)", "color": "#2B1F24" },
    { "slug": "mist", "name": "Mist (hairlines, muted type on dark)", "color": "#B8AAAE" },
    { "slug": "dust", "name": "Dust (muted type)", "color": "#8E7F84" },
    { "slug": "panel", "name": "Pale panel", "color": "#DAD3D4" },
    { "slug": "surface", "name": "Form surface", "color": "#F6F3F3" },
    { "slug": "rose", "name": "Rose (spot, focus)", "color": "#C98A9A" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Literata)",
     "fontFamily": "\"Literata\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese headings subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese headings subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small (meta)", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Medium (section label)", "size": "1.58rem", "fluid": { "min": "1.3rem", "max": "1.58rem" } },
    { "slug": "large", "name": "Large (names)", "size": "2.1rem", "fluid": { "min": "1.6rem", "max": "2.1rem" } },
    { "slug": "x-large", "name": "Extra large (page title)", "size": "6.5rem", "fluid": { "min": "3rem", "max": "6.5rem" } },
    { "slug": "xx-large", "name": "Intro statement", "size": "4.28rem", "fluid": { "min": "2.4rem", "max": "4.28rem" } },
    { "slug": "wordmark", "name": "Wordmark", "size": "10rem", "fluid": { "min": "4.25rem", "max": "10rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "vh", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2.1875rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "XL", "size": "7rem" },
    { "slug": "70", "name": "Section", "size": "12.5rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.15", "letterSpacing": "-0.005em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "500", "lineHeight": "1.1" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "300" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--plum)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--plum)", "text": "var(--wp--preset--color--paper)" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "500", "textDecoration": "none" },
    "spacing": { "padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1.2rem", "right": "1.2rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--mist)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
