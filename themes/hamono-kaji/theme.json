{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "base",
          "name": "Slate (ground)",
          "color": "#121415"
        },
        {
          "slug": "surface",
          "name": "Forge iron (surface)",
          "color": "#1B1E20"
        },
        {
          "slug": "contrast",
          "name": "Kasumi white (text)",
          "color": "#ECEAE5"
        },
        {
          "slug": "steel",
          "name": "Tamahagane steel (quiet text)",
          "color": "#A3A8AB"
        },
        {
          "slug": "hinoki",
          "name": "Hinoki wood (primary)",
          "color": "#D8B98E"
        },
        {
          "slug": "ember",
          "name": "Ember (one accent, sparingly)",
          "color": "#E0693C"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "slate-steel",
          "name": "Slate and steel",
          "colors": [
            "#121415",
            "#ECEAE5"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Archivo)",
          "fontFamily": "Archivo, \"Arial Narrow\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontStyle": "normal",
              "fontWeight": "400 900",
              "fontStretch": "62% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/archivo-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Instrument Sans)",
          "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/instrument-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (JetBrains Mono)",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jetbrains-mono-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "4rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "7.5rem",
          "fluid": {
            "min": "3.25rem",
            "max": "9rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 10rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--contrast) 14%, transparent)",
      "line-strong": "color-mix(in srgb, var(--wp--preset--color--contrast) 30%, transparent)",
      "footer": {
        "background": "#0C0D0E",
        "text": "#ECEAE5",
        "mute": "#A9AEB1",
        "line": "rgba(236, 234, 229, 0.14)",
        "accent": "#D8B98E",
        "ember": "#E0693C"
      },
      "ease": "cubic-bezier(.19, 1, .22, 1)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|hinoki"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|contrast"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|contrast"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1",
          "letterSpacing": "-0.01em",
          "textTransform": "uppercase"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "800",
          "lineHeight": "0.9",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "800",
          "lineHeight": "0.95",
          "letterSpacing": "-0.015em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.05"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.2"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4",
          "textTransform": "none"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|hinoki",
          "text": "var:preset|color|base"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|hinoki"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1.75rem",
            "bottom": "1rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.75rem",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|contrast",
            "text": "var:preset|color|base"
          },
          "border": {
            "color": "var:preset|color|contrast"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|contrast",
            "text": "var:preset|color|base"
          },
          "border": {
            "color": "var:preset|color|contrast"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|steel"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.02em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.375rem",
          "fontWeight": "800",
          "letterSpacing": "0.02em",
          "lineHeight": "1",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|steel"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.4"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "0.9375rem",
          "fontWeight": "700",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase",
          "lineHeight": "1.1"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1.02",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|steel"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|hinoki"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|steel"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.6"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|steel"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "600",
          "lineHeight": "1.15",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "800",
          "lineHeight": "1",
          "textTransform": "uppercase"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.28em;text-decoration-thickness:1px;transition:color .4s ease}::selection{background:var(--wp--preset--color--hinoki);color:var(--wp--preset--color--base)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full width (sections edge to edge)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
