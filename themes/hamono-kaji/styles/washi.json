{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Washi",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "Washi (ground)",
          "color": "#F2EFE9"
        },
        {
          "slug": "surface",
          "name": "Kozo (surface)",
          "color": "#E7E2D8"
        },
        {
          "slug": "contrast",
          "name": "Charcoal (text)",
          "color": "#17191A"
        },
        {
          "slug": "steel",
          "name": "Steel (quiet text)",
          "color": "#5B6064"
        },
        {
          "slug": "hinoki",
          "name": "Smoked hinoki (primary)",
          "color": "#7A4E24"
        },
        {
          "slug": "ember",
          "name": "Rust (one accent, sparingly)",
          "color": "#A13F1B"
        }
      ],
      "duotone": [
        {
          "slug": "slate-steel",
          "name": "Charcoal and washi",
          "colors": [
            "#17191A",
            "#F2EFE9"
          ]
        }
      ]
    },
    "custom": {
      "footer": {
        "background": "#17191A",
        "text": "#F2EFE9",
        "mute": "#B2B6B8",
        "line": "rgba(242, 239, 233, 0.16)",
        "accent": "#D8B98E",
        "ember": "#E0693C"
      }
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "border": {
          "color": "var:preset|color|contrast"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|hinoki",
            "text": "var:preset|color|base"
          },
          "border": {
            "color": "var:preset|color|hinoki"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|hinoki",
            "text": "var:preset|color|base"
          },
          "border": {
            "color": "var:preset|color|hinoki"
          }
        }
      }
    },
    "css": "a{text-underline-offset:0.28em;text-decoration-thickness:1px;transition:color .4s ease}::selection{background:var(--wp--preset--color--contrast);color:var(--wp--preset--color--base)}"
  }
}
