{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Cool off-white (ground, logo tab)", "color": "#FAF8FA" },
				{ "slug": "plum", "name": "Plum (panels, buttons)", "color": "#5C4A5E" },
				{ "slug": "ink", "name": "Ink (text, footer)", "color": "#2B2530" },
				{ "slug": "secondary", "name": "Dusty plum (numbers, meta)", "color": "#8B7B8D" },
				{ "slug": "pill", "name": "Pale plum (notice pill)", "color": "#F6ECEF" },
				{ "slug": "rule", "name": "Rule on white", "color": "#D9D0D8" },
				{ "slug": "surface", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Heading (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-variable-latin.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Sans 3)",
					"fontFamily": "\"Source Sans 3\", \"Noto Serif TC\", \"Noto Serif JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/source-sans-3-variable-latin.woff2"] }
					]
				},
				{
					"slug": "text-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"] }
					]
				},
				{
					"slug": "text-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-serif-jp-400-ja.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pill, captions", "size": "0.8125rem" },
				{ "slug": "base", "name": "Body", "size": "1.0625rem" },
				{ "slug": "medium", "name": "Panel row", "size": "1.25rem" },
				{ "slug": "large", "name": "Card title", "size": "2rem" },
				{ "slug": "x-large", "name": "Hero title (panel)", "size": "clamp(2.6rem, 3.6vw, 3.25rem)" },
				{ "slug": "xx-large", "name": "Section title", "size": "clamp(2.6rem, 5vw, 4.5rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "2.5rem" },
				{ "slug": "50", "name": "L", "size": "4.5rem" },
				{ "slug": "60", "name": "XL", "size": "7.5rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.75",
			"letterSpacing": "0"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.1", "letterSpacing": "-0.01em" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.08" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--plum)" },
				":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--plum)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "600", "lineHeight": "1.4", "letterSpacing": "0" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "32px", "right": "32px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "1.25rem", "fontWeight": "500", "lineHeight": "1.5" } }
		}
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Page, full width", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
