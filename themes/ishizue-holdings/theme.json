{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1380px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FAFBFB"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0B0D0E"
    },
    {
     "slug": "stone",
     "name": "Stone band",
     "color": "#BEC8CE"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#EDF0F1"
    },
    {
     "slug": "accent",
     "name": "Accent (small areas)",
     "color": "#7D8C94"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#4E5A60"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#D9DCDD"
    },
    {
     "slug": "ink-muted",
     "name": "Muted text on ink",
     "color": "#AEB8BD"
    },
    {
     "slug": "tint-1",
     "name": "Tint 1 Materials",
     "color": "#E3DFD3"
    },
    {
     "slug": "tint-2",
     "name": "Tint 2 Logistics",
     "color": "#D5DEE5"
    },
    {
     "slug": "tint-3",
     "name": "Tint 3 Precision",
     "color": "#E2D6D7"
    },
    {
     "slug": "tint-4",
     "name": "Tint 4 Facilities",
     "color": "#D6E0D5"
    },
    {
     "slug": "tint-5",
     "name": "Tint 5 Food",
     "color": "#D3E1E0"
    },
    {
     "slug": "tint-6",
     "name": "Tint 6 Renewables",
     "color": "#C9D1D5"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Noto Serif)",
     "fontFamily": "\"Noto Serif\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Noto Sans)",
     "fontFamily": "\"Noto Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Meta",
     "size": "0.8125rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem"
    },
    {
     "slug": "card",
     "name": "Card heading",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "marquee",
     "name": "Marquee",
     "size": "1.875rem",
     "fluid": {
      "min": "1.5rem",
      "max": "1.875rem"
     }
    },
    {
     "slug": "large",
     "name": "Section label",
     "size": "2.125rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2.125rem"
     }
    },
    {
     "slug": "x-large",
     "name": "H2 statement",
     "size": "2.5rem",
     "fluid": {
      "min": "1.75rem",
      "max": "2.5rem"
     }
    },
    {
     "slug": "display-s",
     "name": "Inner H1",
     "size": "clamp(2.5rem, 4.6vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "display",
     "name": "Hero H1",
     "size": "clamp(2.5rem, 4.72vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "clamp(2.5rem, 5.6vw, 5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "70",
     "name": "Band",
     "size": "clamp(3.5rem, 6.8vw, 6.125rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.5",
     "letterSpacing": "0.02em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display-s)",
     "lineHeight": "1.15",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--card)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.875rem",
     "fontWeight": "500",
     "letterSpacing": "0.06em",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "1.125rem",
      "bottom": "1.125rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "10px"
    }
   }
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}