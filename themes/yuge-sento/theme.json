{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "640px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "tile",
          "name": "Pale tile (ground)",
          "color": "#EEF2F5"
        },
        {
          "slug": "foam",
          "name": "Foam (lightest surface)",
          "color": "#F7F9FB"
        },
        {
          "slug": "misty",
          "name": "Misty blue (panels)",
          "color": "#C9D6E0"
        },
        {
          "slug": "ink",
          "name": "Blue ink (text)",
          "color": "#22323F"
        },
        {
          "slug": "deep",
          "name": "Deep blue (links, buttons)",
          "color": "#2E5470"
        },
        {
          "slug": "quiet",
          "name": "Quiet slate (secondary text)",
          "color": "#4A5A66"
        },
        {
          "slug": "slate",
          "name": "Slate blue (large display, rules and marks only)",
          "color": "#5F7F96"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Zen Antique Soft)",
          "fontFamily": "\"Zen Antique Soft\", \"Hiragino Mincho ProN\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Zen Antique Soft",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/zenantiquesoft-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Be Vietnam Pro)",
          "fontFamily": "\"Be Vietnam Pro\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Be Vietnam Pro",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/be-vietnam-pro-regular-latin.woff2"
              ]
            },
            {
              "fontFamily": "Be Vietnam Pro",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/be-vietnam-pro-medium-latin.woff2"
              ]
            },
            {
              "fontFamily": "Be Vietnam Pro",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/be-vietnam-pro-semibold-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--tile)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.85",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.35",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--deep)",
          "text": "var(--wp--preset--color--foam)"
        },
        "border": {
          "radius": "2px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "letterSpacing": "0.06em",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Bottom bar (wordmark, menu and today's hours with the Open now chip, docked at the bottom of the screen)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (tiled waterline, a quiet street plan beside the address card)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
