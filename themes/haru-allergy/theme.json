{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "680px", "wideSize": "1280px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Base (page ground)", "color": "#F7F6F3" },
    { "slug": "ink", "name": "Ink (text)", "color": "#242423" },
    { "slug": "band", "name": "Soft band (method band, chips)", "color": "#CBD0D2" },
    { "slug": "slate", "name": "Main slate (buttons, footer, veil)", "color": "#5C656E" },
    { "slug": "slate-band", "name": "Slate band (case notes overlay)", "color": "#757E82" },
    { "slug": "paper", "name": "Paper card", "color": "#E9E8E4" },
    { "slug": "sage", "name": "Pale sage (accent, focus on dark)", "color": "#A5B09A" },
    { "slug": "muted", "name": "Muted text", "color": "#5E6266" },
    { "slug": "white", "name": "White", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Public Sans\", system-ui, sans-serif",
     "fontFace": [
      { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese headings subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese headings subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-500.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Medium (card title)", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "Large (H3)", "size": "2.625rem", "fluid": { "min": "1.875rem", "max": "2.625rem" } },
    { "slug": "x-large", "name": "Extra large (band heading)", "size": "5.125rem", "fluid": { "min": "2.75rem", "max": "5.125rem" } },
    { "slug": "xx-large", "name": "Wordmark", "size": "9rem", "fluid": { "min": "4.5rem", "max": "9rem" } }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.25rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "3rem" },
    { "slug": "60", "name": "XL", "size": "5rem" },
    { "slug": "70", "name": "Section", "size": "10rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "2.2",
   "letterSpacing": "0.04em"
  },
  "spacing": { "blockGap": "1.5rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.5", "letterSpacing": "0.04em" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "400", "lineHeight": "1.6" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "500", "lineHeight": "1.7" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "var(--wp--preset--color--slate)" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--slate)", "text": "#FFFFFF" },
    "border": { "radius": "0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "letterSpacing": "0.08em", "textDecoration": "none" },
    "spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "2rem", "right": "2rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "0" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--band)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
