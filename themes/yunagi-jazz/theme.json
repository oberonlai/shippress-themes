{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": false,
  "layout": {
   "contentSize": "1096px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#ECE9EE"
    },
    {
     "slug": "sheet",
     "name": "Sheet",
     "color": "#FAF9FB"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1B1220"
    },
    {
     "slug": "grey",
     "name": "Heading grey",
     "color": "#6E6872"
    },
    {
     "slug": "giant",
     "name": "Giant grey",
     "color": "#8A8290"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#D9D3DD"
    },
    {
     "slug": "plum",
     "name": "Plum",
     "color": "#460E44"
    },
    {
     "slug": "brass",
     "name": "Brass",
     "color": "#B58B4A"
    },
    {
     "slug": "brass-light",
     "name": "Brass light",
     "color": "#E7D9B8"
    },
    {
     "slug": "on-dark-muted",
     "name": "On-dark muted",
     "color": "#C9BFCC"
    }
   ],
   "gradients": [
    {
     "slug": "dusk",
     "name": "Dusk",
     "gradient": "linear-gradient(to top, rgba(27,18,32,.88) 0%, rgba(27,18,32,0) 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Bodoni Moda)",
     "fontFamily": "\"Bodoni Moda\", \"Didot\", \"Bodoni 72\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Bodoni Moda",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/bodoni-moda-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Bodoni Moda",
       "fontStyle": "italic",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/bodoni-moda-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Karla)",
     "fontFamily": "\"Karla\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Karla",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/karla-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "micro",
     "name": "Micro",
     "size": "0.75rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "X-large",
     "size": "3.5rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "XX-large",
     "size": "clamp(2.75rem, 3.2vw + 1.6rem, 4.5rem)",
     "fluid": false
    },
    {
     "slug": "giant",
     "name": "Giant",
     "size": "clamp(3.5rem, 6vw, 6rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw",
    "vh"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "lineHeight": "1.85",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.2"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.04",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.2",
     "fontWeight": "500"
    },
    "color": {
     "text": "var(--wp--preset--color--grey)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.35",
     "fontWeight": "500"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--sheet)",
     "text": "var(--wp--preset--color--ink)"
    },
    "border": {
     "radius": "6px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
