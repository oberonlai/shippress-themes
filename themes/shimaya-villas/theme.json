{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1140px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Base (page ground, hero panel, header)",
     "color": "#EEF1EC"
    },
    {
     "slug": "band",
     "name": "Band (included band, form panels)",
     "color": "#DDE6DE"
    },
    {
     "slug": "ink",
     "name": "Ink (text, h1, glass base)",
     "color": "#19100D"
    },
    {
     "slug": "body",
     "name": "Body text",
     "color": "#3D3A36"
    },
    {
     "slug": "muted",
     "name": "Muted (captions, eyebrows, dates)",
     "color": "#5C5A55"
    },
    {
     "slug": "nav",
     "name": "Nav link ink",
     "color": "#012531"
    },
    {
     "slug": "dark",
     "name": "Dark (hold band, footer)",
     "color": "#19100D"
    },
    {
     "slug": "accent",
     "name": "Accent (ribbon, Hold dates button; never a section ground)",
     "color": "#2E5646"
    },
    {
     "slug": "tile",
     "name": "Tile (bar tile, numbers on dark; never a section ground)",
     "color": "#A6C8B2"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#C9D3CB"
    },
    {
     "slug": "on-dark",
     "name": "Text on dark",
     "color": "#F4F6F2"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "8px"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "16px"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "24px"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "40px"
    },
    {
     "slug": "60",
     "name": "2XL",
     "size": "80px"
    },
    {
     "slug": "70",
     "name": "3XL",
     "size": "120px"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Manrope)",
     "fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "X-small (eyebrows)",
     "size": "0.6875rem"
    },
    {
     "slug": "small",
     "name": "Small (nav, captions, buttons)",
     "size": "0.875rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Medium (S2 titles)",
     "size": "1.25rem"
    },
    {
     "slug": "large",
     "name": "Large (card and row titles)",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "X-large (statement)",
     "size": "2rem"
    },
    {
     "slug": "xx-large",
     "name": "XX-large (section h2)",
     "size": "2.5rem"
    },
    {
     "slug": "huge",
     "name": "Huge (inner h1, hold h2)",
     "size": "3.5rem"
    },
    {
     "slug": "display",
     "name": "Display (home h1)",
     "size": "clamp(2.75rem, 4.2vw + 1.2rem, 4.5rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "lineHeight": "1.6"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.1",
     "letterSpacing": "-0.03em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.05"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "letterSpacing": "-0.02em"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--accent)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "2px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "500",
     "letterSpacing": "-0.02em"
    },
    "spacing": {
     "padding": {
      "top": "14px",
      "bottom": "14px",
      "left": "20px",
      "right": "20px"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--ink)",
      "text": "#FFFFFF"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/button": {
    "border": {
     "radius": "2px"
    }
   }
  }
 }
}
