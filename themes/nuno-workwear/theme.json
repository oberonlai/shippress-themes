{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F3F2EF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#1F1D1B"
    },
    {
     "slug": "main",
     "name": "Charcoal",
     "color": "#524E4A"
    },
    {
     "slug": "stone",
     "name": "Stone band",
     "color": "#E4E2DD"
    },
    {
     "slug": "accent",
     "name": "Accent",
     "color": "#A9521D"
    },
    {
     "slug": "accent-light",
     "name": "Accent on ink",
     "color": "#E39A62"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Manrope",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/manrope-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "H2",
     "size": "2.875rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Number",
     "size": "4.375rem",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Hero",
     "size": "clamp(4.25rem, 11.5vw, 11rem)",
     "fluid": false
    },
    {
     "slug": "head",
     "name": "Page head",
     "size": "clamp(4.25rem, 8vw, 7.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "60",
     "name": "L",
     "size": "5rem"
    },
    {
     "slug": "80",
     "name": "XL",
     "size": "8rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1rem",
   "lineHeight": "1.875",
   "letterSpacing": "0.01em"
  },
  "spacing": {
   "blockGap": "1.25rem"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.38"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "fontWeight": "500",
     "lineHeight": "1",
     "letterSpacing": "0.005em",
     "textTransform": "uppercase"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "letterSpacing": "0.028em",
     "textTransform": "uppercase"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "2rem",
     "lineHeight": "1.375"
    }
   },
   "button": {
    "border": {
     "radius": "10px"
    },
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--ground)"
    }
   }
  },
  "blocks": {
   "core/paragraph": {
    "typography": {
     "lineHeight": "1.875"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
