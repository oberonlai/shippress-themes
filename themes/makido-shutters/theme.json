{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1334px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#FFFFFF"
				},
				{
					"slug": "band",
					"name": "Pale panel",
					"color": "#EEF1F3"
				},
				{
					"slug": "deep",
					"name": "Lens deep",
					"color": "#18263A"
				},
				{
					"slug": "mid",
					"name": "Lens mid",
					"color": "#46607C"
				},
				{
					"slug": "slate",
					"name": "Main slate",
					"color": "#5A6570"
				},
				{
					"slug": "ink",
					"name": "Ink slate",
					"color": "#232B33"
				},
				{
					"slug": "text",
					"name": "Text",
					"color": "#25292D"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5F676D"
				},
				{
					"slug": "line",
					"name": "Hairline",
					"color": "#C9D0D5"
				},
				{
					"slug": "on-deep",
					"name": "Text on deep",
					"color": "#DDE3E8"
				},
				{
					"slug": "ochre",
					"name": "Safety ochre",
					"color": "#B8862F"
				}
			],
			"gradients": []
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Headings (Schibsted Grotesk)",
					"fontFamily": "\"Schibsted Grotesk\", \"Albert Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Albert Sans)",
					"fontFamily": "\"Albert Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/albert-sans-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-tc",
					"name": "Noto Sans TC (zh-TW)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "600 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "cjk-jp",
					"name": "Noto Sans JP (ja)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-400.woff2"
							]
						},
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "600 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Caps label",
					"size": "0.75rem"
				},
				{
					"slug": "s",
					"name": "Small",
					"size": "0.8125rem"
				},
				{
					"slug": "nav",
					"name": "Navigation",
					"size": "0.9375rem"
				},
				{
					"slug": "m",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "l",
					"name": "Lead",
					"size": "1.125rem"
				},
				{
					"slug": "xl",
					"name": "H3",
					"size": "1.25rem"
				},
				{
					"slug": "2xl",
					"name": "Sub line",
					"size": "1.5rem"
				},
				{
					"slug": "3xl",
					"name": "H2",
					"size": "2.5rem"
				},
				{
					"slug": "4xl",
					"name": "Lens statement",
					"size": "3.5rem"
				},
				{
					"slug": "5xl",
					"name": "Inner title",
					"size": "3.25rem"
				},
				{
					"slug": "display",
					"name": "Hero headline",
					"size": "4.5rem"
				}
			]
		},
		"custom": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontWeight": "400",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--slate)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--slate)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				"border": {
					"radius": "100px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			}
		}
	}
}
