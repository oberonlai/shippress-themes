{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "680px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Base (page ground)",
     "color": "#F8F8F8"
    },
    {
     "slug": "white",
     "name": "White (info bar, chip)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#222222"
    },
    {
     "slug": "navy",
     "name": "Navy (buttons)",
     "color": "#24274A"
    },
    {
     "slug": "band",
     "name": "Blue band (spec only)",
     "color": "#307ADD"
    },
    {
     "slug": "label",
     "name": "Label purple (tags)",
     "color": "#7B5EA7"
    },
    {
     "slug": "scan",
     "name": "Scan cyan (small marks)",
     "color": "#31BAFF"
    },
    {
     "slug": "iron",
     "name": "Blue iron (footer)",
     "color": "#3A4150"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#5C6170"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#E4E5E8"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Albert Sans)",
     "fontFamily": "\"Albert Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Albert Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/albert-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "caption",
     "name": "Caption",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "lead",
     "name": "Lead",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "label",
     "name": "Stage label",
     "size": "1.3125rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large (names)",
     "size": "1.75rem",
     "fluid": {
      "min": "1.375rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Section heading",
     "size": "2.5rem",
     "fluid": {
      "min": "1.875rem",
      "max": "2.5rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Stage heading",
     "size": "3.5rem",
     "fluid": {
      "min": "2rem",
      "max": "3.5rem"
     }
    },
    {
     "slug": "xxx-large",
     "name": "Headline",
     "size": "4.5rem",
     "fluid": {
      "min": "2.375rem",
      "max": "4.5rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "vw",
    "vh",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "5rem"
    },
    {
     "slug": "70",
     "name": "XXL",
     "size": "8.5rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "chip",
     "name": "Chip",
     "shadow": "5px 5px 15px rgba(0,0,0,.25)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.4"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "20px"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--small)",
     "fontWeight": "500"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "20px"
    }
   }
  }
 }
}