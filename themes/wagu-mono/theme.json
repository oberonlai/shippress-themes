{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "660px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "beige",
          "name": "Oak-beige (ground)",
          "color": "#E9E2D6"
        },
        {
          "slug": "paper",
          "name": "Paper (cards, colophon page)",
          "color": "#F4EFE6"
        },
        {
          "slug": "shaving",
          "name": "Shaving (soft panels)",
          "color": "#DDD3C3"
        },
        {
          "slug": "oak",
          "name": "Oak (accent: rules, shapes and large type only)",
          "color": "#A7774A"
        },
        {
          "slug": "oak-deep",
          "name": "Deep oak (links, prices, small accent text)",
          "color": "#7A5230"
        },
        {
          "slug": "walnut",
          "name": "Walnut ink (text, headings, the side rail)",
          "color": "#2B2420"
        },
        {
          "slug": "bark",
          "name": "Bark (dark hover, dark panels)",
          "color": "#3A302A"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Libre Caslon Display)",
          "fontFamily": "\"Libre Caslon Display\", \"Libre Caslon Text\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Libre Caslon Display",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/libre-caslon-display-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "serif",
          "name": "Serif (Libre Caslon Text)",
          "fontFamily": "\"Libre Caslon Text\", Baskerville, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Libre Caslon Text",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/libre-caslon-text-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Libre Caslon Text",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/libre-caslon-text-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Karla)",
          "fontFamily": "Karla, \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Karla",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/karla-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.125rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Chapter title",
          "size": "3.5rem",
          "fluid": {
            "min": "2.375rem",
            "max": "4.25rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6.25rem",
          "fluid": {
            "min": "3rem",
            "max": "7.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.2rem + 4.6vw, 7rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 2.6rem + 7vw, 9.5rem)"
        }
      ]
    },
    "custom": {
      "muted": "#5E5148",
      "line": "color-mix(in srgb, var(--wp--preset--color--walnut) 14%, transparent)",
      "line-strong": "color-mix(in srgb, var(--wp--preset--color--walnut) 32%, transparent)",
      "oak-light": "#D9B48A",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "rail": "15.5rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|beige",
      "text": "var:preset|color|walnut"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|oak-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|walnut"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var:preset|color|walnut"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "0.98"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.04"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|walnut",
          "text": "var:preset|color|beige"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.04em"
        },
        "border": {
          "radius": "2px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|oak-deep",
            "text": "var:preset|color|paper"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small"
        },
        "color": {
          "text": "var:custom|muted"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.75rem",
          "fontWeight": "400",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "inherit"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|walnut"
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500"
        },
        "color": {
          "text": "var:custom|muted"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontStyle": "italic",
          "lineHeight": "1.3"
        },
        "border": {
          "width": "0px",
          "style": "none"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line-strong"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (side rail)",
      "area": "header"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (colophon)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Full-width page (sections)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
