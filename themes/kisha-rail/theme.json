{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1120px",
			"wideSize": "1368px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#F6F7F9"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#2A2F4E"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5E6278"
				},
				{
					"slug": "dark",
					"name": "Dark band",
					"color": "#444863"
				},
				{
					"slug": "accent",
					"name": "Accent (bark)",
					"color": "#8C6450"
				},
				{
					"slug": "accent-dark",
					"name": "Accent dark",
					"color": "#7D5745"
				},
				{
					"slug": "tile",
					"name": "Tile",
					"color": "#EFE6E0"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#D5D8DF"
				}
			],
			"gradients": [
				{
					"slug": "accent",
					"name": "Accent",
					"gradient": "linear-gradient(90deg, #96705C 0%, #7D5745 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Libre Baskerville)",
					"fontFamily": "\"Libre Baskerville\", Baskerville, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Libre Baskerville",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/LibreBaskerville-wght-latin.ttf"
							]
						},
						{
							"fontFamily": "Libre Baskerville",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/LibreBaskerville-Italic-wght-latin.ttf"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Mulish)",
					"fontFamily": "Mulish, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Mulish",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/mulish-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese (Noto Serif TC subset)",
					"fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese (Noto Serif JP subset)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X-small",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.875rem",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "X-large",
					"size": "2.25rem",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "XX-large",
					"size": "3.5rem",
					"fluid": false
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(3.25rem, 6.6vw, 6rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"border": {
			"radius": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.75",
			"letterSpacing": "0.02em",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.35"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "8px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
