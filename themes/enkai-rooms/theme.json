{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1060px",
   "wideSize": "1440px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper (light ground)",
     "color": "#F3F0EE"
    },
    {
     "slug": "pale",
     "name": "Pale band",
     "color": "#ECE7E4"
    },
    {
     "slug": "ink",
     "name": "Ink (text on light)",
     "color": "#1B1411"
    },
    {
     "slug": "dark",
     "name": "Dark (bar, hero, dark sections)",
     "color": "#17100D"
    },
    {
     "slug": "dark-alt",
     "name": "Dark alt row",
     "color": "#261A16"
    },
    {
     "slug": "footer",
     "name": "Footer",
     "color": "#120C0A"
    },
    {
     "slug": "on-dark",
     "name": "On dark (headings)",
     "color": "#F2EEEA"
    },
    {
     "slug": "on-dark-body",
     "name": "On dark (body)",
     "color": "#CCC4BE"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6E625C"
    },
    {
     "slug": "russet",
     "name": "Russet (strip, buttons, numerals)",
     "color": "#6C3524"
    },
    {
     "slug": "gold",
     "name": "Gold (labels on dark)",
     "color": "#BB944E"
    },
    {
     "slug": "gold-deep",
     "name": "Gold on light",
     "color": "#8A6A33"
    },
    {
     "slug": "tag",
     "name": "Paper tag",
     "color": "#F7F4F1"
    },
    {
     "slug": "hair",
     "name": "Hairline",
     "color": "#E2DCD8"
    },
    {
     "slug": "error",
     "name": "Error",
     "color": "#9E2F22"
    },
    {
     "slug": "success",
     "name": "Success",
     "color": "#3E6B47"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Cormorant Garamond)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Cormorant Garamond",
       "fontStyle": "italic",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Cormorant Garamond\", \"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400 500",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Room name",
     "size": "1.75rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2rem, 1.3rem + 1.9vw, 2.625rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Hero (maximum 5rem)",
     "size": "clamp(2.75rem, 1.5rem + 3.3vw, 5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.0625rem",
   "lineHeight": "1.75",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.2",
     "letterSpacing": "0.04em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.05",
     "letterSpacing": "0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.25",
     "letterSpacing": "0.02em"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.25rem",
     "lineHeight": "1.3",
     "letterSpacing": "0.02em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--russet)",
     "text": "var(--wp--preset--color--on-dark)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.875rem",
     "fontWeight": "600",
     "letterSpacing": "0.1em"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}