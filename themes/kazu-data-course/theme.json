{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "680px", "wideSize": "1200px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground", "color": "#F8F8F8" },
    { "slug": "stone", "name": "Stone", "color": "#E8E8E0" },
    { "slug": "ink", "name": "Ink", "color": "#1E1A22" },
    { "slug": "grey", "name": "Grey text", "color": "#5E5863" },
    { "slug": "accent", "name": "Edo purple (accent)", "color": "#6E5A7E" },
    { "slug": "tint", "name": "Accent tint", "color": "#A99BB5" },
    { "slug": "white", "name": "White (cards)", "color": "#FFFFFF" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Lora)",
     "fontFamily": "\"Lora\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      { "fontFamily": "Lora", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-variable.woff2" ] },
      { "fontFamily": "Lora", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-italic-variable.woff" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter)",
     "fontFamily": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-variable-latin.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.875rem" },
    { "slug": "medium", "name": "Body", "size": "1.0625rem" },
    { "slug": "large", "name": "Large", "size": "1.375rem" },
    { "slug": "x-large", "name": "Section heading", "size": "clamp(2.25rem, 4.2vw, 3.5rem)" },
    { "slug": "xx-large", "name": "Page heading", "size": "clamp(2.75rem, 6vw, 5.5rem)" },
    { "slug": "display", "name": "Display", "size": "clamp(3.25rem, 9.5vw, 8.5rem)" }
   ]
  },
  "spacing": { "units": [ "px", "em", "rem", "%", "vw" ] },
  "border": { "radius": true }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.7" },
  "spacing": { "blockGap": "0px", "padding": { "left": "0px", "right": "0px" } },
  "elements": {
   "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.15" }, "color": { "text": "var(--wp--preset--color--ink)" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } } },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent)", "text": "#FFFFFF" },
    "border": { "radius": "999px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "1rem" },
    "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
    ":hover": { "color": { "background": "#5A4868", "text": "#FFFFFF" } }
   }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
