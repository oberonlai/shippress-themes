{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1220px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (page, tab, form surface)",
     "color": "#FFFFFF"
    },
    {
     "slug": "wash",
     "name": "Wash (pale evergreen band)",
     "color": "#E4EEEA"
    },
    {
     "slug": "primary",
     "name": "Moegi evergreen (bars, line art, buttons)",
     "color": "#006E54"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#1B2622"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#4A5652"
    },
    {
     "slug": "accent",
     "name": "Amber (the now tick, small numerals)",
     "color": "#C9962B"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#CFDCD7"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "tag",
     "name": "Tag",
     "size": "0.85rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "0.9375rem"
    },
    {
     "slug": "lede",
     "name": "Lede",
     "size": "1.125rem"
    },
    {
     "slug": "nav",
     "name": "Nav",
     "size": "1.1rem"
    },
    {
     "slug": "sub",
     "name": "Sub title",
     "size": "1.6rem"
    },
    {
     "slug": "section",
     "name": "Section title",
     "size": "2rem"
    },
    {
     "slug": "page-title",
     "name": "Page title",
     "size": "3.25rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "4.5rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "5rem"
    },
    {
     "slug": "50",
     "name": "Section",
     "size": "5rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "0.05em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--primary)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--primary)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "0.9375rem",
     "letterSpacing": "0.08em",
     "textTransform": "uppercase"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "fontWeight": "300",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--section)",
     "textTransform": "uppercase"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--sub)",
     "lineHeight": "1.7"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-bare",
   "title": "Page without title (patterns carry their own heading)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}