{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "1140px", "wideSize": "1140px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Stone ground", "color": "#ECEBEC" },
				{ "slug": "surface", "name": "White (header, cards, info bar)", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink (text, rules, dark buttons)", "color": "#25222B" },
				{ "slug": "band", "name": "Ink band (services, footer)", "color": "#2B2830" },
				{ "slug": "accent", "name": "Muted purple (small marks only)", "color": "#6E6272" },
				{ "slug": "muted", "name": "Muted text", "color": "#5F5A66" },
				{ "slug": "rule", "name": "List rule", "color": "#D6D2D8" },
				{ "slug": "line", "name": "Frame and ruler line", "color": "#9A949F" },
				{ "slug": "dot", "name": "Button dot", "color": "#C9BFCD" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Heading (Instrument Sans)",
					"fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/instrument-sans-variable-latin.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Atkinson Hyperlegible)",
					"fontFamily": "\"AA Digits\", \"Atkinson Hyperlegible\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "AA Digits", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "unicodeRange": "U+0030-0039", "src": ["file:./assets/fonts/instrument-sans-variable-latin.woff2"] }
					]
				},
				{
					"slug": "atkinson",
					"name": "Atkinson Hyperlegible",
					"fontFamily": "\"Atkinson Hyperlegible\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Atkinson Hyperlegible", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-400-latin.woff2"] },
						{ "fontFamily": "Atkinson Hyperlegible", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-700-latin.woff2"] }
					]
				},
				{
					"slug": "text-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"] }
					]
				},
				{
					"slug": "text-ja",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400 500", "fontDisplay": "swap", "src": ["file:./assets/fonts/noto-sans-jp-400-ja.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Eyebrow, captions", "size": "0.875rem" },
				{ "slug": "base", "name": "Body", "size": "1rem" },
				{ "slug": "medium", "name": "Lead", "size": "1.125rem" },
				{ "slug": "medium-large", "name": "Row title", "size": "1.75rem" },
				{ "slug": "large", "name": "Card title", "size": "2rem" },
				{ "slug": "x-large", "name": "Section title", "size": "clamp(2rem, 3.4vw, 3rem)" },
				{ "slug": "xx-large", "name": "Hero heading", "size": "clamp(2rem, 4.7vw, 4.25rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "2.5rem" },
				{ "slug": "50", "name": "L", "size": "5rem" },
				{ "slug": "60", "name": "XL", "size": "7.5rem" }
			]
		},
		"border": { "radius": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.9",
			"letterSpacing": "0"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.25", "letterSpacing": "0" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.2" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--band)", "text": "var(--wp--preset--color--surface)" },
				"border": { "radius": "4px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "400", "lineHeight": "1.4", "letterSpacing": "0" },
				"spacing": { "padding": { "top": "20px", "bottom": "20px", "left": "32px", "right": "32px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "0.9375rem", "fontWeight": "400", "lineHeight": "1.5" } }
		}
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Page, full width", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
