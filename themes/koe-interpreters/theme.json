{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "White (ground)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text, scrim, process band, footer)", "color": "#0C2336" },
    { "slug": "teal", "name": "Teal deep (labels, links)", "color": "#25535D" },
    { "slug": "teal-grey", "name": "Teal grey (page heads, hover)", "color": "#55717D" },
    { "slug": "sage", "name": "Sage stone (gradient middle, rules)", "color": "#B6B38F" },
    { "slug": "amber", "name": "Amber (gradient tail, markers)", "color": "#F0A040" },
    { "slug": "green", "name": "Green (call-to-action pills only)", "color": "#58B193" },
    { "slug": "mint", "name": "Pale mint (arcs, example box)", "color": "#E3F1EE" },
    { "slug": "muted", "name": "Muted text (captions)", "color": "#4A5B66" },
    { "slug": "hairline", "name": "Hairline (table rules)", "color": "#D5DDE0" }
   ],
   "gradients": [
    {
     "slug": "band",
     "name": "Teal to amber band",
     "gradient": "linear-gradient(90deg, #25535D 0%, #55717D 34%, #B6B38F 70%, #F0A040 100%)"
    },
    {
     "slug": "head",
     "name": "Page head band",
     "gradient": "linear-gradient(90deg, #25535D 0%, #55717D 55%, #6E8590 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Newsreader)",
     "fontFamily": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/newsreader-variable-latin.woff2" ]
      },
      {
       "fontFamily": "Newsreader",
       "fontStyle": "italic",
       "fontWeight": "200 800",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/newsreader-italic-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Body", "size": "1.0625rem", "fluid": false },
    { "slug": "medium", "name": "Lead", "size": "1.25rem", "fluid": false },
    { "slug": "large", "name": "Heading 3", "size": "1.75rem", "fluid": false },
    { "slug": "x-large", "name": "Heading 2", "size": "clamp(2.25rem, 3.4vw, 3rem)", "fluid": false },
    { "slug": "xx-large", "name": "Display", "size": "clamp(3rem, 4.4vw, 4.5rem)", "fluid": false },
    { "slug": "huge", "name": "Hero (maximum 6rem)", "size": "clamp(2.75rem, 6.6vw, 6rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "em", "rem", "vh", "vw", "%" ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.65",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.25"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" }
   },
   "h3": {
    "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" }
   },
   "h4": {
    "typography": { "fontSize": "1.125rem" }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--teal)" }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--green)",
     "text": "var(--wp--preset--color--ink)"
    },
    "border": { "radius": "50px" },
    "typography": {
     "fontSize": "0.9375rem",
     "fontWeight": "600",
     "fontFamily": "var(--wp--preset--font-family--body)"
    },
    "spacing": {
     "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
    }
   }
  }
 }
}
