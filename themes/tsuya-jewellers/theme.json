{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1372px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ground", "name": "Ground (page)", "color": "#DFDDE2" },
				{ "slug": "ink", "name": "Ink (text, footer)", "color": "#2A2433" },
				{ "slug": "ink-soft", "name": "Ink, lifted", "color": "#352E40" },
				{ "slug": "pale", "name": "Pale band", "color": "#E9E7EB" },
				{ "slug": "rule", "name": "Rule", "color": "#CFCBD3" },
				{ "slug": "muted", "name": "Muted text", "color": "#5E5866" },
				{ "slug": "accent", "name": "Brass (type on light)", "color": "#785A28" },
				{ "slug": "accent-light", "name": "Brass, light (on ink)", "color": "#C9A56B" },
				{ "slug": "mist", "name": "Mist (text on ink)", "color": "#ECE8EE" },
				{ "slug": "faint", "name": "Faint (small print on ink)", "color": "#A8A1AF" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Instrument Sans)",
					"fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-sans-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Manrope)",
					"fontFamily": "\"Manrope\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "cjk-tc",
					"name": "Traditional Chinese (Noto Sans TC subset)",
					"fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ]
						}
					]
				},
				{
					"slug": "cjk-jp",
					"name": "Japanese (Noto Sans JP subset)",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Base", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium (labels, slogan)", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Extra large (inner page titles)", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "XX large (the one big line)", "size": "4.25rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "svh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Gap", "size": "6px" },
				{ "slug": "30", "name": "Side", "size": "2.125rem" },
				{ "slug": "40", "name": "Section (mobile)", "size": "4.5rem" },
				{ "slug": "50", "name": "Section", "size": "8rem" }
			]
		},
		"border": { "radius": false },
		"shadow": { "defaultPresets": false, "presets": [] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "0",
			"padding": { "left": "0", "right": "0", "top": "0", "bottom": "0" }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "lineHeight": "1.2" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--mist)" },
				"border": { "radius": "0" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } }
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "0" } },
			"core/cover": { "border": { "radius": "0" } }
		}
	}
}
