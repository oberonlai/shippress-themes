{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1312px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "panel",
					"name": "Panel",
					"color": "#F4F4F9"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#2A2D4A"
				},
				{
					"slug": "body",
					"name": "Body",
					"color": "#55576B"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#6A6C80"
				},
				{
					"slug": "lilac",
					"name": "Lilac",
					"color": "#8D93C8"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#D9DAE8"
				},
				{
					"slug": "brass",
					"name": "Brass",
					"color": "#C9A25F"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#B9BCD9"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
							]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-italic-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Lato",
					"fontFamily": "\"Lato\", -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Lato-Regular.ttf"
							]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Lato-Bold.ttf"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Noto Serif TC (zh-TW)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Noto Serif JP (ja)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Label",
					"size": "0.8125rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.5rem"
				},
				{
					"slug": "lead-in",
					"name": "Lead-in",
					"size": "2rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2.25rem"
				},
				{
					"slug": "x-large",
					"name": "X-large",
					"size": "3rem"
				},
				{
					"slug": "xx-large",
					"name": "XX-large",
					"size": "4.25rem"
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "5.25rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw"
			]
		},
		"border": {
			"radius": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.85"
		},
		"spacing": {
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"lineHeight": "1.05",
					"letterSpacing": "0.06em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "0.08em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.25"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "400",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	}
}
