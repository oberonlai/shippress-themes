{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F8F7F3"
    },
    {
     "slug": "card",
     "name": "Card",
     "color": "#FBFAF7"
    },
    {
     "slug": "pale",
     "name": "Pale blue",
     "color": "#D4E7ED"
    },
    {
     "slug": "pale-2",
     "name": "Pale blue light",
     "color": "#EAF4F8"
    },
    {
     "slug": "main",
     "name": "Main blue",
     "color": "#3A75A8"
    },
    {
     "slug": "band",
     "name": "Band blue",
     "color": "#64A0D3"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#3D5062"
    },
    {
     "slug": "mist",
     "name": "Mist",
     "color": "#6C7A89"
    },
    {
     "slug": "accent",
     "name": "Accent green",
     "color": "#86C55C"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#D9DEE3"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Schibsted Grotesk)",
     "fontFamily": "\"Schibsted Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Schibsted Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/schibsted-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Figtree)",
     "fontFamily": "Figtree, \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Figtree",
       "fontStyle": "normal",
       "fontWeight": "300 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/figtree-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-400-zh-tw.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-700-zh-tw.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Label",
     "size": "0.875rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Heading 3",
     "size": "1.45rem"
    },
    {
     "slug": "x-large",
     "name": "Heading 2",
     "size": "clamp(1.9rem, 2.8vw, 2.3rem)"
    },
    {
     "slug": "xx-large",
     "name": "Hero heading",
     "size": "clamp(2.6rem, 5.2vw, 4.25rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.6",
   "fontWeight": "500",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.35",
     "letterSpacing": "0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--main)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.18"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.6",
     "letterSpacing": "0.06em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   }
  }
 }
}
