{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "930px", "wideSize": "1120px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Ground (page)", "color": "#F5F8F1" },
    { "slug": "white", "name": "White (header slab, cards)", "color": "#FFFFFF" },
    { "slug": "mist", "name": "Mist (proof band)", "color": "#E1E9D9" },
    { "slug": "mist-2", "name": "Mist 2 (panels, zebra)", "color": "#E9F1E3" },
    { "slug": "mist-3", "name": "Mist 3 (letter band)", "color": "#D9E9E2" },
    { "slug": "ink", "name": "Ink (text)", "color": "#242424" },
    { "slug": "ink-2", "name": "Ink 2 (subtitles)", "color": "#787878" },
    { "slug": "ink-3", "name": "Ink 3 (meta)", "color": "#5E5E5E" },
    { "slug": "line", "name": "Line (rules)", "color": "#CFD1CD" },
    { "slug": "line-2", "name": "Line 2 (hairlines)", "color": "#E1E3DE" },
    { "slug": "accent", "name": "Accent (discs, markers)", "color": "#00A561" },
    { "slug": "accent-text", "name": "Accent text (labels, links, submit)", "color": "#007A47" },
    { "slug": "patina", "name": "Patina (footer)", "color": "#3F5654" },
    { "slug": "patina-2", "name": "Patina 2 (footer rules)", "color": "#5C7A78" },
    { "slug": "error", "name": "Error (forms)", "color": "#B3261E" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Figtree)",
     "fontFamily": "\"Figtree\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Manrope)",
     "fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-variable-latin.woff2" ] }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset, headings (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-500.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "Labels", "size": "0.8125rem", "fluid": false },
    { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
    { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
    { "slug": "h3", "name": "H3 (pair title)", "size": "1.125rem", "fluid": false },
    { "slug": "medium", "name": "Medium", "size": "1.375rem", "fluid": false },
    { "slug": "large", "name": "H2", "size": "2.25rem", "fluid": false },
    { "slug": "lead", "name": "Lead statement", "size": "2.1875rem", "fluid": false },
    { "slug": "x-large", "name": "Page head H1", "size": "3.25rem", "fluid": false },
    { "slug": "xx-large", "name": "Hero H1", "size": "4.5rem", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "%", "vw", "svh" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.75rem" },
    { "slug": "30", "name": "S", "size": "1.5rem" },
    { "slug": "40", "name": "M", "size": "2.5rem" },
    { "slug": "50", "name": "L", "size": "4.5rem" },
    { "slug": "60", "name": "XL (section gap)", "size": "7.5rem" }
   ]
  },
  "border": { "radius": true, "color": true, "style": true, "width": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "fontWeight": "400",
   "lineHeight": "2"
  },
  "spacing": { "blockGap": "1.25rem", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.5" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "700", "lineHeight": "1.6" } },
   "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "700" } },
   "link": {
    "color": { "text": "var(--wp--preset--color--accent-text)" },
    "typography": { "textDecoration": "underline" },
    ":hover": { "color": { "text": "#00663B" } }
   },
   "button": {
    "color": { "background": "var(--wp--preset--color--accent-text)", "text": "#FFFFFF" },
    "border": { "radius": "4px" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.9375rem", "fontWeight": "600", "textDecoration": "none" },
    "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "2rem", "right": "2rem" } }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "4px" } },
   "core/image": { "border": { "radius": "0" } },
   "core/separator": { "color": { "background": "var(--wp--preset--color--line)" } }
  }
 },
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
