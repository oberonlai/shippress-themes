{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Blush paper (ground)",
					"color": "#FBF6F7"
				},
				{
					"slug": "suou",
					"name": "Suou crimson",
					"color": "#8E354A"
				},
				{
					"slug": "mist",
					"name": "Pale mist pink (soft panels)",
					"color": "#F4E6EA"
				},
				{
					"slug": "ink",
					"name": "Plum ink (text, footer)",
					"color": "#2A1219"
				},
				{
					"slug": "deep",
					"name": "Deep crimson (links and labels on light grounds)",
					"color": "#6E2236"
				},
				{
					"slug": "quiet",
					"name": "Quiet plum grey (secondary text)",
					"color": "#5E474D"
				},
				{
					"slug": "pale",
					"name": "Pale pink (labels on crimson and ink)",
					"color": "#F6CCD6"
				},
				{
					"slug": "field-ink",
					"name": "Text on crimson",
					"color": "#FFFFFF"
				}
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (BIZ UDGothic)",
					"fontFamily": "\"BIZ UDGothic\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "BIZ UDGothic",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/biz-udgothic-700-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (BIZ UDGothic JA)",
					"fontFamily": "\"BIZ UDGothic JA\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "BIZ UDGothic JA",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/biz-udgothic-700-ja.woff2"
							]
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Barlow)",
					"fontFamily": "\"Barlow\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-400-latin.woff2"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-600-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
			"lineHeight": "1.8",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4.5vw, 3.5rem)",
				"right": "clamp(1.25rem, 4.5vw, 3.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.25",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--suou)",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontSize": "0.9375rem",
					"letterSpacing": "0.04em",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (top bar: workshop name, Request a survey button; the menu as a fixed side rail on wide screens)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer (ink field: house name, synced house details and the menu)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (sections, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
