{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "1105px",
   "wideSize": "1290px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Base (paper ground)", "color": "#F5F5F5" },
    { "slug": "white", "name": "White (cards, stay band)", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink (text, hairlines)", "color": "#474143" },
    { "slug": "willow", "name": "Willow (ridge, rules, tags)", "color": "#A1A46D" },
    { "slug": "moss", "name": "Moss (discs, footer, deep willow)", "color": "#6B6F3A" },
    { "slug": "leaf", "name": "Leaf (canopy mid tone)", "color": "#8C9058" },
    { "slug": "gold", "name": "Gold (pills, giant words, focus)", "color": "#C49B38" },
    { "slug": "gold-ink", "name": "Gold ink (text on gold)", "color": "#2B2829" },
    { "slug": "mist", "name": "Mist (help and letter bands)", "color": "#DADDD7" },
    { "slug": "error", "name": "Error", "color": "#9A3B2E" }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Mulish)",
     "fontFamily": "\"Mulish\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Mulish",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/mulish-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset, headings (Noto Serif TC)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset, headings (Noto Serif JP)",
     "fontFamily": "\"Noto Serif JP\", \"Noto Serif CJK JP\", serif",
     "fontFace": [
      { "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-400-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "x-small", "name": "X-small", "size": ".8125rem" },
    { "slug": "small", "name": "Small", "size": ".9375rem" },
    { "slug": "medium", "name": "Medium", "size": "1.0625rem" },
    { "slug": "large", "name": "Large", "size": "1.25rem" },
    { "slug": "x-large", "name": "X-large", "size": "1.625rem" },
    { "slug": "xx-large", "name": "XX-large", "size": "2.625rem" },
    { "slug": "huge", "name": "Huge (hero)", "size": "4.5rem" },
    { "slug": "giant", "name": "Giant (section word)", "size": "6.25rem" }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "em", "vw", "%" ],
   "spacingSizes": [
    { "slug": "20", "name": "1", "size": "10px" },
    { "slug": "30", "name": "2", "size": "20px" },
    { "slug": "40", "name": "3", "size": "40px" },
    { "slug": "50", "name": "4", "size": "75px" },
    { "slug": "60", "name": "5", "size": "100px" },
    { "slug": "70", "name": "6", "size": "140px" },
    { "slug": "80", "name": "7", "size": "200px" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.6",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": { "left": "0", "right": "0" },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1"
    },
    "color": { "text": "var(--wp--preset--color--ink)" }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.1",
     "letterSpacing": ".04em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)",
     "lineHeight": "1.4",
     "fontWeight": "500"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.5",
     "fontWeight": "500",
     "letterSpacing": ".1em"
    }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--moss)" } }
   },
   "button": {
    "border": { "radius": "40px" },
    "color": {
     "background": "var(--wp--preset--color--gold)",
     "text": "var(--wp--preset--color--gold-ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "1rem",
     "fontWeight": "700",
     "letterSpacing": ".05em",
     "lineHeight": "1.2"
    },
    "spacing": {
     "padding": { "top": "15px", "bottom": "15px", "left": "34px", "right": "34px" }
    }
   }
  },
  "blocks": {
   "core/button": { "border": { "radius": "40px" } },
   "core/image": { "border": { "radius": "0" } },
   "core/cover": { "border": { "radius": "0" } }
  }
 }
}
