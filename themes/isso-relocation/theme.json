{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1120px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FFFFFF"
    },
    {
     "slug": "band",
     "name": "Quiet band",
     "color": "#F2F2F2"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#2B2B2B"
    },
    {
     "slug": "footer",
     "name": "Footer",
     "color": "#2D2D2D"
    },
    {
     "slug": "haze",
     "name": "Haze (hero top)",
     "color": "#8A8581"
    },
    {
     "slug": "haze-deep",
     "name": "Haze (hero bottom)",
     "color": "#4A4A50"
    },
    {
     "slug": "label",
     "name": "Label (kuwa-take brown)",
     "color": "#6B5B4E"
    },
    {
     "slug": "navy",
     "name": "Navy accent",
     "color": "#2E4282"
    },
    {
     "slug": "rule",
     "name": "Rule",
     "color": "#DEDEDE"
    },
    {
     "slug": "strip",
     "name": "Light strip",
     "color": "#EBEBEB"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#6A6A6A"
    }
   ],
   "gradients": [
    {
     "slug": "haze",
     "name": "Haze",
     "gradient": "linear-gradient(180deg, #8A8581 0%, #4A4A50 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "heading",
     "name": "Heading (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "sans-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "sans-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Label",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Lead",
     "size": "1.25rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "H3",
     "size": "2rem",
     "fluid": {
      "min": "1.5rem",
      "max": "2rem"
     }
    },
    {
     "slug": "x-large",
     "name": "Page title",
     "size": "4.25rem",
     "fluid": {
      "min": "2.5rem",
      "max": "4.25rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "Display",
     "size": "6rem",
     "fluid": {
      "min": "2.75rem",
      "max": "6rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "7.5rem"
    },
    {
     "slug": "70",
     "name": "Section",
     "size": "clamp(6rem, 11vw, 10rem)"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "1em"
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--navy)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--heading)",
     "fontWeight": "300",
     "lineHeight": "1.1",
     "letterSpacing": "-0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.05",
     "letterSpacing": "-0.02em"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "fontWeight": "500",
     "lineHeight": "1.5",
     "letterSpacing": "0.02em"
    }
   },
   "button": {
    "border": {
     "radius": "0"
    },
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--ground)"
    },
    "typography": {
     "fontSize": "0.875rem",
     "fontWeight": "500"
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/cover": {
    "border": {
     "radius": "0"
    }
   },
   "core/table": {
    "border": {
     "radius": "0"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}