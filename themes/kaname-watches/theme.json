{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1600px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "paper", "name": "Ground", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#000000" },
				{ "slug": "taupe", "name": "Caption taupe", "color": "#A09281" },
				{ "slug": "cream", "name": "Footer cream", "color": "#F9F5EE" },
				{ "slug": "card", "name": "Card grey", "color": "#F4F4F4" },
				{ "slug": "meta", "name": "Meta grey", "color": "#666666" },
				{ "slug": "rule", "name": "Rule grey", "color": "#E0E0E0" },
				{ "slug": "pager", "name": "Pager grey", "color": "#EEEEEE" },
				{ "slug": "kuro", "name": "Kuro-cha", "color": "#4A4036" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Hanken Grotesk)",
					"fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hanken-grotesk-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Onest)",
					"fontFamily": "\"Onest\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/onest-variable-latin.woff2" ]
						}
					]
				},
				{
					"slug": "text-zh",
					"name": "Chinese subset (Noto Sans TC)",
					"fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "text-ja",
					"name": "Japanese subset (Noto Sans JP)",
					"fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
					"fontFace": [
						{ "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Tab", "size": "0.625rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": false },
				{ "slug": "x-large", "name": "Title", "size": "1.875rem", "fluid": false },
				{ "slug": "xx-large", "name": "Chapter", "size": "2.75rem", "fluid": false },
				{ "slug": "huge", "name": "Huge", "size": "clamp(2.75rem, 9vw, 4.25rem)", "fluid": false }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.75",
			"fontWeight": "400",
			"letterSpacing": "0.04em"
		},
		"spacing": {
			"padding": { "left": "0", "right": "0" },
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.4",
					"letterSpacing": "0.13em",
					"textTransform": "uppercase"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "letterSpacing": "0.1em" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "letterSpacing": "0.13em" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--kuro)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--kuro)",
					"text": "#FFFFFF"
				},
				"border": { "radius": "0" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "0.8125rem",
					"letterSpacing": "0.13em",
					"textTransform": "uppercase",
					"fontWeight": "400"
				},
				"spacing": {
					"padding": { "top": "1rem", "bottom": "1rem", "left": "2rem", "right": "2rem" }
				}
			}
		}
	}
}
