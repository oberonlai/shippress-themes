{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": { "contentSize": "720px", "wideSize": "1280px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Base (cool white)", "color": "#F4F6F7" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#1B2327" },
				{ "slug": "band", "name": "Band (deep slate)", "color": "#4A5963" },
				{ "slug": "slate", "name": "Slate (theme colour)", "color": "#5E6E78" },
				{ "slug": "scene", "name": "Scene (near-black)", "color": "#14191C" },
				{ "slug": "tint", "name": "Light tint", "color": "#E3E8EB" },
				{ "slug": "ember", "name": "Ember (tiny accent)", "color": "#C8643C" }
			],
			"gradients": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Source Serif 4\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Body (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-serif-4-variable-latin.woff2" ] },
						{ "fontFamily": "Source Serif 4", "fontStyle": "italic", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-serif-4-italic-variable-latin.woff2" ] }
					]
				},
				{
					"slug": "display-zh",
					"name": "Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif TC", "fontStyle": "normal", "fontWeight": "300 600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2" ] }
					]
				},
				{
					"slug": "display-ja",
					"name": "Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif JP", "fontStyle": "normal", "fontWeight": "300 600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-jp-subset.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small (labels)", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "2rem" },
				{ "slug": "x-large", "name": "X-large", "size": "clamp(2.5rem, 5vw, 4.5rem)" },
				{ "slug": "xx-large", "name": "Section word", "size": "clamp(4.25rem, 6.7vw, 6rem)" },
				{ "slug": "wordmark", "name": "Wordmark", "size": "clamp(4.25rem, 10.4vw, 9.375rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh", "svh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.5rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(3rem, 5.55vw, 5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(5rem, 10vw, 9rem)" },
				{ "slug": "70", "name": "Section", "size": "clamp(7.5rem, 16.7vw, 15rem)" }
			]
		},
		"border": { "radius": true },
		"shadow": { "defaultPresets": false }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7",
			"letterSpacing": "0.02em"
		},
		"spacing": { "blockGap": "1.25rem" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--band)" },
				":hover": { "color": { "text": "var(--wp--preset--color--slate)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.2", "letterSpacing": "0" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.5" } },
			"h3": { "typography": { "fontSize": "1.5rem", "fontWeight": "400", "lineHeight": "1.35" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--band)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"typography": { "fontSize": "1rem", "letterSpacing": "0.04em" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.625rem", "right": "1.625rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--slate)", "text": "var(--wp--preset--color--white)" } }
			}
		},
		"blocks": {
			"core/post-title": { "typography": { "fontWeight": "400" } },
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
