{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1236px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground (page)",
					"color": "#F9F6F2"
				},
				{
					"slug": "ink",
					"name": "Ink (text, rules)",
					"color": "#1A1A1A"
				},
				{
					"slug": "band",
					"name": "Band (oven day, visit, footer)",
					"color": "#E7E5DD"
				},
				{
					"slug": "russet",
					"name": "Russet (outlined line, emblem, links)",
					"color": "#6B4540"
				},
				{
					"slug": "pink",
					"name": "Marker pink (bake-day chips)",
					"color": "#F9D4D8"
				},
				{
					"slug": "mint",
					"name": "Marker mint (daily chips)",
					"color": "#BFEBD9"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5C5752"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Fraunces)",
					"fontFamily": "\"Fraunces\", \"Noto Serif TC\", \"Noto Serif JP\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "outline",
					"name": "Outline (Fraunces Outline)",
					"fontFamily": "\"Fraunces Outline\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces Outline",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-500-outline-latin.woff2"
							],
							"unicodeRange": "U+0020-007E, U+00C0-00FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "Text (Source Serif 4)",
					"fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-italic-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
						}
					]
				},
				{
					"slug": "display-zh",
					"name": "Display, Traditional Chinese subset (Noto Serif TC)",
					"fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif TC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
							]
						}
					]
				},
				{
					"slug": "display-ja",
					"name": "Display, Japanese subset (Noto Serif JP)",
					"fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif JP",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-jp-400-ja.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Tiny (suffix)",
					"size": "0.6875rem"
				},
				{
					"slug": "small",
					"name": "Small (labels)",
					"size": "0.75rem"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.125rem"
				},
				{
					"slug": "medium",
					"name": "Item title",
					"size": "1.5625rem"
				},
				{
					"slug": "large",
					"name": "Section title / price",
					"size": "1.75rem"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(2rem, 1.2rem + 2.3vw, 3rem)"
				},
				{
					"slug": "xx-large",
					"name": "Wordmark",
					"size": "clamp(2.5rem, 4.8vw, 4.25rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "Group",
					"size": "clamp(4rem, 2rem + 4vw, 6.25rem)"
				},
				{
					"slug": "60",
					"name": "Section",
					"size": "clamp(5rem, 2rem + 8vw, 10rem)"
				}
			]
		},
		"border": {
			"radius": false
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|ground",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "400",
			"lineHeight": "1.8",
			"letterSpacing": "0.01em"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|russet"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "0.02em"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.25rem, 1rem + 3.4vw, 3.5rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.24",
					"letterSpacing": "0.04em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var:preset|color|ink"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "currentColor",
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "0.875rem",
					"fontWeight": "500",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "0"
				}
			}
		}
	}
}