{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "660px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "mist",
          "name": "Mist (ground)",
          "color": "#EFF0EA"
        },
        {
          "slug": "washi",
          "name": "Washi (surface)",
          "color": "#F8F8F4"
        },
        {
          "slug": "lichen",
          "name": "Lichen (tint)",
          "color": "#D6DDCD"
        },
        {
          "slug": "sumi",
          "name": "Sumi ink (text)",
          "color": "#1E231F"
        },
        {
          "slug": "stone",
          "name": "Stone (quiet text)",
          "color": "#5A6158"
        },
        {
          "slug": "moss",
          "name": "Moss (primary)",
          "color": "#3F5B3C"
        },
        {
          "slug": "cedar",
          "name": "Cedar bark (accent)",
          "color": "#8A4E2D"
        },
        {
          "slug": "shinrin",
          "name": "Deep forest (dark bands)",
          "color": "#22302A"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "sumi-mist",
          "name": "Sumi and mist",
          "colors": [
            "#1E231F",
            "#EFF0EA"
          ]
        },
        {
          "slug": "moss-mist",
          "name": "Moss and mist",
          "colors": [
            "#22302A",
            "#D6DDCD"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Newsreader)",
          "fontFamily": "Newsreader, \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Newsreader",
              "fontStyle": "italic",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Instrument Sans)",
          "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/instrument-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (DM Mono)",
          "fontFamily": "\"DM Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-mono-400-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-mono-500-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.25rem",
          "fluid": {
            "min": "2.125rem",
            "max": "3.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6rem",
          "fluid": {
            "min": "2.875rem",
            "max": "7rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.6vw, 4rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4rem, 2.4rem + 5vw, 8rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(5rem, 2.8rem + 8vw, 12rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 14%, transparent)",
      "ease": "cubic-bezier(.22, .61, .36, 1)",
      "deepText": "#EFF0EA",
      "deepMute": "#B4BEAC"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|mist",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|moss"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|cedar"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|cedar"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "350",
          "lineHeight": "1.12",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "300",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "300",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|moss",
          "text": "var:preset|color|washi"
        },
        "border": {
          "radius": "999px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|moss"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "right": "1.6rem",
            "bottom": "0.9rem",
            "left": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "letterSpacing": "0.01em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.04em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.375rem",
          "fontWeight": "400",
          "letterSpacing": "-0.005em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "0.6875rem",
          "letterSpacing": "0.08em",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "450",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "350",
          "lineHeight": "1.15"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|moss"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|stone"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "300",
          "lineHeight": "1.35"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "300",
          "lineHeight": "1.2"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.24em;text-decoration-thickness:1px;transition:color .4s ease}::selection{background:var(--wp--preset--color--lichen);color:var(--wp--preset--color--sumi)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the trust",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-projects",
      "title": "Projects",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-volunteer",
      "title": "Volunteer",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-donate",
      "title": "Donate",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-impact",
      "title": "Impact report",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}