{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Yoru no Mori",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "mist",
          "name": "Night forest (ground)",
          "color": "#141A16"
        },
        {
          "slug": "washi",
          "name": "Bark shadow (surface)",
          "color": "#1B231E"
        },
        {
          "slug": "lichen",
          "name": "Deep lichen (tint)",
          "color": "#2C3A30"
        },
        {
          "slug": "sumi",
          "name": "Mist (text)",
          "color": "#E7EAE2"
        },
        {
          "slug": "stone",
          "name": "Fog (quiet text)",
          "color": "#A6AFA2"
        },
        {
          "slug": "moss",
          "name": "Moonlit moss (primary)",
          "color": "#A9C19A"
        },
        {
          "slug": "cedar",
          "name": "Ember cedar (accent)",
          "color": "#D9A27A"
        },
        {
          "slug": "shinrin",
          "name": "Deepest forest (dark bands)",
          "color": "#0C110E"
        }
      ],
      "duotone": [
        {
          "slug": "sumi-mist",
          "name": "Night and mist",
          "colors": [
            "#141A16",
            "#E7EAE2"
          ]
        },
        {
          "slug": "moss-mist",
          "name": "Night and moss",
          "colors": [
            "#0C110E",
            "#A9C19A"
          ]
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 16%, transparent)"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "text": "var:preset|color|mist"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|mist"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|mist"
          }
        }
      }
    }
  }
}