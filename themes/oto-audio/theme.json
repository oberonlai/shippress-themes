{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1320px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "White (ground)",
     "color": "#FFFFFF"
    },
    {
     "slug": "stone",
     "name": "Stone",
     "color": "#F4F3F0"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#16160E"
    },
    {
     "slug": "ink-panel",
     "name": "Ink panel",
     "color": "#2F2F27"
    },
    {
     "slug": "hairline",
     "name": "Hairline",
     "color": "#5D5D58"
    },
    {
     "slug": "rule-ink",
     "name": "Row rule on ink",
     "color": "#3E3A39"
    },
    {
     "slug": "on-ink",
     "name": "Text on ink",
     "color": "#E8E8E7"
    },
    {
     "slug": "meta",
     "name": "Meta",
     "color": "#8B8B87"
    },
    {
     "slug": "desc",
     "name": "Description",
     "color": "#464641"
    },
    {
     "slug": "accent",
     "name": "Accent (kuchiba-iro, small marks only)",
     "color": "#6F5A43"
    },
    {
     "slug": "accent-ink",
     "name": "Accent on ink",
     "color": "#A8917A"
    },
    {
     "slug": "rule",
     "name": "Rule on white",
     "color": "#E2E1DC"
    }
   ],
   "gradients": []
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Newsreader)",
     "fontFamily": "Newsreader, Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Newsreader",
       "fontStyle": "normal",
       "fontWeight": "300 600",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/newsreader-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2190-2193, U+2212, U+2215"
      }
     ]
    },
    {
     "slug": "body",
     "name": "Text (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Segoe UI\", \"Noto Sans\", \"DejaVu Sans\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/public-sans-variable-latin.woff2"
       ],
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD"
      }
     ]
    },
    {
     "slug": "noto-serif-tc",
     "name": "Noto Serif TC (zh-TW)",
     "fontFamily": "\"Noto Serif TC\", \"Noto Serif CJK TC\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-serif-jp",
     "name": "Noto Serif JP (ja)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium (names, nav)",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "clamp(2rem, 1.2rem + 1.9vw, 2.625rem)",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Page title (4.25rem max)",
     "size": "clamp(2.75rem, 1rem + 4.6vw, 4.25rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Home heading (4.75rem max)",
     "size": "clamp(3rem, 1.2rem + 5vw, 4.75rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.125rem",
   "lineHeight": "1.6",
   "fontWeight": "300",
   "letterSpacing": "0.011em"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.4",
     "letterSpacing": "0.05em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.1",
     "letterSpacing": "0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.125rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "21px"
    },
    "typography": {
     "fontSize": "0.9375rem",
     "letterSpacing": "0.05em",
     "fontWeight": "400",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "0.8125rem",
      "bottom": "0.8125rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}
