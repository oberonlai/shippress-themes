{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": { "contentSize": "1080px", "wideSize": "1440px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "base", "name": "Base", "color": "#FFFFFF" },
    { "slug": "panel", "name": "Panel", "color": "#F5F5F3" },
    { "slug": "sky", "name": "Sky", "color": "#F2F7FB" },
    { "slug": "mist", "name": "Mist", "color": "#DCE6EE" },
    { "slug": "text", "name": "Text", "color": "#333333" },
    { "slug": "sub", "name": "Secondary text", "color": "#666666" },
    { "slug": "ink", "name": "Ink (brand)", "color": "#3E4C59" },
    { "slug": "line", "name": "Line", "color": "#E6E7E8" },
    { "slug": "line-panel", "name": "Line on panel", "color": "#DADCD8" },
    { "slug": "tea", "name": "Tea (marker)", "color": "#A8743A" },
    { "slug": "footer-sub", "name": "Footer secondary", "color": "#C9D0D6" },
    { "slug": "error", "name": "Error", "color": "#B3412F" },
    { "slug": "success", "name": "Success", "color": "#2F6B55" }
   ]
  },
  "spacing": { "units": ["px", "em", "rem", "%", "vw", "vh"] },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/hanken-grotesk-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Public Sans)",
     "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Public Sans",
       "fontStyle": "normal",
       "fontWeight": "400 600",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/public-sans-variable-latin.woff2"]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "500",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-500.woff2"]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": ["file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Small", "size": "0.8125rem" },
    { "slug": "medium", "name": "Body", "size": "1rem" },
    { "slug": "large", "name": "Column title", "size": "1.25rem" },
    { "slug": "x-large", "name": "Section title", "size": "1.875rem" },
    { "slug": "xx-large", "name": "Headline", "size": "clamp(2.5rem, 1rem + 4.2vw, 4.25rem)" }
   ]
  },
  "custom": {
   "headlineMax": "4.25rem"
  }
 },
 "styles": {
  "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.8",
   "fontWeight": "400"
  },
  "spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0" } },
  "elements": {
   "heading": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.4" },
    "color": { "text": "var(--wp--preset--color--text)" }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "700", "lineHeight": "1.1" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
   "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
   "button": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--base)" },
    "border": { "radius": "0" },
    "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "letterSpacing": "0.04em" },
    "spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "16px", "right": "16px" } }
   }
  }
 },
 "customTemplates": [
  { "name": "page-inner", "title": "Inner page (with its own head)", "postTypes": ["page"] }
 ],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "header-overlay", "title": "Header over the photograph", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
