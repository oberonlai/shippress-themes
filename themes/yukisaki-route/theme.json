{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "860px",
   "wideSize": "1120px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#FAFAFA"
    },
    {
     "slug": "paper",
     "name": "Panel (white)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Text",
     "color": "#000000"
    },
    {
     "slug": "grey",
     "name": "Eyebrow grey",
     "color": "#808080"
    },
    {
     "slug": "dark",
     "name": "Dark card",
     "color": "#313131"
    },
    {
     "slug": "footer",
     "name": "Footer",
     "color": "#262626"
    },
    {
     "slug": "red",
     "name": "Accent red",
     "color": "#E6172C"
    },
    {
     "slug": "red-dark",
     "name": "Accent hover",
     "color": "#C41325"
    },
    {
     "slug": "iron",
     "name": "Blue iron",
     "color": "#3E5160"
    },
    {
     "slug": "rule",
     "name": "Hairline",
     "color": "#E0E0E0"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Hanken Grotesk)",
     "fontFamily": "\"Hanken Grotesk\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Hanken Grotesk",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "200 1000",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "text-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] },
      { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-600.woff2" ] }
     ]
    },
    {
     "slug": "text-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-400-ja.woff2" ] },
      { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-600-ja.woff2" ] }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Note",
     "size": "0.8125rem"
    },
    {
     "slug": "small",
     "name": "Eyebrow",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "large",
     "name": "Hero sub",
     "size": "1.0625rem"
    },
    {
     "slug": "x-large",
     "name": "H3",
     "size": "1.75rem"
    },
    {
     "slug": "xx-large",
     "name": "H2",
     "size": "1.875rem"
    },
    {
     "slug": "xxx-large",
     "name": "CTA H2",
     "size": "2.25rem"
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "clamp(2.5rem, 4.8vw, 4.25rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "XXL",
     "size": "7.5rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "card",
     "name": "Dossier card",
     "shadow": "0 5px 30px rgba(0,0,0,.08)"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.8"
  },
  "spacing": {
   "padding": {
    "left": "var(--yr-gutter, 20px)",
    "right": "var(--yr-gutter, 20px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.4",
     "letterSpacing": "0.04em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "fontWeight": "500",
     "lineHeight": "1.3",
     "letterSpacing": "0.08em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--red)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--red-dark)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--red)",
     "text": "#FFFFFF"
    },
    "border": {
     "radius": "25px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontSize": "var(--wp--preset--font-size--medium)",
     "fontWeight": "500",
     "lineHeight": "1"
    },
    "spacing": {
     "padding": {
      "top": "1.0625rem",
      "bottom": "1.0625rem",
      "left": "1.75rem",
      "right": "1.375rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--red-dark)",
      "text": "#FFFFFF"
     }
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--rule)"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}