{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "paper",
          "name": "Programme paper (ground)",
          "color": "#FBF1E2"
        },
        {
          "slug": "kincha",
          "name": "Kincha golden amber (main colour, large fields)",
          "color": "#C47222"
        },
        {
          "slug": "sand",
          "name": "Sand (soft panels)",
          "color": "#F6DDB8"
        },
        {
          "slug": "ink",
          "name": "Riso indigo ink (text, hero field)",
          "color": "#121433"
        },
        {
          "slug": "deep",
          "name": "Burnt kincha (links, buttons on paper)",
          "color": "#8A4A10"
        },
        {
          "slug": "glow",
          "name": "Lantern glow (accents on indigo)",
          "color": "#F2B66B"
        },
        {
          "slug": "quiet",
          "name": "Quiet brown (secondary text)",
          "color": "#5A4636"
        }
      ],
      "gradients": []
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Shippori Antique B1)",
          "fontFamily": "\"Shippori Antique B1\", \"Hiragino Sans\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Shippori Antique B1",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/shippori-antique-b1-regular.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Inter Tight)",
          "fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter Tight",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-tight-variable-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
          "fluid": false
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1.25rem, 4.5vw, 3.5rem)",
        "right": "clamp(1.25rem, 4.5vw, 3.5rem)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "0.9375rem",
          "letterSpacing": "0.06em",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (kincha field: hall name centred, centred menu between ink rules, Book seats button)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (indigo field: hall name, synced theatre details and links)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-wide",
      "title": "Wide page (sections, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
