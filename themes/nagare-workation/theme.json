{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "White (value cells, cards, form surface)",
     "color": "#FFFFFF"
    },
    {
     "slug": "ground",
     "name": "Lake mist (page ground)",
     "color": "#EEF3F4"
    },
    {
     "slug": "band",
     "name": "Band (day and booking bands)",
     "color": "#E1EAED"
    },
    {
     "slug": "label",
     "name": "Label cell (price board)",
     "color": "#C9DAE0"
    },
    {
     "slug": "sublabel",
     "name": "Sub-label cell",
     "color": "#DCE7EB"
    },
    {
     "slug": "ink",
     "name": "Ink (text, icon tiles, footer)",
     "color": "#1E2B31"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#4A5A61"
    },
    {
     "slug": "accent",
     "name": "Hana-asagi blue (accent, numerals, Book pill)",
     "color": "#2A83A2"
    },
    {
     "slug": "accent-deep",
     "name": "Accent for small text",
     "color": "#1F6783"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#BFD0D6"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Red Hat Display)",
     "fontFamily": "\"Red Hat Display\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Red Hat Display",
       "fontStyle": "normal",
       "fontWeight": "300 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/redhatdisplay-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Nunito Sans)",
     "fontFamily": "\"Nunito Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Nunito Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/nunitosans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Noto Sans TC (zh-TW)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Noto Sans JP (ja)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-700-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "micro",
     "name": "Micro",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "label",
     "name": "Label",
     "size": "1.0625rem"
    },
    {
     "slug": "body",
     "name": "Body",
     "size": "1.125rem"
    },
    {
     "slug": "caps",
     "name": "Band caps",
     "size": "1.3125rem"
    },
    {
     "slug": "h3",
     "name": "H3",
     "size": "1.5rem"
    },
    {
     "slug": "h2",
     "name": "H2",
     "size": "2.125rem"
    },
    {
     "slug": "h1",
     "name": "Title",
     "size": "clamp(2.6rem, 5vw, 4.5rem)"
    },
    {
     "slug": "numeral",
     "name": "Price numeral",
     "size": "6rem"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1.25rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "5rem"
    },
    {
     "slug": "50",
     "name": "Section",
     "size": "8.75rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--body)",
   "fontWeight": "400",
   "lineHeight": "1.6"
  },
  "spacing": {
   "padding": {
    "left": "0",
    "right": "0"
   },
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "500",
     "lineHeight": "1.4",
     "letterSpacing": "0.01em"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--accent-deep)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "500px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontWeight": "600",
     "fontSize": "1rem",
     "letterSpacing": "0.01em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h1)",
     "fontWeight": "300",
     "lineHeight": "1.05",
     "letterSpacing": "-0.01em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h2)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--h3)",
     "fontWeight": "700",
     "lineHeight": "1.5"
    }
   }
  }
 },
 "customTemplates": [
  {
   "name": "page-bare",
   "title": "Page without title (patterns carry their own heading)",
   "postTypes": [
    "page"
   ]
  }
 ],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}