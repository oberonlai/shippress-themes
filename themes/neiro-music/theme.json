{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "650px",
   "wideSize": "1296px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ink",
     "name": "Ink (ground)",
     "color": "#0D0B06"
    },
    {
     "slug": "ink-2",
     "name": "Lifted ink (panel, footer)",
     "color": "#17140E"
    },
    {
     "slug": "bone",
     "name": "Bone (text and lines)",
     "color": "#D9D7D4"
    },
    {
     "slug": "white",
     "name": "White (headline)",
     "color": "#FFFFFF"
    },
    {
     "slug": "grape",
     "name": "Grape (small areas only)",
     "color": "#705868"
    },
    {
     "slug": "grape-light",
     "name": "Grape hover",
     "color": "#8A7282"
    },
    {
     "slug": "muted",
     "name": "Muted text",
     "color": "#9C9893"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "em",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1.5rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "3rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "5.625rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "9rem"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display and body (Crimson Pro)",
     "fontFamily": "\"Crimson Pro\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Crimson Pro",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/crimsonpro-variable-latin.woff2"
       ]
      },
      {
       "fontFamily": "Crimson Pro",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/crimsonpro-italic-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "label",
     "name": "Labels (Outfit)",
     "fontFamily": "Outfit, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Outfit",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/outfit-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Meta",
     "size": "0.75rem"
    },
    {
     "slug": "small",
     "name": "Nav",
     "size": "0.8rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "medium",
     "name": "Tagline",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Quote",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "Row title",
     "size": "2.8125rem"
    },
    {
     "slug": "xx-large",
     "name": "Page head",
     "size": "4.5rem"
    }
   ]
  },
  "border": {
   "radius": true,
   "color": true,
   "style": true,
   "width": true
  },
  "shadow": {
   "defaultPresets": false,
   "presets": []
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ink)",
   "text": "var(--wp--preset--color--bone)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--display)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2.2",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0"
   }
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.4",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--white)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--bone)"
    },
    "typography": {
     "textDecoration": "underline"
    }
   },
   "button": {
    "color": {
     "background": "transparent",
     "text": "var(--wp--preset--color--bone)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--label)",
     "fontWeight": "400",
     "fontSize": "0.8rem",
     "letterSpacing": "0.08em",
     "textTransform": "uppercase"
    },
    "border": {
     "radius": "0",
     "width": "1px",
     "style": "solid",
     "color": "var(--wp--preset--color--bone)"
    },
    "spacing": {
     "padding": {
      "top": "0.75rem",
      "bottom": "0.75rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    }
   }
  },
  "blocks": {
   "core/image": {
    "border": {
     "radius": "0"
    }
   },
   "core/navigation": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--label)",
     "fontWeight": "400",
     "fontSize": "0.8rem",
     "letterSpacing": "0.08em",
     "textTransform": "uppercase"
    }
   }
  }
 }
}