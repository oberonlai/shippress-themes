{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "660px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "blush",
					"name": "Washi (page)",
					"color": "#F4EFE3"
				},
				{
					"slug": "petal",
					"name": "Kinari (panels, cells)",
					"color": "#EAE2D0"
				},
				{
					"slug": "seam",
					"name": "Fibre (hairlines)",
					"color": "#D3C7AD"
				},
				{
					"slug": "muted",
					"name": "Nezumi (secondary text)",
					"color": "#57524A"
				},
				{
					"slug": "ink",
					"name": "Sumi (text, buttons)",
					"color": "#1C1C1C"
				},
				{
					"slug": "mauve",
					"name": "Shu vermilion (seal, numerals, marks)",
					"color": "#EB6101"
				},
				{
					"slug": "mauve-deep",
					"name": "Edo murasaki (opening field, letter band, links, labels)",
					"color": "#745399"
				},
				{
					"slug": "ai",
					"name": "Ai indigo (hero and fit bands)",
					"color": "#165E83"
				},
				{
					"slug": "matcha",
					"name": "Matcha (shapes band)",
					"color": "#C5C56A"
				},
				{
					"slug": "gofun",
					"name": "Gofun white (text on indigo and sumi)",
					"color": "#FBF8F1"
				},
				{
					"slug": "shikon",
					"name": "Shikon (footer)",
					"color": "#2B1E3A"
				}
			],
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Display (Kaisei Opti)",
					"fontFamily": "\"Kaisei Opti\", \"Hiragino Mincho ProN\", \"Yu Mincho\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Kaisei Opti",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/KaiseiOpti-Regular.woff2"
							]
						},
						{
							"fontFamily": "Kaisei Opti",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/KaiseiOpti-Bold.woff2"
							]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Text (M PLUS 2)",
					"fontFamily": "\"M PLUS 2\", \"Hiragino Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "M PLUS 2",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/MPLUS2-wght.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.8125rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "clamp(1.0625rem, 1rem + 0.2vw, 1.125rem)"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "clamp(1.2rem, 1.08rem + 0.45vw, 1.5rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "clamp(1.75rem, 1.4rem + 1.3vw, 2.6rem)"
				},
				{
					"slug": "xx-large",
					"name": "Section title",
					"size": "clamp(2.4rem, 1.7rem + 2.9vw, 4.4rem)"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(3rem, 1.8rem + 5vw, 6.6rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "Gap",
					"size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
				},
				{
					"slug": "40",
					"name": "Block",
					"size": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)"
				},
				{
					"slug": "50",
					"name": "Section",
					"size": "clamp(3.5rem, 2.2rem + 4.6vw, 6.5rem)"
				},
				{
					"slug": "60",
					"name": "Large section",
					"size": "clamp(4.5rem, 2.6rem + 7vw, 9rem)"
				}
			]
		},
		"custom": {
			"line": "color-mix(in srgb, var(--wp--preset--color--ink) 12%, transparent)",
			"line-strong": "color-mix(in srgb, var(--wp--preset--color--ink) 28%, transparent)",
			"muted": "var(--wp--preset--color--muted)",
			"on-dark": "#FBF8F1",
			"on-dark-muted": "#BFD6E2",
			"ease": "cubic-bezier(.2, .7, .2, 1)",
			"panel": "#165E83"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|blush",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.8",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|mauve-deep"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.12",
					"letterSpacing": "0",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.18",
					"letterSpacing": "0",
					"fontWeight": "400"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400",
					"lineHeight": "1.3",
					"letterSpacing": "0"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"letterSpacing": "0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|blush"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.08em"
				},
				"border": {
					"radius": "0px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|mauve",
						"text": "var:preset|color|ink"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontSize": "1.25rem",
					"fontWeight": "700",
					"letterSpacing": "0.08em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var:preset|color|ink"
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"textTransform": "uppercase",
					"letterSpacing": "0.14em"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"lineHeight": "1.45"
				},
				"border": {
					"left": {
						"color": "var:preset|color|mauve",
						"width": "2px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:custom|line-strong"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "checkout-header",
			"title": "Checkout header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (sections)",
			"postTypes": [
				"page"
			]
		}
	]
}
