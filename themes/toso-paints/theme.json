{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "ground",
     "name": "Moss ink (ground)",
     "color": "#1A211C"
    },
    {
     "slug": "raised",
     "name": "Raised panel",
     "color": "#232B25"
    },
    {
     "slug": "moss",
     "name": "Moss (brand)",
     "color": "#3A4A3E"
    },
    {
     "slug": "pale",
     "name": "Pale cool ground",
     "color": "#E8ECE8"
    },
    {
     "slug": "text",
     "name": "Chalk (text on dark)",
     "color": "#F2F4F0"
    },
    {
     "slug": "brass",
     "name": "Lamp brass (accent)",
     "color": "#D9A66A"
    }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Onest)",
     "fontFamily": "\"Onest\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.375rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Statement",
     "size": "clamp(2.25rem, 4.45vw, 4rem)",
     "fluid": false
    },
    {
     "slug": "huge",
     "name": "Chapter word (maximum 5rem)",
     "size": "clamp(3rem, 5.6vw, 5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.8",
   "fontWeight": "400"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 2.8vw, 2.5rem)",
    "right": "clamp(1.25rem, 2.8vw, 2.5rem)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.3",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--text)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--text)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--text)",
     "text": "var(--wp--preset--color--ground)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.875rem",
     "letterSpacing": "0.04em",
     "fontWeight": "400"
    },
    "spacing": {
     "padding": {
      "top": "0.95rem",
      "bottom": "0.95rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}