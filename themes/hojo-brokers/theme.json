{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "860px", "wideSize": "1120px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#F4F6F8" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "mist", "name": "Mist", "color": "#E4E9EE" },
        { "slug": "ink", "name": "Deep ink", "color": "#243241" },
        { "slug": "muted", "name": "Muted ink", "color": "#4A5767" },
        { "slug": "primary", "name": "Slate", "color": "#5E6C7B" },
        { "slug": "primary-light", "name": "Light slate", "color": "#8D9AA8" },
        { "slug": "idle-tab", "name": "Idle tab", "color": "#C9D2DB" },
        { "slug": "rule", "name": "Rule", "color": "#D5DBE1" },
        { "slug": "accent", "name": "Ochre", "color": "#D8A93E" },
        { "slug": "accent-edge", "name": "Ochre edge", "color": "#A9802A" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Headings (Inter Tight)",
          "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-tight-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Public Sans)",
          "fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Public Sans", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/public-sans-variable-latin.woff2" ] }
          ]
        },
        {
          "slug": "display-zh",
          "name": "Noto Sans TC (zh-TW)",
          "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans TC", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2" ] }
          ]
        },
        {
          "slug": "display-ja",
          "name": "Noto Sans JP (ja)",
          "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
          "fontFace": [
            { "fontFamily": "Noto Sans JP", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-sans-jp-ja-400.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.75rem" },
        { "slug": "s", "name": "S", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1rem" },
        { "slug": "m", "name": "Lead", "size": "1.0625rem" },
        { "slug": "l", "name": "Statement", "size": "1.5rem" },
        { "slug": "xl", "name": "XL", "size": "2.25rem" },
        { "slug": "xxl", "name": "H2", "size": "2.5rem" },
        { "slug": "numeral", "name": "Numeral", "size": "5rem" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.75rem, 4.75vw, 4.5rem)" },
        { "slug": "display", "name": "Largest", "size": "4.5rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "12px" },
        { "slug": "20", "name": "S", "size": "20px" },
        { "slug": "30", "name": "M", "size": "32px" },
        { "slug": "40", "name": "L", "size": "64px" },
        { "slug": "50", "name": "XL", "size": "96px" }
      ]
    },
    "custom": { "radius": "4px", "radiusButton": "5px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.75" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.2" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)", "lineHeight": "1.15", "letterSpacing": "-0.01em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--l)", "fontWeight": "600", "lineHeight": "1.3" } }
    },
    "spacing": { "blockGap": "20px" },
    "blocks": {
      "core/button": { "border": { "radius": "5px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
