{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "780px",
   "wideSize": "1250px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "pale",
     "name": "Pale ground",
     "color": "#EEF1EE"
    },
    {
     "slug": "paper",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "charcoal",
     "name": "Warm charcoal (ground, nav, text)",
     "color": "#3C3939"
    },
    {
     "slug": "copper",
     "name": "Copper (strip, button, current dot)",
     "color": "#A0522A"
    },
    {
     "slug": "caramel",
     "name": "Caramel (strip)",
     "color": "#C88C5A"
    },
    {
     "slug": "patina",
     "name": "Patina (rules, focus)",
     "color": "#47885E"
    },
    {
     "slug": "light",
     "name": "Light text",
     "color": "#F3EDE6"
    },
    {
     "slug": "grey",
     "name": "Mid grey (underline, dots)",
     "color": "#9A9696"
    },
    {
     "slug": "rule",
     "name": "Rule on light",
     "color": "#C9CFC9"
    },
    {
     "slug": "ember",
     "name": "Link on dark",
     "color": "#E08A5A"
    },
    {
     "slug": "ink",
     "name": "Ink (text on caramel)",
     "color": "#2A2727"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": {
    "minViewportWidth": "390px",
    "maxViewportWidth": "1440px"
   },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (DM Serif Display)",
     "fontFamily": "\"DM Serif Display\", \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "DM Serif Display",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dm-serif-display-latin.woff2"
       ]
      },
      {
       "fontFamily": "DM Serif Display",
       "fontStyle": "italic",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/dm-serif-display-italic-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-zh",
     "name": "Display, Traditional Chinese (Noto Serif TC subset)",
     "fontFamily": "\"Noto Serif TC\", \"Songti TC\", \"PMingLiU\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "display-ja",
     "name": "Display, Japanese (Noto Serif JP subset)",
     "fontFamily": "\"Noto Serif JP\", \"Hiragino Mincho ProN\", \"Yu Mincho\", serif",
     "fontFace": [
      {
       "fontFamily": "Noto Serif JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-serif-jp-400-ja.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Work Sans)",
     "fontFamily": "\"Work Sans\", system-ui, \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Work Sans",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/work-sans-variable-latin.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "x-small",
     "name": "Caps label",
     "size": "0.78rem",
     "fluid": false
    },
    {
     "slug": "small",
     "name": "Nav caps",
     "size": "0.95rem",
     "fluid": false
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "1.125rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.5rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.25rem",
     "fluid": false
    },
    {
     "slug": "x-large",
     "name": "Heading",
     "size": "3rem",
     "fluid": false
    },
    {
     "slug": "xx-large",
     "name": "Display (maximum 4.5rem)",
     "size": "clamp(2.6rem, 1.2rem + 4.8vw, 4.5rem)",
     "fluid": false
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "vh",
    "vw",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "1.25rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "3.5rem"
    },
    {
     "slug": "60",
     "name": "Section",
     "size": "6rem"
    }
   ]
  },
  "border": {
   "radius": false
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--pale)",
   "text": "var(--wp--preset--color--charcoal)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "1.125rem",
   "lineHeight": "1.8",
   "fontWeight": "400",
   "letterSpacing": "0.02em"
  },
  "spacing": {
   "padding": {
    "left": "clamp(1.25rem, 6.6vw, 95px)",
    "right": "clamp(1.25rem, 6.6vw, 95px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1",
     "letterSpacing": "0"
    },
    "color": {
     "text": "var(--wp--preset--color--charcoal)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "clamp(2rem, 1.3rem + 2vw, 3rem)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "1.75rem"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "1.25rem"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--copper)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--copper)",
     "text": "var(--wp--preset--color--light)"
    },
    "border": {
     "radius": "0"
    },
    "typography": {
     "fontSize": "0.85rem",
     "letterSpacing": "0.12em",
     "fontWeight": "500",
     "textTransform": "uppercase"
    },
    "spacing": {
     "padding": {
      "top": "0.8rem",
      "bottom": "0.8rem",
      "left": "1.75rem",
      "right": "1.75rem"
     }
    }
   }
  }
 }
}