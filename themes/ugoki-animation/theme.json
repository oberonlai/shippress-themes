{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "712px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F6F8F7"
				},
				{
					"slug": "window",
					"name": "Window",
					"color": "#232A2B"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#383D3E"
				},
				{
					"slug": "window-text",
					"name": "Window text",
					"color": "#D6DCDB"
				},
				{
					"slug": "window-muted",
					"name": "Window muted",
					"color": "#8E9A9B"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5C6B6E"
				},
				{
					"slug": "light-table",
					"name": "Light table",
					"color": "#A2D7DD"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#CDD3D3"
				},
				{
					"slug": "signal",
					"name": "Signal",
					"color": "#A93432"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Syne",
					"fontFamily": "\"Syne\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Syne",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/syne-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "\"Manrope\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-variable-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "noto-sans-tc",
					"name": "Noto Sans TC",
					"fontFamily": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans TC",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
							],
							"unicodeRange": "U+2E80-9FFF, U+F900-FAFF, U+FE30-FE4F, U+FF00-FFEF, U+3000-303F"
						}
					]
				},
				{
					"slug": "noto-sans-jp",
					"name": "Noto Sans JP",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans JP",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-jp-ja-700.woff2"
							],
							"unicodeRange": "U+2E80-9FFF, U+F900-FAFF, U+FE30-FE4F, U+FF00-FFEF, U+3000-303F"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X-small",
					"size": "0.6875rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "credit",
					"name": "Credit",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "1.1875rem"
				},
				{
					"slug": "title",
					"name": "Title",
					"size": "1.25rem"
				},
				{
					"slug": "x-large",
					"name": "Section",
					"size": "1.75rem"
				},
				{
					"slug": "xx-large",
					"name": "Hero",
					"size": "2.25rem"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.25rem"
				}
			],
			"defaultFontSizes": false
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "12px"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "24px"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "44px"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "80px"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "120px"
				}
			],
			"defaultSpacingSizes": false
		},
		"border": {
			"radius": true
		},
		"custom": {
			"radius": {
				"image": "4px",
				"pill": "28px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85",
			"letterSpacing": "0.01em"
		},
		"spacing": {
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--signal)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.4"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--title)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--window)",
					"text": "var(--wp--preset--color--paper)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--credit)",
					"fontWeight": "700",
					"letterSpacing": "0.2em",
					"textTransform": "uppercase",
					"textDecoration": "none"
				},
				"border": {
					"radius": "28px"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "4px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"textDecoration": "none"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}