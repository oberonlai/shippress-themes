{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Cedar Night",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "rice",
          "name": "Cedar night (ground)",
          "color": "#1C1714"
        },
        {
          "slug": "paper",
          "name": "Night label",
          "color": "#26201B"
        },
        {
          "slug": "koji",
          "name": "Lamplit cedar",
          "color": "#33291F"
        },
        {
          "slug": "lees-pale",
          "name": "Shadowed lees",
          "color": "#2B2723"
        },
        {
          "slug": "lees",
          "name": "Lees grey",
          "color": "#4A443D"
        },
        {
          "slug": "gold-light",
          "name": "Candle gilt",
          "color": "#E3C98F"
        },
        {
          "slug": "gold",
          "name": "Gilded gold",
          "color": "#C9A462"
        },
        {
          "slug": "gold-deep",
          "name": "Bright gilt (links, italic voice)",
          "color": "#DDBF83"
        },
        {
          "slug": "cedar",
          "name": "Gilt buttons",
          "color": "#D9BC7E"
        },
        {
          "slug": "hairline",
          "name": "Night hairline",
          "color": "#3D342B"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#B5AA9B"
        },
        {
          "slug": "ink",
          "name": "Rice white (text)",
          "color": "#F1EADC"
        }
      ],
      "gradients": [
        {
          "slug": "polished-rice",
          "name": "Polished rice",
          "gradient": "linear-gradient(180deg, #26201B 0%, #1C1714 100%)"
        },
        {
          "slug": "koji-warmth",
          "name": "Koji warmth",
          "gradient": "radial-gradient(110% 80% at 50% 0%, #33291F 0%, #1C1714 100%)"
        },
        {
          "slug": "cellar",
          "name": "Cedar cellar",
          "gradient": "linear-gradient(180deg, #33291F 0%, #120F0D 100%)"
        },
        {
          "slug": "gilt",
          "name": "Gilt",
          "gradient": "linear-gradient(90deg, #C9A462 0%, #E3C98F 50%, #C9A462 100%)"
        }
      ]
    },
    "custom": {
      "band": {
        "bg": "#120F0D",
        "deep": "#0D0B09",
        "text": "#F1EADC",
        "quiet": "#B5AA9B",
        "accent": "#E3C98F"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|rice",
      "text": "var:preset|color|ink"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|cedar",
          "text": "#1C1714"
        },
        "border": {
          "color": "var:preset|color|cedar"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "#1C1714"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "#1C1714"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        }
      }
    },
    "css": "::selection{background:var(--wp--preset--color--gold);color:#1C1714}"
  }
}
