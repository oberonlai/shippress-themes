{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "rice",
          "name": "Rice-polish ivory (ground)",
          "color": "#F4EFE4"
        },
        {
          "slug": "paper",
          "name": "Label paper (cards, panels)",
          "color": "#FBF9F4"
        },
        {
          "slug": "koji",
          "name": "Koji beige",
          "color": "#E6D9BF"
        },
        {
          "slug": "lees-pale",
          "name": "Pale sake lees",
          "color": "#E4E1DA"
        },
        {
          "slug": "lees",
          "name": "Sake-lees grey",
          "color": "#C8C4BA"
        },
        {
          "slug": "gold-light",
          "name": "Pale gilt",
          "color": "#D9BC7E"
        },
        {
          "slug": "gold",
          "name": "Gilded gold (hairlines, ornaments)",
          "color": "#B8954F"
        },
        {
          "slug": "gold-deep",
          "name": "Deep gold (links, italic voice)",
          "color": "#735720"
        },
        {
          "slug": "cedar",
          "name": "Aged cedar (buttons, bands)",
          "color": "#4B3326"
        },
        {
          "slug": "hairline",
          "name": "Hairline",
          "color": "#DCD2BF"
        },
        {
          "slug": "mute",
          "name": "Quiet text",
          "color": "#625950"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#241D18"
        }
      ],
      "gradients": [
        {
          "slug": "polished-rice",
          "name": "Polished rice",
          "gradient": "linear-gradient(180deg, #FBF9F4 0%, #F4EFE4 100%)"
        },
        {
          "slug": "koji-warmth",
          "name": "Koji warmth",
          "gradient": "radial-gradient(110% 80% at 50% 0%, #FBF9F4 0%, #E6D9BF 100%)"
        },
        {
          "slug": "cellar",
          "name": "Cedar cellar",
          "gradient": "linear-gradient(180deg, #4B3326 0%, #241D18 100%)"
        },
        {
          "slug": "gilt",
          "name": "Gilt",
          "gradient": "linear-gradient(90deg, #B8954F 0%, #D9BC7E 50%, #B8954F 100%)"
        }
      ],
      "duotone": [
        {
          "slug": "ink-rice",
          "name": "Ink and rice",
          "colors": [
            "#241D18",
            "#F4EFE4"
          ]
        },
        {
          "slug": "cedar-gilt",
          "name": "Cedar and gilt",
          "colors": [
            "#4B3326",
            "#D9BC7E"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "writingMode": false,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (EB Garamond)",
          "fontFamily": "\"EB Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "EB Garamond",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/eb-garamond-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "EB Garamond",
              "fontStyle": "italic",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/eb-garamond-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Albert Sans)",
          "fontFamily": "\"Albert Sans\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Albert Sans",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/albert-sans-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Albert Sans",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/albert-sans-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.75rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.25rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6.25rem",
          "fluid": {
            "min": "3.25rem",
            "max": "7.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Hairline gap",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1.125rem)"
        },
        {
          "slug": "30",
          "name": "Gutter",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Label padding",
          "size": "clamp(1.75rem, 1.1rem + 2.4vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4rem, 2.6rem + 5.5vw, 8rem)"
        },
        {
          "slug": "60",
          "name": "Quiet air",
          "size": "clamp(5.5rem, 3.2rem + 8.5vw, 12rem)"
        }
      ]
    },
    "custom": {
      "radius": {
        "label": "2px",
        "arch": "999px 999px 2px 2px",
        "pill": "999px"
      },
      "shadow": {
        "label": "0 1px 0 rgba(36,29,24,.04), 0 28px 56px -40px rgba(75,51,38,.45)"
      },
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "band": {
        "bg": "#3A281E",
        "deep": "#241D18",
        "text": "#F4EFE4",
        "quiet": "#D8CDB9",
        "accent": "#D9BC7E"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|rice",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|gold-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.04",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.12"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.25",
          "fontWeight": "500"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.35",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.24em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|cedar",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|cedar"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "2rem",
            "bottom": "1rem",
            "left": "2rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.75rem",
          "fontWeight": "600",
          "letterSpacing": "0.22em",
          "lineHeight": "1.2",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|ink"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.8125rem",
          "lineHeight": "1.5",
          "letterSpacing": "0.02em"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "1.5rem",
          "fontWeight": "400",
          "letterSpacing": "0.02em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "0.75rem",
          "letterSpacing": "0.04em",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.75rem",
          "fontWeight": "500",
          "letterSpacing": "0.2em",
          "lineHeight": "1.3",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "letterSpacing": "-0.015em",
          "lineHeight": "1.08"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|gold-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|mute"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "400"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|mute"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|gold"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontStyle": "italic",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.28"
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.06"
        }
      },
      "core/image": {
        "border": {
          "radius": "2px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "2px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.26em;text-decoration-thickness:1px;transition:color .3s ease,text-decoration-color .3s ease}::selection{background:var(--wp--preset--color--gold-light);color:var(--wp--preset--color--ink)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the brewery family",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-brewery",
      "title": "The brewery (process and tours)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-tasting-room",
      "title": "Tasting room (visits and flights)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter (The Pressing Letter)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact and visits",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
