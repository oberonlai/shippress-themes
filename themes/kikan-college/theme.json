{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "960px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "base",
     "name": "Ground",
     "color": "#F4F6F8"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "tint",
     "name": "Tint",
     "color": "#E4E9EE"
    },
    {
     "slug": "primary",
     "name": "Katsu-iro",
     "color": "#3C4F62"
    },
    {
     "slug": "panel",
     "name": "Panel",
     "color": "#34404C"
    },
    {
     "slug": "accent",
     "name": "Copper",
     "color": "#B8683A"
    },
    {
     "slug": "contrast",
     "name": "Ink",
     "color": "#1B2733"
    },
    {
     "slug": "muted",
     "name": "Soft ink",
     "color": "#56606B"
    },
    {
     "slug": "line",
     "name": "Hairline",
     "color": "#CDCED5"
    },
    {
     "slug": "steel",
     "name": "Tile steel",
     "color": "#C5D0DB"
    },
    {
     "slug": "sage",
     "name": "Tile sage",
     "color": "#C9D4D0"
    },
    {
     "slug": "copper-tint",
     "name": "Tile copper tint",
     "color": "#E3D3C7"
    },
    {
     "slug": "on-panel",
     "name": "Text on panel",
     "color": "#E3C2A8"
    }
   ],
   "gradients": []
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Headings (Instrument Sans)",
     "fontFamily": "\"Instrument Sans\", \"Source Sans 3\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Sans",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-sans-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-tc",
     "name": "Noto Sans TC",
     "fontFamily": "\"Noto Sans TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-700.woff2"
       ]
      }
     ]
    },
    {
     "slug": "noto-sans-jp",
     "name": "Noto Sans JP",
     "fontFamily": "\"Noto Sans JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-400.woff2"
       ]
      },
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-ja-700.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "Times, ticks",
     "size": "0.8125rem"
    },
    {
     "slug": "s",
     "name": "Labels",
     "size": "0.875rem"
    },
    {
     "slug": "m",
     "name": "Body",
     "size": "1rem"
    },
    {
     "slug": "l",
     "name": "Numerals, lede",
     "size": "1.125rem"
    },
    {
     "slug": "xl",
     "name": "Sub-lines, plate labels",
     "size": "1.375rem"
    },
    {
     "slug": "2xl",
     "name": "H3, quote",
     "size": "1.75rem"
    },
    {
     "slug": "3xl",
     "name": "Section heading",
     "size": "2.25rem"
    },
    {
     "slug": "4xl",
     "name": "Inner page title, stats",
     "size": "3rem"
    },
    {
     "slug": "display",
     "name": "Home headline",
     "size": "4.25rem"
    }
   ]
  },
  "custom": {}
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--contrast)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--m)",
   "fontWeight": "400",
   "lineHeight": "1.8"
  },
  "spacing": {
   "blockGap": "0",
   "padding": {
    "left": "0",
    "right": "0",
    "top": "0",
    "bottom": "0"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--primary)"
     }
    }
   },
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.4"
    },
    "color": {
     "text": "var(--wp--preset--color--contrast)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--contrast)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "700"
    },
    "border": {
     "radius": "999px"
    },
    "spacing": {
     "padding": {
      "top": "0.9rem",
      "bottom": "0.9rem",
      "left": "2rem",
      "right": "2rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--primary)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  },
  "blocks": {
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)"
    }
   }
  }
 }
}
