{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": { "contentSize": "680px", "wideSize": "1240px" },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    { "slug": "ground", "name": "Greige ground", "color": "#DFDAD6" },
    { "slug": "field-light", "name": "Field light", "color": "#E9E6E3" },
    { "slug": "field-deep", "name": "Field deep", "color": "#D5CFCA" },
    { "slug": "ghost", "name": "Ghost white", "color": "#FFFFFF" },
    { "slug": "ink", "name": "Ink", "color": "#303030" },
    { "slug": "muted", "name": "Muted ink", "color": "#5C5753" },
    { "slug": "deep", "name": "Deep (footer)", "color": "#3B3123" },
    { "slug": "accent", "name": "Azuki (small accent)", "color": "#6E4E4A" }
   ],
   "gradients": []
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1440px" },
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Fraunces)",
     "fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Fraunces",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/fraunces-variable-latin.woff2" ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Arial, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [ "file:./assets/fonts/source-sans-3-variable-latin.woff2" ]
      }
     ]
    }
   ],
   "fontSizes": [
    { "slug": "small", "name": "Label", "size": "0.875rem" },
    { "slug": "base", "name": "Body", "size": "1.0625rem" },
    { "slug": "medium", "name": "Name / price", "size": "1.5rem", "fluid": false },
    { "slug": "large", "name": "Course name", "size": "clamp(1.625rem, 1.3rem + 1vw, 2.25rem)", "fluid": false },
    { "slug": "x-large", "name": "Lead title", "size": "clamp(2.125rem, 1.8rem + 1.333vw, 3rem)", "fluid": false },
    { "slug": "xx-large", "name": "Section ghost", "size": "6rem", "fluid": false },
    { "slug": "ghost", "name": "Ghost XL", "size": "clamp(6rem, 22vw, 20rem)", "fluid": false }
   ]
  },
  "spacing": {
   "units": [ "px", "rem", "%", "vw" ],
   "spacingSizes": [
    { "slug": "20", "name": "XS", "size": "0.5rem" },
    { "slug": "30", "name": "S", "size": "1rem" },
    { "slug": "40", "name": "M", "size": "2rem" },
    { "slug": "50", "name": "L", "size": "4rem" },
    { "slug": "60", "name": "XL", "size": "6rem" },
    { "slug": "70", "name": "Section", "size": "clamp(6rem, 11vw, 10rem)" },
    { "slug": "80", "name": "Menu padding", "size": "clamp(6rem, 16.7vw, 15rem)" },
    { "slug": "90", "name": "Access padding", "size": "clamp(7rem, 22vw, 20rem)" }
   ]
  },
  "border": { "radius": true },
  "shadow": { "defaultPresets": false, "presets": [] }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "2",
   "letterSpacing": "0.02em"
  },
  "spacing": { "blockGap": "1.5rem" },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "300",
     "lineHeight": "1.33",
     "letterSpacing": "0.01em"
    }
   },
   "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)",
     "lineHeight": "1.11",
     "letterSpacing": "0.04em",
     "textTransform": "uppercase"
    }
   },
   "link": {
    "color": { "text": "var(--wp--preset--color--ink)" },
    ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
   },
   "button": {
    "color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
    "border": { "radius": "42px", "width": "1px", "style": "solid", "color": "#303030" },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.9375rem",
     "fontWeight": "600",
     "letterSpacing": "0.14em",
     "lineHeight": "1",
     "textTransform": "uppercase"
    },
    "spacing": { "padding": { "top": "0", "bottom": "0", "left": "2.75rem", "right": "2.75rem" } }
   }
  },
  "blocks": {
   "core/image": { "border": { "radius": "0" } }
  }
 },
 "customTemplates": [],
 "templateParts": [
  { "name": "header", "title": "Header", "area": "header" },
  { "name": "footer", "title": "Footer", "area": "footer" }
 ]
}
