{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "layout": {
   "contentSize": "1360px",
   "wideSize": "1360px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "palette": [
    {
     "slug": "ground",
     "name": "Ground",
     "color": "#F6F6F6"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    },
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#333333"
    },
    {
     "slug": "mauve",
     "name": "Grape mouse (accent panel)",
     "color": "#6B5E66"
    },
    {
     "slug": "deep",
     "name": "Deep mauve",
     "color": "#5A4E56"
    },
    {
     "slug": "band",
     "name": "Mauve grey",
     "color": "#AFA3A3"
    },
    {
     "slug": "tint",
     "name": "Mauve tint",
     "color": "#D9CFD3"
    },
    {
     "slug": "stain",
     "name": "Water stain",
     "color": "#A8553F"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "customFontSize": true,
   "fluid": false,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Onest)",
     "fontFamily": "\"Onest\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Source Sans 3)",
     "fontFamily": "\"Source Sans 3\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Source Sans 3",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/source-sans-3-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-zh",
     "name": "Chinese subset (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "cjk-ja",
     "name": "Japanese subset (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400 700",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "caption",
     "name": "Caption",
     "size": "0.625rem"
    },
    {
     "slug": "label",
     "name": "Label",
     "size": "0.75rem"
    },
    {
     "slug": "base",
     "name": "Body",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Numbered title",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Statement",
     "size": "1.5rem"
    },
    {
     "slug": "x-large",
     "name": "Section headline",
     "size": "2.5rem"
    },
    {
     "slug": "xx-large",
     "name": "Page title",
     "size": "4.25rem"
    },
    {
     "slug": "stat",
     "name": "Stat numeral",
     "size": "6rem"
    },
    {
     "slug": "wordmark",
     "name": "Wordmark",
     "size": "clamp(4.25rem, 12vw, 10.5rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "30",
     "name": "M",
     "size": "2.5rem"
    },
    {
     "slug": "40",
     "name": "L",
     "size": "5rem"
    },
    {
     "slug": "50",
     "name": "XL",
     "size": "9.375rem"
    }
   ]
  },
  "border": {
   "radius": true
  },
  "useRootPaddingAwareAlignments": false
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--ground)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.75",
   "fontWeight": "400"
  },
  "spacing": {
   "blockGap": "0"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "700",
     "lineHeight": "1.2",
     "letterSpacing": "-0.01em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "1.05",
     "letterSpacing": "-0.02em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--medium)",
     "lineHeight": "1.45",
     "letterSpacing": "0"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--mauve)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--mauve)",
     "text": "var(--wp--preset--color--white)"
    },
    "border": {
     "radius": "900px"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--body)",
     "fontSize": "0.75rem",
     "fontWeight": "700"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-inner",
   "title": "Inner page",
   "postTypes": [
    "page"
   ]
  }
 ]
}