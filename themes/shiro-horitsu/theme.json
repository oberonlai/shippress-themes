{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "washi",
          "name": "Washi ivory (ground)",
          "color": "#F4F1EA"
        },
        {
          "slug": "paper",
          "name": "Paper (surface)",
          "color": "#FBFAF6"
        },
        {
          "slug": "kinari",
          "name": "Stone light (tint)",
          "color": "#E7E3DA"
        },
        {
          "slug": "sumi",
          "name": "Sumi ink (text)",
          "color": "#1D1F24"
        },
        {
          "slug": "stone",
          "name": "Stone grey (quiet text)",
          "color": "#5F5E59"
        },
        {
          "slug": "ai",
          "name": "Deep indigo (primary)",
          "color": "#2A3A5E"
        },
        {
          "slug": "yoru",
          "name": "Night indigo (dark bands)",
          "color": "#1A2133"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "sumi-washi",
          "name": "Sumi and washi",
          "colors": [
            "#1D1F24",
            "#F4F1EA"
          ]
        },
        {
          "slug": "indigo-washi",
          "name": "Indigo and washi",
          "colors": [
            "#1A2133",
            "#E7E3DA"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (EB Garamond)",
          "fontFamily": "\"EB Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "EB Garamond",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/eb-garamond-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "EB Garamond",
              "fontStyle": "italic",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/eb-garamond-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (Hanken Grotesk)",
          "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-italic-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.5625rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.375rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "3.25rem",
          "fluid": {
            "min": "2.25rem",
            "max": "4rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "6rem",
          "fluid": {
            "min": "3rem",
            "max": "7.25rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1.25rem, 0.9rem + 1.2vw, 2rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.3rem + 2.6vw, 4rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(4rem, 2.4rem + 5vw, 8rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(5rem, 2.8rem + 8vw, 12rem)"
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 15%, transparent)",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "deepText": "#EEEAE1",
      "deepMute": "#AEB4C4"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|washi",
      "text": "var:preset|color|sumi"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4.5vw, 4rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4.5vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.72"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|ai"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|sumi"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|sumi"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "fontWeight": "400",
          "lineHeight": "1",
          "letterSpacing": "-0.03em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "400",
          "lineHeight": "1.06",
          "letterSpacing": "-0.022em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ai",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "0px",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|ai"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1.75rem",
            "bottom": "1rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "0.875rem",
          "fontWeight": "500",
          "letterSpacing": "0.06em",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|paper"
          },
          "border": {
            "color": "var:preset|color|sumi"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "letterSpacing": "0.04em",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "1.5rem",
          "fontWeight": "400",
          "letterSpacing": "-0.01em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "0.6875rem",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase",
          "lineHeight": "1.3"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "450",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.12"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|sumi"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ai"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|stone"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|stone"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontStyle": "italic",
          "fontWeight": "400",
          "lineHeight": "1.3"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "400",
          "lineHeight": "1.15"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.24em;text-decoration-thickness:1px;transition:color .4s ease}::selection{background:var(--wp--preset--color--kinari);color:var(--wp--preset--color--sumi)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About the firm",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-practice",
      "title": "Practice areas",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-attorneys",
      "title": "Attorneys",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-consultation",
      "title": "Consultation and fees",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
