{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Yoru (night office)",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "washi",
          "name": "Night ink (ground)",
          "color": "#14161C"
        },
        {
          "slug": "paper",
          "name": "Lamp shadow (surface)",
          "color": "#1B1E26"
        },
        {
          "slug": "kinari",
          "name": "Slate (tint)",
          "color": "#272B36"
        },
        {
          "slug": "sumi",
          "name": "Washi (text)",
          "color": "#ECE8DE"
        },
        {
          "slug": "stone",
          "name": "Fog grey (quiet text)",
          "color": "#A7A59E"
        },
        {
          "slug": "ai",
          "name": "Moonlit indigo (primary)",
          "color": "#A9B8DB"
        },
        {
          "slug": "yoru",
          "name": "Deepest night (dark bands)",
          "color": "#0C0E13"
        }
      ],
      "duotone": [
        {
          "slug": "sumi-washi",
          "name": "Night and washi",
          "colors": [
            "#14161C",
            "#ECE8DE"
          ]
        },
        {
          "slug": "indigo-washi",
          "name": "Night and indigo",
          "colors": [
            "#0C0E13",
            "#A9B8DB"
          ]
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--sumi) 16%, transparent)"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "text": "var:preset|color|washi"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|sumi",
            "text": "var:preset|color|washi"
          }
        }
      }
    }
  }
}
