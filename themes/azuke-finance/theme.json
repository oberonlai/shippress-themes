{
 "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "720px",
   "wideSize": "1372px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "defaultDuotone": false,
   "custom": true,
   "palette": [
    {
     "slug": "paper",
     "name": "Paper (ground)",
     "color": "#F9F8F4"
    },
    {
     "slug": "panel",
     "name": "Sage panel",
     "color": "#D6DBD6"
    },
    {
     "slug": "ink",
     "name": "Ink (text)",
     "color": "#333333"
    },
    {
     "slug": "dark",
     "name": "Dark (tab, band, footer)",
     "color": "#2E322F"
    },
    {
     "slug": "light",
     "name": "Light on dark",
     "color": "#EDE6DD"
    },
    {
     "slug": "accent",
     "name": "Coral accent (one word, numerals)",
     "color": "#FF6D48"
    },
    {
     "slug": "main",
     "name": "Sage grey (muted text, rules)",
     "color": "#5E6E68"
    }
   ],
   "gradients": []
  },
  "typography": {
   "fluid": false,
   "customFontSize": true,
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display (Onest)",
     "fontFamily": "\"Onest\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Onest",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/onest-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "body",
     "name": "Body (Inter Tight)",
     "fontFamily": "\"Inter Tight\", \"Noto Sans TC\", \"Noto Sans JP\", system-ui, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter Tight",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/inter-tight-variable-latin.woff2"
       ]
      }
     ]
    },
    {
     "slug": "text-zh",
     "name": "Chinese subset, text (Noto Sans TC)",
     "fontFamily": "\"Noto Sans TC\", \"Noto Sans CJK TC\", sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans TC",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-tc-zh-tw-400.woff2"
       ]
      }
     ]
    },
    {
     "slug": "text-ja",
     "name": "Japanese subset, text (Noto Sans JP)",
     "fontFamily": "\"Noto Sans JP\", \"Noto Sans CJK JP\", \"Hiragino Sans\", \"Yu Gothic\", Meiryo, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Noto Sans JP",
       "fontStyle": "normal",
       "fontWeight": "400",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/noto-sans-jp-400-ja.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.8125rem"
    },
    {
     "slug": "base",
     "name": "Base",
     "size": "0.9375rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.125rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.75rem"
    },
    {
     "slug": "x-large",
     "name": "Figure",
     "size": "clamp(2.75rem, 2rem + 2.4vw, 4rem)"
    },
    {
     "slug": "xx-large",
     "name": "Headline",
     "size": "clamp(2.75rem, 1.4rem + 4.3vw, 4.5rem)"
    },
    {
     "slug": "huge",
     "name": "Section title",
     "size": "clamp(3rem, 1.2rem + 5.6vw, 6rem)"
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "em",
    "rem",
    "%",
    "vw",
    "vh"
   ],
   "spacingSizes": [
    {
     "slug": "20",
     "name": "XS",
     "size": "0.5rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "2rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "4rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "7.5rem"
    },
    {
     "slug": "70",
     "name": "XXL",
     "size": "10rem"
    }
   ]
  },
  "border": {
   "radius": true
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--paper)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "fontSize": "var(--wp--preset--font-size--base)",
   "lineHeight": "1.6"
  },
  "spacing": {
   "blockGap": "1.5rem"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "400",
     "lineHeight": "1.1",
     "letterSpacing": "-0.04em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)",
     "lineHeight": "0.91",
     "letterSpacing": "-0.05em"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--huge)",
     "lineHeight": "1.3"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--main)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--paper)"
    },
    "border": {
     "radius": "9999px"
    },
    "typography": {
     "fontSize": "var(--wp--preset--font-size--base)",
     "fontWeight": "500"
    }
   }
  },
  "blocks": {
   "core/button": {
    "border": {
     "radius": "9999px"
    }
   }
  }
 },
 "customTemplates": [],
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ]
}
