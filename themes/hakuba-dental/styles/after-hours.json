{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "After hours",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "white",
          "name": "Night navy (ground)",
          "color": "#0B1E31"
        },
        {
          "slug": "mist",
          "name": "Deep mist (cells)",
          "color": "#12304D"
        },
        {
          "slug": "ice",
          "name": "Ice at night (rules and chips)",
          "color": "#1E4466"
        },
        {
          "slug": "blue",
          "name": "Lamp blue (accent)",
          "color": "#7DB5E6"
        },
        {
          "slug": "blue-deep",
          "name": "Pale blue (buttons and links)",
          "color": "#9CC6EA"
        },
        {
          "slug": "navy",
          "name": "Mist white (text)",
          "color": "#E8F1F8"
        },
        {
          "slug": "slate",
          "name": "Blue grey (quiet text)",
          "color": "#B4C6D8"
        },
        {
          "slug": "ink",
          "name": "Deepest navy (dark cells and footer)",
          "color": "#06131F"
        }
      ],
      "duotone": [
        {
          "slug": "navy-mist",
          "name": "Night and mist",
          "colors": [
            "#06131F",
            "#E8F1F8"
          ]
        }
      ]
    },
    "custom": {
      "line": "color-mix(in srgb, var(--wp--preset--color--navy) 14%, transparent)"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "text": "var:preset|color|white"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|navy",
            "text": "var:preset|color|white"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|navy",
            "text": "var:preset|color|white"
          }
        }
      }
    }
  }
}
