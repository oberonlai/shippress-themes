{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "palette": [
        {
          "slug": "white",
          "name": "White (ground)",
          "color": "#FFFFFF"
        },
        {
          "slug": "mist",
          "name": "Mist blue (tint)",
          "color": "#E8F1F8"
        },
        {
          "slug": "ice",
          "name": "Ice (soft rule and chips)",
          "color": "#D4E4F1"
        },
        {
          "slug": "blue",
          "name": "Clinic blue (accent, large text and icons)",
          "color": "#2F7FC1"
        },
        {
          "slug": "blue-deep",
          "name": "Deep blue (buttons and links)",
          "color": "#1F64A0"
        },
        {
          "slug": "navy",
          "name": "Navy (text and dark bands)",
          "color": "#0F2A44"
        },
        {
          "slug": "slate",
          "name": "Slate (quiet text)",
          "color": "#4A5D70"
        },
        {
          "slug": "ink",
          "name": "Ink navy (dark cells and footer)",
          "color": "#0F2A44"
        }
      ],
      "gradients": [],
      "duotone": [
        {
          "slug": "navy-mist",
          "name": "Navy and mist",
          "colors": [
            "#0F2A44",
            "#E8F1F8"
          ]
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": {
        "minViewportWidth": "390px",
        "maxViewportWidth": "1440px"
      },
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading (Sora)",
          "fontFamily": "Sora, \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Sora",
              "fontStyle": "normal",
              "fontWeight": "100 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/sora-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+2713, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body (Inter)",
          "fontFamily": "Inter, \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+2713, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "Label",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Lead",
          "size": "1.3125rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "1.875rem",
          "fluid": {
            "min": "1.4375rem",
            "max": "2.125rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Section title",
          "size": "2.875rem",
          "fluid": {
            "min": "2rem",
            "max": "3.375rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "4.25rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "Tiny",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "Small",
          "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)"
        },
        {
          "slug": "30",
          "name": "Gap",
          "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
        },
        {
          "slug": "40",
          "name": "Block",
          "size": "clamp(2rem, 1.4rem + 2.2vw, 3.5rem)"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(3.5rem, 2.4rem + 4vw, 6.5rem)"
        },
        {
          "slug": "60",
          "name": "Large section",
          "size": "clamp(4.5rem, 3rem + 6vw, 9rem)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "radius": {
        "cell": "clamp(1.5rem, 1rem + 1.6vw, 2.5rem)",
        "crown": "clamp(5rem, 3rem + 7vw, 11rem)",
        "pill": "999px"
      },
      "line": "color-mix(in srgb, var(--wp--preset--color--navy) 12%, transparent)",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "deepText": "#E8F1F8",
      "deepMute": "#B4C6D8",
      "deepAccent": "#9CC6EA"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|navy"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "top": "0px",
        "right": "clamp(1.25rem, 4vw, 3.5rem)",
        "bottom": "0px",
        "left": "clamp(1.25rem, 4vw, 3.5rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|blue-deep"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|navy"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|navy"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|navy"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "600",
          "lineHeight": "1.12",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display",
          "lineHeight": "1.04",
          "letterSpacing": "-0.035em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.08",
          "letterSpacing": "-0.03em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.4",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|blue-deep",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "999px",
          "width": "0px",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "right": "1.6rem",
            "bottom": "0.9rem",
            "left": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "0.9375rem",
          "fontWeight": "600",
          "letterSpacing": "0",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|navy",
            "text": "var:preset|color|white"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|navy",
            "text": "var:preset|color|white"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|slate"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.25rem",
          "fontWeight": "600",
          "letterSpacing": "-0.02em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|navy"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "500",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "600",
          "lineHeight": "1.15"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|navy"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|slate"
        },
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "500"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|blue-deep"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|slate"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.6"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|slate"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|line"
        },
        "border": {
          "width": "0px"
        }
      },
      "core/quote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "500",
          "lineHeight": "1.3"
        },
        "spacing": {
          "padding": {
            "left": "0px"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "width": "0px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "500",
          "lineHeight": "1.15"
        }
      },
      "core/image": {
        "border": {
          "radius": "var:custom|radius|cell"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "var:custom|radius|cell"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "css": "a{text-underline-offset:0.2em;text-decoration-thickness:1px;transition:color .3s ease}::selection{background:var(--wp--preset--color--ice);color:var(--wp--preset--color--navy)}"
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-about",
      "title": "Clinic and team",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-treatments",
      "title": "Treatments",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-fees",
      "title": "Fees",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-first-visit",
      "title": "First visit",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-newsletter",
      "title": "Newsletter",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-wide",
      "title": "Wide page (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
